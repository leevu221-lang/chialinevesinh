   padding: 3px 12px;\n      border-radius: 20px;\n      font-weight: 800;\n      font-size: 13px;\n      box-shadow: 0 2px 6px rgba(217, 119, 6, 0.3);\n    }\n    .map-cell.in-allocation-target {\n      outline: 3px solid #16a34a !important;\n      background: #dcfce7 !important;\n      color: #166534 !important;\n      transform: scale(1.02);\n      z-index: 15;\n      box-shadow: 0 4px 14px rgba(22, 163, 74, 0.35) !important;\n    }\n    .map-cell.in-allocation-target::after {\n      content: \"✓\";\n      position: absolute;\n      top: 2px;\n      right: 4px;\n      font-size: 12px;\n      font-weight: 900;\n      color: #15803d;\n    }\n    .allocation-mode-active .map-cell {\n      cursor: pointer;\n    }\n    .allocation-mode-active .map-cell:hover {\n      outline: 2.5px dashed #d97706 !important;\n      transform: translateY(-2px);\n    }\n\n  \n    /* ==========================================================================\n       TỐI ƯU HÓA ĐẶC BIỆT CHO TRÌNH DUYỆT ĐIỆN THOẠI & LINE/ZALO IN-APP BROWSER\n       ========================================================================== */\n    html {\n      -webkit-text-size-adjust: 100%;\n      touch-action: manipulation;\n    }\n    body {\n      overflow-x: hidden;\n      -webkit-tap-highlight-color: transparent;\n      padding-bottom: env(safe-area-inset-bottom, 20px);\n    }\n\n    /* Sub-tabs điều hướng lọc nhanh cho mobile */\n    .mobile-emp-subtabs {\n      display: none;\n      gap: 6px;\n      margin-bottom: 12px;\n      overflow-x: auto;\n      scrollbar-width: none;\n      -webkit-overflow-scrolling: touch;\n    }\n    .mobile-emp-subtabs::-webkit-scrollbar {\n      display: none;\n    }\n    .mobile-subtab-btn {\n      flex: 1;\n      padding: 8px 12px;\n      border-radius: 20px;\n      font-size: 12.5px;\n      font-weight: 700;\n      border: 1.5px solid #fde68a;\n      background: #ffffff;\n      color: #78350f;\n      cursor: pointer;\n      white-space: nowrap;\n      text-align: center;\n      transition: all 0.2s ease;\n    }\n    .mobile-subtab-btn.active {\n      background: var(--primary-gradient);\n      color: #ffffff;\n      border-color: #d97706;\n      box-shadow: 0 2px 8px rgba(217, 119, 6, 0.25);\n    }\n\n    .mobile-scroll-tip {\n      display: none;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      background: #fffbeb;\n      border: 1.5px dashed #f59e0b;\n      color: #92400e;\n      padding: 7px 12px;\n      border-radius: 10px;\n      font-size: 11.5px;\n      font-weight: 700;\n      margin-bottom: 10px;\n      animation: pulseTip 2s infinite;\n    }\n    @keyframes pulseTip {\n      0%, 100% { opacity: 0.9; transform: scale(1); }\n      50% { opacity: 1; transform: scale(1.01); }\n    }\n\n    /* Nút cuộn nhanh lên đầu trang */\n    .btn-scroll-top {\n      position: fixed;\n      bottom: 20px;\n      right: 16px;\n      width: 42px;\n      height: 42px;\n      border-radius: 50%;\n      background: var(--primary-gradient);\n      color: #ffffff;\n      border: none;\n      box-shadow: 0 4px 14px rgba(217, 119, 6, 0.4);\n      display: none;\n      align-items: center;\n      justify-content: center;\n      font-size: 16px;\n      z-index: 999;\n      cursor: pointer;\n      transition: all 0.2s ease;\n    }\n    .btn-scroll-top:active {\n      transform: scale(0.92);\n    }\n\n    /* MEDIA QUERY TỐI ƯU MÀN HÌNH ĐIỆN THOẠI (<= 768px) */\n    @media (max-width: 768px) {\n      .app-container {\n        padding: 8px 8px 60px 8px !important;\n      }\n\n      /* HEADER */\n      .app-header {\n        padding: 10px 12px !important;\n        border-radius: var(--radius-lg) !important;\n        margin-bottom: 10px !important;\n        gap: 10px !important;\n        flex-direction: column !important;\n        align-items: stretch !important;\n      }\n      .header-branding {\n        display: flex !important;\n        align-items: center !important;\n        gap: 10px !important;\n        width: 1