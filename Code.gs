t:28px;\"><i class=\"fa-solid fa-xmark\"></i></button>\n      </div>\n      <div style=\"display:flex; flex-direction:column; gap:16px; margin-top:14px;\">\n        <input type=\"hidden\" id=\"empEditIndex\" value=\"-1\">\n        <div>\n          <label style=\"display:block; font-size:12.5px; font-weight:700; color:#78350f; margin-bottom:6px;\">\n            Họ và Tên Nhân Viên / PG <span style=\"color:#ef4444;\">*</span>\n          </label>\n          <input type=\"text\" id=\"empInputName\" class=\"shift-field-input\" placeholder=\"Ví dụ: Huỳnh Hoàng Phúc hoặc Oanh LG\" style=\"width:100%; font-size:13.5px; font-weight:600;\">\n        </div>\n\n        <div>\n          <label style=\"display:block; font-size:12.5px; font-weight:700; color:#78350f; margin-bottom:6px;\">\n            Phân Loại Nhân Sự\n          </label>\n          <select id=\"empInputRole\" class=\"shift-field-select\" style=\"width:100%; font-size:13.5px; font-weight:600;\">\n            <option value=\"nv\">👤 Nhân viên siêu thị</option>\n            <option value=\"pg\">🤝 PG Hãng hỗ trợ</option>\n          </select>\n        </div>\n\n        <div>\n          <label style=\"display:block; font-size:12.5px; font-weight:700; color:#78350f; margin-bottom:8px;\">\n            Trạng Thái Điểm Danh\n          </label>\n          <div style=\"display:flex; gap:20px; align-items:center;\">\n            <label style=\"display:flex; align-items:center; gap:6px; cursor:pointer; font-size:13px; font-weight:600;\">\n              <input type=\"radio\" name=\"empStatusRadio\" value=\"present\" checked> <span style=\"color:#059669;\">✓ Có mặt / Đang trực</span>\n            </label>\n            <label style=\"display:flex; align-items:center; gap:6px; cursor:pointer; font-size:13px; font-weight:600;\">\n              <input type=\"radio\" name=\"empStatusRadio\" value=\"absent\"> <span style=\"color:#78716c;\">○ Vắng mặt</span>\n            </label>\n          </div>\n        </div>\n\n        <div id=\"empRenameAllocationsRow\" style=\"display:none; background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:10px 12px;\">\n          <label style=\"display:flex; align-items:flex-start; gap:8px; cursor:pointer; font-size:12px; color:#92400e; font-weight:600; line-height:1.4;\">\n            <input type=\"checkbox\" id=\"empSyncAllocationName\" checked style=\"margin-top:2px;\">\n            <span>Đồng thời cập nhật tên mới vào tất cả 15 ca trực và các ô sơ đồ mặt bằng đã gán tên này</span>\n          </label>\n        </div>\n      </div>\n      <div style=\"display:flex; justify-content:flex-end; gap:10px; margin-top:18px;\">\n        <button class=\"btn btn-secondary\" id=\"btnCancelEmployeeModal\">Hủy</button>\n        <button class=\"btn btn-primary\" id=\"btnSaveEmployeeModal\" style=\"background: linear-gradient(135deg, #f59e0b, #d97706);\">\n          <i class=\"fa-solid fa-floppy-disk\"></i> Lưu Thông Tin\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL XÁC NHẬN XÓA NV / PG -->\n  <div class=\"modal-overlay\" id=\"deleteEmployeeModal\">\n    <div class=\"modal-box\" style=\"max-width: 440px;\">\n      <div class=\"modal-title\">\n        <span style=\"color:#dc2626;\"><i class=\"fa-solid fa-triangle-exclamation\"></i> Xác Nhận Xóa Nhân Sự</span>\n        <button class=\"btn-icon\" id=\"btnCloseDeleteModal\" style=\"width:28px;height:28px;\"><i class=\"fa-solid fa-xmark\"></i></button>\n      </div>\n      <div style=\"font-size:13.5px; color:#44403c; line-height:1.6; margin-top:12px;\">\n        <p>Bạn có chắc chắn muốn xóa nhân sự <strong id=\"deleteEmpNameSpan\" style=\"color:#dc2626; font-size:14.5px;\"></strong> khỏi danh sách?</p>\n        <div style=\"font-size:12px; color:#78716c; margin-top:10px; background:#fef2f2; padding:10px 12px; border-radius:8px; border:1px solid #fecaca; display:flex; gap:8px; align-items:flex-start;\">\n          <i class=\"fa-solid fa-circle-info\" style=\"color:#dc2626; margin-top:2px;\"></i>\n          <span>Hệ thống sẽ tự động cập nhật lại số thứ tự (STT) liên tục và đồng bộ lên Google Sheet.</span>\n        </div>\n      </div>\n      <div style=\"display:flex; justify-content:flex-end; gap:10px; margin-top:18px;\">\n        <button class=\"btn btn-secondary\" id=\"btnCancelDeleteModal\">Hủy Bỏ</button>\n        <button class=\"btn btn-primary\" id=\"btnConfirmDeleteModal\" style=\"background:#dc2626; border-color:#b91c1c;\">\n          <i class=\"fa-solid fa-trash-can\"></i> Xóa Khỏi Danh Sách\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL CẤU HÌNH WEB APP URL -->\n  <div class=\"modal-overlay\" id=\"configModal\">\n    <div class=\"modal-box\">\n      <div class=\"modal-title\">\n        <span><i class=\"fa-solid fa-sliders\"></i> Cài Đặt Kết Nối Web App</span>\n        <button class=\"btn-icon\" id=\"btnCloseConfigModal\" style=\"width:28px;height:28px;\"><i class=\"fa-solid fa-xmark\"></i></button>\n      </div>\n      <p style=\"font-size:12.5px; color:var(--text-muted); margin-bottom:14px;\">\n        Dán URL Web App triển khai từ Google Apps Script để kích hoạt tính năng lưu tự động 2 chiều về Google Sheet.\n      </p>\n      <div style=\"margin-bottom:14px;\">\n        <label style=\"font-size:12px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:5px;\">URL Web App Apps Script</label>\n        <input type=\"text\" id=\"cfgWebAppUrl\" class=\"shift-field-input\" placeholder=\"https://script.google.com/macros/s/.../exec\">\n      </div>\n      <div style=\"display:flex; justify-content:flex-end; gap:8px;\">\n        <button class=\"btn btn-secondary\" onclick=\"document.getElementById('configModal').style.display='none'\">Hủy</button>\n        <button class=\"btn btn-primary\" id=\"btnSaveConfig\">Lưu Cấu Hình</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- JAVASCRIPT LOGIC & REALTIME SYNC -->\n  <script>\n    const DEFAULT_CONFIG = {\n      sheetId: \"1z6vAzHRIrYihI91Yw1dMnluPPL0BuAYiZarPBD5qNfw\",\n      webAppUrl: \"https://script.google.com/macros/s/AKfycbx0FkqSMkIymq7Le4L3lkHJ_33y35zQOfAev-4b-BMJdL1MCUIIVGvjLqd9dk8PIhwjSw/exec\",\n      mqttBroker: \"wss://broker.emqx.io:8084/mqtt\",\n      mqttTopic: \"st1841/vesinh/realtime_sync\"\n    };\n    localStorage.setItem('phancong_webapp_url', DEFAULT_CONFIG.webAppUrl);\n\n    // Cập nhật trạng thái kết nối & đồng bộ trên thanh tiêu đề\n    function setSyncStatus(stateType, text) {\n      const pill = document.getElementById('realtimeStatusPill');\n      const txt = document.getElementById('realtimeStatusText');\n      if (pill) {\n        pill.classList.remove('syncing', 'connected', 'offline');\n        pill.classList.add(stateType);\n      }\n      if (txt) {\n        txt.textContent = text;\n      }\n    }\n\n    const state = {\n      activeTab: 'floorMapTab',\n      shifts: [],\n      employees: [],\n      searchKeyword: '',\n      empSearchKeyword: '',\n      pendingDeleteEmpIndex: -1\n    };\n\n    // Khởi tạo 15 ca trực mặc định từ Sheet\n    const DEFAULT_SHIFTS = [\n      { stt: 1, row: 17, nv: \"LÊ ÁNH\", kv: \"ALL KHU VỰC ICT\", pg: \"PG ICT\" },\n      { stt: 2, row: 18, nv: \"HẠNH\", kv: \"TIVI 1,2,3, VÁCH SONY, VÁCH SS\", pg: \"OANH LG\" },\n      { stt: 3, row: 19, nv: \"HÙNG MẠNH\", kv: \"TIVI 4,5, LOA, VÁCH LG\", pg: \"\" },\n      { stt: 4, row: 20, nv: \"NHẠN\", kv: \"MÁY GIẶT 1,2,3\", pg: \"TRANG / -\" },\n      { stt: 5, row: 21, nv: \"KIM MỸ\", kv: \"MÁY GIẶT 4,5,6\", pg: \"\" },\n      { stt: 6, row: 22, nv: \"DIỄM MY\", kv: \"VÁCH ML, DÀN MƯỚP, TỦ ĐÔNG\", pg: \"-\" },\n      { stt: 7, row: 23, nv: \"ÁNH\", kv: \"ALL VÁCH GD ÁP TƯỜNG, CHẢO, NỒI CHIÊN\", pg: \"PG KAROFI\" },\n      { stt: 8, row: 24, nv: \"DUY\", kv: \"LỌC NƯỚC, GIA DỤNG 1\", pg: \"HI MUTOSHI\" },\n      { stt: 9, row: 25, nv: \"Ý\", kv: \"GIA DỤNG 2,3\", pg: \"\" },\n      { stt: 10, row: 26, nv: \"- MI\", kv: \"GIA DỤNG 4,5\", pg: \"BĂNG BLUE\" },\n      { stt: 11, row: 27, nv: \"THẮM\", kv: \"GIA DỤNG 6,7\", pg: \"TRINH SUN\" },\n      { stt: 12, row: 28, nv: \"THANH NHI\", kv: \"TỦ LẠNH 1,2\", pg: \"TÍN TCL\" },\n      { stt: 13, row: 29, nv: \"PHÚC\", kv: \"TỦ LẠNH 3,4\", pg: \"ĐƯỢC\" },\n      { stt: 14, row: 30, nv: \"ĐẠI\", kv: \"ALL VÁCH TỦ LẠNH\", pg: \"\" },\n      { stt: 15, row: 31, nv: \"LINH + LÊN TĐKH\", kv: \"VÁCH KÍNH - SÂN XE - BANNER\", pg: \"\" }\n    ];\n\n    const DEFAULT_EMPLOYEES = [\n      { stt: 1, name: \"Huỳnh Hoàng Phúc\", marked: false },\n      { stt: 2, name: \"Thanh Nhi\", marked: true },\n      { stt: 3, name: \"Lâm Thị Như Ý\", marked: true },\n      { stt: 4, name: \"Lê Kim Mỹ\", marked: true },\n      { stt: 5, name: \"Lê Văn Kỳ\", marked: true },\n      { stt: 6, name: \"Ngô Thị Bé Thắm\", marked: true },\n      { stt: 7, name: \"Nguyễn Diễm My\", marked: true },\n      { stt: 8, name: \"Nguyễn Hùng Mạnh\", marked: true },\n      { stt: 9, name: \"Thạch Vũ\", marked: true },\n      { stt: 10, name: \"Nguyễn Tuấn Mi\", marked: true },\n      { stt: 11, name: \"Nguyễn Thị Nhạn\", marked: true },\n      { stt: 12, name: \"Phạm Ngọc Anh\", marked: true },\n      { stt: 13, name: \"Phạm Văn Đại\", marked: true },\n      { stt: 14, name: \"Trần Văn Duy\", marked: true },\n      { stt: 15, name: \"Trang Toshiba\", marked: true },\n      { stt: 16, name: \"Tuấn Aqua\", marked: true },\n      { stt: 17, name: \"Thanh Xiaomi\", marked: true },\n      { stt: 18, name: \"Trinh - Sunhouse\", marked: true },\n      { stt: 19, name: \"Oanh LG\", marked: true },\n      { stt: 20, name: \"Băng Bluestone\", marked: true },\n      { stt: 21, name: \"Ái Vivo\", marked: true },\n      { stt: 22, name: \"Tín TCL\", marked: true },\n      { stt: 23, name: \"Trâm Realme\", marked: true },\n      { stt: 24, name: \"Khang Hi Mutosi\", marked: true },\n      { stt: 25, name: \"Anh Thư - Oppo\", marked: true },\n      { stt: 26, name: \"Lam Karofi\", marked: true }\n    ];\n\n    state.shifts = JSON.parse(localStorage.getItem('st1841_shifts')) || DEFAULT_SHIFTS;\n    // Tự động làm sạch ca trực nếu bộ nhớ đệm cũ từng lưu nhầm dòng tiêu đề\n    if (Array.isArray(state.shifts) && state.shifts.length > 0) {\n      if (state.shifts[0].nv === 'NHÂN VIÊN TRỰC' || state.shifts[0].kv === 'KHU VỰC PHỤ TRÁCH') {\n        state.shifts.shift();\n      }\n      if (state.shifts.length < 15) {\n        state.shifts = DEFAULT_SHIFTS;\n      }\n    }\n    state.employees = JSON.parse(localStorage.getItem('st1841_employees')) || DEFAULT_EMPLOYEES;\n\n    function showToast(msg) {\n      const container = document.getElementById('toastContainer');\n      const toast = document.createElement('div');\n      toast.className = 'toast-msg';\n      toast.innerHTML = '<i class=\"fa-solid fa-circle-info\" style=\"color:#f59e0b;\"></i> ' + msg;\n      container.appendChild(toast);\n      setTimeout(() => {\n        toast.style.opacity = '0';\n        toast.style.transform = 'translateY(10px)';\n        toast.style.transition = 'all 0.3s ease';\n        setTimeout(() => toast.remove(), 300);\n      }, 2600);\n    }\n\n    // RENDER 15 CA TRỰC (NẾU CÓ CONTAINER)\n    function renderShifts() {\n      const assignedCount = state.shifts.filter(s => s.nv && s.nv.trim() !== '').length;\n      const badgeShift = document.getElementById('badgeShiftCount');\n      if (badgeShift) {\n        badgeShift.textContent = `${assignedCount}/15 Vị trí`;\n      }\n\n      const container = document.getElementById('shiftsCardsContainer');\n      if (!container) return;\n      container.innerHTML = '';\n\n      state.shifts.forEach((s, idx) => {\n        const isAssigned = s.nv && s.nv.trim() !== '';\n        const card = document.createElement('div');\n        card.className = 'shift-card';\n        card.innerHTML = `\n          <div class=\"shift-card-header\">\n            <span class=\"shift-stt-badge\"><i class=\"fa-solid fa-hashtag\"></i> Vị trí ${s.stt}</span>\n            <span class=\"shift-status-tag ${isAssigned ? 'assigned' : 'empty'}\">\n              ${isAssigned ? '✓ Đã phân công' : 'Chưa phân công'}\n            </span>\n          </div>\n          <div class=\"shift-field-group\">\n            <label class=\"shift-field-label\"><i class=\"fa-solid fa-user\"></i> Nhân Viên Trực</label>\n            <input type=\"text\" class=\"shift-field-input\" value=\"${s.nv || ''}\" placeholder=\"Nhập tên nhân viên trực...\" onchange=\"updateShiftField(${idx}, 'nv', this.value)\">\n          </div>\n          <div class=\"shift-field-group\">\n            <label class=\"shift-field-label\"><i class=\"fa-solid fa-location-dot\"></i> Khu Vực Phụ Trách</label>\n            <input type=\"text\" class=\"shift-field-input\" value=\"${s.kv || ''}\" placeholder=\"Khu vực trực...\" onchange=\"updateShiftField(${idx}, 'kv', this.value)\">\n          </div>\n          <div class=\"shift-field-group\">\n            <label class=\"shift-field-label\"><i class=\"fa-solid fa-handshake\"></i> PG Hỗ Trợ Hãng</label>\n            <input type=\"text\" class=\"shift-field-input\" value=\"${s.pg || ''}\" placeholder=\"PG hỗ trợ...\" onchange=\"updateShiftField(${idx}, 'pg', this.value)\">\n          </div>\n          <div style=\"font-size:11px; color:#78716c; display:flex; justify-content:space-between; margin-top:2px;\">\n            <span>Dòng Sheet: ${s.row || (16 + s.stt)}</span>\n            <span style=\"color:#d97706; font-weight:600;\"><i class=\"fa-solid fa-bolt\"></i> Tự động lưu</span>\n          </div>\n        `;\n        container.appendChild(card);\n      });\n    }\n\n    // HELPER: PHÂN LOẠI PG HÃNG HOẶC NHÂN VIÊN\n    function isPgStaff(emp) {\n      if (!emp) return false;\n      if (emp.role === 'pg') return true;\n      if (emp.role === 'nv') return false;\n      const name = (emp.name || '').toLowerCase();\n      const pgKeywords = ['pg', 'tcl', 'lg', 'oppo', 'vivo', 'realme', 'xiaomi', 'aqua', 'toshiba', 'sunhouse', 'bluestone', 'karofi', 'mutosi', 'sony', 'samsung'];\n      return pgKeywords.some(kw => name.includes(kw));\n    }\n\n    // HELPER TẠO CARD HTML CHO NHÂN SỰ\n    function createEmployeeCardElement(emp) {\n      const originalIdx = state.employees.indexOf(emp);\n      const isPg = isPgStaff(emp);\n      const card = document.createElement('div');\n      card.className = 'employee-card ' + (emp.marked ? 'present' : '');\n      card.innerHTML = `\n        <div class=\"emp-info\">\n          <div class=\"emp-stt\">${emp.stt}</div>\n          <div>\n            <div class=\"emp-name\">${emp.name}</div>\n            <div style=\"display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:2px;\">\n              <span class=\"emp-role-badge ${isPg ? 'role-pg' : 'role-nv'}\">\n                ${isPg ? '<i class=\"fa-solid fa-handshake\"></i> PG Hãng' : '<i class=\"fa-solid fa-user\"></i> NV Siêu Thị'}\n              </span>\n              <span style=\"font-size:11px; color:var(--text-muted);\">\n                ${emp.marked ? '<span style=\"color:#059669; font-weight:700;\">✓ Có mặt</span>' : 'Vắng mặt'}\n              </span>\n            </div>\n          </div>\n        </div>\n        <div class=\"emp-actions-group\">\n          <button class=\"btn-toggle-attend ${emp.marked ? 'checked' : 'unchecked'}\" onclick=\"toggleEmployeeAttendance(${originalIdx})\" title=\"Điểm danh có mặt / vắng\">\n            ${emp.marked ? '✓ Có mặt' : '○ Vắng'}\n          </button>\n          <button class=\"btn-action-icon edit\" onclick=\"openEditEmployeeModal(${originalIdx})\" title=\"Sửa thông tin\">\n            <i class=\"fa-solid fa-pen-to-square\"></i>\n          </button>\n          <button class=\"btn-action-icon delete\" onclick=\"confirmDeleteEmployee(${originalIdx})\" title=\"Xoá khỏi danh sách\">\n            <i class=\"fa-solid fa-trash-can\"></i>\n          </button>\n        </div>\n      `;\n      return card;\n    }\n\n    // RENDER DANH SÁCH NV / PG CHIA LÀM 2 CỘT (NHÂN VIÊN BÊN TRÁI, PG BÊN PHẢI)\n    function renderEmployees() {\n      const staffContainer = document.getElementById('staffNvGridContainer');\n      const pgContainer = document.getElementById('staffPgGridContainer');\n      if (!staffContainer || !pgContainer) return;\n\n      staffContainer.innerHTML = '';\n      pgContainer.innerHTML = '';\n\n      let presentCount = 0;\n      let pgCount = 0;\n      let staffNvPresent = 0;\n      let staffPgPresent = 0;\n\n      state.employees.forEach((emp) => {\n        const isPg = isPgStaff(emp);\n        if (isPg) {\n          pgCount++;\n          if (emp.marked) staffPgPresent++;\n        } else {\n          if (emp.marked) staffNvPresent++;\n        }\n        if (emp.marked) presentCount++;\n      });\n\n      const totalEmployees = state.employees.length;\n      const staffNvCount = totalEmployees - pgCount;\n      const absentCount = Math.max(0, totalEmployees - presentCount);\n\n      // Lọc danh sách theo từ khóa tìm kiếm nếu có\n      const kw = (state.empSearchKeyword || '').trim().toLowerCase();\n      const displayList = kw \n        ? state.employees.filter(emp => (emp.name || '').toLowerCase().includes(kw))\n        : state.employees;\n\n      const staffNvList = displayList.filter(emp => !isPgStaff(emp));\n      const staffPgList = displayList.filter(emp => isPgStaff(emp));\n\n      // 1. Render Cột Nhân Viên Siêu Thị (Bên Trái)\n      if (staffNvList.length === 0) {\n        staffContainer.innerHTML = `\n          <div style=\"grid-column: 1 / -1; text-align: center; padding: 24px 14px; color: #78716c; background: #f8fafc; border-radius: 10px; border: 1.5px dashed #cbd5e1;\">\n            <i class=\"fa-solid fa-user-slash\" style=\"font-size: 24px; color: #94a3b8; margin-bottom: 6px;\"></i>\n            <div style=\"font-weight: 700; font-size: 13.5px; color: #475569;\">Không có nhân viên siêu thị nào</div>\n            <div style=\"font-size: 11.5px; margin-top: 2px;\">Bấm \"Thêm NV\" để thêm nhân sự vào cột này</div>\n          </div>\n        `;\n      } else {\n        staffNvList.forEach(emp => {\n          staffContainer.appendChild(createEmployeeCardElement(emp));\n        });\n      }\n\n      // 2. Render Cột PG Hỗ Trợ Hãng (Bên Phải)\n      if (staffPgList.length === 0) {\n        pgContainer.innerHTML = `\n          <div style=\"grid-column: 1 / -1; text-align: center; padding: 24px 14px; color: #78716c; background: #fff5f8; border-radius: 10px; border: 1.5px dashed #fbcfe8;\">\n            <i class=\"fa-solid fa-handshake-slash\" style=\"font-size: 24px; color: #f472b6; margin-bottom: 6px;\"></i>\n            <div style=\"font-weight: 700; font-size: 13.5px; color: #9d174d;\">Không có PG hãng nào</div>\n            <div style=\"font-size: 11.5px; margin-top: 2px;\">Bấm \"Thêm PG\" để thêm PG vào cột này</div>\n          </div>\n        `;\n      } else {\n        staffPgList.forEach(emp => {\n          pgContainer.appendChild(createEmployeeCardElement(emp));\n        });\n      }\n\n      // 3. Cập nhật Badge số lượng từng cột\n      const badgeStaff = document.getElementById('badgeColumnStaffCount');\n      if (badgeStaff) badgeStaff.textContent = `${staffNvCount} NV (${staffNvPresent} có mặt)`;\n\n      const badgePg = document.getElementById('badgeColumnPgCount');\n      if (badgePg) badgePg.textContent = `${pgCount} PG (${staffPgPresent} có mặt)`;\n\n      // 4. Cập nhật các thẻ thống kê tổng\n      const totalEl = document.getElementById('statTotalEmployees');\n      if (totalEl) totalEl.textContent = totalEmployees;\n\n      const presentEl = document.getElementById('statPresentCount');\n      if (presentEl) presentEl.textContent = presentCount;\n\n      const pgEl = document.getElementById('statPgCount');\n      if (pgEl) pgEl.textContent = pgCount;\n\n      const absentEl = document.getElementById('statAbsentCount');\n      if (absentEl) absentEl.textContent = absentCount;\n\n      const badgeEl = document.getElementById('badgeEmpCount');\n      if (badgeEl) badgeEl.textContent = `${totalEmployees} NV/PG`;\n    }\n\n    // CẬP NHẬT 1 TRƯỜNG CA TRỰC\n    window.updateShiftField = function(idx, field, value) {\n      state.shifts[idx][field] = value.trim();\n      localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n      if (typeof syncMapCellsFromShifts === 'function') syncMapCellsFromShifts();\n      broadcastMqtt({ type: 'UPDATE_SHIFT', index: idx, data: state.shifts[idx] });\n      saveToSheetImmediately(`☁️ Đã lưu thay đổi vị trí ${state.shifts[idx].stt} về Google Sheet!`);\n    };\n\n    // TOGGLE ĐIỂM DANH\n    window.toggleEmployeeAttendance = function(idx) {\n      if (!state.employees[idx]) return;\n      state.employees[idx].marked = !state.employees[idx].marked;\n      localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n      renderEmployees();\n      broadcastMqtt({ type: 'TOGGLE_ATTENDANCE', index: idx, marked: state.employees[idx].marked });\n      saveToSheetImmediately(`☁️ Đã lưu điểm danh: ${state.employees[idx].name} về Google Sheet!`);\n    };\n\n    // ==========================================================================\n    // CHỨC NĂNG THÊM / SỬA / XÓA NHÂN VIÊN & PG\n    // ==========================================================================\n\n    // MỞ MODAL THÊM NV/PG (HỖ TRỢ MẶC ĐỊNH VAI TRÒ)\n    window.openAddEmployeeModal = function(defaultRole) {\n      const role = (defaultRole === 'pg') ? 'pg' : 'nv';\n      document.getElementById('empEditIndex').value = \"-1\";\n      document.getElementById('empInputName').value = \"\";\n      document.getElementById('empInputRole').value = role;\n      const radios = document.querySelectorAll('input[name=\"empStatusRadio\"]');\n      radios.forEach(r => r.checked = (r.value === 'present'));\n      document.getElementById('empRenameAllocationsRow').style.display = 'none';\n      \n      const titleEl = document.getElementById('employeeModalTitle');\n      if (role === 'pg') {\n        titleEl.innerHTML = '<i class=\"fa-solid fa-handshake\" style=\"color:#db2777;\"></i> Thêm PG Hãng Mới';\n      } else {\n        titleEl.innerHTML = '<i class=\"fa-solid fa-user-plus\" style=\"color:#0284c7;\"></i> Thêm Nhân Viên Siêu Thị';\n      }\n      \n      document.getElementById('employeeModal').style.display = 'flex';\n      setTimeout(() => document.getElementById('empInputName').focus(), 100);\n    };\n\n    // MỞ MODAL SỬA NV/PG\n    window.openEditEmployeeModal = function(idx) {\n      const emp = state.employees[idx];\n      if (!emp) return;\n      document.getElementById('empEditIndex').value = String(idx);\n      document.getElementById('empInputName').value = emp.name;\n      document.getElementById('empInputRole').value = emp.role || (isPgStaff(emp) ? 'pg' : 'nv');\n      const radios = document.querySelectorAll('input[name=\"empStatusRadio\"]');\n      radios.forEach(r => r.checked = (emp.marked ? r.value === 'present' : r.value === 'absent'));\n      document.getElementById('empRenameAllocationsRow').style.display = 'block';\n      document.getElementById('empSyncAllocationName').checked = true;\n      document.getElementById('employeeModalTitle').innerHTML = `<i class=\"fa-solid fa-user-pen\" style=\"color:#d97706;\"></i> Chỉnh Sửa: ${emp.name}`;\n      document.getElementById('employeeModal').style.display = 'flex';\n      setTimeout(() => document.getElementById('empInputName').focus(), 100);\n    };\n\n    // ĐÓNG MODAL NV/PG\n    function closeEmployeeModal() {\n      document.getElementById('employeeModal').style.display = 'none';\n    }\n    const btnCloseEmpModal = document.getElementById('btnCloseEmployeeModal');\n    if (btnCloseEmpModal) btnCloseEmpModal.onclick = closeEmployeeModal;\n    const btnCancelEmpModal = document.getElementById('btnCancelEmployeeModal');\n    if (btnCancelEmpModal) btnCancelEmpModal.onclick = closeEmployeeModal;\n    const employeeModalEl = document.getElementById('employeeModal');\n    if (employeeModalEl) {\n      employeeModalEl.onclick = (e) => {\n        if (e.target.id === 'employeeModal') closeEmployeeModal();\n      };\n    }\n\n    const btnOpenAddEmp = document.getElementById('btnOpenAddEmployeeModal');\n    if (btnOpenAddEmp) btnOpenAddEmp.onclick = window.openAddEmployeeModal;\n\n    // LƯU MODAL THÊM / SỬA NV/PG\n    const btnSaveEmpModal = document.getElementById('btnSaveEmployeeModal');\n    if (btnSaveEmpModal) {\n      btnSaveEmpModal.onclick = function() {\n        const idx = parseInt(document.getElementById('empEditIndex').value, 10);\n        const newName = document.getElementById('empInputName').value.trim();\n        if (!newName) {\n          alert('Vui lòng nhập Họ và Tên Nhân Viên / PG!');\n          document.getElementById('empInputName').focus();\n          return;\n        }\n\n        const role = document.getElementById('empInputRole').value;\n        let isMarked = true;\n        const checkedRadio = document.querySelector('input[name=\"empStatusRadio\"]:checked');\n        if (checkedRadio && checkedRadio.value === 'absent') isMarked = false;\n\n        if (idx === -1) {\n          // THÊM MỚI\n          const newEmp = {\n            stt: state.employees.length + 1,\n            name: newName,\n            role: role,\n            marked: isMarked\n          };\n          state.employees.push(newEmp);\n          showToast(`✅ Đã thêm NV/PG mới: ${newName}`);\n        } else if (idx >= 0 && state.employees[idx]) {\n          // SỬA THÔNG TIN\n          const oldName = state.employees[idx].name;\n          state.employees[idx].name = newName;\n          state.employees[idx].role = role;\n          state.employees[idx].marked = isMarked;\n\n          // Nếu có tick đổi tên liên quan trên các line ca trực và sơ đồ\n          const syncNameEl = document.getElementById('empSyncAllocationName');\n          if (syncNameEl && syncNameEl.checked && oldName.trim().toUpperCase() !== newName.trim().toUpperCase()) {\n            if (typeof updateAllAssignmentsWithNewName === 'function') {\n              updateAllAssignmentsWithNewName(oldName, newName);\n            }\n          }\n          showToast(`✅ Đã cập nhật: ${newName}`);\n        }\n\n        localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n        renderEmployees();\n        if (typeof initModalDropdowns === 'function') initModalDropdowns();\n        broadcastMqtt({ type: 'SYNC_EMPLOYEES', employees: state.employees });\n        autoSaveEmployeesToSheetDebounced();\n        closeEmployeeModal();\n      };\n    }\n\n    // XOÁ NHÂN VIÊN / PG\n    window.confirmDeleteEmployee = function(idx) {\n      const emp = state.employees[idx];\n      if (!emp) return;\n      state.pendingDeleteEmpIndex = idx;\n      const spanEl = document.getElementById('deleteEmpNameSpan');\n      if (spanEl) spanEl.textContent = `${emp.name} (STT ${emp.stt})`;\n      const delModal = document.getElementById('deleteEmployeeModal');\n      if (delModal) delModal.style.display = 'flex';\n    };\n\n    function closeDeleteModal() {\n      const delModal = document.getElementById('deleteEmployeeModal');\n      if (delModal) delModal.style.display = 'none';\n      state.pendingDeleteEmpIndex = -1;\n    }\n    const btnCloseDel = document.getElementById('btnCloseDeleteModal');\n    if (btnCloseDel) btnCloseDel.onclick = closeDeleteModal;\n    const btnCancelDel = document.getElementById('btnCancelDeleteModal');\n    if (btnCancelDel) btnCancelDel.onclick = closeDeleteModal;\n    const deleteModalEl = document.getElementById('deleteEmployeeModal');\n    if (deleteModalEl) {\n      deleteModalEl.onclick = (e) => {\n        if (e.target.id === 'deleteEmployeeModal') closeDeleteModal();\n      };\n    }\n\n    const btnConfirmDel = document.getElementById('btnConfirmDeleteModal');\n    if (btnConfirmDel) {\n      btnConfirmDel.onclick = function() {\n        const idx = state.pendingDeleteEmpIndex;\n        if (idx >= 0 && idx < state.employees.length) {\n          const deleted = state.employees.splice(idx, 1)[0];\n          // Đánh lại số thứ tự (STT) liên tục từ 1..N\n          state.employees.forEach((emp, i) => {\n            emp.stt = i + 1;\n          });\n          localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n          renderEmployees();\n          if (typeof initModalDropdowns === 'function') initModalDropdowns();\n          broadcastMqtt({ type: 'SYNC_EMPLOYEES', employees: state.employees });\n          autoSaveEmployeesToSheetDebounced();\n          showToast(`🗑️ Đã xóa \"${deleted.name}\" khỏi danh sách`);\n        }\n        closeDeleteModal();\n      };\n    }\n\n    // TÌM KIẾM NHANH TRONG TAB NV/PG\n    const empSearchInput = document.getElementById('employeeSearchInput');\n    if (empSearchInput) {\n      empSearchInput.addEventListener('input', function(e) {\n        state.empSearchKeyword = e.target.value.trim().toLowerCase();\n        renderEmployees();\n      });\n    }\n\n    // ==========================================================================\n    // HỆ THỐNG ĐỒNG BỘ & LƯU TỨC THÌ VỀ GOOGLE SHEET (REALTIME INSTANT SYNC)\n    // ==========================================================================\n    let isSavingToSheet = false;\n    let pendingSaveAgain = false;\n\n    function saveToSheetImmediately(customToastMsg) {\n      const url = DEFAULT_CONFIG.webAppUrl;\n      if (!url) return;\n\n      if (isSavingToSheet) {\n        pendingSaveAgain = true;\n        return;\n      }\n      isSavingToSheet = true;\n      pendingSaveAgain = false;\n\n      // Cập nhật trạng thái hiển thị trên giao diện ngay lập tức\n      setSyncStatus('syncing', '⚡ Đang lưu về Google Sheet...');\n      if (customToastMsg) {\n        showToast(customToastMsg);\n      }\n\n      const timestamp = Date.now();\n\n      // 1. Gửi request saveAll đồng thời cả 15 Ca trực và Danh sách NV/PG\n      const pSaveAll = fetch(url, {\n        method: 'POST',\n        headers: { 'Content-Type': 'text/plain;charset=utf-8' },\n        mode: 'no-cors',\n        body: JSON.stringify({\n          action: 'saveAll',\n          sheetId: DEFAULT_CONFIG.sheetId,\n          shifts: state.shifts,\n          employees: state.employees,\n          _t: timestamp\n        })\n      });\n\n      // 2. Gửi đồng thời updateAllShifts & updateAllEmployees dự phòng\n      const pShifts = fetch(url, {\n        method: 'POST',\n        headers: { 'Content-Type': 'text/plain;charset=utf-8' },\n        mode: 'no-cors',\n        body: JSON.stringify({\n          action: 'updateAllShifts',\n          sheetId: DEFAULT_CONFIG.sheetId,\n          shifts: state.shifts,\n          _t: timestamp\n        })\n      });\n\n      const pEmps = fetch(url, {\n        method: 'POST',\n        headers: { 'Content-Type': 'text/plain;charset=utf-8' },\n        mode: 'no-cors',\n        body: JSON.stringify({\n          action: 'updateAllEmployees',\n          sheetId: DEFAULT_CONFIG.sheetId,\n          employees: state.employees,\n          _t: timestamp\n        })\n      });\n\n      Promise.allSettled([pSaveAll, pShifts, pEmps]).then(() => {\n        isSavingToSheet = false;\n        setSyncStatus('connected', '☁️ Đã lưu về Google Sheet (Vừa xong)');\n        if (pendingSaveAgain) {\n          saveToSheetImmediately();\n        }\n      }).catch(err => {\n        isSavingToSheet = false;\n        console.warn('Lỗi lưu tức thì về Sheet:', err);\n        setSyncStatus('connected', '☁️ Đã gửi lưu về Sheet');\n      });\n    }\n\n    // Các hàm tương thích ngược để gọi tức thì không độ trễ\n    function autoSaveEmployeesToSheetDebounced() {\n      saveToSheetImmediately();\n    }\n    function saveAllEmployeesToSheet() {\n      saveToSheetImmediately();\n    }\n    function autoSaveToSheetDebounced() {\n      saveToSheetImmediately();\n    }\n    function saveAllToSheet() {\n      saveToSheetImmediately();\n    }\n\n    // TÌM KIẾM VÀ HIGHLIGHT TRÊN SƠ ĐỒ MẶT BẰNG\n    document.getElementById('globalSearchInput').addEventListener('input', function(e) {\n      const kw = e.target.value.trim().toLowerCase();\n      state.searchKeyword = kw;\n\n      const cells = document.querySelectorAll('.map-cell');\n      cells.forEach(c => {\n        const text = c.textContent.toLowerCase();\n        const staff = (c.getAttribute('data-staff') || '').toLowerCase();\n        if (kw && (text.includes(kw) || staff.includes(kw))) {\n          c.classList.add('highlight-target');\n        } else {\n          c.classList.remove('highlight-target');\n        }\n      });\n    });\n\n    // ==========================================================================\n    // QUẢN LÝ PHÂN BỔ KHU VỰC VỆ SINH & THAY ĐỔI NHÂN VIÊN TRỰC TIẾP TRÊN SƠ ĐỒ\n    // ==========================================================================\n    state.selectedCellEl = null;\n    state.isAllocatingDirectly = false;\n    state.allocatingStaff = '';\n\n    // Khởi tạo các ô trên sơ đồ với ID duy nhất & nạp trạng thái đã lưu\n    function initMapCells() {\n      const cells = document.querySelectorAll('.map-cell');\n      const savedAllocations = JSON.parse(localStorage.getItem('st1841_map_allocations') || '{}');\n\n      cells.forEach((cell, idx) => {\n        const cellId = 'cell_' + idx;\n        cell.setAttribute('data-cell-id', cellId);\n\n        const titleEl = cell.querySelector('.cell-title');\n        const staffEl = cell.querySelector('.cell-staff');\n        const cellTitle = titleEl ? titleEl.textContent.trim() : (cell.textContent.trim() || 'Khu vực');\n\n        // Gợi ý thao tác khi di chuột\n        cell.title = `Nhấp đúp (hoặc bấm) để sửa phân bổ: ${cellTitle}`;\n\n        // Nếu đã có cấu hình lưu trước đó\n        if (savedAllocations[cellId]) {\n          const staffName = savedAllocations[cellId].staff || '';\n          cell.setAttribute('data-staff', staffName);\n          if (staffEl) {\n            staffEl.textContent = staffName;\n          }\n        }\n\n        // Gán sự kiện hỗ trợ cả nhấp đơn và nhấp đúp trên mọi trình duyệt/thiết bị\n        const onCellTrigger = (e) => {\n          if (e) {\n            e.stopPropagation();\n            if (e.type === 'dblclick') {\n              e.preventDefault();\n            }\n          }\n          handleMapCellClick(cell);\n        };\n\n        // Gỡ bỏ handler cũ nếu có để tránh trùng lặp\n        if (cell._onTriggerHandler) {\n          cell.removeEventListener('click', cell._onTriggerHandler);\n          cell.removeEventListener('dblclick', cell._onTriggerHandler);\n        }\n        cell._onTriggerHandler = onCellTrigger;\n\n        cell.addEventListener('click', onCellTrigger);\n        cell.addEventListener('dblclick', onCellTrigger);\n      });\n    }\n\n    // Xử lý khi click / double-click vào ô trên sơ đồ\n    function handleMapCellClick(cell) {\n      const cellTitle = cell.querySelector('.cell-title') ? cell.querySelector('.cell-title').textContent.trim() : cell.textContent.trim();\n      const currentStaff = cell.getAttribute('data-staff') || (cell.querySelector('.cell-staff') ? cell.querySelector('.cell-staff').textContent.trim() : '');\n\n      // 1. Nếu đang ở CHẾ ĐỘ PHÂN BỔ TRỰC TIẾP\n      if (state.isAllocatingDirectly && state.allocatingStaff) {\n        const staffEl = cell.querySelector('.cell-staff');\n        \n        // Nếu ô đang thuộc nhân viên này -> Click lại sẽ bỏ gán\n        if (currentStaff.toUpperCase() === state.allocatingStaff.toUpperCase()) {\n          cell.setAttribute('data-staff', '');\n          if (staffEl) staffEl.textContent = '';\n          cell.classList.remove('in-allocation-target');\n          updateShiftForCell(cell, '');\n          showToast('⚪ Đã hủy gán khu vực: ' + cellTitle);\n        } else {\n          // Gán khu vực cho nhân viên này\n          cell.setAttribute('data-staff', state.allocatingStaff);\n          if (staffEl) {\n            staffEl.textContent = state.allocatingStaff;\n          } else {\n            const newStaffSpan = document.createElement('span');\n            newStaffSpan.className = 'cell-staff';\n            newStaffSpan.textContent = state.allocatingStaff;\n            cell.appendChild(newStaffSpan);\n          }\n          cell.classList.add('in-allocation-target');\n          updateShiftForCell(cell, state.allocatingStaff);\n          showToast('🎯 Đã gán [' + cellTitle + '] cho ' + state.allocatingStaff);\n        }\n\n        saveMapAllocations();\n        updateAllocatingCount();\n        broadcastMqtt({\n          type: 'UPDATE_MAP_CELL',\n          cellId: cell.getAttribute('data-cell-id'),\n          staff: cell.getAttribute('data-staff')\n        });\n        saveToSheetImmediately();\n        return;\n      }\n\n      // 2. Nếu ở chế độ bình thường -> Mở Modal Phân Bổ & Thay Đổi Tên Nhân Viên\n      openStaffAllocationModal(cell, cellTitle, currentStaff);\n    }\n\n    // Mở modal phân bổ & thay đổi nhân viên\n    function openStaffAllocationModal(cell, areaTitle, currentStaff) {\n      state.modalOpenTime = Date.now();\n      state.selectedCellEl = cell;\n      const modal = document.getElementById('staffAllocationModal');\n      if (!modal) return;\n      \n      const titleEl = document.getElementById('modalTargetAreaTitle');\n      if (titleEl) titleEl.textContent = areaTitle;\n\n      const currentStaffEl = document.getElementById('modalCurrentStaffName');\n      if (currentStaffEl) currentStaffEl.textContent = currentStaff || 'Chưa gán';\n\n      const btnTargetEl = document.getElementById('modalBtnStaffTargetName');\n      if (btnTargetEl) btnTargetEl.textContent = currentStaff || 'khu vực này';\n\n      const btnDirectEl = document.getElementById('modalBtnDirectStaffName');\n      if (btnDirectEl) btnDirectEl.textContent = currentStaff || 'nhân viên';\n\n      // Đếm số lượng khu vực nhân viên này đang phụ trách\n      const count = getStaffAreaCount(currentStaff);\n      const countBadge = document.getElementById('modalCurrentStaffCountBadge');\n      if (countBadge) countBadge.textContent = 'Đang có ' + count + ' khu vực';\n\n      // Đổ danh sách 26 nhân viên vào dropdown\n      const dropdown = document.getElementById('modalStaffDropdown');\n      if (dropdown) {\n        dropdown.innerHTML = '<option value=\"\">-- Chọn từ ' + (state.employees ? state.employees.length : 26) + ' nhân viên siêu thị --</option>';\n        (state.employees || []).forEach(emp => {\n          const opt = document.createElement('option');\n          opt.value = emp.name;\n          opt.textContent = emp.stt + '. ' + emp.name + (emp.role === 'pg' ? ' [PG]' : '');\n          dropdown.appendChild(opt);\n        });\n\n        const customInp = document.getElementById('modalStaffCustomInput');\n        if (customInp) customInp.value = '';\n        dropdown.onchange = function() {\n          if (this.value && customInp) customInp.value = this.value;\n        };\n      }\n\n      modal.style.display = 'flex';\n    }\n\n    // Đếm số khu vực 1 nhân viên đang phụ trách\n    function getStaffAreaCount(staffName) {\n      if (!staffName || !staffName.trim()) return 0;\n      let count = 0;\n      document.querySelectorAll('.map-cell').forEach(c => {\n        const st = c.getAttribute('data-staff') || '';\n        if (st.trim().toUpperCase() === staffName.trim().toUpperCase()) {\n          count++;\n        }\n      });\n      return count;\n    }\n\n    // ÁNH XẠ Ô TRÊN SƠ ĐỒ VỀ ĐÚNG 1 TRONG 15 CA TRỰC ĐỂ LƯU VỀ GOOGLE SHEET\n    function getShiftIndexForCell(cell) {\n      if (!cell) return -1;\n      const titleEl = cell.querySelector('.cell-title');\n      const title = (titleEl ? titleEl.textContent : cell.textContent).trim().toUpperCase();\n      const isIctSubgrid = cell.closest('.ict-subgrid') !== null;\n\n      if (isIctSubgrid || title.includes('VÁCH PK') || title.includes('LAPTOP') || \n          title.includes('SMARTPHONE') || title.includes('MOTOROLA') || title.includes('REALME') ||\n          title.includes('VIVO') || title.includes('XIAOMI') || title.includes('PK BASEUS') ||\n          title.includes('PK ANKER') || title.includes('CAMERA') || title.includes('BTN XIAOMI') ||\n          title.includes('BTN MOTO') || title.includes('OPPO') || title.includes('ĐỒNG HỒ') ||\n          title.includes('BTN OPPO') || title.includes('BTN VIVO') || title.includes('BTN REALME') ||\n          title.includes('BTN SAMSUNG') || title.includes('BTN HONOR') || title.includes('BTN APPLE') ||\n          title.includes('APPLE') || title.includes('VÁCH PHỤ KIỆN') || title.includes('BTV ')) {\n        return 0; // Ca 1 (STT 1)\n      } else if (title.includes('TIVI 1') || title.includes('TIVI 2') || title.includes('TIVI 3') || \n                 title.includes('VÁCH HÃNG SONY') || title.includes('VÁCH HÃNG SAMSUNG') || (title.includes('BỤC HÃNG SAMSUNG') && !title.includes('TỦ LẠNH'))) {\n        return 1; // Ca 2 (STT 2)\n      } else if (title.includes('TIVI 4') || title.includes('TIVI 5') || title.includes('LOA') || \n                 title.includes('VÁCH HÃNG LG') || title.includes('VÁCH LOA') || title.includes('KỆ LOA') || (title.includes('BỤC HÃNG LG') && !title.includes('TỦ LẠNH'))) {\n        return 2; // Ca 3 (STT 3)\n      } else if (title.includes('MÁY GIẶT 1') || title.includes('MÁY GIẶT 2') || title.includes('MÁY GIẶT 3') || \n                 title.includes('MÁY GIẶT 1 - 2 -3') || title.includes('MÁY GIẶT ELECTROLUX') || title.includes('MÁY GIẶT HISENSE') || title.includes('BỤC HÃNG HESENSI')) {\n        return 3; // Ca 4 (STT 4)\n      } else if (title.includes('MÁY GIẶT 4') || title.includes('MÁY GIẶT 5') || title.includes('MÁY GIẶT 6') || \n                 title.includes('MÁY GIẶT 4 - 5 - 6') || title.includes('MÁY GIẶT SAMSUNG') || title.includes('MÁY GIẶT PANASONIC') || \n                 title.includes('MÁY GIẶT AQUA') || title.includes('MÁY GIẶT HAIER') || title.includes('MÁY GIẶT TOSHIBA') || \n                 title.includes('BỤC MÁY GIẶT') || title.includes('BỤC HÃNG TOSHIBA') || title.includes('BỤC HÃNG TCL')) {\n        return 4; // Ca 5 (STT 5)\n      } else if (title.includes('VÁCH MÁY LẠNH') || title.includes('DÀN MƯỚP') || title.includes('TỦ ĐÔNG')) {\n        return 5; // Ca 6 (STT 6)\n      } else if (title.includes('BẾP') || title.includes('LÒ VI SÓNG') || title.includes('CHẢO') || \n                 title.includes('VÁCH NỒI') || title.includes('NỒI CHIÊN') || title.includes('JUNGER') || title.includes('HAFALE')) {\n        return 6; // Ca 7 (STT 7)\n      } else if (title.includes('LỌC NƯỚC') || title.includes('MLN MUTOSI') || title.includes('MLN HOÀ PHÁT') || \n                 title.includes('MLN KAROFI') || title.includes('GIA DỤNG 1') || title.includes('GIA DỤNG 01')) {\n        return 7; // Ca 8 (STT 8)\n      } else if (title.includes('GIA DỤNG 2') || title.includes('GIA DỤNG 02') || title.includes('GIA DỤNG 3') || title.includes('GIA DỤNG 03')) {\n        return 8; // Ca 9 (STT 9)\n      } else if (title.includes('GIA DỤNG 4') || title.includes('GIA DỤNG 04') || title.includes('GIA DỤNG 5') || title.includes('GIA DỤNG 05') || \n                 title.includes('GIA DỤNG KANGAROO') || (title.includes('GIA DỤNG TOSHIBA') && !title.includes('MLN'))) {\n        return 9; // Ca 10 (STT 10)\n      } else if (title.includes('GIA DỤNG 6') || title.includes('GIA DỤNG 06') || title.includes('GIA DỤNG 7') || title.includes('GIA DỤNG 07') || \n                 title.includes('KỆ GIA DỤNG') || title.includes('GIA DỤNG SUNHOUSE') || title.includes('ROBOT') || title.includes('MLN SUNHOUSE')) {\n        return 10; // Ca 11 (STT 11)\n      } else if (title.includes('TỦ LẠNH 1') || title.includes('TỦ LẠNH 2') || title.includes('TỦ LẠNH HITACHI') || \n                 title.includes('TỦ LẠNH AQUA') || title.includes('TỦ LẠNH LG') || title.includes('TỦ LẠNH SHARP') || \n                 (title.includes('TỦ LẠNH TOSHIBA') && !title.includes('VÁCH')) || title.includes('BỤC HÃNG HAIER') || \n                 title.includes('BỤC HÃNG AQUA') || title.includes('BỤC HÃNG XIAOMI')) {\n        return 11; // Ca 12 (STT 12)\n      } else if (title.includes('TỦ LẠNH 3') || title.includes('TỦ LẠNH 4') || title.includes('TỦ LẠNH SAMSUNG') || \n                 title.includes('TỦ LẠNH PANASONIC') || title.includes('TỦ LẠNH HAIER') || title.includes('BỤC TỦ LẠNH')) {\n        return 12; // Ca 13 (STT 13)\n      } else if (title.includes('VÁCH TỦ LẠNH') || title.includes('VÁCH TL')) {\n        return 13; // Ca 14 (STT 14)\n      } else if (title.includes('VÁCH KÍNH') || title.includes('CỬA') || title.includes('TIẾP ĐÓN') || \n                 title.includes('GIAO HÀNG') || title.includes('HTKT') || title.includes('THU NGÂN')) {\n        return 14; // Ca 15 (STT 15)\n      }\n      return -1;\n    }\n\n    function updateShiftForCell(cell, staffName) {\n      const shiftIdx = getShiftIndexForCell(cell);\n      if (shiftIdx >= 0 && state.shifts[shiftIdx]) {\n        state.shifts[shiftIdx].nv = staffName;\n        localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n        renderShifts();\n      }\n    }\n\n    // Lưu toàn bộ cấu hình sơ đồ vào localStorage\n    function saveMapAllocations() {\n      const allocations = {};\n      document.querySelectorAll('.map-cell').forEach(c => {\n        const cellId = c.getAttribute('data-cell-id');\n        const staff = c.getAttribute('data-staff') || '';\n        if (cellId) {\n          allocations[cellId] = { staff: staff };\n        }\n      });\n      localStorage.setItem('st1841_map_allocations', JSON.stringify(allocations));\n    }\n\n    // ĐỒNG BỘ TỰ ĐỘNG TÊN NHÂN SỰ TỪ 15 CA TRỰC LÊN CÁC Ô SƠ ĐỒ MẶT BẰNG\n    function syncMapCellsFromShifts() {\n      if (!Array.isArray(state.shifts) || state.shifts.length === 0) return;\n\n      const sMap = {};\n      state.shifts.forEach((s, idx) => {\n        sMap[idx + 1] = s;\n      });\n\n      const cells = document.querySelectorAll('.map-cell');\n      cells.forEach(cell => {\n        const titleEl = cell.querySelector('.cell-title');\n        if (!titleEl) return;\n        const title = titleEl.textContent.trim().toUpperCase();\n        const isIctSubgrid = cell.closest('.ict-subgrid') !== null;\n\n        let assignedStaff = '';\n\n        if (isIctSubgrid || title.includes('VÁCH PK') || title.includes('LAPTOP') || \n            title.includes('SMARTPHONE') || title.includes('MOTOROLA') || title.includes('REALME') ||\n            title.includes('VIVO') || title.includes('XIAOMI') || title.includes('PK BASEUS') ||\n            title.includes('PK ANKER') || title.includes('CAMERA') || title.includes('BTN XIAOMI') ||\n            title.includes('BTN MOTO') || title.includes('OPPO') || title.includes('ĐỒNG HỒ') ||\n            title.includes('BTN OPPO') || title.includes('BTN VIVO') || title.includes('BTN REALME') ||\n            title.includes('BTN SAMSUNG') || title.includes('BTN HONOR') || title.includes('BTN APPLE') ||\n            title.includes('APPLE') || title.includes('VÁCH PHỤ KIỆN') || title.includes('BTV ')) {\n          assignedStaff = sMap[1] ? sMap[1].nv : '';\n        } else if (title.includes('TIVI 1') || title.includes('TIVI 2') || title.includes('TIVI 3') || \n                   title.includes('VÁCH HÃNG SONY') || title.includes('VÁCH HÃNG SAMSUNG') || (title.includes('BỤC HÃNG SAMSUNG') && !title.includes('TỦ LẠNH'))) {\n          assignedStaff = sMap[2] ? sMap[2].nv : '';\n        } else if (title.includes('TIVI 4') || title.includes('TIVI 5') || title.includes('LOA') || \n                   title.includes('VÁCH HÃNG LG') || title.includes('VÁCH LOA') || title.includes('KỆ LOA') || (title.includes('BỤC HÃNG LG') && !title.includes('TỦ LẠNH'))) {\n          assignedStaff = sMap[3] ? sMap[3].nv : '';\n        } else if (title.includes('MÁY GIẶT 1') || title.includes('MÁY GIẶT 2') || title.includes('MÁY GIẶT 3') || \n                   title.includes('MÁY GIẶT 1 - 2 -3') || title.includes('MÁY GIẶT ELECTROLUX') || title.includes('MÁY GIẶT HISENSE') || title.includes('BỤC HÃNG HESENSI')) {\n          assignedStaff = sMap[4] ? sMap[4].nv : '';\n        } else if (title.includes('MÁY GIẶT 4') || title.includes('MÁY GIẶT 5') || title.includes('MÁY GIẶT 6') || \n                   title.includes('MÁY GIẶT 4 - 5 - 6') || title.includes('MÁY GIẶT SAMSUNG') || title.includes('MÁY GIẶT PANASONIC') || \n                   title.includes('MÁY GIẶT AQUA') || title.includes('MÁY GIẶT HAIER') || title.includes('MÁY GIẶT TOSHIBA') || \n                   title.includes('BỤC MÁY GIẶT') || title.includes('BỤC HÃNG TOSHIBA') || title.includes('BỤC HÃNG TCL')) {\n          assignedStaff = sMap[5] ? sMap[5].nv : '';\n        } else if (title.includes('VÁCH MÁY LẠNH') || title.includes('DÀN MƯỚP') || title.includes('TỦ ĐÔNG')) {\n          assignedStaff = sMap[6] ? sMap[6].nv : '';\n        } else if (title.includes('BẾP') || title.includes('LÒ VI SÓNG') || title.includes('CHẢO') || \n                   title.includes('VÁCH NỒI') || title.includes('NỒI CHIÊN') || title.includes('JUNGER') || title.includes('HAFALE')) {\n          assignedStaff = sMap[7] ? sMap[7].nv : '';\n        } else if (title.includes('LỌC NƯỚC') || title.includes('MLN MUTOSI') || title.includes('MLN HOÀ PHÁT') || \n                   title.includes('MLN KAROFI') || title.includes('GIA DỤNG 1') || title.includes('GIA DỤNG 01')) {\n          assignedStaff = sMap[8] ? sMap[8].nv : '';\n        } else if (title.includes('GIA DỤNG 2') || title.includes('GIA DỤNG 02') || title.includes('GIA DỤNG 3') || title.includes('GIA DỤNG 03')) {\n          assignedStaff = sMap[9] ? sMap[9].nv : '';\n        } else if (title.includes('GIA DỤNG 4') || title.includes('GIA DỤNG 04') || title.includes('GIA DỤNG 5') || title.includes('GIA DỤNG 05') || \n                   title.includes('GIA DỤNG KANGAROO') || (title.includes('GIA DỤNG TOSHIBA') && !title.includes('MLN'))) {\n          assignedStaff = sMap[10] ? sMap[10].nv : '';\n        } else if (title.includes('GIA DỤNG 6') || title.includes('GIA DỤNG 06') || title.includes('GIA DỤNG 7') || title.includes('GIA DỤNG 07') || \n                   title.includes('KỆ GIA DỤNG') || title.includes('GIA DỤNG SUNHOUSE') || title.includes('ROBOT') || title.includes('MLN SUNHOUSE')) {\n          assignedStaff = sMap[11] ? sMap[11].nv : '';\n        } else if (title.includes('TỦ LẠNH 1') || title.includes('TỦ LẠNH 2') || title.includes('TỦ LẠNH HITACHI') || \n                   title.includes('TỦ LẠNH AQUA') || title.includes('TỦ LẠNH LG') || title.includes('TỦ LẠNH SHARP') || \n                   (title.includes('TỦ LẠNH TOSHIBA') && !title.includes('VÁCH')) || title.includes('BỤC HÃNG HAIER') || \n                   title.includes('BỤC HÃNG AQUA') || title.includes('BỤC HÃNG XIAOMI')) {\n          assignedStaff = sMap[12] ? sMap[12].nv : '';\n        } else if (title.includes('TỦ LẠNH 3') || title.includes('TỦ LẠNH 4') || title.includes('TỦ LẠNH SAMSUNG') || \n                   title.includes('TỦ LẠNH PANASONIC') || title.includes('TỦ LẠNH HAIER') || title.includes('BỤC TỦ LẠNH')) {\n          assignedStaff = sMap[13] ? sMap[13].nv : '';\n        } else if (title.includes('VÁCH TỦ LẠNH') || title.includes('VÁCH TL')) {\n          assignedStaff = sMap[14] ? sMap[14].nv : '';\n        } else if (title.includes('VÁCH KÍNH') || title.includes('CỬA') || title.includes('TIẾP ĐÓN') || \n                   title.includes('GIAO HÀNG') || title.includes('HTKT') || title.includes('THU NGÂN')) {\n          assignedStaff = sMap[15] ? sMap[15].nv : '';\n        }\n\n        if (assignedStaff) {\n          cell.setAttribute('data-staff', assignedStaff);\n          let staffEl = cell.querySelector('.cell-staff');\n          if (!staffEl) {\n            staffEl = document.createElement('span');\n            staffEl.className = 'cell-staff';\n            cell.appendChild(staffEl);\n          }\n          staffEl.textContent = assignedStaff;\n        }\n      });\n\n      saveMapAllocations();\n      initMapCells();\n    }\n\n    // Đổi tên nhân viên trên TẤT CẢ các khu vực\n    document.getElementById('btnApplyToAllStaffAreas').addEventListener('click', () => {\n      const oldStaff = (document.getElementById('modalCurrentStaffName').textContent || '').trim();\n      const dropdownVal = document.getElementById('modalStaffDropdown').value.trim();\n      const customVal = document.getElementById('modalStaffCustomInput').value.trim();\n      const newStaff = customVal || dropdownVal;\n\n      if (!newStaff) {\n        showToast('⚠️ Vui lòng chọn hoặc nhập tên nhân viên mới!');\n        return;\n      }\n\n      if (!oldStaff || oldStaff === 'Chưa gán') {\n        // Nếu trước đó chưa gán thì chỉ gán cho ô hiện tại\n        if (state.selectedCellEl) {\n          state.selectedCellEl.setAttribute('data-staff', newStaff);\n          const staffEl = state.selectedCellEl.querySelector('.cell-staff');\n          if (staffEl) staffEl.textContent = newStaff;\n          updateShiftForCell(state.selectedCellEl, newStaff);\n          saveMapAllocations();\n        }\n      } else {\n        // Thay đổi TẤT CẢ các ô có tên nhân viên này\n        let updatedCount = 0;\n        document.querySelectorAll('.map-cell').forEach(c => {\n          const st = (c.getAttribute('data-staff') || '').trim();\n          if (st.toUpperCase() === oldStaff.toUpperCase()) {\n            c.setAttribute('data-staff', newStaff);\n            const staffEl = c.querySelector('.cell-staff');\n            if (staffEl) staffEl.textContent = newStaff;\n            updateShiftForCell(c, newStaff);\n            updatedCount++;\n          }\n        });\n\n        // Đồng bộ cập nhật cả bảng phân ca 15 vị trí nếu có tên cũ\n        state.shifts.forEach((s, idx) => {\n          if (s.nv && s.nv.trim().toUpperCase().includes(oldStaff.toUpperCase())) {\n            s.nv = s.nv.replace(new RegExp(oldStaff, 'gi'), newStaff);\n          }\n        });\n        localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n        renderShifts();\n\n        saveMapAllocations();\n        broadcastMqtt({\n          type: 'BATCH_RENAME_STAFF',\n          oldStaff: oldStaff,\n          newStaff: newStaff\n        });\n\n        showToast('🔄 Đã đổi TẤT CẢ ' + updatedCount + ' khu vực của [' + oldStaff + '] thành [' + newStaff + ']!');\n      }\n\n      document.getElementById('staffAllocationModal').style.display = 'none';\n      saveToSheetImmediately('☁️ Đã lưu cập nhật tất cả khu vực về Google Sheet!');\n    });\n\n    // Chỉ đổi riêng khu vực đang chọn\n    document.getElementById('btnApplyToSingleArea').addEventListener('click', () => {\n      const dropdownVal = document.getElementById('modalStaffDropdown').value.trim();\n      const customVal = document.getElementById('modalStaffCustomInput').value.trim();\n      const newStaff = customVal || dropdownVal;\n\n      if (!newStaff) {\n        showToast('⚠️ Vui lòng chọn hoặc nhập tên nhân viên mới!');\n        return;\n      }\n\n      if (state.selectedCellEl) {\n        state.selectedCellEl.setAttribute('data-staff', newStaff);\n        const staffEl = state.selectedCellEl.querySelector('.cell-staff');\n        if (staffEl) {\n          staffEl.textContent = newStaff;\n        } else {\n          const s = document.createElement('span');\n          s.className = 'cell-staff';\n          s.textContent = newStaff;\n          state.selectedCellEl.appendChild(s);\n        }\n        updateShiftForCell(state.selectedCellEl, newStaff);\n        saveMapAllocations();\n        broadcastMqtt({\n          type: 'UPDATE_MAP_CELL',\n          cellId: state.selectedCellEl.getAttribute('data-cell-id'),\n          staff: newStaff\n        });\n        showToast('✓ Đã cập nhật khu vực cho: ' + newStaff);\n      }\n\n      document.getElementById('staffAllocationModal').style.display = 'none';\n      saveToSheetImmediately('☁️ Đã lưu phân bổ khu vực về Google Sheet!');\n    });\n\n    // Bắt đầu Chế Độ Phân Bổ Trực Tiếp Trên Sơ Đồ\n    document.getElementById('btnStartDirectAllocation').addEventListener('click', () => {\n      const staffName = (document.getElementById('modalCurrentStaffName').textContent || '').trim();\n      if (!staffName || staffName === 'Chưa gán') {\n        showToast('⚠️ Vui lòng chọn một nhân viên cụ thể để bắt đầu phân bổ!');\n        return;\n      }\n      document.getElementById('staffAllocationModal').style.display = 'none';\n      enterDirectAllocationMode(staffName);\n    });\n\n    // Nút Phân Bổ Nhanh trên thanh công cụ sơ đồ\n    document.getElementById('btnQuickAllocationMode').addEventListener('click', () => {\n      const name = prompt('Nhập tên nhân viên cần click phân bổ trên sơ đồ (VD: TRANG, PHÚC, ÁI, MẠNH...):');\n      if (name && name.trim()) {\n        enterDirectAllocationMode(name.trim().toUpperCase());\n      }\n    });\n\n    function enterDirectAllocationMode(staffName) {\n      state.isAllocatingDirectly = true;\n      state.allocatingStaff = staffName;\n\n      document.getElementById('allocatingStaffNameBadge').textContent = staffName;\n      document.getElementById('allocationActiveBanner').style.display = 'flex';\n      document.getElementById('storeLayoutGridEl').classList.add('allocation-mode-active');\n\n      // Highlight tất cả các ô của nhân viên này\n      document.querySelectorAll('.map-cell').forEach(c => {\n        const st = (c.getAttribute('data-staff') || '').trim();\n        if (st.toUpperCase() === staffName.toUpperCase()) {\n          c.classList.add('in-allocation-target');\n        } else {\n          c.classList.remove('in-allocation-target');\n        }\n      });\n\n      updateAllocatingCount();\n      showToast('🎯 Bắt đầu phân bổ cho [' + staffName + ']: Click vào các ô trên sơ đồ để Gán hoặc Bỏ Gán!');\n\n      // Cuộn tới sơ đồ\n      document.getElementById('floorPlanExportTarget').scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n\n    function exitDirectAllocationMode() {\n      state.isAllocatingDirectly = false;\n      state.allocatingStaff = '';\n\n      document.getElementById('allocationActiveBanner').style.display = 'none';\n      document.getElementById('storeLayoutGridEl').classList.remove('allocation-mode-active');\n\n      document.querySelectorAll('.map-cell').forEach(c => {\n        c.classList.remove('in-allocation-target');\n      });\n\n      saveMapAllocations();\n      saveToSheetImmediately('✅ Đã lưu phân bổ khu vực về Google Sheet!');\n    }\n\n    function updateAllocatingCount() {\n      if (!state.allocatingStaff) return;\n      const count = getStaffAreaCount(state.allocatingStaff);\n      document.getElementById('allocatingAreaCountBadge').textContent = count + ' khu vực';\n    }\n\n    document.getElementById('btnFinishAllocation').onclick = exitDirectAllocationMode;\n    document.getElementById('btnCancelAllocation').onclick = exitDirectAllocationMode;\n    document.getElementById('btnCloseStaffModal').onclick = () => {\n      document.getElementById('staffAllocationModal').style.display = 'none';\n    };\n    document.getElementById('staffAllocationModal').onclick = (e) => {\n      if (e.target.id === 'staffAllocationModal') {\n        // Ngăn chặn click thứ 2 của thao tác nhấp đúp vô tình rơi vào nền overlay và đóng modal ngay lập tức\n        if (Date.now() - (state.modalOpenTime || 0) < 400) {\n          return;\n        }\n        document.getElementById('staffAllocationModal').style.display = 'none';\n      }\n    };\n\n    // TABS SWITCHING\n    document.querySelectorAll('.nav-tab-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));\n        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n        btn.classList.add('active');\n        const tabId = btn.getAttribute('data-tab');\n        document.getElementById(tabId).classList.add('active');\n        state.activeTab = tabId;\n      });\n    });\n\n    // REALTIME MQTT CLIENT\n    let mqttClient = null;\n    function initRealtime() {\n      try {\n        if (typeof mqtt !== 'undefined') {\n          mqttClient = mqtt.connect(DEFAULT_CONFIG.mqttBroker, {\n            clientId: 'client_1841_' + Math.random().toString(16).substring(2, 8),\n            clean: true,\n            connectTimeout: 4000\n          });\n\n          mqttClient.on('connect', () => {\n            console.log('MQTT Realtime Connected');\n            mqttClient.subscribe(DEFAULT_CONFIG.mqttTopic);\n            document.getElementById('realtimeStatusText').textContent = 'Realtime Live (Đã kết nối)';\n          });\n\n          mqttClient.on('message', (topic, payload) => {\n            try {\n              const msg = JSON.parse(payload.toString());\n              handleRealtimeMessage(msg);\n            } catch (err) {}\n          });\n        }\n      } catch (e) {}\n    }\n\n    function broadcastMqtt(msg) {\n      if (mqttClient && mqttClient.connected) {\n        mqttClient.publish(DEFAULT_CONFIG.mqttTopic, JSON.stringify(msg));\n      }\n    }\n\n    function handleRealtimeMessage(msg) {\n      if (msg.type === 'UPDATE_SHIFT' && state.shifts[msg.index]) {\n        state.shifts[msg.index] = msg.data;\n        renderShifts();\n      } else if (msg.type === 'TOGGLE_ATTENDANCE' && state.employees[msg.index]) {\n        state.employees[msg.index].marked = msg.marked;\n        renderEmployees();\n      } else if (msg.type === 'SYNC_EMPLOYEES' && Array.isArray(msg.employees)) {\n        state.employees = msg.employees;\n        localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n        renderEmployees();\n        if (typeof initModalDropdowns === 'function') initModalDropdowns();\n        showToast('👥 Danh sách NV/PG vừa được cập nhật từ thiết bị khác');\n      } else if (msg.type === 'BATCH_RENAME_STAFF') {\n        document.querySelectorAll('.map-cell').forEach(c => {\n          const st = (c.getAttribute('data-staff') || '').trim();\n          if (st.toUpperCase() === msg.oldStaff.toUpperCase()) {\n            c.setAttribute('data-staff', msg.newStaff);\n            const staffEl = c.querySelector('.cell-staff');\n            if (staffEl) staffEl.textContent = msg.newStaff;\n          }\n        });\n        saveMapAllocations();\n      } else if (msg.type === 'UPDATE_MAP_CELL') {\n        const c = document.querySelector('[data-cell-id=\"' + msg.cellId + '\"]');\n        if (c) {\n          c.setAttribute('data-staff', msg.staff);\n          const staffEl = c.querySelector('.cell-staff');\n          if (staffEl) staffEl.textContent = msg.staff;\n          saveMapAllocations();\n        }\n      }\n    }\n\n    // Lưu 15 ca trực tức thì về Google Sheet (không chờ độ trễ)\n    function autoSaveToSheetDebounced() {\n      saveToSheetImmediately();\n    }\n    function saveAllToSheet() {\n      saveToSheetImmediately();\n    }\n\n    let currentExportBlob = null;\n    let currentExportDataUrl = \"\";\n\n\n    // HÀM XỬ LÝ VÀ HIỂN THỊ DỮ LIỆU ĐỌC ĐƯỢC TỪ SHEET\n    function applyReceivedSheetData(data, sourceName = 'Google Apps Script', silent = false) {\n      let hasUpdated = false;\n\n      // 1. Cập nhật 15 ca trực nếu có\n      if (Array.isArray(data.shifts) && data.shifts.length > 0) {\n        let validShifts = data.shifts.filter(s => {\n          const nv = (s.nv || '').trim().toUpperCase();\n          const kv = (s.kv || '').trim().toUpperCase();\n          return nv !== 'NHÂN VIÊN TRỰC' && kv !== 'KHU VỰC PHỤ TRÁCH';\n        });\n\n        validShifts = validShifts.map((s, idx) => ({\n          stt: idx + 1,\n          row: s.rowInSheet || s.row || (17 + idx),\n          nv: (s.nv || '').trim(),\n          kv: (s.kv || '').trim(),\n          pg: (s.pg || '').trim()\n        }));\n\n        if (validShifts.length < 15) {\n          for (let i = validShifts.length; i < 15; i++) {\n            validShifts.push(DEFAULT_SHIFTS[i]);\n          }\n        }\n\n        state.shifts = validShifts;\n        localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n        renderShifts();\n        syncMapCellsFromShifts();\n        hasUpdated = true;\n      }\n\n      // 2. Cập nhật danh sách NV/PG nếu có\n      if (Array.isArray(data.employees) && data.employees.length > 0) {\n        const validEmps = data.employees.filter(e => {\n          const name = (e.name || '').trim().toUpperCase();\n          return name !== 'HỌ VÀ TÊN' && name !== 'NHÂN SỰ';\n        }).map((emp, idx) => ({\n          stt: emp.stt || (idx + 1),\n          name: (emp.name || '').trim(),\n          role: emp.role || (/pg|tcl|lg|oppo|vivo|realme|xiaomi|aqua|toshiba|sunhouse|bluestone|karofi|mutosi/i.test(emp.name) ? 'pg' : 'nv'),\n          marked: (emp.marked === true || emp.marked === 'X' || emp.marked === '1')\n        }));\n\n        state.employees = validEmps;\n        localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n        renderEmployees();\n        if (typeof initModalDropdowns === 'function') initModalDropdowns();\n        hasUpdated = true;\n      }\n\n      // 3. Cập nhật trạng thái hiển thị\n      const statusPill = document.getElementById('realtimeStatusPill');\n      const statusText = document.getElementById('realtimeStatusText');\n      const now = new Date();\n      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;\n      if (statusPill && statusText) {\n        statusPill.className = 'live-status-pill connected';\n        statusText.textContent = `🟢 Realtime Live (${timeStr})`;\n      }\n\n      if (hasUpdated && !silent) {\n        showToast(`☁️ Đã đồng bộ dữ liệu mới nhất từ Google Trang Tính! (${sourceName})`);\n      }\n    }\n\n    // ĐỌC DỮ LIỆU QUA GOOGLE VISUALIZATION API (FALLBACK TRỰC TIẾP TỪ GOOGLE DRIVE CHỐNG NGHẼN/CORS)\n    function fetchDirectFromGoogleSheetGviz(silent = false) {\n      const gvizUrl = `https://docs.google.com/spreadsheets/d/${DEFAULT_CONFIG.sheetId}/gviz/tq?tqx=out:json&_t=${Date.now()}`;\n      \n      fetch(gvizUrl)\n        .then(res => res.text())\n        .then(text => {\n          const match = text.match(/setResponse\\(([\\s\\S]*)\\);/);\n          if (!match) throw new Error('Không đọc được định dạng Google Visualization');\n          const json = JSON.parse(match[1]);\n          const rows = (json.table && json.table.rows) ? json.table.rows : [];\n\n          // 1. Trích xuất 15 ca trực từ dòng 17 (chỉ mục 16, cột W..Z)\n          const shifts = [];\n          for (let i = 0; i < 15; i++) {\n            const r = rows[16 + i];\n            if (!r || !r.c) continue;\n            const c = r.c;\n            const stt = c[22] ? (c[22].v || (i + 1)) : (i + 1);\n            const nv = c[23] ? String(c[23].v || '').trim() : '';\n            const kv = c[24] ? String(c[24].v || '').trim() : '';\n            const pg = c[25] ? String(c[25].v || '').trim() : '';\n            shifts.push({ stt: Number(stt), nv, kv, pg });\n          }\n\n          // 2. Trích xuất danh sách nhân viên từ dòng 1 (chỉ mục 0, cột AC..AE)\n          const employees = [];\n          for (let i = 0; i < rows.length; i++) {\n            const r = rows[i];\n            if (!r || !r.c) continue;\n            const c = r.c;\n            const name = c[29] ? String(c[29].v || '').trim() : '';\n            if (!name || name === 'HỌ VÀ TÊN' || name === 'NHÂN SỰ') continue;\n            const stt = c[28] ? (c[28].v || (employees.length + 1)) : (employees.length + 1);\n            const mark = c[30] ? String(c[30].v || '').trim().toUpperCase() : '';\n            const isPg = /pg|tcl|lg|oppo|vivo|realme|xiaomi|aqua|toshiba|sunhouse|bluestone|karofi|mutosi/i.test(name);\n            employees.push({\n              stt: Number(stt),\n              name,\n              role: isPg ? 'pg' : 'nv',\n              marked: (mark === 'X' || mark === '1' || mark === 'TRUE')\n            });\n          }\n\n          if (shifts.length > 0 || employees.length > 0) {\n            applyReceivedSheetData({ success: true, shifts, employees }, 'Google Sheets Live', silent);\n          } else {\n            throw new Error('Không có hàng dữ liệu');\n          }\n        })\n        .catch(err => {\n          console.warn('Cả Apps Script và Gviz fallback đều không đọc được:', err);\n          const statusPill = document.getElementById('realtimeStatusPill');\n          const statusText = document.getElementById('realtimeStatusText');\n          if (statusPill && statusText) {\n            statusPill.className = 'live-status-pill offline';\n            statusText.textContent = '⚠️ Dùng dữ liệu đệm (Bấm làm mới)';\n          }\n          if (!silent) {\n            showToast('⚠️ Đang hiển thị dữ liệu bộ nhớ đệm. Bấm nút Làm Mới để tải lại từ Sheet.');\n          }\n        });\n    }\n\n    // ĐỒNG BỘ ĐỌC DỮ LIỆU TỪ GOOGLE SHEET VỀ WEB APP\n    function fetchDataFromGoogleSheet(silent = false) {\n      const url = DEFAULT_CONFIG.webAppUrl;\n      if (!url) {\n        fetchDirectFromGoogleSheetGviz(silent);\n        return;\n      }\n\n      const statusPill = document.getElementById('realtimeStatusPill');\n      const statusText = document.getElementById('realtimeStatusText');\n      if (statusPill && statusText) {\n        statusPill.className = 'live-status-pill syncing';\n        statusText.textContent = '🔄 Đang đồng bộ Google Sheet...';\n      }\n\n      if (!silent) showToast('☁️ Đang kết nối và đồng bộ dữ liệu từ Google Trang Tính...');\n\n      // Thêm _t=Date.now() chống cache WebView iOS/Android/LINE\n      const fetchUrl = url + (url.includes('?') ? '&' : '?') + 'action=getData&sheetId=' + encodeURIComponent(DEFAULT_CONFIG.sheetId) + '&_t=' + Date.now();\n\n      const controller = new AbortController();\n      const timeoutId = setTimeout(() => controller.abort(), 12000);\n\n      // Simple Request không có headers tùy biến để tránh bị trình duyệt chặn CORS preflight\n      fetch(fetchUrl, {\n        method: 'GET',\n        signal: controller.signal\n      })\n        .then(res => {\n          clearTimeout(timeoutId);\n          if (!res.ok) throw new Error('HTTP ' + res.status);\n          return res.json();\n        })\n        .then(data => {\n          if (data && data.success) {\n            applyReceivedSheetData(data, 'Google Apps Script', silent);\n          } else {\n            throw new Error(data && data.message ? data.message : 'Dữ liệu không hợp lệ');\n          }\n        })\n        .catch(err => {\n          clearTimeout(timeoutId);\n          console.warn('Apps Script Web App không phản hồi, tự động chuyển sang đọc trực tiếp Google Sheets Gviz:', err);\n          fetchDirectFromGoogleSheetGviz(silent);\n        });\n    }\n\n    // NÚT XUẤT ẢNH HD: ĐẢM BẢO CHỤP 100% TOÀN BỘ SƠ ĐỒ MẶT BẰNG KHÔNG BỊ CẮT XÉN\n    document.getElementById('btnExportImage').addEventListener('click', async () => {\n      if (typeof html2canvas === 'undefined') {\n        showToast('❌ Thư viện tạo ảnh chưa sẵn sàng!');\n        return;\n      }\n\n      showToast('📸 Đang kết xuất toàn bộ sơ đồ HD (sắc nét 2X)...');\n\n      const isFloorMap = (state.activeTab === 'floorMapTab');\n      const target = isFloorMap \n        ? document.getElementById('floorPlanExportTarget') \n        : (state.activeTab === 'rulesTab' \n          ? document.getElementById('rulesExportTarget') \n          : document.getElementById('employeesTab') || document.getElementById('appMainContainer'));\n\n      if (!target) return;\n\n      // Xóa các ô đang highlight tìm kiếm (nếu có) để ảnh xuất ra chuẩn đẹp\n      document.querySelectorAll('.highlight-target').forEach(el => el.classList.remove('highlight-target'));\n\n      // Lưu trạng thái scroll ngang của viewport sơ đồ\n      const scrollViewport = document.querySelector('.floorplan-scroll-viewport');\n      const originalScrollLeft = scrollViewport ? scrollViewport.scrollLeft : 0;\n      if (scrollViewport) scrollViewport.scrollLeft = 0;\n\n      // Cập nhật timestamp xuất ảnh\n      const now = new Date();\n      const timeStr = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;\n      const tsEl = document.getElementById('exportTimeText');\n      if (tsEl) tsEl.textContent = timeStr;\n\n      // Bật chế độ full width để bung toàn bộ kích thước sơ đồ trong DOM\n      if (isFloorMap) {\n        document.body.classList.add('exporting-full-map');\n      }\n\n      // Chờ DOM tính toán lại layout (60ms)\n      await new Promise(r => setTimeout(r, 60));\n\n      try {\n        const gridEl = document.getElementById('storeLayoutGridEl');\n        const gridW = gridEl ? Math.max(gridEl.scrollWidth, 1920) : 1920;\n        const exportW = isFloorMap ? Math.max(target.scrollWidth, target.offsetWidth, gridW + 40, 1960) : Math.max(target.offsetWidth, target.scrollWidth);\n        const exportH = isFloorMap ? Math.max(target.scrollHeight, target.offsetHeight) : target.scrollHeight;\n\n        const windowW = Math.max(exportW + 80, 2050);\n        const windowH = Math.max(exportH + 100, 1600);\n\n        const canvas = await html2canvas(target, {\n          scale: 2,\n          backgroundColor: '#fffdf5',\n          useCORS: true,\n          logging: false,\n          width: exportW,\n          height: exportH,\n          windowWidth: windowW,\n          windowHeight: windowH,\n          scrollX: 0,\n          scrollY: 0,\n          onclone: (clonedDoc) => {\n            if (isFloorMap) {\n              clonedDoc.documentElement.style.overflow = 'visible';\n              clonedDoc.body.style.overflow = 'visible';\n              \n              const clonedApp = clonedDoc.querySelector('.app-container');\n              if (clonedApp) {\n                clonedApp.style.width = exportW + 'px';\n                clonedApp.style.maxWidth = 'none';\n                clonedApp.style.overflow = 'visible';\n                clonedApp.style.padding = '0';\n                clonedApp.style.margin = '0';\n              }\n\n              const clonedTarget = clonedDoc.getElementById('floorPlanExportTarget');\n              if (clonedTarget) {\n                clonedTarget.style.width = exportW + 'px';\n                clonedTarget.style.minWidth = exportW + 'px';\n                clonedTarget.style.maxWidth = 'none';\n                clonedTarget.style.overflow = 'visible';\n              }\n\n              const clonedVp = clonedDoc.querySelector('.floorplan-scroll-viewport');\n              if (clonedVp) {\n                clonedVp.style.width = '100%';\n                clonedVp.style.maxWidth = 'none';\n                clonedVp.style.overflow = 'visible';\n                clonedVp.style.overflowX = 'visible';\n                clonedVp.scrollLeft = 0;\n              }\n\n              const clonedGrid = clonedDoc.getElementById('storeLayoutGridEl');\n              if (clonedGrid) {\n                clonedGrid.style.width = '100%';\n                clonedGrid.style.minWidth = (exportW - 40) + 'px';\n              }\n\n              const btnQ = clonedDoc.getElementById('btnQuickAllocationMode');\n              if (btnQ) btnQ.style.display = 'none';\n              const tip = clonedDoc.querySelector('.mobile-scroll-tip');\n              if (tip) tip.style.display = 'none';\n              const banner = clonedDoc.getElementById('allocationActiveBanner');\n              if (banner) banner.style.display = 'none';\n              const timeBadge = clonedDoc.getElementById('exportTimeBadge');\n              if (timeBadge) timeBadge.style.display = 'inline-flex';\n            }\n          }\n        });\n\n        currentExportDataUrl = canvas.toDataURL('image/png');\n\n        canvas.toBlob(blob => {\n          currentExportBlob = blob;\n\n          // Auto copy vào Clipboard nếu hỗ trợ\n          if (navigator.clipboard && window.ClipboardItem && blob) {\n            try {\n              const item = new ClipboardItem({ 'image/png': blob });\n              navigator.clipboard.write([item]).then(() => {\n                showToast('📋 Đã tự động sao chép toàn bộ ảnh sơ đồ vào Clipboard! (Bấm Ctrl+V để dán Zalo)');\n              }).catch(err => {\n                console.warn('Clipboard write error:', err);\n              });\n            } catch(e) {}\n          }\n\n          // Hiển thị modal popup xem trước\n          const modal = document.getElementById('imagePreviewModal');\n          const imgEl = document.getElementById('previewModalImageEl');\n          imgEl.src = currentExportDataUrl;\n          modal.style.display = 'flex';\n\n          showToast('✅ Đã xuất trọn vẹn toàn bộ sơ đồ HD!');\n        }, 'image/png');\n\n      } catch (err) {\n        console.error('Lỗi khi xuất ảnh sơ đồ:', err);\n        showToast('❌ Lỗi xuất ảnh: ' + err.message);\n      } finally {\n        // Luôn khôi phục giao diện người dùng bình thường\n        if (isFloorMap) {\n          document.body.classList.remove('exporting-full-map');\n        }\n        if (scrollViewport) {\n          scrollViewport.scrollLeft = originalScrollLeft;\n        }\n      }\n    });\n\n    // Nút sao chép lại ảnh trong modal\n    document.getElementById('btnCopyImageAgain').addEventListener('click', () => {\n      if (currentExportBlob && navigator.clipboard && window.ClipboardItem) {\n        try {\n          const item = new ClipboardItem({ 'image/png': currentExportBlob });\n          navigator.clipboard.write([item]).then(() => {\n            showToast('📋 Đã sao chép lại ảnh vào Clipboard! Bấm Ctrl+V dán vào Zalo');\n          }).catch(() => {\n            showToast('⚠️ Không thể ghi vào Clipboard tự động');\n          });\n        } catch(e) {\n          showToast('⚠️ Không thể sao chép trực tiếp');\n        }\n      } else {\n        showToast('⚠️ Trình duyệt không hỗ trợ sao chép ảnh trực tiếp');\n      }\n    });\n\n    // Nút tải về máy thủ công (khi người dùng chủ động muốn tải)\n    document.getElementById('btnDownloadImageManually').addEventListener('click', () => {\n      if (currentExportDataUrl) {\n        const a = document.createElement('a');\n        a.download = `SoDo_VeSinh_1841_${Date.now()}.png`;\n        a.href = currentExportDataUrl;\n        a.click();\n        showToast('💾 Đang tải ảnh về máy...');\n      }\n    });\n\n    // Đóng modal xem trước ảnh\n    const closePreviewModal = () => {\n      document.getElementById('imagePreviewModal').style.display = 'none';\n    };\n    document.getElementById('btnClosePreviewModal').onclick = closePreviewModal;\n    document.getElementById('btnClosePreviewModalBtn').onclick = closePreviewModal;\n    document.getElementById('imagePreviewModal').onclick = (e) => {\n      if (e.target.id === 'imagePreviewModal') closePreviewModal();\n    };\n\n    // LÀM MỚI & ĐỒNG BỘ TỪ GOOGLE SHEET\n    document.getElementById('btnReloadPage').addEventListener('click', () => {\n      fetchDataFromGoogleSheet(false);\n    });\n\n    // NÚT LƯU VỀ SHEET (LƯU CẢ CA TRỰC VÀ DANH SÁCH NV/PG)\n    document.getElementById('btnSaveToSheetMain').addEventListener('click', () => {\n      showToast('☁️ Đang lưu toàn bộ ca trực & danh sách NV/PG về tab \"save data\" trên Google Sheet...');\n      saveAllToSheet();\n      saveAllEmployeesToSheet();\n    });\n\n    // MODAL CÀI ĐẶT\n    document.getElementById('btnOpenConfigModal').onclick = () => {\n      document.getElementById('cfgWebAppUrl').value = DEFAULT_CONFIG.webAppUrl;\n      document.getElementById('configModal').style.display = 'flex';\n    };\n    document.getElementById('btnCloseConfigModal').onclick = () => document.getElementById('configModal').style.display = 'none';\n    document.getElementById('btnSaveConfig').onclick = () => {\n      const url = document.getElementById('cfgWebAppUrl').value.trim();\n      DEFAULT_CONFIG.webAppUrl = url;\n      localStorage.setItem('phancong_webapp_url', url);\n      document.getElementById('configModal').style.display = 'none';\n      showToast('✅ Đã lưu cấu hình Web App URL!');\n    };\n\n\n    // XỬ LÝ SUB-TABS TRÊN ĐIỆN THOẠI (CHUYỂN NHANH NV / PG)\n    let currentMobileEmpFilter = 'all';\n    document.querySelectorAll('.mobile-subtab-btn').forEach(btn => {\n      btn.addEventListener('click', function() {\n        document.querySelectorAll('.mobile-subtab-btn').forEach(b => b.classList.remove('active'));\n        this.classList.add('active');\n        currentMobileEmpFilter = this.getAttribute('data-filter');\n        applyMobileEmpFilter();\n      });\n    });\n\n    function applyMobileEmpFilter() {\n      const panelStaff = document.querySelector('.emp-column-panel.panel-staff');\n      const panelPg = document.querySelector('.emp-column-panel.panel-pg');\n      if (!panelStaff || !panelPg) return;\n\n      if (window.innerWidth <= 768) {\n        if (currentMobileEmpFilter === 'nv') {\n          panelStaff.style.display = 'flex';\n          panelPg.style.display = 'none';\n        } else if (currentMobileEmpFilter === 'pg') {\n          panelStaff.style.display = 'none';\n          panelPg.style.display = 'flex';\n        } else {\n          panelStaff.style.display = 'flex';\n          panelPg.style.display = 'flex';\n        }\n      } else {\n        panelStaff.style.display = 'flex';\n        panelPg.style.display = 'flex';\n      }\n    }\n\n    window.addEventListener('resize', applyMobileEmpFilter);\n\n    // NÚT CUỘN LÊN ĐẦU TRANG (MOBILE BACK TO TOP)\n    const btnScrollTopEl = document.getElementById('btnScrollTop');\n    window.addEventListener('scroll', () => {\n      if (window.scrollY > 300) {\n        btnScrollTopEl.style.display = 'flex';\n      } else {\n        btnScrollTopEl.style.display = 'none';\n      }\n    });\n    btnScrollTopEl.addEventListener('click', () => {\n      window.scrollTo({ top: 0, behavior: 'smooth' });\n    });\n\n    // KHỞI ĐỘNG\n    renderShifts();\n    renderEmployees();\n    initRealtime();\n    initMapCells();\n    syncMapCellsFromShifts();\n    fetchDataFromGoogleSheet(false);\n\n    // Bấm vào status pill để làm mới thủ công\n    const pillEl = document.getElementById('realtimeStatusPill');\n    if (pillEl) {\n      pillEl.addEventListener('click', () => {\n        fetchDataFromGoogleSheet(false);\n      });\n    }\n\n    // Tự động đồng bộ khi chuyển lại tab / mở lại app\n    document.addEventListener('visibilitychange', () => {\n      if (document.visibilityState === 'visible') {\n        fetchDataFromGoogleSheet(true);\n      }\n    });\n\n    // Tự động đồng bộ định kỳ mỗi 45 giây nếu đang mở trang\n    setInterval(() => {\n      if (document.visibilityState === 'visible') {\n        fetchDataFromGoogleSheet(true);\n      }\n    }, 45000);\n  </script>\n  <!-- NÚT CUỘN LÊN ĐẦU TRANG TRÊN MOBILE -->\n  <button class=\"btn-scroll-top\" id=\"btnScrollTop\" title=\"Lên đầu trang\">\n    <i class=\"fa-solid fa-arrow-up\"></i>\n  </button>\n</body>\n</html>\n";
