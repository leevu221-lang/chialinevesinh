kground: #ffffff;\n      border: 1.5px solid var(--primary-border);\n      color: #6d28d9;\n    }\n\n    .btn-secondary:hover {\n      background: #f5f3ff;\n      border-color: #c4b5fd;\n      transform: translateY(-1px);\n    }\n\n    .btn-icon-square {\n      width: 38px;\n      height: 38px;\n      padding: 0;\n      border-radius: var(--radius-md);\n      font-size: 15px;\n    }\n\n    /* ==========================================================================\n       TABS NAVIGATION: TONE TÍM PASTEL\n       ========================================================================== */\n    .tab-bar-container {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 12px;\n      margin-bottom: 20px;\n      flex-wrap: wrap;\n    }\n\n    .nav-tabs-pill {\n      display: inline-flex;\n      align-items: center;\n      background: rgba(255, 255, 255, 0.85);\n      backdrop-filter: blur(10px);\n      border: 1.5px solid var(--primary-border);\n      border-radius: 9999px;\n      padding: 5px;\n      gap: 4px;\n      box-shadow: 0 4px 12px rgba(139, 92, 246, 0.06);\n    }\n\n    .tab-btn {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 8px 18px;\n      border-radius: 9999px;\n      border: none;\n      background: transparent;\n      color: var(--text-muted);\n      font-size: 13px;\n      font-weight: 700;\n      cursor: pointer;\n      transition: all 0.2s ease;\n    }\n\n    .tab-btn:hover {\n      color: var(--primary-dark);\n      background: rgba(237, 233, 254, 0.5);\n    }\n\n    .tab-btn.active {\n      background: var(--primary-gradient);\n      color: #ffffff;\n      box-shadow: 0 3px 10px rgba(139, 92, 246, 0.32);\n    }\n\n    .tab-badge {\n      font-size: 11px;\n      padding: 2px 7px;\n      border-radius: 9999px;\n      background: rgba(255, 255, 255, 0.25);\n      font-weight: 800;\n    }\n\n    .tab-btn:not(.active) .tab-badge {\n      background: #ede9fe;\n      color: #6d28d9;\n    }\n\n    .search-filter-box {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      flex: 1;\n      max-width: 420px;\n      min-width: 260px;\n    }\n\n    .search-input-wrap {\n      position: relative;\n      width: 100%;\n    }\n\n    .search-input-wrap i {\n      position: absolute;\n      left: 14px;\n      top: 50%;\n      transform: translateY(-50%);\n      color: #a78bfa;\n      font-size: 14px;\n    }\n\n    .search-input {\n      width: 100%;\n      padding: 10px 14px 10px 38px;\n      background: #ffffff;\n      border: 1.5px solid var(--primary-border);\n      border-radius: var(--radius-md);\n      font-size: 13px;\n      color: var(--text-main);\n      outline: none;\n      transition: all 0.2s ease;\n    }\n\n    .search-input:focus {\n      border-color: var(--primary);\n      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.18);\n    }\n\n    /* ==========================================================================\n       TAB 1: BẢNG PHÂN CÔNG NHÂN VIÊN TRỰC (15 VỊ TRÍ)\n       ========================================================================== */\n    .shifts-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));\n      gap: 16px;\n      margin-bottom: 24px;\n    }\n\n    .shift-card {\n      background: var(--card-bg);\n      border: 1.5px solid var(--card-border);\n      border-radius: var(--radius-lg);\n      padding: 16px;\n      box-shadow: var(--card-shadow);\n      transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);\n      display: flex;\n      flex-direction: column;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .shift-card:hover {\n      border-color: #c084fc;\n      transform: translateY(-2px);\n      box-shadow: var(--card-shadow-hover);\n    }\n\n    .shift-card::before {\n      content: '';\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 4px;\n      background: var(--primary-gradient);\n      opacity: 0.85;\n    }\n\n    .shift-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 12px;\n    }\n\n    .shift-stt-badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      background: #ede9fe;\n      color: #6d28d9;\n      font-size: 12px;\n      font-weight: 800;\n      padding: 4px 10px;\n      border-radius: 9999px;\n      border: 1px solid #ddd6fe;\n    }\n\n    .shift-status-tag {\n      font-size: 11.5px;\n      font-weight: 700;\n      padding: 3px 9px;\n      border-radius: 6px;\n    }\n\n    .status-assigned {\n      background: #ecfdf5;\n      color: #059669;\n      border: 1px solid #a7f3d0;\n    }\n\n    .status-empty {\n      background: #fef3c7;\n      color: #b45309;\n      border: 1px solid #fde68a;\n    }\n\n    .shift-field-group {\n      margin-bottom: 10px;\n    }\n\n    .field-label {\n      font-size: 11px;\n      font-weight: 700;\n      color: #6b7280;\n      text-transform: uppercase;\n      letter-spacing: 0.03em;\n      margin-bottom: 4px;\n      display: flex;\n      align-items: center;\n      gap: 5px;\n    }\n\n    .field-select, .field-input {\n      width: 100%;\n      padding: 8px 12px;\n      background: #faf5ff;\n      border: 1px solid #e9d5ff;\n      border-radius: var(--radius-sm);\n      font-size: 13px;\n      font-weight: 600;\n      color: var(--text-main);\n      outline: none;\n      transition: all 0.15s ease;\n    }\n\n    .field-select:focus, .field-input:focus {\n      background: #ffffff;\n      border-color: var(--primary);\n      box-shadow: 0 0 0 2.5px rgba(139, 92, 246, 0.15);\n    }\n\n    .field-select option {\n      background: #ffffff;\n      color: #1e1b4b;\n    }\n\n    .pg-badge-cell {\n      background: #fdf4ff;\n      border: 1px dashed #f0abfc;\n      border-radius: var(--radius-sm);\n      padding: 7px 10px;\n      font-size: 12px;\n      color: #a21caf;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 6px;\n    }\n\n    .shift-card-footer {\n      margin-top: auto;\n      padding-top: 10px;\n      border-top: 1px dashed #e9d5ff;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      font-size: 11.5px;\n      color: var(--text-muted);\n    }\n\n    /* ==========================================================================\n       TAB 2: SƠ ĐỒ MẶT BẰNG SIÊU THỊ 1841 (INTERACTIVE MAP)\n       ========================================================================== */\n    .map-card-container {\n      background: var(--card-bg);\n      border: 1.5px solid var(--card-border);\n      border-radius: var(--radius-xl);\n      padding: 20px;\n      box-shadow: var(--card-shadow);\n      margin-bottom: 24px;\n    }\n\n    .map-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 16px;\n      flex-wrap: wrap;\n      gap: 10px;\n    }\n\n    .map-title {\n      font-size: 17px;\n      font-weight: 800;\n      color: #4c1d95;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .map-legend {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      flex-wrap: wrap;\n      font-size: 12px;\n      font-weight: 600;\n    }\n\n    .legend-item {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .legend-color {\n      width: 12px;\n      height: 12px;\n      border-radius: 4px;\n    }\n\n    /* Layout sơ đồ kiến trúc mặt bằng */\n    .store-floor-plan {\n      background: #faf5ff;\n      border: 2px dashed #ddd6fe;\n      border-radius: var(--radius-lg);\n      padding: 20px;\n      display: flex;\n      flex-direction: column;\n      gap: 14px;\n      overflow-x: auto;\n      min-width: 860px;\n    }\n\n    .floor-row {\n      display: flex;\n      gap: 12px;\n      align-items: stretch;\n      width: 100%;\n    }\n\n    .zone-box {\n      background: #ffffff;\n      border: 1.5px solid #e9d5ff;\n      border-radius: var(--radius-md);\n      padding: 12px 14px;\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      min-height: 72px;\n      box-shadow: 0 2px 6px rgba(139, 92, 246, 0.04);\n      cursor: pointer;\n      transition: all 0.2s ease;\n      position: relative;\n    }\n\n    .zone-box:hover {\n      border-color: #8b5cf6;\n      transform: translateY(-2px);\n      box-shadow: 0 6px 16px rgba(139, 92, 246, 0.16);\n    }\n\n    .zone-box.highlight {\n      background: #ede9fe;\n      border-color: #7c3aed;\n      box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.25);\n    }\n\n    .zone-name {\n      font-size: 12px;\n      font-weight: 800;\n      color: #3b0764;\n      line-height: 1.3;\n    }\n\n    .zone-assignee {\n      margin-top: 6px;\n      font-size: 11px;\n      font-weight: 700;\n      color: #6d28d9;\n      background: #f5f3ff;\n      padding: 2px 7px;\n      border-radius: 4px;\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      width: fit-content;\n    }\n\n    /* Màu sắc đặc trưng từng phân khu */\n    .zone-entrance {\n      background: #f0fdf4;\n      border-color: #bbf7d0;\n      color: #166534;\n      text-align: center;\n      justify-content: center;\n    }\n    .zone-ict {\n      background: #eff6ff;\n      border-color: #bfdbfe;\n    }\n    .zone-ict .zone-name { color: #1e40af; }\n    \n    .zone-tivi {\n      background: #fff7ed;\n      border-color: #fed7aa;\n    }\n    .zone-tivi .zone-name { color: #9a3412; }\n\n    .zone-washing {\n      background: #f0fdfa;\n      border-color: #99f6e4;\n    }\n    .zone-washing .zone-name { color: #115e59; }\n\n    .zone-fridge {\n      background: #f0f9ff;\n      border-color: #bae6fd;\n    }\n    .zone-fridge .zone-name { color: #075985; }\n\n    .zone-appliance {\n      background: #fdf2f8;\n      border-color: #fbcfe8;\n    }\n    .zone-appliance .zone-name { color: #9d174d; }\n\n    .zone-storage {\n      background: #f8fafc;\n      border-color: #cbd5e1;\n      color: #475569;\n    }\n\n    /* ==========================================================================\n       TAB 3: ĐIỂM DANH 26 NHÂN VIÊN SIÊU THỊ\n       ========================================================================== */\n    .employee-stats-bar {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n      gap: 14px;\n      margin-bottom: 20px;\n    }\n\n    .stat-card {\n      background: var(--card-bg);\n      border: 1.5px solid var(--card-border);\n      border-radius: var(--radius-lg);\n      padding: 16px;\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      box-shadow: var(--card-shadow);\n    }\n\n    .stat-icon {\n      width: 46px;\n      height: 46px;\n      border-radius: var(--radius-md);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 20px;\n      color: #ffffff;\n    }\n\n    .stat-number {\n      font-size: 22px;\n      font-weight: 800;\n      color: var(--text-main);\n      font-family: var(--font-mono);\n      line-height: 1;\n    }\n\n    .stat-label {\n      font-size: 12px;\n      font-weight: 600;\n      color: var(--text-muted);\n      margin-top: 3px;\n    }\n\n    .emp-list-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n      gap: 12px;\n    }\n\n    .emp-item-card {\n      background: var(--card-bg);\n      border: 1.5px solid var(--card-border);\n      border-radius: var(--radius-md);\n      padding: 12px 14px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 10px;\n      box-shadow: var(--card-shadow);\n      transition: all 0.18s ease;\n    }\n\n    .emp-item-card:hover {\n      border-color: #c084fc;\n      transform: translateY(-1px);\n    }\n\n    .emp-item-card.is-active {\n      background: #faf5ff;\n      border-color: #a855f7;\n    }\n\n    .emp-info {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n\n    .emp-stt {\n      font-size: 11px;\n      font-weight: 800;\n      color: #7c3aed;\n      background: #ede9fe;\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .emp-name {\n      font-size: 13.5px;\n      font-weight: 700;\n      color: var(--text-main);\n    }\n\n    .emp-assign-tag {\n      font-size: 11px;\n      color: #6d28d9;\n      background: #ede9fe;\n      padding: 1px 6px;\n      border-radius: 4px;\n      margin-top: 2px;\n      display: inline-block;\n      max-width: 150px;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .btn-toggle-att {\n      padding: 6px 12px;\n      border-radius: 8px;\n      font-size: 11.5px;\n      font-weight: 700;\n      cursor: pointer;\n      border: none;\n      transition: all 0.15s ease;\n    }\n\n    .att-active {\n      background: #d1fae5;\n      color: #065f46;\n      border: 1px solid #a7f3d0;\n    }\n\n    .att-inactive {\n      background: #f1f5f9;\n      color: #64748b;\n      border: 1px solid #e2e8f0;\n    }\n\n    /* Toast Notification */\n    .toast-box {\n      position: fixed;\n      bottom: 24px;\n      right: 24px;\n      background: #1e1b4b;\n      color: #ffffff;\n      padding: 12px 20px;\n      border-radius: var(--radius-md);\n      font-size: 13px;\n      font-weight: 700;\n      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      z-index: 9999;\n      animation: slideUp 0.25s ease forwards;\n      border-left: 4px solid #a855f7;\n    }\n\n    @keyframes slideUp {\n      from { transform: translateY(20px); opacity: 0; }\n      to { transform: translateY(0); opacity: 1; }\n    }\n\n    /* Modal dialog */\n    .modal-overlay {\n      position: fixed;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      background: rgba(15, 23, 42, 0.6);\n      backdrop-filter: blur(4px);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 20px;\n      z-index: 9999;\n    }\n\n    .modal-card {\n      background: #ffffff;\n      border-radius: var(--radius-lg);\n      padding: 24px;\n      max-width: 480px;\n      width: 100%;\n      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);\n      border: 1.5px solid var(--primary-border);\n    }\n\n    .modal-card h3 {\n      font-size: 17px;\n      font-weight: 800;\n      color: #4c1d95;\n      margin-bottom: 12px;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    /* Responsive */\n    @media (max-width: 768px) {\n      .app-container { padding: 12px 12px 30px; }\n      .app-header { padding: 14px 16px; border-radius: var(--radius-lg); }\n      .brand-info h1 { font-size: 16px; }\n      .nav-tabs-pill { width: 100%; justify-content: space-between; }\n      .tab-btn { padding: 7px 12px; font-size: 12px; }\n      .search-filter-box { max-width: 100%; }\n      .shifts-grid { grid-template-columns: 1fr; }\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"app-container\" id=\"appMainContainer\">\n\n    <!-- ================= HEADER CHÍNH TONE TÍM PASTEL ================= -->\n    <header class=\"app-header\">\n      <div class=\"brand-box\">\n        <div class=\"brand-icon-wrap\">\n          <i class=\"fa-solid fa-broom\"></i>\n        </div>\n        <div class=\"brand-info\">\n          <h1>HỆ THỐNG PHÂN CÔNG TRỰC & VỆ SINH</h1>\n          <p class=\"brand-subtitle\">\n            <span class=\"sheet-tag\"><i class=\"fa-solid fa-store\"></i> Siêu thị 1841</span>\n            <span>•</span>\n            <span class=\"sheet-badge\"><i class=\"fa-solid fa-table-cells\"></i> 1841 - VỆ SINH ÁP DỤNG 1/7/2026</span>\n          </p>\n        </div>\n      </div>\n\n      <div class=\"header-right-actions\">\n        <!-- Live status dot -->\n        <div class=\"live-pill\" id=\"realtimeLiveBadge\">\n          <span class=\"live-dot\"></span>\n          <span id=\"syncText\">Đồng bộ tức thì (Realtime)</span>\n        </div>\n\n        <!-- Realtime Clock -->\n        <div class=\"clock-badge\" id=\"clockDisplay\">--:--:-- --/--/----</div>\n\n        <!-- Quick actions -->\n        <button type=\"button\" class=\"btn-action btn-secondary\" id=\"btnExportImage\" title=\"Xuất file ảnh HD gửi Zalo\">\n          <i class=\"fa-solid fa-camera\"></i>\n          <span>Xuất Ảnh HD</span>\n        </button>\n\n        <button type=\"button\" class=\"btn-action btn-primary\" id=\"btnSaveToSheetMain\" title=\"Lưu toàn bộ lên Google Sheet\">\n          <i class=\"fa-solid fa-cloud-arrow-up\"></i>\n          <span id=\"saveBtnMainText\">Lưu Về Sheet</span>\n        </button>\n\n        <button type=\"button\" class=\"btn-action btn-secondary btn-icon-square\" id=\"btnReloadPage\" title=\"Làm mới trang hiện tại\">\n          <i class=\"fa-solid fa-rotate\"></i>\n        </button>\n\n        <button type=\"button\" class=\"btn-action btn-secondary btn-icon-square\" id=\"btnOpenConfigModal\" title=\"Cấu hình Google Apps Script\">\n          <i class=\"fa-solid fa-gear\"></i>\n        </button>\n      </div>\n    </header>\n\n    <!-- ================= THANH ĐIỀU HƯỚNG TABS ================= -->\n    <div class=\"tab-bar-container\">\n      <div class=\"nav-tabs-pill\">\n        <button type=\"button\" class=\"tab-btn active\" data-tab=\"shiftsTab\">\n          <i class=\"fa-solid fa-clipboard-list\"></i>\n          <span>Phân Công Trực</span>\n          <span class=\"tab-badge\" id=\"badgeShiftCount\">15 Vị trí</span>\n        </button>\n        <button type=\"button\" class=\"tab-btn\" data-tab=\"floorMapTab\">\n          <i class=\"fa-solid fa-map-location-dot\"></i>\n          <span>Sơ Đồ Mặt Bằng</span>\n        </button>\n        <button type=\"button\" class=\"tab-btn\" data-tab=\"employeesTab\">\n          <i class=\"fa-solid fa-users\"></i>\n          <span>Điểm Danh Nhân Viên</span>\n          <span class=\"tab-badge\" id=\"badgeEmpCount\">26 NV</span>\n        </button>\n      </div>\n\n      <div class=\"search-filter-box\">\n        <div class=\"search-input-wrap\">\n          <i class=\"fa-solid fa-magnifying-glass\"></i>\n          <input type=\"text\" id=\"searchInput\" class=\"search-input\" placeholder=\"Tìm kiếm nhân viên, khu vực trực, PG...\" autocomplete=\"off\">\n        </div>\n      </div>\n    </div>\n\n    <!-- ================= TAB 1: BẢNG PHÂN CÔNG 15 VỊ TRÍ ================= -->\n    <div class=\"tab-content-panel\" id=\"shiftsTab\">\n      <div class=\"shifts-grid\" id=\"shiftsGridContainer\">\n        <!-- Render động 15 thẻ phân công trực -->\n      </div>\n    </div>\n\n    <!-- ================= TAB 2: SƠ ĐỒ MẶT BẰNG SIÊU THỊ 1841 ================= -->\n    <div class=\"tab-content-panel\" id=\"floorMapTab\" style=\"display: none;\">\n      <div class=\"map-card-container\" id=\"floorPlanExportTarget\">\n        <div class=\"map-header\">\n          <div class=\"map-title\">\n            <i class=\"fa-solid fa-store\"></i>\n            <span>SƠ ĐỒ BẢN ĐỒ MẶT BẰNG BỐ TRÍ SIÊU THỊ 1841</span>\n          </div>\n          <div class=\"map-legend\">\n            <div class=\"legend-item\"><span class=\"legend-color\" style=\"background:#eff6ff; border:1px solid #bfdbfe;\"></span> <span>ICT & Phone</span></div>\n            <div class=\"legend-item\"><span class=\"legend-color\" style=\"background:#fff7ed; border:1px solid #fed7aa;\"></span> <span>Dãy Tivi</span></div>\n            <div class=\"legend-item\"><span class=\"legend-color\" style=\"background:#f0fdfa; border:1px solid #99f6e4;\"></span> <span>Máy Giặt</span></div>\n            <div class=\"legend-item\"><span class=\"legend-color\" style=\"background:#f0f9ff; border:1px solid #bae6fd;\"></span> <span>Tủ Lạnh</span></div>\n            <div class=\"legend-item\"><span class=\"legend-color\" style=\"background:#fdf2f8; border:1px solid #fbcfe8;\"></span> <span>Gia Dụng</span></div>\n          </div>\n        </div>\n\n        <div class=\"store-floor-plan\" id=\"storeFloorPlan\">\n          <!-- Hàng 1: Mặt tiền & Lối vào -->\n          <div class=\"floor-row\">\n            <div class=\"zone-box zone-entrance\" style=\"flex:2;\" data-zone=\"VÁCH KÍNH\">\n              <span class=\"zone-name\">🪟 VÁCH KÍNH TRƯỚC</span>\n              <span class=\"zone-assignee\" id=\"assign_vach_kinh\">Linh + Lên TĐKH</span>\n            </div>\n            <div class=\"zone-box zone-entrance\" style=\"flex:1; background:#bbf7d0;\" data-zone=\"CỬA\">\n              <span class=\"zone-name\">🚪 CỬA RA VÀO CHÍNH</span>\n            </div>\n            <div class=\"zone-box zone-entrance\" style=\"flex:2;\" data-zone=\"VÁCH KÍNH\">\n              <span class=\"zone-name\">🪟 VÁCH KÍNH - SÂN XE - BANNER</span>\n              <span class=\"zone-assignee\" id=\"assign_san_xe\">Linh + Lên TĐKH</span>\n            </div>\n          </div>\n\n          <!-- Hàng 2: Khu vực ICT, Điện thoại & Dãy Tivi đầu tiên -->\n          <div class=\"floor-row\">\n            <div class=\"zone-box zone-ict\" data-zone=\"ALL KHU VỰC ICT\">\n              <span class=\"zone-name\">📱 TỦ PHONE (LÊ ?NH)</span>\n              <span class=\"zone-assignee\" id=\"assign_ict_1\">Lê ?nh • PG ICT</span>\n            </div>\n            <div class=\"zone-box zone-ict\" data-zone=\"ALL KHU VỰC ICT\">\n              <span class=\"zone-name\">📱 BÀN TRẢI NGHIỆM 1 (ÁI)</span>\n              <span class=\"zone-assignee\">Ái Vivo</span>\n            </div>\n            <div class=\"zone-box zone-ict\" data-zone=\"ALL KHU VỰC ICT\">\n              <span class=\"zone-name\">⌚ TỦ ĐỒNG HỒ 1 & 2 (TRÂM)</span>\n              <span class=\"zone-assignee\">Trâm Realme</span>\n            </div>\n            <div class=\"zone-box zone-tivi\" data-zone=\"TIVI 1,2,3, VÁCH SONY, VÁCH SS\">\n              <span class=\"zone-name\">📺 DÃY TIVI 1 & 2</span>\n              <span class=\"zone-assignee\" id=\"assign_tivi_1\">Hạnh • Oanh LG</span>\n            </div>\n            <div class=\"zone-box zone-tivi\" data-zone=\"TIVI 1,2,3, VÁCH SONY, VÁCH SS\">\n              <span class=\"zone-name\">📺 VÁCH HÃNG SONY & SAMSUNG</span>\n              <span class=\"zone-assignee\">Hạnh • Oanh LG</span>\n            </div>\n          </div>\n\n          <!-- Hàng 3: Bàn trải nghiệm di động & Tivi 3, 4, 5 -->\n          <div class=\"floor-row\">\n            <div class=\"zone-box zone-ict\" data-zone=\"ALL KHU VỰC ICT\">\n              <span class=\"zone-name\">📱 BTN REALME - SAMSUNG - VIVO</span>\n              <span class=\"zone-assignee\">Thanh Xiaomi • Ái Vivo</span>\n            </div>\n            <div class=\"zone-box zone-ict\" data-zone=\"ALL KHU VỰC ICT\">\n              <span class=\"zone-name\">💻 LAPTOP & BTN OPPO</span>\n              <span class=\"zone-assignee\">Thanh • Anh Thư</span>\n            </div>\n            <div class=\"zone-box zone-ict\" data-zone=\"ALL KHU VỰC ICT\">\n              <span class=\"zone-name\">🎧 VÁCH PHỤ KIỆN</span>\n              <span class=\"zone-assignee\">Lê ?nh</span>\n            </div>\n            <div class=\"zone-box zone-tivi\" data-zone=\"TIVI 4,5, LOA, VÁCH LG\">\n              <span class=\"zone-name\">📺 DÃY TIVI 3, 4, 5 & VÁCH LG</span>\n              <span class=\"zone-assignee\" id=\"assign_tivi_2\">Hùng Mạnh</span>\n            </div>\n            <div class=\"zone-box zone-tivi\" data-zone=\"TIVI 4,5, LOA, VÁCH LG\">\n              <span class=\"zone-name\">🔊 LOA KÉO XÁCH TAY</span>\n              <span class=\"zone-assignee\">Hùng Mạnh</span>\n            </div>\n          </div>\n\n          <!-- Hàng 4: Thu ngân, Vách máy lạnh, Máy giặt 1..3 -->\n          <div class=\"floor-row\">\n            <div class=\"zone-box\" style=\"background:#fefce8; border-color:#fde047;\" data-zone=\"QUẦY THU NGÂN - HTKT\">\n              <span class=\"zone-name\">💳 QUẦY THU NGÂN - HTKT</span>\n              <span class=\"zone-assignee\">Thu Ngân / Kho</span>\n            </div>\n            <div class=\"zone-box\" style=\"background:#e0f2fe; border-color:#7dd3fc;\" data-zone=\"VÁCH ML, DÀN MƯỚP, TỦ ĐÔNG\">\n              <span class=\"zone-name\">❄️ VÁCH MÁY LẠNH & DÀN MƯỚP</span>\n              <span class=\"zone-assignee\" id=\"assign_may_lanh\">Diễm My</span>\n            </div>\n            <div class=\"zone-box\" style=\"background:#f0fdf4; border-color:#86efac;\" data-zone=\"VÁCH ML, DÀN MƯỚP, TỦ ĐÔNG\">\n              <span class=\"zone-name\">🧊 TỦ ĐÔNG 1 & 2</span>\n              <span class=\"zone-assignee\">Diễm My</span>\n            </div>\n            <div class=\"zone-box zone-washing\" data-zone=\"MÁY GIẶT 1,2,3\">\n              <span class=\"zone-name\">🧺 DÃY MÁY GIẶT 1 - 2 - 3</span>\n              <span class=\"zone-assignee\" id=\"assign_giat_1\">Nhạn • Trang</span>\n            </div>\n            <div class=\"zone-box zone-washing\" data-zone=\"MÁY GIẶT 4,5,6\">\n              <span class=\"zone-name\">🧺 DÃY MÁY GIẶT 4 - 5 - 6</span>\n              <span class=\"zone-assignee\" id=\"assign_giat_2\">Kim Mỹ</span>\n            </div>\n          </div>\n\n          <!-- Hàng 5: Lọc nước & Tủ lạnh 1..4 -->\n          <div class=\"floor-row\">\n            <div class=\"zone-box zone-appliance\" data-zone=\"LỌC NƯỚC, GIA DỤNG 1\">\n              <span class=\"zone-name\">💧 LỌC NƯỚC 1 & 2</span>\n              <span class=\"zone-assignee\" id=\"assign_loc_nuoc\">Duy • Hi Mutosi</span>\n            </div>\n            <div class=\"zone-box zone-fridge\" data-zone=\"TỦ LẠNH 1,2\">\n              <span class=\"zone-name\">❄️ DÃY TỦ LẠNH 1 & 2</span>\n              <span class=\"zone-assignee\" id=\"assign_lanh_1\">Thanh Nhi • Tín TCL</span>\n            </div>\n            <div class=\"zone-box zone-fridge\" data-zone=\"TỦ LẠNH 3,4\">\n              <span class=\"zone-name\">❄️ DÃY TỦ LẠNH 3 & 4</span>\n              <span class=\"zone-assignee\" id=\"assign_lanh_2\">Phúc • Được</span>\n            </div>\n            <div class=\"zone-box zone-fridge\" data-zone=\"ALL VÁCH TỦ LẠNH\">\n              <span class=\"zone-name\">❄️ VÁCH TỦ LẠNH HÃNG</span>\n              <span class=\"zone-assignee\" id=\"assign_vach_lanh\">Đại</span>\n            </div>\n          </div>\n\n          <!-- Hàng 6: Gia dụng 1..7 & Vách áp tường -->\n          <div class=\"floor-row\">\n            <div class=\"zone-box zone-appliance\" data-zone=\"GIA DỤNG 2,3\">\n              <span class=\"zone-name\">🍳 GIA DỤNG 1, 2, 3</span>\n              <span class=\"zone-assignee\">Duy • Ý</span>\n            </div>\n            <div class=\"zone-box zone-appliance\" data-zone=\"GIA DỤNG 4,5\">\n              <span class=\"zone-name\">🍳 GIA DỤNG 4, 5</span>\n              <span class=\"zone-assignee\">Tuấn Mi • Băng Blue</span>\n            </div>\n            <div class=\"zone-box zone-appliance\" data-zone=\"GIA DỤNG 6,7\">\n              <span class=\"zone-name\">🍳 GIA DỤNG 6, 7</span>\n              <span class=\"zone-assignee\">Thắm • Trinh Sun</span>\n            </div>\n            <div class=\"zone-box zone-appliance\" data-zone=\"ALL VÁCH GD ÁP TƯỜNG, CHẢO, NỒI CHIÊN\">\n              <span class=\"zone-name\">🥘 VÁCH CHẢO - NỒI CHIÊN - BẾP ĐIỆN</span>\n              <span class=\"zone-assignee\">?nh • PG Karofi</span>\n            </div>\n            <div class=\"zone-box zone-storage\" data-zone=\"KHO\">\n              <span class=\"zone-name\">🚪 CỬA KHO ĐM & KHO ICT</span>\n              <span class=\"zone-assignee\">Kho Siêu Thị</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ================= TAB 3: ĐIỂM DANH 26 NHÂN VIÊN ================= -->\n    <div class=\"tab-content-panel\" id=\"employeesTab\" style=\"display: none;\">\n      <!-- Thống kê điểm danh -->\n      <div class=\"employee-stats-bar\">\n        <div class=\"stat-card\">\n          <div class=\"stat-icon\" style=\"background: linear-gradient(135deg, #a78bfa 0%, #8b5cf6 100%);\">\n            <i class=\"fa-solid fa-users\"></i>\n          </div>\n          <div>\n            <div class=\"stat-number\" id=\"statTotalEmployees\">26</div>\n            <div class=\"stat-label\">Tổng Nhân Viên</div>\n          </div>\n        </div>\n\n        <div class=\"stat-card\">\n          <div class=\"stat-icon\" style=\"background: linear-gradient(135deg, #34d399 0%, #059669 100%);\">\n            <i class=\"fa-solid fa-user-check\"></i>\n          </div>\n          <div>\n            <div class=\"stat-number\" id=\"statPresentCount\">0</div>\n            <div class=\"stat-label\">Đang Trực / Có Mặt</div>\n          </div>\n        </div>\n\n        <div class=\"stat-card\">\n          <div class=\"stat-icon\" style=\"background: linear-gradient(135deg, #f472b6 0%, #db2777 100%);\">\n            <i class=\"fa-solid fa-handshake-angle\"></i>\n          </div>\n          <div>\n            <div class=\"stat-number\" id=\"statPgCount\">10</div>\n            <div class=\"stat-label\">PG Hỗ Trợ Hãng</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Danh sách 26 thẻ nhân viên -->\n      <div class=\"emp-list-grid\" id=\"empListContainer\">\n        <!-- Render động 26 nhân viên -->\n      </div>\n    </div>\n\n  </div>\n\n  <!-- Toast notification -->\n  <div class=\"toast-box\" id=\"toastBox\" style=\"display: none;\">\n    <i class=\"fa-solid fa-circle-check\" style=\"color: #a855f7; font-size: 16px;\"></i>\n    <span id=\"toastMsg\">Đã cập nhật dữ liệu thành công!</span>\n  </div>\n\n  <!-- Modal cấu hình Google Apps Script Web App -->\n  <div class=\"modal-overlay\" id=\"configModal\" style=\"display: none;\">\n    <div class=\"modal-card\">\n      <h3>\n        <i class=\"fa-solid fa-sliders\"></i>\n        <span>Cài Đặt Kết Nối Google Sheets</span>\n      </h3>\n      <p style=\"font-size: 12.5px; color: #64748b; margin-bottom: 14px; line-height: 1.5;\">\n        Dán URL Web App Google Apps Script của bạn vào đây để đồng bộ 2 chiều (Lưu dữ liệu về Google Sheet ngay lập tức).\n      </p>\n\n      <div style=\"margin-bottom: 12px;\">\n        <label style=\"font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;\">Google Spreadsheet ID</label>\n        <input type=\"text\" id=\"cfgSheetId\" class=\"field-input\" value=\"1z6vAzHRIrYihI91Yw1dMnluPPL0BuAYiZarPBD5qNfw\" style=\"margin-top: 4px;\">\n      </div>\n\n      <div style=\"margin-bottom: 16px;\">\n        <label style=\"font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;\">Google Apps Script Web App URL</label>\n        <input type=\"text\" id=\"cfgWebAppUrl\" class=\"field-input\" placeholder=\"https://script.google.com/macros/s/.../exec\" style=\"margin-top: 4px;\">\n      </div>\n\n      <div style=\"display: flex; justify-content: flex-end; gap: 8px;\">\n        <button type=\"button\" class=\"btn-action btn-secondary\" id=\"btnCloseConfigModal\">Đóng</button>\n        <button type=\"button\" class=\"btn-action btn-primary\" id=\"btnSaveConfig\">Lưu Cài Đặt</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- JAVASCRIPT LOGIC ĐỒNG BỘ THỜI GIAN THỰC & GOOGLE SHEETS -->\n  <script>\n    /**\n     * DỮ LIỆU KHỞI TẠO TỪ GOOGLE SHEET 1z6vAzHRIrYihI91Yw1dMnluPPL0BuAYiZarPBD5qNfw\n     */\n    const DEFAULT_CONFIG = {\n      sheetId: '1z6vAzHRIrYihI91Yw1dMnluPPL0BuAYiZarPBD5qNfw',\n      webAppUrl: localStorage.getItem('phancong_webapp_url') || '',\n      mqttBroker: 'wss://broker.emqx.io:8084/mqtt',\n      mqttTopic: 'dmx1841/vesinh/realtime_sync'\n    };\n\n    // 26 Nhân viên mặc định từ sheet\n    const INITIAL_EMPLOYEES = [\n      \"Huỳnh Hoàng Phúc\", \"Thanh Nhi\", \"Lâm Thị Như Ý\", \"Lê Kim Mỹ\", \"Lê Văn Kỳ\",\n      \"Ngô Thị Bé Thắm\", \"Nguyễn Diễm My\", \"Nguyễn Hùng Mạnh\", \"Thạch Vũ\", \"Nguyễn Tuấn Mi\",\n      \"Nguyễn Thị Nhạn\", \"Phạm Ngọc Anh\", \"Phạm Văn Đại\", \"Trần Văn Duy\", \"Trang Toshiba\",\n      \"Tuấn Aqua\", \"Thanh Xiaomi\", \"Trinh - Sunhouse\", \"Oanh LG\", \"Băng Bluestone\",\n      \"Ái Vivo\", \"Tín TCL\", \"Trâm Realme\", \"Khang Hi Mutosi\", \"Anh Thư - Oppo\", \"Lam Karofi\"\n    ];\n\n    // 15 Vị trí phân công mặc định từ sheet\n    const INITIAL_SHIFTS = [\n      { stt: 1, nv: \"LÊ ?NH\", kv: \"ALL KHU VỰC ICT\", pg: \"PG ICT\" },\n      { stt: 2, nv: \"HẠNH\", kv: \"TIVI 1,2,3, VÁCH SONY, VÁCH SS\", pg: \"OANH LG\" },\n      { stt: 3, nv: \"HÙNG MẠNH\", kv: \"TIVI 4,5, LOA, VÁCH LG\", pg: \"\" },\n      { stt: 4, nv: \"NHẠN\", kv: \"MÁY GIẶT 1,2,3\", pg: \"TRANG / -\" },\n      { stt: 5, nv: \"KIM MỸ\", kv: \"MÁY GIẶT 4,5,6\", pg: \"\" },\n      { stt: 6, nv: \"DIỄM MY\", kv: \"VÁCH ML, DÀN MƯỚP, TỦ ĐÔNG\", pg: \"-\" },\n      { stt: 7, nv: \"?NH\", kv: \"ALL VÁCH GD ÁP TƯỜNG, CHẢO, NỒI CHIÊN\", pg: \"PG KAROFI\" },\n      { stt: 8, nv: \"DUY\", kv: \"LỌC NƯỚC, GIA DỤNG 1\", pg: \"HI MUTOSHI\" },\n      { stt: 9, nv: \"Ý\", kv: \"GIA DỤNG 2,3\", pg: \"\" },\n      { stt: 10, nv: \"- MI\", kv: \"GIA DỤNG 4,5\", pg: \"BĂNG BLUE\" },\n      { stt: 11, nv: \"THẮM\", kv: \"GIA DỤNG 6,7\", pg: \"TRINH SUN\" },\n      { stt: 12, nv: \"THANH NHI\", kv: \"TỦ LẠNH 1,2\", pg: \"TÍN TCL\" },\n      { stt: 13, nv: \"PHÚC\", kv: \"TỦ LẠNH 3,4\", pg: \"ĐƯỢC\" },\n      { stt: 14, nv: \"ĐẠI\", kv: \"ALL VÁCH TỦ LẠNH\", pg: \"\" },\n      { stt: 15, nv: \"LINH + LÊN TĐKH\", kv: \"VÁCH KÍNH - SÂN XE - BANNER\", pg: \"\" }\n    ];\n\n    const state = {\n      clientId: 'client_' + Math.random().toString(36).substring(2, 9),\n      shifts: JSON.parse(localStorage.getItem('phancong_shifts_cached') || JSON.stringify(INITIAL_SHIFTS)),\n      employees: JSON.parse(localStorage.getItem('phancong_employees_cached') || '[]'),\n      attendanceMap: JSON.parse(localStorage.getItem('phancong_attendance_cached') || '{}'),\n      searchQuery: '',\n      activeTab: 'shiftsTab',\n      isSaving: false\n    };\n\n    // Khởi tạo danh sách nhân viên nếu chưa có\n    if (!state.employees || state.employees.length === 0) {\n      state.employees = INITIAL_EMPLOYEES.map((name, idx) => ({\n        stt: idx + 1,\n        name: name,\n        marked: name === \"Tuấn Aqua\" || name === \"Oanh LG\"\n      }));\n    }\n\n    // Thiết lập kênh BroadcastChannel đa cửa sổ\n    const broadcastChannel = window.BroadcastChannel ? new BroadcastChannel('phancong_1841_realtime') : null;\n\n    /* ==========================================================================\n       ĐỒNG BỒ REALTIME QUA MQTT WEBSOCKET & BROADCAST CHANNEL\n       ========================================================================== */\n    let mqttClient = null;\n\n    function initRealtimeSync() {\n      // 1. Kênh BroadcastChannel (0ms giữa các tab cùng trình duyệt)\n      if (broadcastChannel) {\n        broadcastChannel.onmessage = (event) => {\n          if (event && event.data && event.data.senderId !== state.clientId) {\n            handleRemoteMessage(event.data);\n          }\n        };\n      }\n\n      // 2. Kênh LocalStorage Event (đa cửa sổ)\n      window.addEventListener('storage', (e) => {\n        if (e.key === 'phancong_realtime_event' && e.newValue) {\n          try {\n            const data = JSON.parse(e.newValue);\n            if (data && data.senderId !== state.clientId) {\n              handleRemoteMessage(data);\n            }\n          } catch (err) {}\n        }\n      });\n\n      // 3. Kênh MQTT WebSocket (20ms - 50ms giữa mọi máy tính và điện thoại khác nhau)\n      try {\n        if (typeof mqtt !== 'undefined') {\n          mqttClient = mqtt.connect(DEFAULT_CONFIG.mqttBroker, {\n            clientId: 'pub_' + state.clientId,\n            clean: true,\n            connectTimeout: 4000,\n            reconnectPeriod: 3000\n          });\n\n          mqttClient.on('connect', () => {\n            document.getElementById('syncText').textContent = 'Realtime Live (Đã kết nối)';\n            mqttClient.subscribe(DEFAULT_CONFIG.mqttTopic);\n          });\n\n          mqttClient.on('message', (topic, payload) => {\n            if (topic === DEFAULT_CONFIG.mqttTopic) {\n              try {\n                const data = JSON.parse(payload.toString());\n                if (data && data.senderId !== state.clientId) {\n                  handleRemoteMessage(data);\n                }\n              } catch (e) {}\n            }\n          });\n        }\n      } catch (err) {\n        console.warn('MQTT init failed:', err);\n      }\n    }\n\n    function broadcastEvent(action, payload) {\n      const msg = {\n        action: action,\n        senderId: state.clientId,\n        timestamp: Date.now(),\n        data: payload\n      };\n      const str = JSON.stringify(msg);\n\n      if (broadcastChannel) {\n        try { broadcastChannel.postMessage(msg); } catch (e) {}\n      }\n      try {\n        localStorage.setItem('phancong_realtime_event', str);\n      } catch (e) {}\n\n      if (mqttClient && mqttClient.connected) {\n        try {\n          mqttClient.publish(DEFAULT_CONFIG.mqttTopic, str);\n        } catch (e) {}\n      }\n    }\n\n    function handleRemoteMessage(msg) {\n      if (!msg || !msg.action) return;\n      if (msg.action === 'updateShift') {\n        const item = msg.data;\n        const target = state.shifts.find(s => s.stt === item.stt);\n        if (target) {\n          target.nv = item.nv;\n          target.kv = item.kv;\n          target.pg = item.pg;\n          renderShifts();\n          renderFloorPlan();\n          renderEmployees();\n          showToast(`⚡ Trình duyệt khác vừa đổi Vị trí ${item.stt}: ${item.nv}`);\n        }\n      } else if (msg.action === 'toggleAttendance') {\n        const { stt, marked } = msg.data;\n        const emp = state.employees.find(e => e.stt === stt);\n        if (emp) {\n          emp.marked = marked;\n          renderEmployees();\n        }\n      } else if (msg.action === 'reloadAll') {\n        loadDataFromGoogleSheet();\n      }\n    }\n\n    /* ==========================================================================\n       LOAD DỮ LIỆU TỪ GOOGLE SHEETS QUA GVIZ API (SIÊU TỐC 0.2S)\n       ========================================================================== */\n    function loadDataFromGoogleSheet() {\n      const gvizUrl = `https://docs.google.com/spreadsheets/d/${DEFAULT_CONFIG.sheetId}/gviz/tq?tqx=out:json&_=${Date.now()}`;\n      \n      fetch(gvizUrl)\n        .then(res => res.text())\n        .then(text => {\n          const raw = text.substring(text.indexOf('{'), text.lastIndexOf('}') + 1);\n          const json = JSON.parse(raw);\n          parseGvizData(json);\n        })\n        .catch(err => {\n          console.warn('Load GViz failed, using cache:', err);\n          renderShifts();\n          renderFloorPlan();\n          renderEmployees();\n        });\n    }\n\n    function parseGvizData(json) {\n      if (!json || !json.table || !json.table.rows) return;\n      const rows = json.table.rows;\n\n      // 1. Phân tích 15 vị trí phân công (Dòng 17..31 => index 16..30)\n      const parsedShifts = [];\n      for (let r = 16; r <= 30; r++) {\n        if (r < rows.length) {\n          const row = rows[r];\n          const stt = row.c[22] ? parseInt(row.c[22].v, 10) : (r - 15);\n          const nv = row.c[23] ? String(row.c[23].v || '').trim() : '';\n          const kv = row.c[24] ? String(row.c[24].v || '').trim() : '';\n          const pg = row.c[25] ? String(row.c[25].v || '').trim() : '';\n          parsedShifts.push({ stt, nv, kv, pg });\n        }\n      }\n      if (parsedShifts.length > 0) {\n        state.shifts = parsedShifts;\n        localStorage.setItem('phancong_shifts_cached', JSON.stringify(state.shifts));\n      }\n\n      // 2. Phân tích danh sách 26 nhân viên (Dòng 1..26 => index 0..25)\n      const parsedEmployees = [];\n      for (let r = 0; r <= 25; r++) {\n        if (r < rows.length) {\n          const row = rows[r];\n          const name = row.c[29] ? String(row.c[29].v || '').trim() : '';\n          if (name) {\n            const stt = row.c[28] ? parseInt(row.c[28].v, 10) : (r + 1);\n            const mark = row.c[30] ? String(row.c[30].v || '').trim().toUpperCase() : '';\n            const isMarked = mark === 'X' || mark === 'TRUE' || mark === '1';\n            parsedEmployees.push({ stt, name, marked: isMarked });\n          }\n        }\n      }\n      if (parsedEmployees.length > 0) {\n        state.employees = parsedEmployees;\n        localStorage.setItem('phancong_employees_cached', JSON.stringify(state.employees));\n      }\n\n      renderShifts();\n      renderFloorPlan();\n      renderEmployees();\n      showToast('✅ Đã nạp dữ liệu mới nhất từ Google Sheet!');\n    }\n\n    /* ==========================================================================\n       LƯU DỮ LIỆU NGƯỢC VỀ GOOGLE SHEETS\n       ========================================================================== */\n    function saveShiftRowToSheet(stt, nv, kv, pg) {\n      if (!DEFAULT_CONFIG.webAppUrl) return;\n\n      const formData = new URLSearchParams();\n      formData.append('action', 'updateShift');\n      formData.append('stt', stt);\n      formData.append('nv', nv);\n      formData.append('kv', kv);\n      formData.append('pg', pg);\n      formData.append('sheetId', DEFAULT_CONFIG.sheetId);\n\n      fetch(DEFAULT_CONFIG.webAppUrl, {\n        method: 'POST',\n        mode: 'no-cors',\n        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\n        body: formData.toString()\n      }).catch(err => {\n        // Fallback GET\n        const url = `${DEFAULT_CONFIG.webAppUrl}?action=updateShift&stt=${stt}&nv=${encodeURIComponent(nv)}&kv=${encodeURIComponent(kv)}&pg=${encodeURIComponent(pg)}&_=${Date.now()}`;\n        const ping = new Image();\n        ping.src = url;\n      });\n    }\n\n    function saveAllShiftsToSheet() {\n      if (state.isSaving) return;\n      state.isSaving = true;\n      const btn = document.getElementById('btnSaveToSheetMain');\n      const textEl = document.getElementById('saveBtnMainText');\n      if (btn) btn.disabled = true;\n      if (textEl) textEl.textContent = 'Đang lưu...';\n\n      if (!DEFAULT_CONFIG.webAppUrl) {\n        showToast('⚠️ Vui lòng cài đặt URL Web App Google Apps Script trước!');\n        state.isSaving = false;\n        if (btn) btn.disabled = false;\n        if (textEl) textEl.textContent = 'Lưu Về Sheet';\n        document.getElementById('configModal').style.display = 'flex';\n        return;\n      }\n\n      const postData = {\n        action: 'updateAllShifts',\n        sheetId: DEFAULT_CONFIG.sheetId,\n        shifts: state.shifts\n      };\n\n      fetch(DEFAULT_CONFIG.webAppUrl, {\n        method: 'POST',\n        mode: 'no-cors',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(postData)\n      })\n      .then(() => {\n        state.isSaving = false;\n        if (btn) btn.disabled = false;\n        if (textEl) textEl.textContent = 'Lưu Về Sheet';\n        showToast('✅ Đã lưu toàn bộ 15 vị trí phân công về Google Sheet!');\n        broadcastEvent('reloadAll', {});\n      })\n      .catch(err => {\n        state.isSaving = false;\n        if (btn) btn.disabled = false;\n        if (textEl) textEl.textContent = 'Lưu Về Sheet';\n        showToast('❌ Lỗi khi gửi dữ liệu: ' + err.message);\n      });\n    }\n\n    function toggleAttendanceInSheet(stt, marked) {\n      if (!DEFAULT_CONFIG.webAppUrl) return;\n\n      const url = `${DEFAULT_CONFIG.webAppUrl}?action=toggleAttendance&stt=${stt}&marked=${marked ? 'X' : ''}&sheetId=${DEFAULT_CONFIG.sheetId}&_=${Date.now()}`;\n      const ping = new Image();\n      ping.src = url;\n    }\n\n    /* ==========================================================================\n       RENDER GIAO DIỆN (UI RENDERING)\n       ========================================================================== */\n    function renderShifts() {\n      const container = document.getElementById('shiftsGridContainer');\n      if (!container) return;\n\n      const q = (state.searchQuery || '').toLowerCase().trim();\n      const filtered = state.shifts.filter(item => {\n        if (!q) return true;\n        const str = `${item.stt} ${item.nv} ${item.kv} ${item.pg}`.toLowerCase();\n        return str.includes(q);\n      });\n\n      let assignedCount = 0;\n      state.shifts.forEach(s => { if (s.nv && s.nv.trim()) assignedCount++; });\n      document.getElementById('badgeShiftCount').textContent = `${assignedCount}/15 Vị trí`;\n\n      container.innerHTML = filtered.map(item => {\n        const isAssigned = item.nv && item.nv.trim() !== '';\n        return `\n          <div class=\"shift-card\" data-stt=\"${item.stt}\">\n            <div class=\"shift-header\">\n              <span class=\"shift-stt-badge\">\n                <i class=\"fa-solid fa-hashtag\"></i> Vị trí ${item.stt}\n              </span>\n              <span class=\"shift-status-tag ${isAssigned ? 'status-assigned' : 'status-empty'}\">\n                ${isAssigned ? '✓ Đã phân công' : '⚠ Chưa phân công'}\n              </span>\n            </div>\n\n            <div class=\"shift-field-group\">\n              <label class=\"field-label\"><i class=\"fa-solid fa-user-tag\"></i> Nhân viên trực</label>\n              <select class=\"field-select select-assign-emp\" data-stt=\"${item.stt}\">\n                <option value=\"\">-- Chọn nhân viên siêu thị --</option>\n                ${state.employees.map(e => `\n                  <option value=\"${escapeHtml(e.name)}\" ${item.nv === e.name ? 'selected' : ''}>\n                    ${e.stt}. ${escapeHtml(e.name)}\n                  </option>\n                `).join('')}\n                ${!state.employees.some(e => e.name === item.nv) && item.nv ? `\n                  <option value=\"${escapeHtml(item.nv)}\" selected>${escapeHtml(item.nv)} (Tùy chỉnh)</option>\n                ` : ''}\n              </select>\n            </div>\n\n            <div class=\"shift-field-group\">\n              <label class=\"field-label\"><i class=\"fa-solid fa-location-dot\"></i> Khu vực phụ trách</label>\n              <input type=\"text\" class=\"field-input input-kv\" data-stt=\"${item.stt}\" value=\"${escapeHtml(item.kv)}\" placeholder=\"Nhập khu vực...\">\n            </div>\n\n            <div class=\"shift-field-group\">\n              <label class=\"field-label\"><i class=\"fa-solid fa-handshake-angle\"></i> PG Hỗ trợ</label>\n              <input type=\"text\" class=\"field-input input-pg\" data-stt=\"${item.stt}\" value=\"${escapeHtml(item.pg)}\" placeholder=\"PG hãng...\">\n            </div>\n\n            <div class=\"shift-card-footer\">\n              <span>Hàng Google Sheet: ${item.stt + 16}</span>\n              <span style=\"color:#8b5cf6; font-weight:700;\"><i class=\"fa-solid fa-bolt\"></i> Auto Lưu</span>\n            </div>\n          </div>\n        `;\n      }).join('');\n\n      // Gắn sự kiện thay đổi\n      container.querySelectorAll('.select-assign-emp').forEach(el => {\n        el.addEventListener('change', (e) => {\n          const stt = parseInt(e.target.dataset.stt, 10);\n          const shift = state.shifts.find(s => s.stt === stt);\n          if (shift) {\n            shift.nv = e.target.value;\n            localStorage.setItem('phancong_shifts_cached', JSON.stringify(state.shifts));\n            saveShiftRowToSheet(shift.stt, shift.nv, shift.kv, shift.pg);\n            broadcastEvent('updateShift', shift);\n            renderFloorPlan();\n            renderEmployees();\n            showToast(`✅ Đã gán vị trí ${stt}: ${shift.nv || 'Trống'}`);\n          }\n        });\n      });\n\n      container.querySelectorAll('.input-kv').forEach(el => {\n        el.addEventListener('change', (e) => {\n          const stt = parseInt(e.target.dataset.stt, 10);\n          const shift = state.shifts.find(s => s.stt === stt);\n          if (shift) {\n            shift.kv = e.target.value.trim();\n            localStorage.setItem('phancong_shifts_cached', JSON.stringify(state.shifts));\n            saveShiftRowToSheet(shift.stt, shift.nv, shift.kv, shift.pg);\n            broadcastEvent('updateShift', shift);\n            renderFloorPlan();\n          }\n        });\n      });\n\n      container.querySelectorAll('.input-pg').forEach(el => {\n        el.addEventListener('change', (e) => {\n          const stt = parseInt(e.target.dataset.stt, 10);\n          const shift = state.shifts.find(s => s.stt === stt);\n          if (shift) {\n            shift.pg = e.target.value.trim();\n            localStorage.setItem('phancong_shifts_cached', JSON.stringify(state.shifts));\n            saveShiftRowToSheet(shift.stt, shift.nv, shift.kv, shift.pg);\n            broadcastEvent('updateShift', shift);\n          }\n        });\n      });\n    }\n\n    function renderFloorPlan() {\n      // Cập nhật tên nhân viên lên từng phân khu trên sơ đồ\n      function getAssignee(stt) {\n        const item = state.shifts.find(s => s.stt === stt);\n        if (!item || !item.nv) return 'Chưa phân công';\n        return `${item.nv}${item.pg ? ' • ' + item.pg : ''}`;\n      }\n\n      const mapEl = {\n        assign_vach_kinh: getAssignee(15),\n        assign_san_xe: getAssignee(15),\n        assign_ict_1: getAssignee(1),\n        assign_tivi_1: getAssignee(2),\n        assign_tivi_2: getAssignee(3),\n        assign_may_lanh: getAssignee(6),\n        assign_giat_1: getAssignee(4),\n        assign_giat_2: getAssignee(5),\n        assign_loc_nuoc: getAssignee(8),\n        assign_lanh_1: getAssignee(12),\n        assign_lanh_2: getAssignee(13),\n        assign_vach_lanh: getAssignee(14)\n      };\n\n      for (const id in mapEl) {\n        const el = document.getElementById(id);\n        if (el) el.textContent = mapEl[id];\n      }\n\n      // Gắn sự kiện click vào khu vực trên sơ đồ\n      document.querySelectorAll('.zone-box').forEach(box => {\n        box.onclick = () => {\n          document.querySelectorAll('.zone-box').forEach(b => b.classList.remove('highlight'));\n          box.classList.add('highlight');\n          const zoneName = box.dataset.zone || box.querySelector('.zone-name').textContent;\n          const assignee = box.querySelector('.zone-assignee') ? box.querySelector('.zone-assignee').textContent : '';\n          showToast(`📍 ${zoneName} ➜ Phụ trách: ${assignee || 'Khu vực chung'}`);\n        };\n      });\n    }\n\n    function renderEmployees() {\n      const container = document.getElementById('empListContainer');\n      if (!container) return;\n\n      const q = (state.searchQuery || '').toLowerCase().trim();\n      const filtered = state.employees.filter(e => {\n        if (!q) return true;\n        return `${e.stt} ${e.name}`.toLowerCase().includes(q);\n      });\n\n      let presentCount = 0;\n      state.employees.forEach(e => { if (e.marked) presentCount++; });\n      document.getElementById('statTotalEmployees').textContent = state.employees.length;\n      document.getElementById('statPresentCount').textContent = presentCount;\n\n      container.innerHTML = filtered.map(emp => {\n        // Tìm xem nhân viên này đang trực vị trí nào\n        const assignedShift = state.shifts.find(s => s.nv && s.nv.toLowerCase().includes(emp.name.toLowerCase()));\n        return `\n          <div class=\"emp-item-card ${emp.marked ? 'is-active' : ''}\">\n            <div class=\"emp-info\">\n              <span class=\"emp-stt\">${emp.stt}</span>\n              <div>\n                <div class=\"emp-name\">${escapeHtml(emp.name)}</div>\n                ${assignedShift ? `\n                  <span class=\"emp-assign-tag\">\n                    <i class=\"fa-solid fa-thumbtack\"></i> Vị trí ${assignedShift.stt}: ${escapeHtml(assignedShift.kv)}\n                  </span>\n                ` : `\n                  <span style=\"font-size:11px; color:#9ca3af;\">Chưa gán vị trí</span>\n                `}\n              </div>\n            </div>\n\n            <button type=\"button\" class=\"btn-toggle-att ${emp.marked ? 'att-active' : 'att-inactive'}\" data-stt=\"${emp.stt}\">\n              ${emp.marked ? '✓ Có mặt' : '○ Vắng'}\n            </button>\n          </div>\n        `;\n      }).join('');\n\n      // Gắn sự kiện điểm danh\n      container.querySelectorAll('.btn-toggle-att').forEach(btn => {\n        btn.addEventListener('click', (e) => {\n          const stt = parseInt(btn.dataset.stt, 10);\n          const emp = state.employees.find(x => x.stt === stt);\n          if (emp) {\n            emp.marked = !emp.marked;\n            localStorage.setItem('phancong_employees_cached', JSON.stringify(state.employees));\n            toggleAttendanceInSheet(emp.stt, emp.marked);\n            broadcastEvent('toggleAttendance', { stt: emp.stt, marked: emp.marked });\n            renderEmployees();\n            showToast(`${emp.marked ? '✅' : '⚪'} Điểm danh: ${emp.name} ➜ ${emp.marked ? 'Có mặt' : 'Vắng'}`);\n          }\n        });\n      });\n    }\n\n    /* ==========================================================================\n       TIỆN ÍCH & EVENT LISTENERS\n       ========================================================================== */\n    function showToast(msg) {\n      const toast = document.getElementById('toastBox');\n      const text = document.getElementById('toastMsg');\n      if (!toast || !text) return;\n      text.textContent = msg;\n      toast.style.display = 'flex';\n      clearTimeout(window._toastTimer);\n      window._toastTimer = setTimeout(() => {\n        toast.style.display = 'none';\n      }, 3500);\n    }\n\n    function escapeHtml(text) {\n      if (!text) return '';\n      return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n    }\n\n    // Khởi chạy khi tài liệu sẵn sàng\n    document.addEventListener('DOMContentLoaded', () => {\n      // 1. Đồng hồ thời gian thực\n      function updateClock() {\n        const el = document.getElementById('clockDisplay');\n        if (!el) return;\n        const now = new Date();\n        const pad = n => (n < 10 ? '0' + n : n);\n        el.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())} ${pad(now.getDate())}/${pad(now.getMonth() + 1)}/${now.getFullYear()}`;\n      }\n      setInterval(updateClock, 1000);\n      updateClock();\n\n      // 2. Chuyển đổi Tabs\n      document.querySelectorAll('.tab-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n          document.querySelectorAll('.tab-content-panel').forEach(p => p.style.display = 'none');\n          btn.classList.add('active');\n          const targetTab = document.getElementById(btn.dataset.tab);\n          if (targetTab) targetTab.style.display = 'block';\n          state.activeTab = btn.dataset.tab;\n        });\n      });\n\n      // 3. Tìm kiếm\n      const searchInput = document.getElementById('searchInput');\n      if (searchInput) {\n        searchInput.addEventListener('input', (e) => {\n          state.searchQuery = e.target.value;\n          renderShifts();\n          renderEmployees();\n        });\n      }\n\n      // 4. Nút Lưu về Google Sheet\n      const btnSaveMain = document.getElementById('btnSaveToSheetMain');\n      if (btnSaveMain) {\n        btnSaveMain.addEventListener('click', saveAllShiftsToSheet);\n      }\n\n      // 5. Nút Làm Mới Trang\n      const btnReload = document.getElementById('btnReloadPage');\n      if (btnReload) {\n        btnReload.addEventListener('click', () => {\n          btnReload.querySelector('i').style.transition = 'transform 0.4s ease';\n          btnReload.querySelector('i').style.transform = 'rotate(360deg)';\n          setTimeout(() => {\n            window.location.reload();\n          }, 150);\n        });\n      }\n\n      // 6. Nút Xuất file ảnh HD\n      const btnExport = document.getElementById('btnExportImage');\n      if (btnExport) {\n        btnExport.addEventListener('click', () => {\n          showToast('📸 Đang tạo file ảnh phân ca HD...');\n          let targetEl = document.getElementById('appMainContainer');\n          if (state.activeTab === 'floorMapTab') {\n            targetEl = document.getElementById('floorPlanExportTarget');\n          }\n          if (typeof html2canvas !== 'undefined') {\n            html2canvas(targetEl, {\n              scale: 2,\n              useCORS: true,\n              backgroundColor: '#f5f3ff'\n            }).then(canvas => {\n              const link = document.createElement('a');\n              link.download = `PhanCong_VeSinh_1841_${Date.now()}.png`;\n              link.href = canvas.toDataURL('image/png');\n              link.click();\n              showToast('✅ Đã xuất và tải file ảnh HD thành công!');\n            }).catch(e => {\n              showToast('❌ Lỗi khi xuất ảnh: ' + e.message);\n            });\n          }\n        });\n      }\n\n      // 7. Modal cài đặt\n      const modal = document.getElementById('configModal');\n      const btnOpenCfg = document.getElementById('btnOpenConfigModal');\n      const btnCloseCfg = document.getElementById('btnCloseConfigModal');\n      const btnSaveCfg = document.getElementById('btnSaveConfig');\n\n      if (btnOpenCfg) btnOpenCfg.onclick = () => modal.style.display = 'flex';\n      if (btnCloseCfg) btnCloseCfg.onclick = () => modal.style.display = 'none';\n      if (btnSaveCfg) {\n        btnSaveCfg.onclick = () => {\n          const url = document.getElementById('cfgWebAppUrl').value.trim();\n          DEFAULT_CONFIG.webAppUrl = url;\n          localStorage.setItem('phancong_webapp_url', url);\n          modal.style.display = 'none';\n          showToast('✅ Đã lưu cấu hình kết nối Web App!');\n        };\n      }\n\n      // 8. Khởi tạo dữ liệu ban đầu\n      renderShifts();\n      renderFloorPlan();\n      renderEmployees();\n      initRealtimeSync();\n      loadDataFromGoogleSheet();\n    });\n  </script>\n</body>\n</html>\n";
