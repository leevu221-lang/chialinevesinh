     background: #10b981;\n      box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);\n      animation: pulseDot 1.8s infinite;\n    }\n\n    @keyframes pulseDot {\n      0%, 100% { transform: scale(1); opacity: 1; }\n      50% { transform: scale(1.3); opacity: 0.7; }\n    }\n\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 7px;\n      padding: 8px 14px;\n      border-radius: var(--radius-md);\n      font-family: var(--font-sans);\n      font-size: 13px;\n      font-weight: 600;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      border: none;\n      outline: none;\n      text-decoration: none;\n    }\n\n    .btn-primary {\n      background: var(--primary-gradient);\n      color: white;\n      box-shadow: 0 3px 10px rgba(217, 119, 6, 0.28);\n    }\n    .btn-primary:hover {\n      background: linear-gradient(135deg, #d97706 0%, #b45309 100%);\n      transform: translateY(-1px);\n      box-shadow: 0 5px 14px rgba(217, 119, 6, 0.35);\n    }\n\n    .btn-secondary {\n      background: #ffffff;\n      color: var(--text-main);\n      border: 1px solid var(--primary-border);\n    }\n    .btn-secondary:hover {\n      background: var(--primary-subtle);\n      border-color: #f59e0b;\n      color: var(--primary-dark);\n    }\n\n    .btn-icon {\n      width: 38px;\n      height: 38px;\n      padding: 0;\n      border-radius: var(--radius-md);\n      background: #ffffff;\n      border: 1px solid var(--primary-border);\n      color: var(--text-muted);\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      transition: all 0.2s ease;\n    }\n    .btn-icon:hover {\n      background: var(--primary-subtle);\n      color: var(--primary-dark);\n      border-color: #f59e0b;\n    }\n    .btn-icon.spinning {\n      background: #fef3c7 !important;\n      border-color: #f59e0b !important;\n      color: #92400e !important;\n      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25) !important;\n      pointer-events: none;\n    }\n    .btn-icon.spinning i {\n      display: inline-block;\n      animation: spinReload 0.7s cubic-bezier(0.4, 0, 0.2, 1) infinite;\n      color: #b45309 !important;\n    }\n    @keyframes spinReload {\n      from { transform: rotate(0deg); }\n      to { transform: rotate(360deg); }\n    }\n\n    /* NAVIGATION TABS & SEARCH */\n    .nav-toolbar {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      margin-bottom: 16px;\n      width: 100%;\n      max-width: 100%;\n      box-sizing: border-box;\n    }\n    @media (min-width: 960px) {\n      .nav-toolbar {\n        flex-direction: row;\n        align-items: center;\n        justify-content: space-between;\n      }\n    }\n\n    .nav-tabs {\n      display: flex;\n      background: rgba(255, 255, 255, 0.95);\n      border: 1.5px solid var(--primary-border);\n      padding: 5px;\n      border-radius: var(--radius-lg);\n      gap: 6px;\n      box-shadow: 0 2px 6px rgba(217, 119, 6, 0.04);\n      overflow-x: auto;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n      flex-wrap: nowrap;\n      max-width: 100%;\n      box-sizing: border-box;\n    }\n    .nav-tabs::-webkit-scrollbar {\n      display: none;\n    }\n\n    .nav-tab-btn {\n      padding: 8px 14px;\n      border-radius: var(--radius-md);\n      border: none;\n      background: transparent;\n      color: var(--text-muted);\n      font-size: 13px;\n      font-weight: 700;\n      cursor: pointer;\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      transition: all 0.2s ease;\n      white-space: nowrap !important;\n      flex-shrink: 0 !important;\n    }\n    .nav-tab-btn:hover {\n      color: var(--primary-dark);\n      background: var(--primary-subtle);\n    }\n    .nav-tab-btn.active {\n      background: var(--primary-gradient);\n      color: white;\n      box-shadow: 0 2px 8px rgba(217, 119, 6, 0.28);\n    }\n    .nav-tab-btn .tab-badge {\n      padding: 1px 7px;\n      border-radius: 12px;\n      font-size: 11px;\n      background: rgba(255, 255, 255, 0.25);\n    }\n    .nav-tab-btn:not(.active) .tab-badge {\n      background: var(--primary-light);\n      color: var(--primary-dark);\n    }\n\n    .search-box-wrap {\n      position: relative;\n      width: 100%;\n      max-width: 100%;\n      box-sizing: border-box;\n    }\n    @media (min-width: 960px) {\n      .search-box-wrap {\n        max-width: 380px;\n        min-width: 260px;\n      }\n    }\n    .search-box-wrap i {\n      position: absolute;\n      left: 12px;\n      top: 50%;\n      transform: translateY(-50%);\n      color: #b45309;\n      font-size: 14px;\n    }\n    .search-input {\n      width: 100%;\n      padding: 8px 12px 8px 36px;\n      border-radius: var(--radius-lg);\n      border: 1.5px solid var(--primary-border);\n      background: #ffffff;\n      font-family: var(--font-sans);\n      font-size: 13px;\n      color: var(--text-main);\n      outline: none;\n      transition: all 0.2s ease;\n    }\n    .search-input:focus {\n      border-color: #d97706;\n      box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.15);\n    }\n\n    /* FLOOR MAP CONTAINER */\n    .tab-content {\n      display: none;\n    }\n    .tab-content.active {\n      display: block;\n      animation: fadeIn 0.25s ease;\n    }\n    @keyframes fadeIn {\n      from { opacity: 0; transform: translateY(4px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n\n    /* S\u01a0 \u0110\u1ed2 M\u1eb6T B\u1eb0NG CHU\u1ea8N H\u00ccNH M\u1eaaU */\n    .floorplan-card {\n      background: #ffffff;\n      border: 1.5px solid var(--primary-border);\n      border-radius: var(--radius-xl);\n      padding: 16px;\n      box-shadow: var(--card-shadow);\n      margin-bottom: 20px;\n      width: 100%;\n      max-width: 100%;\n      box-sizing: border-box;\n      overflow: hidden; /* C\u1eaeT \u0110\u1ee8T HO\u00c0N TO\u00c0N M\u1eccI TR\u00c0N VI\u1ec0N */\n      position: relative;\n    }\n\n    .floorplan-header-strip {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 12px;\n      gap: 12px;\n      flex-wrap: wrap;\n    }\n    .floorplan-legend {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      flex-wrap: wrap;\n      font-size: 12px;\n      font-weight: 600;\n    }\n    .legend-item {\n      display: inline-flex;\n      align-items: center;\n      gap: 5px;\n    }\n    .legend-box {\n      width: 14px;\n      height: 14px;\n      border-radius: 4px;\n      border: 1px solid rgba(0,0,0,0.1);\n    }\n\n    /* KHUNG CU\u1ed8N C\u00c1CH BI\u1ec6T CHO S\u01a0 \u0110\u1ed2 - GI\u1eee VI\u1ec0N B\u00caN NGO\u00c0I KH\u00d4NG BAO GI\u1edc B\u1eca TR\u00c0N */\n    .floorplan-scroll-viewport {\n      width: 100%;\n      max-width: 100%;\n      overflow-x: auto;\n      overflow-y: hidden;\n      -webkit-overflow-scrolling: touch;\n      border-radius: var(--radius-lg);\n      border: 1.5px solid #fde047;\n      background: #fefce8;\n      box-sizing: border-box;\n      padding: 2px;\n      position: relative;\n      touch-action: pan-x pan-y pinch-zoom;\n    }\n\n    /* KHUNG B\u1eccC THU PH\u00d3NG (ZOOM WRAPPER) \u0110\u1ec2 AUTO ZOOM V\u1eeaA M\u00c0N H\u00ccNH MOBILE */\n    .floorplan-zoom-wrapper {\n      transform-origin: 0 0;\n      transition: transform 0.22s cubic-bezier(0.2, 0.9, 0.4, 1), width 0.22s ease, height 0.22s ease;\n      display: inline-block;\n      vertical-align: top;\n      will-change: transform;\n    }\n\n    /* THANH \u0110I\u1ec0U KHI\u1ec2N THU PH\u00d3NG (ZOOM & FIT VIEWPORT) */\n    .floorplan-zoom-toolbar {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      background: #fffbeb;\n      border: 1.5px solid #fde68a;\n      border-radius: var(--radius-md);\n      padding: 6px 12px;\n      margin-bottom: 8px;\n      gap: 10px;\n      flex-wrap: wrap;\n      user-select: none;\n      -webkit-user-select: none;\n    }\n    .zoom-toolbar-left, .zoom-toolbar-right {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .zoom-mode-badge {\n      font-size: 11.5px;\n      font-weight: 700;\n      color: #92400e;\n      margin-right: 2px;\n    }\n    .btn-zoom-mode {\n      display: inline-flex;\n      align-items: center;\n      gap: 5px;\n      padding: 5px 11px;\n      border-radius: 14px;\n      border: 1px solid #fcd34d;\n      background: #ffffff;\n      font-family: var(--font-sans);\n      font-size: 11.5px;\n      font-weight: 700;\n      color: #78350f;\n      cursor: pointer;\n      transition: all 0.18s ease;\n      white-space: nowrap;\n    }\n    .btn-zoom-mode:hover {\n      background: #fef3c7;\n      border-color: #f59e0b;\n      color: #92400e;\n    }\n    .btn-zoom-mode.active {\n      background: var(--primary-gradient) !important;\n      color: #ffffff !important;\n      border-color: #d97706 !important;\n      box-shadow: 0 2px 6px rgba(217, 119, 6, 0.25) !important;\n    }\n    .btn-zoom-mode.active i {\n      color: #ffffff !important;\n    }\n    .btn-zoom-step {\n      width: 28px;\n      height: 28px;\n      border-radius: 50%;\n      border: 1px solid #fde68a;\n      background: #ffffff;\n      color: #92400e;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 12px;\n      cursor: pointer;\n      transition: all 0.18s ease;\n    }\n    .btn-zoom-step:hover {\n      background: #fef3c7;\n      border-color: #f59e0b;\n      transform: scale(1.06);\n    }\n    .zoom-level-text {\n      font-size: 11.5px;\n      font-weight: 800;\n      color: #b45309;\n      min-width: 62px;\n      text-align: center;\n      font-family: var(--font-mono, monospace);\n    }\n\n    /* GRID M\u1eb6T B\u1eb0NG */\n    .store-layout-grid {\n      display: grid;\n      grid-template-columns: 140px 1.4fr 1.6fr 2.8fr;\n      gap: 10px;\n      min-width: 1100px;\n      width: max-content;\n      padding: 10px;\n      box-sizing: border-box;\n      border: none;\n      background: transparent;\n    }\n\n    /* C\u1ed8T \u0110\u1ec8NH (TOP BANNER) */\n    .top-barrier-row {\n      grid-column: 1 / -1;\n      display: grid;\n      grid-template-columns: 100px 1fr 1fr 1fr 120px;\n      gap: 8px;\n      margin-bottom: 4px;\n    }\n\n    /* MAP CELL STYLES */\n    .map-cell {\n      border-radius: var(--radius-sm);\n      padding: 6px 8px;\n      font-size: 11.5px;\n      font-weight: 700;\n      text-align: center;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      transition: all 0.18s ease;\n      cursor: pointer;\n      user-select: none;\n      -webkit-user-select: none;\n      touch-action: manipulation;\n      min-height: 38px;\n      line-height: 1.25;\n      border: 1px solid transparent;\n      position: relative;\n    }\n    .map-cell * {\n      user-select: none;\n      -webkit-user-select: none;\n      pointer-events: none;\n    }\n    .map-cell:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 4px 10px rgba(0,0,0,0.12);\n      filter: brightness(1.02);\n      z-index: 5;\n    }\n    .map-cell.highlight-target {\n      outline: 2.5px solid #d97706 !important;\n      animation: pulseHighlight 1s infinite alternate;\n      z-index: 10;\n    }\n    @keyframes pulseHighlight {\n      from { box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.7); }\n      to { box-shadow: 0 0 0 8px rgba(217, 119, 6, 0); }\n    }\n\n    .cell-title {\n      font-weight: 800;\n      letter-spacing: -0.15px;\n      line-height: 1.22;\n      word-break: break-word;\n    }\n    .cell-staff {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 10px;\n      font-weight: 800;\n      margin-top: 3px;\n      padding: 1.5px 6px;\n      border-radius: 5px;\n      background: rgba(255, 255, 255, 0.92);\n      color: #1e293b;\n      border: 1px solid rgba(0, 0, 0, 0.12);\n      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);\n      white-space: nowrap;\n      max-width: 96%;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      letter-spacing: -0.1px;\n      transition: all 0.18s ease;\n      line-height: 1.25;\n    }\n    .map-cell:hover .cell-staff {\n      background: #ffffff;\n      border-color: #d97706;\n      color: #92400e;\n      box-shadow: 0 2px 5px rgba(217, 119, 6, 0.2);\n    }\n\n    /* M\u00c0U S\u1eaeC PH\u00c2N KHU CHU\u1ea8N THEO \u1ea2NH */\n    .bg-green-wall {\n      background: #dcfce7;\n      border-color: #86efac;\n      color: #166534;\n    }\n    .bg-door-red {\n      background: #fee2e2;\n      border-color: #fca5a5;\n      color: #991b1b;\n      font-weight: 800;\n    }\n    .bg-storage-red {\n      background: #ffe4e6;\n      border-color: #fda4af;\n      color: #9f1239;\n    }\n    .bg-yellow-ict {\n      background: #fef08a;\n      border-color: #eab308;\n      color: #854d0e;\n    }\n    .bg-yellow-dark {\n      background: #facc15;\n      border-color: #ca8a04;\n      color: #713f12;\n      font-weight: 800;\n    }\n    .bg-orange-fridge {\n      background: #ffedd5;\n      border-color: #fdba74;\n      color: #9a3412;\n    }\n    .bg-purple-fridge {\n      background: #f3e8ff;\n      border-color: #d8b4fe;\n      color: #6b21a8;\n    }\n    .bg-blue-wash {\n      background: #dbeafe;\n      border-color: #93c5fd;\n      color: #1e40af;\n    }\n    .bg-cream-appliance {\n      background: #fffbeb;\n      border-color: #fde68a;\n      color: #78350f;\n    }\n    .bg-pink-service {\n      background: #ffe4e6;\n      border-color: #fca5a5;\n      color: #9f1239;\n    }\n    .bg-gray-divider {\n      background: #f5f5f4;\n      border-color: #d6d3d1;\n      color: #44403c;\n    }\n\n    /* B\u1ea2NG V\u1eacN H\u00c0NH */\n    .van-hanh-box {\n      grid-column: 6;\n      grid-row: 1 / 8;\n      background: #fffbeb;\n      border: 2px solid #f59e0b;\n      border-radius: var(--radius-md);\n      padding: 10px 12px;\n      font-size: 11px;\n      line-height: 1.45;\n      color: #78350f;\n      box-shadow: 0 2px 8px rgba(217, 119, 6, 0.1);\n    }\n    .van-hanh-title {\n      font-size: 14px;\n      font-weight: 900;\n      color: #b45309;\n      text-align: center;\n      margin-bottom: 6px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      border-bottom: 1.5px solid #fde68a;\n      padding-bottom: 4px;\n    }\n    .van-hanh-content {\n      color: #991b1b;\n      font-weight: 600;\n    }\n    .van-hanh-content p {\n      margin-bottom: 4px;\n    }\n    .van-hanh-rules {\n      color: #78350f;\n      margin-top: 4px;\n      padding-left: 14px;\n    }\n\n    /* KH\u1ed0I ICT GRID B\u00caN D\u01af\u1edaI */\n    .ict-subgrid {\n      display: grid;\n      grid-template-columns: repeat(9, 1fr);\n      gap: 6px;\n      margin-top: 6px;\n    }\n\n    /* CARDS VIEW (TAB 2) */\n    .shifts-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));\n      gap: 16px;\n    }\n\n    .shift-card {\n      background: #ffffff;\n      border: 1.5px solid var(--primary-border);\n      border-radius: var(--radius-lg);\n      padding: 16px;\n      box-shadow: var(--card-shadow);\n      transition: all 0.22s ease;\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .shift-card:hover {\n      border-color: #f59e0b;\n      box-shadow: var(--card-shadow-hover);\n      transform: translateY(-2px);\n    }\n    .shift-card-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px dashed var(--primary-border);\n      padding-bottom: 8px;\n    }\n    .shift-stt-badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 5px;\n      padding: 3px 10px;\n      border-radius: 20px;\n      background: var(--primary-light);\n      color: var(--primary-dark);\n      font-size: 12px;\n      font-weight: 800;\n      border: 1px solid var(--primary-border);\n    }\n    .shift-status-tag {\n      font-size: 11px;\n      font-weight: 700;\n      padding: 3px 9px;\n      border-radius: 12px;\n    }\n    .shift-status-tag.assigned {\n      background: #dcfce7;\n      color: #166534;\n      border: 1px solid #86efac;\n    }\n    .shift-status-tag.empty {\n      background: #fee2e2;\n      color: #991b1b;\n      border: 1px solid #fca5a5;\n    }\n\n    .shift-field-group {\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n    }\n    .shift-field-label {\n      font-size: 11.5px;\n      font-weight: 700;\n      color: var(--text-muted);\n      text-transform: uppercase;\n      letter-spacing: 0.3px;\n      display: flex;\n      align-items: center;\n      gap: 5px;\n    }\n    .shift-field-select, .shift-field-input {\n      width: 100%;\n      padding: 8px 10px;\n      border-radius: var(--radius-sm);\n      border: 1px solid #e7e5e4;\n      background: #fafaf9;\n      font-family: var(--font-sans);\n      font-size: 13px;\n      font-weight: 600;\n      color: var(--text-main);\n      outline: none;\n      transition: all 0.2s ease;\n    }\n    .shift-field-select:focus, .shift-field-input:focus {\n      border-color: #d97706;\n      background: #ffffff;\n      box-shadow: 0 0 0 2px rgba(217, 119, 6, 0.15);\n    }\n\n    /* EMPLOYEES LIST (TAB 3) */\n    .employees-stats-row {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n      gap: 12px;\n      margin-bottom: 16px;\n    }\n    .stat-card {\n      background: #ffffff;\n      border: 1.5px solid var(--primary-border);\n      border-radius: var(--radius-md);\n      padding: 14px 18px;\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      box-shadow: var(--card-shadow);\n    }\n    .stat-icon {\n      width: 44px;\n      height: 44px;\n      border-radius: 12px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 20px;\n      color: white;\n    }\n    .stat-value {\n      font-size: 22px;\n      font-weight: 800;\n      color: var(--text-main);\n      line-height: 1;\n    }\n    .stat-label {\n      font-size: 12px;\n      color: var(--text-muted);\n      font-weight: 600;\n      margin-top: 3px;\n    }\n\n    .employees-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n      gap: 12px;\n    }\n    .employee-card {\n      background: #ffffff;\n      border: 1.5px solid #fef08a;\n      border-radius: var(--radius-md);\n      padding: 12px 14px;\n      box-shadow: var(--card-shadow);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 10px;\n      transition: all 0.2s ease;\n    }\n    .employee-card:hover {\n      border-color: #f59e0b;\n      transform: translateY(-1px);\n    }\n    .employee-card.present {\n      background: #f0fdf4;\n      border-color: #86efac;\n    }\n    .emp-info {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n    .emp-stt {\n      width: 28px;\n      height: 28px;\n      border-radius: 50%;\n      background: var(--primary-light);\n      color: var(--primary-dark);\n      font-size: 12px;\n      font-weight: 800;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .emp-name {\n      font-size: 13.5px;\n      font-weight: 700;\n      color: var(--text-main);\n    }\n    .btn-toggle-attend {\n      padding: 5px 10px;\n      border-radius: 20px;\n      font-size: 11px;\n      font-weight: 700;\n      cursor: pointer;\n      border: 1px solid transparent;\n      transition: all 0.2s ease;\n    }\n    .btn-toggle-attend.checked {\n      background: #dcfce7;\n      color: #166534;\n      border-color: #86efac;\n    }\n    .btn-toggle-attend.unchecked {\n      background: #f5f5f4;\n      color: #78716c;\n      border-color: #e7e5e4;\n    }\n\n\n\n    /* B\u1ed0 C\u1ee4C 2 C\u1ed8T: NH\u00c2N VI\u00caN B\u00caN TR\u00c1I, PG B\u00caN PH\u1ea2I */\n    .employees-dual-columns {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 16px;\n      margin-top: 14px;\n      align-items: start;\n    }\n    @media (max-width: 980px) {\n      .employees-dual-columns {\n        grid-template-columns: 1fr;\n      }\n    }\n    .emp-column-panel {\n      background: #ffffff;\n      border: 1.5px solid #fef08a;\n      border-radius: var(--radius-lg);\n      padding: 16px;\n      box-shadow: var(--card-shadow);\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    .emp-column-panel.panel-staff {\n      border-color: #bae6fd;\n      background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 65px);\n    }\n    .emp-column-panel.panel-pg {\n      border-color: #fbcfe8;\n      background: linear-gradient(180deg, #fdf2f8 0%, #ffffff 65px);\n    }\n    .emp-column-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding-bottom: 12px;\n      border-bottom: 1.5px solid #f1f5f9;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n    .emp-column-title-wrap {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n    .emp-column-icon {\n      width: 36px;\n      height: 36px;\n      border-radius: 9px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 16px;\n    }\n    .emp-column-icon.staff {\n      background: #0284c7;\n      color: #ffffff;\n      box-shadow: 0 2px 8px rgba(2, 132, 199, 0.25);\n    }\n    .emp-column-icon.pg {\n      background: #db2777;\n      color: #ffffff;\n      box-shadow: 0 2px 8px rgba(219, 39, 119, 0.25);\n    }\n    .emp-column-title {\n      font-size: 14.5px;\n      font-weight: 800;\n      letter-spacing: 0.3px;\n    }\n    .emp-column-panel.panel-staff .emp-column-title {\n      color: #0369a1;\n    }\n    .emp-column-panel.panel-pg .emp-column-title {\n      color: #be185d;\n    }\n    .emp-column-badge {\n      display: inline-block;\n      padding: 2px 8px;\n      border-radius: 12px;\n      font-size: 11.5px;\n      font-weight: 700;\n      margin-left: 6px;\n    }\n    .emp-column-panel.panel-staff .emp-column-badge {\n      background: #e0f2fe;\n      color: #0369a1;\n      border: 1px solid #bae6fd;\n    }\n    .emp-column-panel.panel-pg .emp-column-badge {\n      background: #fce7f3;\n      color: #be185d;\n      border: 1px solid #fbcfe8;\n    }\n    .btn-quick-add-column {\n      padding: 5px 12px;\n      border-radius: 20px;\n      font-size: 12px;\n      font-weight: 700;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      gap: 5px;\n      border: 1.5px solid transparent;\n      transition: all 0.2s ease;\n    }\n    .btn-quick-add-column.staff {\n      background: #e0f2fe;\n      color: #0284c7;\n      border-color: #bae6fd;\n    }\n    .btn-quick-add-column.staff:hover {\n      background: #0284c7;\n      color: #ffffff;\n      border-color: #0284c7;\n      box-shadow: 0 2px 6px rgba(2, 132, 199, 0.3);\n    }\n    .btn-quick-add-column.pg {\n      background: #fce7f3;\n      color: #db2777;\n      border-color: #fbcfe8;\n    }\n    .btn-quick-add-column.pg:hover {\n      background: #db2777;\n      color: #ffffff;\n      border-color: #db2777;\n      box-shadow: 0 2px 6px rgba(219, 39, 119, 0.3);\n    }\n    .emp-column-grid {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      min-height: 120px;\n    }\n    @media (min-width: 1400px) {\n      .emp-column-grid {\n        display: grid;\n        grid-template-columns: repeat(2, 1fr);\n        gap: 10px;\n      }\n    }\n\n    /* QU\u1ea2N L\u00dd DANH S\u00c1CH NV/PG */\n    .employees-toolbar {\n      background: #ffffff;\n      border: 1.5px solid #fef08a;\n      border-radius: var(--radius-md);\n      padding: 12px 18px;\n      margin-bottom: 14px;\n      box-shadow: var(--card-shadow);\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 12px;\n      flex-wrap: wrap;\n    }\n    .emp-search-wrap {\n      position: relative;\n      width: 250px;\n    }\n    .emp-search-wrap i {\n      position: absolute;\n      left: 11px;\n      top: 50%;\n      transform: translateY(-50%);\n      color: #b45309;\n      font-size: 12.5px;\n    }\n    .emp-search-wrap input {\n      width: 100%;\n      padding: 7px 12px 7px 32px;\n      border: 1.5px solid #fde68a;\n      border-radius: 20px;\n      font-size: 12.5px;\n      font-weight: 600;\n      background: #fffbeb;\n      color: var(--text-main);\n      outline: none;\n      transition: all 0.2s ease;\n    }\n    .emp-search-wrap input:focus {\n      border-color: #f59e0b;\n      background: #ffffff;\n      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);\n    }\n    .emp-role-badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      padding: 2px 8px;\n      border-radius: 10px;\n      font-size: 10.5px;\n      font-weight: 700;\n      letter-spacing: 0.2px;\n    }\n    .emp-role-badge.role-nv {\n      background: #e0f2fe;\n      color: #0369a1;\n      border: 1px solid #bae6fd;\n    }\n    .emp-role-badge.role-pg {\n      background: #fce7f3;\n      color: #be185d;\n      border: 1px solid #fbcfe8;\n    }\n    .emp-actions-group {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .btn-action-icon {\n      width: 30px;\n      height: 30px;\n      border-radius: 6px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 12.5px;\n      border: 1px solid transparent;\n      cursor: pointer;\n      transition: all 0.2s ease;\n    }\n    .btn-action-icon.edit {\n      background: #fef3c7;\n      border-color: #fde68a;\n      color: #b45309;\n    }\n    .btn-action-icon.edit:hover {\n      background: #fde68a;\n      color: #92400e;\n      transform: translateY(-1px);\n    }\n    .btn-action-icon.delete {\n      background: #fef2f2;\n      border-color: #fecaca;\n      color: #dc2626;\n    }\n    .btn-action-icon.delete:hover {\n      background: #fee2e2;\n      color: #991b1b;\n      transform: translateY(-1px);\n    }\n\n    /* TOAST */\n    .toast-container {\n      position: fixed;\n      bottom: 24px;\n      right: 24px;\n      z-index: 9999;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      pointer-events: none;\n    }\n    .toast-msg {\n      background: #1c1917;\n      color: #ffffff;\n      padding: 10px 16px;\n      border-radius: var(--radius-md);\n      font-size: 13px;\n      font-weight: 600;\n      box-shadow: 0 8px 24px rgba(0,0,0,0.2);\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      animation: toastIn 0.25s ease;\n      pointer-events: auto;\n    }\n    @keyframes toastIn {\n      from { transform: translateY(12px); opacity: 0; }\n      to { transform: translateY(0); opacity: 1; }\n    }\n\n    /* MODAL */\n    .modal-overlay {\n      position: fixed;\n      inset: 0;\n      background: rgba(0,0,0,0.55);\n      backdrop-filter: blur(4px);\n      -webkit-backdrop-filter: blur(4px);\n      z-index: 999999 !important;\n      display: none;\n      align-items: center;\n      justify-content: center;\n      padding: 16px;\n    }\n    .modal-box {\n      background: #ffffff;\n      border-radius: var(--radius-xl);\n      border: 1.5px solid var(--primary-border);\n      width: 100%;\n      max-width: 480px;\n      padding: 20px;\n      box-shadow: 0 20px 40px rgba(0,0,0,0.18);\n    }\n    .modal-title {\n      font-size: 16px;\n      font-weight: 800;\n      color: #92400e;\n      margin-bottom: 12px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    @media (max-width: 768px) {\n      .app-header {\n        flex-direction: column;\n        align-items: flex-start;\n      }\n      .header-acti