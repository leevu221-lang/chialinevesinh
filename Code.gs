      padding: 0;\n    }\n    .rule-items-list li {\n      display: flex;\n      align-items: flex-start;\n      gap: 10px;\n      font-size: 13px;\n      font-weight: 600;\n      line-height: 1.5;\n      color: var(--text-main);\n    }\n    .rule-items-list li i {\n      margin-top: 3px;\n      font-size: 14px;\n      flex-shrink: 0;\n    }\n\n    /* STEP TIMELINE CH\u1ebe T\u00c0I */\n    .sanctions-timeline {\n      display: grid;\n      grid-template-columns: 1fr auto 1fr auto 1fr;\n      gap: 12px;\n      align-items: center;\n      margin-top: 10px;\n    }\n    @media (max-width: 768px) {\n      .sanctions-timeline {\n        grid-template-columns: 1fr;\n        gap: 14px;\n      }\n      .sanction-arrow-divider {\n        display: none;\n      }\n    }\n    .sanction-step-card {\n      background: #fffdf5;\n      border: 1.5px solid #fde68a;\n      border-radius: var(--radius-md);\n      padding: 16px 14px;\n      text-align: center;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 8px;\n      box-shadow: 0 2px 6px rgba(0,0,0,0.02);\n      transition: all 0.2s ease;\n    }\n    .sanction-step-card:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 6px 16px rgba(0,0,0,0.06);\n    }\n    .sanction-step-card.step-1 { border-color: #facc15; }\n    .sanction-step-card.step-2 { border-color: #fb923c; }\n    .sanction-step-card.step-3 { border-color: #f87171; background: #fff5f5; }\n\n    .step-badge {\n      font-size: 11px;\n      font-weight: 800;\n      padding: 3px 12px;\n      border-radius: 20px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n    .step-badge.yellow { background: #fef08a; color: #854d0e; border: 1px solid #eab308; }\n    .step-badge.orange { background: #ffedd5; color: #9a3412; border: 1px solid #fdba74; }\n    .step-badge.red { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }\n\n    .step-main-icon {\n      width: 44px;\n      height: 44px;\n  