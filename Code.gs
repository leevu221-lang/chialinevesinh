0px !important;\n      }\n      .shift-card {\n        padding: 12px 12px !important;\n      }\n      .shift-field-input, .shift-field-select {\n        font-size: 16px !important;\n        min-height: 40px !important;\n      }\n\n      /* TAB DANH SÁCH NV/PG */\n      .employees-toolbar {\n        padding: 10px !important;\n        flex-direction: column !important;\n        align-items: stretch !important;\n        gap: 10px !important;\n      }\n      .emp-search-wrap {\n        width: 100% !important;\n      }\n      .emp-search-wrap input {\n        font-size: 16px !important;\n        padding: 9px 12px 9px 34px !important;\n      }\n      #btnOpenAddEmployeeModal {\n        width: 100% !important;\n        justify-content: center !important;\n        padding: 10px 16px !important;\n        font-size: 13.5px !important;\n      }\n      .employees-stats-row {\n        grid-template-columns: 1fr 1fr !important;\n        gap: 8px !important;\n      }\n      .stat-card {\n        padding: 10px 10px !important;\n        gap: 8px !important;\n      }\n      .stat-icon {\n        width: 34px !important;\n        height: 34px !important;\n        font-size: 14px !important;\n        border-radius: 8px !important;\n      }\n      .stat-value {\n        font-size: 19px !important;\n      }\n      .stat-label {\n        font-size: 10.5px !important;\n      }\n\n      /* Hiển thị sub-tabs lọc trên mobile */\n      .mobile-emp-subtabs {\n        display: flex !important;\n      }\n      .employees-dual-columns {\n        grid-template-columns: 1fr !important;\n        gap: 12px !important;\n      }\n      .emp-column-panel {\n        padding: 12px 10px !important;\n        border-radius: var(--radius-md) !important;\n      }\n      .employee-card {\n        padding: 10px 10px !important;\n        gap: 6px !important;\n      }\n      .emp-name {\n        font-size: 13.5px !important;\n      }\n      .emp-stt {\n        width: 26px !important;\n        height: 26px !important;\n        font-size: 11px !important;\n      }\n      .btn-toggle-attend {\n        padding: 6px 10px !important;\n        font-size: 11px !important;\n        min-height: 34px !important;\n      }\n      .btn-action-icon {\n        width: 32px !important;\n        height: 32px !important;\n      }\n\n      /* QUY ƯỚC */\n      .rules-card-wrapper {\n        padding: 12px !important;\n        border-radius: var(--radius-lg) !important;\n      }\n      .rules-banner-header {\n        padding: 12px !important;\n        gap: 10px !important;\n      }\n      .rules-banner-icon {\n        width: 40px !important;\n        height: 40px !important;\n        font-size: 18px !important;\n        border-radius: 12px !important;\n      }\n      .rules-banner-title {\n        font-size: 14px !important;\n      }\n      .rules-banner-sub {\n        font-size: 11.5px !important;\n      }\n      .rules-grid-layout {\n        grid-template-columns: 1fr !important;\n        gap: 10px !important;\n      }\n      .rule-box-card {\n        padding: 12px !important;\n      }\n      .sanctions-timeline {\n        grid-template-columns: 1fr !important;\n        gap: 8px !important;\n      }\n      .sanction-arrow-divider {\n        display: none !important;\n      }\n\n      /* MODALS BOTTOM SHEET */\n      .modal-overlay {\n        padding: 8px !important;\n        align-items: flex-end !important;\n      }\n      .modal-box {\n        max-width: 100% !important;\n        width: 100% !important;\n        max-height: 88vh !important;\n        overflow-y: auto !important;\n        border-radius: 20px 20px 10px 10px !important;\n        padding: 16px 14px 28px !important;\n        animation: mobileModalUp 0.25s ease !important;\n      }\n      @keyframes mobileModalUp {\n        from { transform: translateY(60px); opacity: 0; }\n        to { transform: translateY(0); opacity: 1; }\n      }\n      .shift-field-input, .shift-field-select, input, select {\n        font-size: 16px !important; /* Chống iOS LINE zoom */\n      }\n      .toast-container {\n        left: 12px !important;\n        right: 12px !important;\n        bottom: 16px !important;\n      }\n      .toast-msg {\n        font-size: 12px !important;\n        padding: 8px 12px !important;\n        border-radius: 8px !important;\n      }\n    }\n\n    /* ==========================================================================\n       CSS CHẾ ĐỘ XUẤT ẢNH HD TOÀN BỘ SƠ ĐỒ MẶT BẰNG (KHÔNG BỊ CẮT XÉN BẤT KỲ GÓC NÀO)\n       ========================================================================== */\n    body.exporting-full-map {\n      overflow: visible !important;\n      position: static !important;\n    }\n    body.exporting-full-map .app-container {\n      width: max-content !important;\n      max-width: none !important;\n      overflow: visible !important;\n      padding: 0 !important;\n      margin: 0 !important;\n    }\n    body.exporting-full-map #floorMapTab {\n      width: max-content !important;\n      max-width: none !important;\n      overflow: visible !important;\n    }\n    body.exporting-full-map .floorplan-card {\n      width: max-content !important;\n      min-width: 1960px !important;\n      max-width: none !important;\n      overflow: visible !important;\n      box-sizing: border-box !important;\n      border-radius: 16px !important;\n      padding: 20px !important;\n      background: #ffffff !important;\n    }\n    body.exporting-full-map .floorplan-scroll-viewport {\n      width: 100% !important;\n      max-width: none !important;\n      overflow: visible !important;\n      overflow-x: visible !important;\n      border: 1.5px solid #fde047 !important;\n    }\n    body.exporting-full-map .store-layout-grid {\n      width: 100% !important;\n      min-width: 1920px !important;\n    }\n    body.exporting-full-map #btnQuickAllocationMode,\n    body.exporting-full-map .mobile-scroll-tip,\n    body.exporting-full-map #allocationActiveBanner {\n      display: none !important;\n    }\n    body.exporting-full-map .export-time-badge {\n      display: inline-flex !important;\n    }\n\n  </style>\n</head>\n<body>\n  <div class=\"app-container\" id=\"appMainContainer\">\n    <!-- HEADER -->\n    <header class=\"app-header\">\n      <div class=\"header-branding\">\n        <div class=\"brand-icon\">\n          <i class=\"fa-solid fa-broom\"></i>\n        </div>\n        <div class=\"brand-title\">\n          <h1>\n            PHÂN CÔNG VỆ SINH 1841\n            <span class=\"badge-tag\">Tone Vàng Pastel</span>\n          </h1>\n          <div class=\"brand-subtitle\">\n            <i class=\"fa-solid fa-store\"></i> Siêu thị 1841 • Sơ đồ chuẩn mặt bằng vận hành\n          </div>\n        </div>\n      </div>\n\n      <div class=\"header-actions\">\n        <div class=\"live-status-pill syncing\" id=\"realtimeStatusPill\" title=\"Bấm để đồng bộ lại dữ liệu\">\n          <span class=\"live-dot\"></span>\n          <span id=\"realtimeStatusText\">🔄 Đang nạp từ Google Sheet...</span>\n        </div>\n        <button class=\"btn btn-primary\" id=\"btnExportImage\" title=\"Xuất ảnh sơ đồ chất lượng cao gửi Zalo\">\n          <i class=\"fa-solid fa-camera\"></i> Xuất Ảnh HD\n        </button>\n        <button class=\"btn btn-secondary\" id=\"btnSaveToSheetMain\" title=\"Lưu ngay về Google Sheet\">\n          <i class=\"fa-solid fa-cloud-arrow-up\"></i> Lưu Về Sheet\n        </button>\n        <button class=\"btn-icon\" id=\"btnReloadPage\" title=\"Làm mới trang\">\n          <i class=\"fa-solid fa-rotate-right\"></i>\n        </button>\n        <button class=\"btn-icon\" id=\"btnOpenConfigModal\" title=\"Cài đặt kết nối\">\n          <i class=\"fa-solid fa-gear\"></i>\n        </button>\n      </div>\n    </header>\n\n    <!-- NAVIGATION TOOLBAR -->\n    <div class=\"nav-toolbar\">\n      <div class=\"nav-tabs\">\n        <button class=\"nav-tab-btn active\" data-tab=\"floorMapTab\">\n          <i class=\"fa-solid fa-map-location-dot\"></i> Sơ Đồ Mặt Bằng\n        </button>\n        <button class=\"nav-tab-btn\" data-tab=\"employeesTab\">\n          <i class=\"fa-solid fa-users-gear\"></i> Danh Sách NV/PG\n          <span class=\"tab-badge\" id=\"badgeEmpCount\">26 NV/PG</span>\n        </button>\n        <button class=\"nav-tab-btn\" data-tab=\"rulesTab\">\n          <i class=\"fa-solid fa-scroll\"></i> Quy Ước\n        </button>\n      </div>\n\n      <div class=\"search-box-wrap\">\n        <i class=\"fa-solid fa-magnifying-glass\"></i>\n        <input type=\"text\" class=\"search-input\" id=\"globalSearchInput\" placeholder=\"Tìm nhân viên, khu vực (gõ để sáng vị trí trên bản đồ)...\">\n      </div>\n    </div>\n\n    <!-- TAB 1: SƠ ĐỒ MẶT BẰNG CHUẨN THEO ẢNH -->\n    <div class=\"tab-content active\" id=\"floorMapTab\">\n      <div class=\"floorplan-card\" id=\"floorPlanExportTarget\">\n        <div class=\"floorplan-header-strip\">\n          <div style=\"display:flex; align-items:center; gap:12px; flex-wrap:wrap;\">\n            <h2 style=\"font-size: 15px; font-weight: 800; color: #92400e;\">\n              <i class=\"fa-solid fa-layer-group\"></i> SƠ ĐỒ MẶT BẰNG BỐ TRÍ VỆ SINH SIÊU THỊ 1841\n            </h2>\n            <button class=\"btn btn-secondary\" id=\"btnQuickAllocationMode\" style=\"padding:4px 12px; font-size:12px;\">\n              <i class=\"fa-solid fa-hand-pointer\" style=\"color:#d97706;\"></i> Phân Bổ Nhanh\n            </button>\n            <div class=\"export-time-badge\" id=\"exportTimeBadge\" style=\"display:none; font-size:12px; font-weight:700; color:#b45309; background:#fffbeb; padding:3px 10px; border-radius:12px; border:1px solid #fde68a;\">\n              <i class=\"fa-regular fa-clock\"></i> Xuất ảnh: <span id=\"exportTimeText\"></span>\n            </div>\n          </div>\n          <div class=\"floorplan-legend\">\n            <span class=\"legend-item\"><span class=\"legend-box\" style=\"background:#dcfce7;border-color:#86efac;\"></span> Vách Tủ Lạnh</span>\n            <span class=\"legend-item\"><span class=\"legend-box\" style=\"background:#ffedd5;border-color:#fdba74;\"></span> Tủ Lạnh / Gia Dụng</span>\n            <span class=\"legend-item\"><span class=\"legend-box\" style=\"background:#dbeafe;border-color:#93c5fd;\"></span> Máy Giặt</span>\n            <span class=\"legend-item\"><span class=\"legend-box\" style=\"background:#fef08a;border-color:#eab308;\"></span> Khu ICT / Điện Thoại</span>\n            <span class=\"legend-item\"><span class=\"legend-box\" style=\"background:#ffe4e6;border-color:#fca5a5;\"></span> Thu Ngân / HTKT</span>\n          </div>\n        </div>\n\n        <!-- GỢI Ý VUỐT NGANG TRÊN ĐIỆN THOẠI -->\n        <div class=\"mobile-scroll-tip\">\n          <i class=\"fa-solid fa-arrows-left-right\"></i>\n          <span>Vuốt ngang <strong>👈 👉</strong> để xem toàn bộ sơ đồ mặt bằng</span>\n        </div>\n\n        <!-- BANNER CHẾ ĐỘ PHÂN BỔ TRỰC TIẾP -->\n        <div class=\"allocation-banner\" id=\"allocationActiveBanner\" style=\"display:none;\">\n          <div style=\"display:flex; align-items:center; gap:10px; flex-wrap:wrap;\">\n            <span class=\"live-dot\" style=\"background:#d97706;\"></span>\n            <span style=\"font-weight:800; color:#92400e; font-size:13.5px;\">\n              🎯 ĐANG PHÂN BỔ CHO:\n            </span>\n            <span class=\"allocation-staff-name-badge\" id=\"allocatingStaffNameBadge\">TRANG</span>\n            <span style=\"font-size:12px; color:#78350f; font-weight:600;\">\n              👉 Nhấp vào ô bất kỳ trên sơ đồ để Gán / Bỏ Gán khu vực!\n            </span>\n            <span class=\"badge-tag\" id=\"allocatingAreaCountBadge\" style=\"background:#fff; border:1px solid #d97706; color:#92400e;\">\n              0 khu vực\n            </span>\n          </div>\n          <div style=\"display:flex; gap:8px;\">\n            <button class=\"btn btn-primary\" id=\"btnFinishAllocation\" style=\"padding:5px 14px; font-size:12.5px;\">\n              <i class=\"fa-solid fa-check\"></i> Xong & Lưu\n            </button>\n            <button class=\"btn btn-secondary\" id=\"btnCancelAllocation\" style=\"padding:5px 10px; font-size:12.5px;\">\n              Thoát\n            </button>\n          </div>\n        </div>\n\n        <!-- BẢN ĐỒ MẶT BẰNG CHUẨN HÌNH MẪU (BỌC TRONG KHUNG CUỘN NỘI BỘ) -->\n        <div class=\"floorplan-scroll-viewport\">\n          <div class=\"store-layout-grid\" id=\"storeLayoutGridEl\">\n          <!-- HÀNG ĐỈNH (TOP BARRIER) -->\n          <div class=\"top-barrier-row\">\n            <div class=\"map-cell bg-door-red\">\n              <span class=\"cell-title\">CỬA</span>\n            </div>\n            <div class=\"map-cell bg-green-wall\" data-staff=\"XUYÊN\">\n              <span class=\"cell-title\">VÁCH TỦ LẠNH HITACHI</span>\n              <span class=\"cell-staff\">XUYÊN</span>\n            </div>\n            <div class=\"map-cell bg-green-wall\" data-staff=\"XUYÊN\">\n              <span class=\"cell-title\">VÁCH TỦ LẠNH AQUA</span>\n              <span class=\"cell-staff\">XUYÊN</span>\n            </div>\n            <div class=\"map-cell bg-green-wall\" data-staff=\"OANH\">\n              <span class=\"cell-title\">VÁCH TỦ LẠNH LG</span>\n              <span class=\"cell-staff\">OANH</span>\n            </div>\n            <div class=\"map-cell bg-storage-red\">\n              <span class=\"cell-title\">CỬA KHO</span>\n            </div>\n          </div>\n\n          <!-- CỘT 1: VÁCH TƯỜNG TRÁI -->\n          <div style=\"display:flex; flex-direction:column; gap:6px;\">\n            <div class=\"map-cell bg-green-wall\" data-staff=\"TRANG\"><span class=\"cell-title\">VÁCH TỦ LẠNH SHARP</span><span class=\"cell-staff\">TRANG</span></div>\n            <div class=\"map-cell bg-green-wall\" data-staff=\"TRANG\"><span class=\"cell-title\">VÁCH TỦ LẠNH TOSHIBA</span><span class=\"cell-staff\">TRANG</span></div>\n            <div class=\"map-cell bg-orange-fridge\" data-staff=\"MY\"><span class=\"cell-title\">VÁCH BẾP ĐIỆN, BẾP GAS</span><span class=\"cell-staff\">MY</span></div>\n            <div class=\"map-cell bg-orange-fridge\" style=\"min-height:50px;\" data-staff=\"MY\"><span class=\"cell-title\">VÁCH HÃNG: JUNGER, HAFALE, SUNHOUSE...</span><span class=\"cell-staff\">MY</span></div>\n            <div class=\"map-cell bg-green-wall\" data-staff=\"TÍN\"><span class=\"cell-title\">VÁCH HÃNG TOSHIBA</span><span class=\"cell-staff\">TÍN</span></div>\n            <div class=\"map-cell bg-green-wall\" data-staff=\"OANH\"><span class=\"cell-title\">VÁCH HÃNG LG</span><span class=\"cell-staff\">OANH</span></div>\n            <div class=\"map-cell bg-green-wall\" data-staff=\"TÍN\"><span class=\"cell-title\">VÁCH HÃNG SAMSUNG</span><span class=\"cell-staff\">TÍN</span></div>\n          </div>\n\n          <!-- CỘT 2: TỦ LẠNH & GIA DỤNG -->\n          <div style=\"display:flex; flex-direction:column; gap:6px;\">\n            <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:6px;\">\n              <div class=\"map-cell bg-orange-fridge\" data-staff=\"Ý\"><span class=\"cell-title\">BỤC TỦ LẠNH</span><span class=\"cell-staff\">Ý</span></div>\n              <div class=\"map-cell bg-orange-fridge\" data-staff=\"XUYÊN\"><span class=\"cell-title\">TỦ LẠNH AQUA</span><span class=\"cell-staff\">XUYÊN</span></div>\n            </div>\n            <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:6px;\">\n              <div class=\"map-cell bg-orange-fridge\" data-staff=\"Ý\"><span class=\"cell-title\">BỤC TỦ LẠNH</span><span class=\"cell-staff\">Ý</span></div>\n              <div class=\"map-cell bg-orange-fridge\" data-staff=\"TRANG\"><span class=\"cell-title\">TỦ LẠNH TOSHIBA</span><span class=\"cell-staff\">TRANG</span></div>\n            </div>\n            <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:6px;\">\n              <div class=\"map-cell bg-orange-fridge\" data-staff=\"Ý\"><span class=\"cell-title\">TỦ LẠNH PANASONIC</span><span class=\"cell-staff\">Ý</span></div>\n              <div class=\"map-cell bg-orange-fridge\" data-staff=\"XUYÊN\"><span class=\"cell-title\">TỦ LẠNH HAIER</span><span class=\"cell-staff\">XUYÊN</span></div>\n            </div>\n\n            <!-- GIA DỤNG 7..1 -->\n            <div class=\"map-cell bg-cream-appliance\" data-staff=\"THẮM\"><span class=\"cell-title\">GIA DỤNG 07</span><span class=\"cell-staff\">THẮM</span></div>\n            <div class=\"map-cell bg-cream-appliance\" data-staff=\"THẠCH VŨ\"><span class=\"cell-title\">GIA DỤNG 06</span><span class=\"cell-staff\">THẠCH VŨ</span></div>\n            <div class=\"map-cell bg-cream-appliance\" data-staff=\"KHANG HI\"><span class=\"cell-title\">GIA DỤNG 05</span><span class=\"cell-staff\">KHANG HI</span></div>\n            <div class=\"map-cell bg-cream-appliance\" data-staff=\"NHẠN\"><span class=\"cell-title\">GIA DỤNG 04</span><span class=\"cell-staff\">NHẠN</span></div>\n            <div class=\"map-cell bg-cream-appliance\" data-staff=\"MI\"><span class=\"cell-title\">GIA DỤNG 03</span><span class=\"cell-staff\">MI</span></div>\n            <div class=\"map-cell bg-cream-appliance\" data-staff=\"ĐẠI\"><span class=\"cell-title\">GIA DỤNG 02</span><span class=\"cell-staff\">ĐẠI</span></div>\n            <div class=\"map-cell bg-cream-appliance\" data-staff=\"BĂNG BLUESTONE\"><span class=\"cell-title\">GIA DỤNG 01</span><span class=\"cell-staff\">BĂNG BLUESTONE</span></div>\n\n            <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:6px;\">\n              <div class=\"map-cell bg-cream-appliance\" data-staff=\"TRANG\"><span class=\"cell-title\">GIA DỤNG KANGAROO</span><span class=\"cell-staff\">TRANG</span></div>\n              <div class=\"map-cell bg-cream-appliance\" data-staff=\"TRANG\"><span class=\"cell-title\">GIA DỤNG TOSHIBA</span><span class=\"cell-staff\">TRANG</span></div>\n            </div>\n            <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:6px;\">\n              <div class=\"map-cell bg-cream-appliance\" data-staff=\"TRINH\"><span class=\"cell-title\">KỆ GIA DỤNG</span><span class=\"cell-staff\">TRINH</span></div>\n              <div class=\"map-cell bg-cream-appliance\" data-staff=\"TRINH\"><span class=\"cell-title\">GIA DỤNG SUNHOUSE</span><span class=\"cell-staff\">TRINH</span></div>\n            </div>\n            <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:6px;\">\n              <div class=\"map-cell bg-cream-appliance\" data-staff=\"TRINH\"><span class=\"cell-title\">ROBOT</span><span class=\"cell-staff\">TRINH</span></div>\n              <div class=\"map-cell bg-cream-appliance\" data-staff=\"TRINH\"><span class=\"cell-title\">MLN SUNHOUSE</span><span class=\"cell-staff\">TRINH</span></div>\n            </div>\n\n            <!-- MLN HÀNG NGANG -->\n            <div style=\"display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px;\">\n              <div class=\"map-cell bg-green-wall\" data-staff=\"HI\"><span class=\"cell-title\">MLN MUTOSI</span><span class=\"cell-staff\">HI</span></div>\n              <div class=\"map-cell bg-green-wall\" data-staff=\"TRANG\"><span class=\"cell-title\">MLN TOSHIBA</span><span class=\"cell-staff\">TRANG</span></div>\n              <div class=\"map-cell bg-green-wall\" data-staff=\"HI\"><span class=\"cell-title\">MLN HOÀ PHÁT</span><span class=\"cell-staff\">HI</span></div>\n            </div>\n\n            <div class=\"map-cell bg-orange-fridge\" data-staff=\"TÍN\"><span class=\"cell-title\">KỆ LOA KARAOKE</span><span class=\"cell-staff\">TÍN</span></div>\n            <div class=\"map-cell bg-orange-fridge\" data-staff=\"XUYÊN\"><span class=\"cell-title\">BỤC HÃNG HAIER</span><span class=\"cell-staff\">XUYÊN</span></div>\n            <div class=\"map-cell bg-orange-fridge\" data-staff=\"XUYÊN\"><span class=\"cell-title\">BỤC HÃNG AQUA</span><span class=\"cell-staff\">XUYÊN</span></div>\n            <div class=\"map-cell bg-orange-frid