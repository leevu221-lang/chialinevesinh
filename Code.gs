column-title-wrap\">\n              <div class=\"emp-column-icon pg\">\n                <i class=\"fa-solid fa-handshake\"></i>\n              </div>\n              <div>\n                <span class=\"emp-column-title\">PG H\u1ed6 TR\u1ee2 H\u00c3NG</span>\n                <span class=\"emp-column-badge\" id=\"badgeColumnPgCount\">8 PG</span>\n              </div>\n            </div>\n            <button class=\"btn-quick-add-column pg\" onclick=\"openAddEmployeeModal('pg')\" title=\"Th\u00eam PG H\u1ed7 Tr\u1ee3 H\u00e3ng M\u1edbi\">\n              <i class=\"fa-solid fa-plus\"></i> Th\u00eam PG\n            </button>\n          </div>\n          <div class=\"emp-column-grid\" id=\"staffPgGridContainer\">\n            <!-- Render danh s\u00e1ch PG H\u1ed7 Tr\u1ee3 H\u00e3ng -->\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- TAB 4: QUY \u01af\u1edaC V\u1eacN H\u00c0NH & N\u1ed8I QUY V\u1ec6 SINH -->\n    <div class=\"tab-content\" id=\"rulesTab\">\n      <div class=\"rules-card-wrapper\" id=\"rulesExportTarget\">\n        <div class=\"rules-banner-header\">\n          <div class=\"rules-banner-icon\">\n            <i class=\"fa-solid fa-scroll\"></i>\n          </div>\n          <div>\n            <h2 class=\"rules-banner-title\">QUY \u01af\u1edaC V\u1eacN H\u00c0NH & N\u1ed8I QUY V\u1ec6 SINH SI\u00caU TH\u1eca 1841</h2>\n            <p class=\"rules-banner-sub\">Quy \u0111\u1ecbnh b\u1eaft bu\u1ed9c \u00e1p d\u1ee5ng cho to\u00e0n b\u1ed9 nh\u00e2n vi\u00ean v\u00e0 \u0111\u1ed1i t\u00e1c PG tr\u1ef1c t\u1ea1i si\u00eau th\u1ecb</p>\n          </div>\n        </div>\n\n        <div class=\"rules-grid-layout\">\n          <!-- QUY \u0110\u1ecaNH 1 -->\n          <div class=\"rule-box-card\">\n            <div class=\"rule-box-header\">\n              <div class=\"rule-title-tag red\">\n                <i class=\"fa-solid fa-broom\"></i> 1. V\u1ec6 SINH N\u1ec0N NH\u00c0 & ROOM 8NTT\n              </div>\n              <span class=\"rule-pill-badge red\">B\u1eaft bu\u1ed9c m\u1ed7i ca</span>\n            </div>\n            <div class=\"rule-callout-box red\">\n              <i class=\"fa-solid fa-triangle-exclamation\" style=\"margin-top:2px; font-size:16px;\"></i>\n              <div>\n                <strong>L\u01afU \u00dd QUAN TR\u1eccNG:</strong> Khu v\u1ef1c b\u1ea1n n\u00e0o ph\u1ee5 tr\u00e1ch, khi v\u00e0o ca ph\u1ea3i v\u1ec7 sinh s\u1ea1ch s\u1ebd n\u1ec1n nh\u00e0, ki\u1ec3m tra \u0111\u00fang ti\u00eau chu\u1ea9n <strong>8NTT</strong>.\n              </div>\n            </div>\n            <ul class=\"rule-items-list\">\n              <li>\n                <i class=\"fa-solid fa-camera\" style=\"color:#d97706;\"></i>\n                <span>G\u1eedi h\u00ecnh \u1ea3nh tr\u1ef1c ti\u1ebfp l\u00ean <strong>ROOM 8NTT</strong> ngay khi ho\u00e0n t\u1ea5t v\u1ec7 sinh.</span>\n              </li>\n              <li>\n                <i class=\"fa-solid fa-ban\" style=\"color:#dc2626;\"></i>\n                <span style=\"color:#b91c1c; font-weight:800;\">TUY\u1ec6T \u0110\u1ed0I: KH\u00d4NG T\u1ea0O ALBUM, KH\u00d4NG T\u1ea0O GHI CH\u00da.</span>\n              </li>\n              <li>\n                <i class=\"fa-solid fa-clock-rotate-left\" style=\"color:#059669;\"></i>\n                <span><strong>Cu\u1ed1i ca l\u00e0m vi\u1ec7c:</strong> B\u1eaft bu\u1ed9c ki\u1ec3m tra l\u1ea1i to\u00e0n b\u1ed9 khu v\u1ef1c tr\u01b0\u1edbc khi b\u00e0n giao ra v\u1ec1.</span>\n              </li>\n            </ul>\n          </div>\n\n          <!-- QUY \u0110\u1ecaNH 2 -->\n          <div class=\"rule-box-card\">\n            <div class=\"rule-box-header\">\n              <div class=\"rule-title-tag amber\">\n                <i class=\"fa-solid fa-star\"></i> 2. NGUY\u00caN T\u1eaeC PH\u1ee4C V\u1ee4 & B\u00c1O C\u00c1O\n              </div>\n              <span class=\"rule-pill-badge amber\">\u01afu ti\u00ean s\u1ed1 1</span>\n            </div>\n            <div class=\"rule-callout-box amber\">\n              <i class=\"fa-solid fa-award\" style=\"margin-top:2px; font-size:16px;\"></i>\n              <div>\n                <strong>\u01afU TI\u00caN S\u1ed0 1:</strong> Ph\u1ee5c v\u1ee5 v\u00e0 h\u1ed7 tr\u1ee3 kh\u00e1ch h\u00e0ng l\u00e0 nhi\u1ec7m v\u1ee5 h\u00e0ng \u0111\u1ea7u. X\u1eed l\u00fd c\u00f4ng vi\u1ec7c xong th\u00ec ho\u00e0n t\u1ea5t b\u00e1o c\u00e1o.\n              </div>\n            </div>\n            <ul class=\"rule-items-list\">\n              <li>\n                <i class=\"fa-solid fa-calendar-check\" style=\"color:#059669;\"></i>\n                <span><strong>B\u1eaeT BU\u1ed8C ho\u00e0n t\u1ea5t b\u00e1o c\u00e1o m\u1ed7i ng\u00e0y l\u00e0m vi\u1ec7c</strong> \u0111\u1ea7y \u0111\u1ee7 v\u00e0 ch\u00ednh x\u00e1c.</span>\n              </li>\n              <li>\n                <i class=\"fa-solid fa-user-check\" style=\"color:#d97706;\"></i>\n                <span>Ch\u1ee7 \u0111\u1ed9ng ch\u00e0o h\u1ecfi, ni\u1ec1m n\u1edf v\u00e0 h\u1ed7 tr\u1ee3 kh\u00e1ch h\u00e0ng \u0111\u1ebfn tr\u1ea3i nghi\u1ec7m si\u00eau th\u1ecb.</span>\n              </li>\n              <li>\n                <i class=\"fa-solid fa-handshake-angle\" style=\"color:#2563eb;\"></i>\n                <span>H\u1ed7 tr\u1ee3 \u0111\u1ed3ng nghi\u1ec7p v\u00e0 ph\u1ed1i h\u1ee3p nh\u1ecbp nh\u00e0ng gi\u1eefa c\u00e1c ph\u00e2n khu tr\u1ef1c ca.</span>\n              </li>\n            </ul>\n          </div>\n\n          <!-- QUY \u0110\u1ecaNH 3: CH\u1ebe T\u00c0I -->\n          <div class=\"rule-box-card full-width\">\n            <div class=\"rule-box-header\">\n              <div class=\"rule-title-tag purple\">\n                <i class=\"fa-solid fa-gavel\"></i> 3. QUY TR\u00ccNH X\u1eec L\u00dd SAI PH\u1ea0M (\u0110\u00c3 TH\u1ed0NG NH\u1ea4T)\n              </div>\n              <span class=\"rule-pill-badge purple\">K\u1ef7 lu\u1eadt & Ch\u1ebf t\u00e0i</span>\n            </div>\n            <p style=\"font-size:13px; color:#57534e; font-weight:600;\">\n              M\u1ecdi ph\u00e1t sinh sai ph\u1ea1m v\u1ec1 v\u1ec7 sinh, b\u00e1o c\u00e1o v\u00e0 quy tr\u00ecnh v\u1eadn h\u00e0nh s\u1ebd \u0111\u01b0\u1ee3c x\u1eed l\u00fd nghi\u00eam theo 3 c\u1ea5p \u0111\u1ed9 \u0111\u00e3 tri\u1ec3n khai th\u1ed1ng nh\u1ea5t:\n            </p>\n\n            <div class=\"sanctions-timeline\">\n              <div class=\"sanction-step-card step-1\">\n                <span class=\"step-badge yellow\">L\u1ea6N 1 TRONG TH\u00c1NG</span>\n                <div class=\"step-main-icon yellow\"><i class=\"fa-solid fa-bullhorn\"></i></div>\n                <div class=\"step-header-text\">Nh\u1eafc Nh\u1edf Mi\u1ec7ng</div>\n                <div class=\"step-detail-text\">Nh\u1eafc nh\u1edf tr\u1ef1c ti\u1ebfp, h\u01b0\u1edbng d\u1eabn kh\u1eafc ph\u1ee5c sai s\u00f3t ngay t\u1ea1i ch\u1ed7</div>\n              </div>\n\n              <div class=\"sanction-arrow-divider\"><i class=\"fa-solid fa-chevron-right\"></i></div>\n\n              <div class=\"sanction-step-card step-2\">\n                <span class=\"step-badge orange\">L\u1ea6N 2 TRONG TH\u00c1NG</span>\n                <div class=\"step-main-icon orange\"><i class=\"fa-solid fa-file-pen\"></i></div>\n                <div class=\"step-header-text\">L\u1eadp Bi\u00ean B\u1ea3n XLKL</div>\n                <div class=\"step-detail-text\">Bi\u00ean b\u1ea3n x\u1eed l\u00fd k\u1ef7 lu\u1eadt, khi\u1ec3n tr\u00e1ch b\u1eb1ng mi\u1ec7ng trong cu\u1ed9c h\u1ecdp</div>\n              </div>\n\n              <div class=\"sanction-arrow-divider\"><i class=\"fa-solid fa-chevron-right\"></i></div>\n\n              <div class=\"sanction-step-card step-3\">\n                <span class=\"step-badge red\">L\u1ea6N 3 TRONG TH\u00c1NG</span>\n                <div class=\"step-main-icon red\"><i class=\"fa-solid fa-scale-unbalanced\"></i></div>\n                <div class=\"step-header-text\">\u00dap H\u1ec7 Th\u1ed1ng HRM</div>\n                <div class=\"step-detail-text\">L\u1eadp bi\u00ean b\u1ea3n XLKL \u00fap h\u1ec7 th\u1ed1ng HRM, khi\u1ec3n tr\u00e1ch b\u1eb1ng v\u0103n b\u1ea3n</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- TOAST NOTIFICATION -->\n  <div class=\"toast-container\" id=\"toastContainer\"></div>\n\n  <!-- MODAL XEM TR\u01af\u1edaC V\u00c0 T\u1ef0 \u0110\u1ed8NG COPY \u1ea2NH XU\u1ea4T HD -->\n  <div class=\"modal-overlay\" id=\"imagePreviewModal\" style=\"display:none;\">\n    <div class=\"modal-box image-preview-modal-box\">\n      <div class=\"modal-title\">\n        <div style=\"display:flex; align-items:center; gap:8px;\">\n          <i class=\"fa-solid fa-camera\"></i>\n          <span>Xem Tr\u01b0\u1edbc \u1ea2nh Xu\u1ea5t HD</span>\n          <span class=\"rule-pill-badge\" style=\"background:#dcfce7; color:#166534; border:1px solid #86efac;\">\n            <i class=\"fa-solid fa-check\"></i> \u0110\u00e3 Auto Copy\n          </span>\n        </div>\n        <button class=\"btn-icon\" id=\"btnClosePreviewModal\" style=\"width:28px;height:28px;\">\n          <i class=\"fa-solid fa-xmark\"></i>\n        </button>\n      </div>\n\n      <div class=\"image-copy-tip-banner\">\n        <i class=\"fa-solid fa-circle-check\" style=\"font-size:18px; color:#10b981; flex-shrink:0;\"></i>\n        <div>\n          <strong>\u1ea2nh \u0111\u00e3 \u0111\u01b0\u1ee3c t\u1ef1 \u0111\u1ed9ng sao ch\u00e9p v\u00e0o b\u1ed9 nh\u1edb t\u1ea1m (Clipboard)!</strong><br>\n          B\u1ea1n ch\u1ec9 c\u1ea7n m\u1edf Zalo ho\u1eb7c \u1ee9ng d\u1ee5ng chat v\u00e0 nh\u1ea5n <strong>Ctrl + V</strong> (ho\u1eb7c ch\u1ecdn <em>D\u00e1n</em>) \u0111\u1ec3 g\u1eedi ngay.\n        </div>\n      </div>\n\n      <div class=\"image-preview-viewport\">\n        <img id=\"previewModalImageEl\" src=\"\" alt=\"\u1ea2nh Xu\u1ea5t HD\" />\n      </div>\n\n      <div style=\"display:flex; justify-content:space-between; align-items:center; margin-top:16px; gap:10px; flex-wrap:wrap;\">\n        <div style=\"display:flex; gap:8px; flex-wrap:wrap;\">\n          <button class=\"btn btn-primary\" id=\"btnCopyImageAgain\">\n            <i class=\"fa-solid fa-copy\"></i> Sao Ch\u00e9p L\u1ea1i \u1ea2nh\n          </button>\n          <button class=\"btn btn-secondary\" id=\"btnDownloadImageManually\">\n            <i class=\"fa-solid fa-download\"></i> T\u1ea3i V\u1ec1 M\u00e1y\n          </button>\n        </div>\n        <button class=\"btn btn-secondary\" id=\"btnClosePreviewModalBtn\">\u0110\u00f3ng</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL PH\u00c2N B\u1ed4 & THAY \u0110\u1ed4I T\u00caN NH\u00c2N VI\u00caN TR\u1ef0C TI\u1ebeP -->\n  <div class=\"modal-overlay\" id=\"staffAllocationModal\" style=\"display:none;\">\n    <div class=\"modal-box\" style=\"max-width:520px;\">\n      <div class=\"modal-title\">\n        <span style=\"display:flex; align-items:center; gap:8px;\">\n          <i class=\"fa-solid fa-user-gear\" style=\"color:#d97706;\"></i> Ph\u00e2n B\u1ed5 Nh\u00e2n Vi\u00ean Khu V\u1ef1c\n        </span>\n        <button class=\"btn-icon\" id=\"btnCloseStaffModal\" style=\"width:28px;height:28px;\">\n          <i class=\"fa-solid fa-xmark\"></i>\n        </button>\n      </div>\n\n      <!-- TH\u00d4NG TIN KHU V\u1ef0C HI\u1ec6N T\u1ea0I -->\n      <div style=\"background:#fffbeb; border:1.5px solid #fde68a; border-radius:10px; padding:12px 14px; margin-bottom:14px;\">\n        <div style=\"font-size:11.5px; color:#78350f; font-weight:700; text-transform:uppercase;\">Khu v\u1ef1c \u0111\u00e3 ch\u1ecdn:</div>\n        <div style=\"font-size:15px; font-weight:800; color:#1c1917; margin:2px 0 6px;\" id=\"modalTargetAreaTitle\">V\u00c1CH T\u1ee6 L\u1ea0NH TOSHIBA</div>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; font-size:12.5px;\">\n          <span>Nh\u00e2n vi\u00ean hi\u1ec7n t\u1ea1i: <strong id=\"modalCurrentStaffName\" style=\"color:#d97706;\">TRANG</strong></span>\n          <span class=\"badge-tag\" id=\"modalCurrentStaffCountBadge\" style=\"background:#fef3c7; color:#92400e;\">\u0110ang c\u00f3 7 khu v\u1ef1c</span>\n        </div>\n      </div>\n\n      <!-- \u00d4 CH\u1eccN HO\u1eb6C NH\u1eacP T\u00caN M\u1edaI -->\n      <div style=\"margin-bottom:14px;\">\n        <label style=\"font-size:12px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:5px;\">\n          Ch\u1ecdn nh\u00e2n vi\u00ean m\u1edbi (ho\u1eb7c nh\u1eadp t\u00ean):\n        </label>\n        <div style=\"display:flex; gap:8px;\">\n          <select id=\"modalStaffDropdown\" class=\"shift-field-select\" style=\"flex:1;\">\n            <option value=\"\">-- Ch\u1ecdn t\u1eeb 26 nh\u00e2n vi\u00ean si\u00eau th\u1ecb --</option>\n          </select>\n          <input type=\"text\" id=\"modalStaffCustomInput\" class=\"shift-field-input\" placeholder=\"Ho\u1eb7c g\u00f5 t\u00ean...\" style=\"flex:1;\">\n        </div>\n      </div>\n\n      <!-- C\u00c1C H\u00c0NH \u0110\u1ed8NG -->\n      <div style=\"display:flex; flex-direction:column; gap:8px; margin-bottom:14px;\">\n        <button class=\"btn btn-primary\" id=\"btnApplyToAllStaffAreas\" style=\"width:100%; justify-content:center; padding:10px;\">\n          <i class=\"fa-solid fa-arrows-rotate\"></i> \u0110\u1ed5i tr\u00ean T\u1ea4T C\u1ea2 c\u00e1c khu v\u1ef1c c\u1ee7a <span id=\"modalBtnStaffTargetName\">TRANG</span>\n        </button>\n        <button class=\"btn btn-secondary\" id=\"btnApplyToSingleArea\" style=\"width:100%; justify-content:center; padding:8px;\">\n          <i class=\"fa-solid fa-pen\"></i> Ch\u1ec9 \u0111\u1ed5i ri\u00eang khu v\u1ef1c n\u00e0y\n        </button>\n      </div>\n\n      <!-- PH\u00c2N B\u1ed4 TR\u1ef0C TI\u1ebeP TR\u00caN S\u01a0 \u0110\u1ed2 -->\n      <div style=\"border-top:1px dashed #fde68a; padding-top:12px;\">\n        <button class=\"btn btn-secondary\" id=\"btnStartDirectAllocation\" style=\"width:100%; justify-content:center; padding:9px; background:#fffbeb; border-color:#d97706; color:#92400e; font-weight:700;\">\n          <i class=\"fa-solid fa-hand-pointer\" style=\"color:#d97706;\"></i> Click ch\u1ecdn c\u00e1c khu v\u1ef1c tr\u00ean s\u01a1 \u0111\u1ed3 cho <span id=\"modalBtnDirectStaffName\">TRANG</span>\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL TH\u00caM / CH\u1ec8NH S\u1eecA NV / PG -->\n  <div class=\"modal-overlay\" id=\"employeeModal\">\n    <div class=\"modal-box\" style=\"max-width: 480px;\">\n      <div class=\"modal-title\">\n        <span id=\"employeeModalTitle\"><i class=\"fa-solid fa-user-plus\" style=\"color:#d97706;\"></i> Th\u00eam NV / PG M\u1edbi</span>\n        <button class=\"btn-icon\" id=\"btnCloseEmployeeModal\" style=\"width:28px;height:28px;\"><i class=\"fa-solid fa-xmark\"></i></button>\n      </div>\n      <div style=\"display:flex; flex-direction:column; gap:16px; margin-top:14px;\">\n        <input type=\"hidden\" id=\"empEditIndex\" value=\"-1\">\n        <div>\n          <label style=\"display:block; font-size:12.5px; font-weight:700; color:#78350f; margin-bottom:6px;\">\n            H\u1ecd v\u00e0 T\u00ean Nh\u00e2n Vi\u00ean / PG <span style=\"color:#ef4444;\">*</span>\n          </label>\n          <input type=\"text\" id=\"empInputName\" class=\"shift-field-input\" placeholder=\"V\u00ed d\u1ee5: Hu\u1ef3nh Ho\u00e0ng Ph\u00fac ho\u1eb7c Oanh LG\" style=\"width:100%; font-size:13.5px; font-weight:600;\">\n        </div>\n\n        <div>\n          <label style=\"display:block; font-size:12.5px; font-weight:700; color:#78350f; margin-bottom:6px;\">\n            Ph\u00e2n Lo\u1ea1i Nh\u00e2n S\u1ef1\n          </label>\n          <select id=\"empInputRole\" class=\"shift-field-select\" style=\"width:100%; font-size:13.5px; font-weight:600;\">\n            <option value=\"nv\">\ud83d\udc64 Nh\u00e2n vi\u00ean si\u00eau th\u1ecb</option>\n            <option value=\"pg\">\ud83e\udd1d PG H\u00e3ng h\u1ed7 tr\u1ee3</option>\n          </select>\n        </div>\n\n        <div>\n          <label style=\"display:block; font-size:12.5px; font-weight:700; color:#78350f; margin-bottom:8px;\">\n            Tr\u1ea1ng Th\u00e1i \u0110i\u1ec3m Danh\n          </label>\n          <div style=\"display:flex; gap:20px; align-items:center;\">\n            <label style=\"display:flex; align-items:center; gap:6px; cursor:pointer; font-size:13px; font-weight:600;\">\n              <input type=\"radio\" name=\"empStatusRadio\" value=\"present\" checked> <span style=\"color:#059669;\">\u2713 C\u00f3 m\u1eb7t / \u0110ang tr\u1ef1c</span>\n            </label>\n            <label style=\"display:flex; align-items:center; gap:6px; cursor:pointer; font-size:13px; font-weight:600;\">\n              <input type=\"radio\" name=\"empStatusRadio\" value=\"absent\"> <span style=\"color:#78716c;\">\u25cb V\u1eafng m\u1eb7t</span>\n            </label>\n          </div>\n        </div>\n\n        <div id=\"empRenameAllocationsRow\" style=\"display:none; background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:10px 12px;\">\n          <label style=\"display:flex; align-items:flex-start; gap:8px; cursor:pointer; font-size:12px; color:#92400e; font-weight:600; line-height:1.4;\">\n            <input type=\"checkbox\" id=\"empSyncAllocationName\" checked style=\"margin-top:2px;\">\n            <span>\u0110\u1ed3ng th\u1eddi c\u1eadp nh\u1eadt t\u00ean m\u1edbi v\u00e0o t\u1ea5t c\u1ea3 15 ca tr\u1ef1c v\u00e0 c\u00e1c \u00f4 s\u01a1 \u0111\u1ed3 m\u1eb7t b\u1eb1ng \u0111\u00e3 g\u00e1n t\u00ean n\u00e0y</span>\n          </label>\n        </div>\n      </div>\n      <div style=\"display:flex; justify-content:flex-end; gap:10px; margin-top:18px;\">\n        <button class=\"btn btn-secondary\" id=\"btnCancelEmployeeModal\">H\u1ee7y</button>\n        <button class=\"btn btn-primary\" id=\"btnSaveEmployeeModal\" style=\"background: linear-gradient(135deg, #f59e0b, #d97706);\">\n          <i class=\"fa-solid fa-floppy-disk\"></i> L\u01b0u Th\u00f4ng Tin\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL X\u00c1C NH\u1eacN X\u00d3A NV / PG -->\n  <div class=\"modal-overlay\" id=\"deleteEmployeeModal\">\n    <div class=\"modal-box\" style=\"max-width: 440px;\">\n      <div class=\"modal-title\">\n        <span style=\"color:#dc2626;\"><i class=\"fa-solid fa-triangle-exclamation\"></i> X\u00e1c Nh\u1eadn X\u00f3a Nh\u00e2n S\u1ef1</span>\n        <button class=\"btn-icon\" id=\"btnCloseDeleteModal\" style=\"width:28px;height:28px;\"><i class=\"fa-solid fa-xmark\"></i></button>\n      </div>\n      <div style=\"font-size:13.5px; color:#44403c; line-height:1.6; margin-top:12px;\">\n        <p>B\u1ea1n c\u00f3 ch\u1eafc ch\u1eafn mu\u1ed1n x\u00f3a nh\u00e2n s\u1ef1 <strong id=\"deleteEmpNameSpan\" style=\"color:#dc2626; font-size:14.5px;\"></strong> kh\u1ecfi danh s\u00e1ch?</p>\n        <div style=\"font-size:12px; color:#78716c; margin-top:10px; background:#fef2f2; padding:10px 12px; border-radius:8px; border:1px solid #fecaca; display:flex; gap:8px; align-items:flex-start;\">\n          <i class=\"fa-solid fa-circle-info\" style=\"color:#dc2626; margin-top:2px;\"></i>\n          <span>H\u1ec7 th\u1ed1ng s\u1ebd t\u1ef1 \u0111\u1ed9ng c\u1eadp nh\u1eadt l\u1ea1i s\u1ed1 th\u1ee9 t\u1ef1 (STT) li\u00ean t\u1ee5c v\u00e0 \u0111\u1ed3ng b\u1ed9 l\u00ean Google Sheet.</span>\n        </div>\n      </div>\n      <div style=\"display:flex; justify-content:flex-end; gap:10px; margin-top:18px;\">\n        <button class=\"btn btn-secondary\" id=\"btnCancelDeleteModal\">H\u1ee7y B\u1ecf</button>\n        <button class=\"btn btn-primary\" id=\"btnConfirmDeleteModal\" style=\"background:#dc2626; border-color:#b91c1c;\">\n          <i class=\"fa-solid fa-trash-can\"></i> X\u00f3a Kh\u1ecfi Danh S\u00e1ch\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL C\u1ea4U H\u00ccNH WEB APP URL -->\n  <div class=\"modal-overlay\" id=\"configModal\">\n    <div class=\"modal-box\">\n      <div class=\"modal-title\">\n        <span><i class=\"fa-solid fa-sliders\"></i> C\u00e0i \u0110\u1eb7t K\u1ebft N\u1ed1i Web App</span>\n        <button class=\"btn-icon\" id=\"btnCloseConfigModal\" style=\"width:28px;height:28px;\"><i class=\"fa-solid fa-xmark\"></i></button>\n      </div>\n      <p style=\"font-size:12.5px; color:var(--text-muted); margin-bottom:14px;\">\n        D\u00e1n URL Web App tri\u1ec3n khai t\u1eeb Google Apps Script \u0111\u1ec3 k\u00edch ho\u1ea1t t\u00ednh n\u0103ng l\u01b0u t\u1ef1 \u0111\u1ed9ng 2 chi\u1ec1u v\u1ec1 Google Sheet.\n      </p>\n      <div style=\"margin-bottom:14px;\">\n        <label style=\"font-size:12px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:5px;\">URL Web App Apps Script</label>\n        <input type=\"text\" id=\"cfgWebAppUrl\" class=\"shift-field-input\" placeholder=\"https://script.google.com/macros/s/.../exec\">\n      </div>\n      <div style=\"display:flex; justify-content:flex-end; gap:8px;\">\n        <button class=\"btn btn-secondary\" onclick=\"document.getElementById('configModal').style.display='none'\">H\u1ee7y</button>\n        <button class=\"btn btn-primary\" id=\"btnSaveConfig\">L\u01b0u C\u1ea5u H\u00ecnh</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- N\u00daT CU\u1ed8N L\u00caN \u0110\u1ea6U TRANG TR\u00caN MOBILE -->\n  <button class=\"btn-scroll-top\" id=\"btnScrollTop\" title=\"L\u00ean \u0111\u1ea7u trang\">\n    <i class=\"fa-solid fa-arrow-up\"></i>\n  </button>\n\n  <!-- JAVASCRIPT LOGIC & REALTIME SYNC -->\n  <script>\n    const CLIENT_ID = 'client_1841_' + Math.random().toString(36).substring(2, 9);\n    let lastLocalEditTime = 0;\n\n    const DEFAULT_CONFIG = {\n      sheetId: \"1z6vAzHRIrYihI91Yw1dMnluPPL0BuAYiZarPBD5qNfw\",\n      webAppUrl: \"https://script.google.com/macros/s/AKfycbx0FkqSMkIymq7Le4L3lkHJ_33y35zQOfAev-4b-BMJdL1MCUIIVGvjLqd9dk8PIhwjSw/exec\",\n      mqttBrokers: [\n        \"wss://broker.hivemq.com:8884/mqtt\",\n        \"wss://broker.emqx.io:8084/mqtt\",\n        \"wss://test.mosquitto.org:8081/mqtt\"\n      ],\n      mqttBroker: \"wss://broker.hivemq.com:8884/mqtt\",\n      mqttTopic: \"st1841/vesinh/realtime_sync_v2\"\n    };\n    localStorage.setItem('phancong_webapp_url', DEFAULT_CONFIG.webAppUrl);\n\n    // C\u1eadp nh\u1eadt tr\u1ea1ng th\u00e1i k\u1ebft n\u1ed1i & \u0111\u1ed3ng b\u1ed9 tr\u00ean thanh ti\u00eau \u0111\u1ec1\n    function setSyncStatus(stateType, text) {\n      const pill = document.getElementById('realtimeStatusPill');\n      const txt = document.getElementById('realtimeStatusText');\n      if (pill) {\n        pill.classList.remove('syncing', 'connected', 'offline');\n        pill.classList.add(stateType);\n      }\n      if (txt) {\n        txt.textContent = text;\n      }\n    }\n\n    const state = {\n      activeTab: 'floorMapTab',\n      shifts: [],\n      employees: [],\n      searchKeyword: '',\n      empSearchKeyword: '',\n      pendingDeleteEmpIndex: -1,\n      spotlightStaff: null,\n      colorByStaffMode: false,\n      showShiftTagsMode: false,\n      mySavedStaff: localStorage.getItem('st1841_my_staff') || '',\n      zoomMode: (window.innerWidth < 1200) ? 'fit' : 'actual',\n      currentZoom: 1\n    };\n\n    // B\u1ea3ng 14 h\u1ec7 m\u00e0u pastel h\u00e0i h\u00f2a, t\u01b0\u01a1ng ph\u1ea3n cao \u0111\u1ec3 ph\u00e2n bi\u1ec7t c\u00e1c nh\u00e2n s\u1ef1\n    const STAFF_PALETTES = [\n      { name: 'Xanh Da Tr\u1eddi', bg: '#e0f2fe', border: '#7dd3fc', text: '#0369a1', dot: '#0ea5e9' },\n      { name: 'T\u00edm Lavender', bg: '#f3e8ff', border: '#d8b4fe', text: '#6b21a8', dot: '#a855f7' },\n      { name: 'Xanh B\u1ea1c H\u00e0', bg: '#dcfce7', border: '#86efac', text: '#166534', dot: '#22c55e' },\n      { name: 'Cam H\u1ed5 Ph\u00e1ch', bg: '#ffedd5', border: '#fdba74', text: '#9a3412', dot: '#f97316' },\n      { name: 'H\u1ed3ng \u0110\u00e0o Coral', bg: '#ffe4e6', border: '#fda4af', text: '#9f1239', dot: '#f43f5e' },\n      { name: 'Xanh Ng\u1ecdc (Teal)', bg: '#ccfbf1', border: '#5eead4', text: '#115e59', dot: '#14b8a6' },\n      { name: 'V\u00e0ng M\u1eadt Ong', bg: '#fef08a', border: '#facc15', text: '#854d0e', dot: '#eab308' },\n      { name: 'Xanh Ch\u00e0m Indigo', bg: '#e0e7ff', border: '#a5b4fc', text: '#3730a3', dot: '#6366f1' },\n      { name: 'H\u1ed3ng C\u00e1nh Sen', bg: '#fce7f3', border: '#f9a8d4', text: '#9d174d', dot: '#ec4899' },\n      { name: 'Xanh L\u1ee5c Emerald', bg: '#ecfdf5', border: '#a7f3d0', text: '#047857', dot: '#059669' },\n      { name: 'N\u00e2u V\u00e0ng \u1ea4m', bg: '#fef3c7', border: '#fde68a', text: '#78350f', dot: '#d97706' },\n      { name: 'T\u00edm C\u1ea9m Qu\u1ef3', bg: '#ede9fe', border: '#c4b5fd', text: '#5b21b6', dot: '#8b5cf6' },\n      { name: 'Lam \u0110\u1eadm Slate', bg: '#f1f5f9', border: '#cbd5e1', text: '#334155', dot: '#64748b' },\n      { name: 'Xanh Bi\u1ec3n Cyan', bg: '#cffafe', border: '#67e8f9', text: '#0e7490', dot: '#06b6d4' }\n    ];\n\n    function getPaletteForStaff(staffName) {\n      if (!staffName || !staffName.trim()) return STAFF_PALETTES[0];\n      const clean = staffName.trim().toUpperCase();\n      let hash = 0;\n      for (let i = 0; i < clean.length; i++) {\n        hash = (hash << 5) - hash + clean.charCodeAt(i);\n        hash |= 0;\n      }\n      const idx = Math.abs(hash) % STAFF_PALETTES.length;\n      return STAFF_PALETTES[idx];\n    }\n\n    // Kh\u1edfi t\u1ea1o 15 ca tr\u1ef1c m\u1eb7c \u0111\u1ecbnh t\u1eeb Sheet\n    const DEFAULT_SHIFTS = [\n      { stt: 1, row: 17, nv: \"L\u00ca \u00c1NH\", kv: \"ALL KHU V\u1ef0C ICT\", pg: \"PG ICT\" },\n      { stt: 2, row: 18, nv: \"H\u1ea0NH\", kv: \"TIVI 1,2,3, V\u00c1CH SONY, V\u00c1CH SS\", pg: \"OANH LG\" },\n      { stt: 3, row: 19, nv: \"H\u00d9NG M\u1ea0NH\", kv: \"TIVI 4,5, LOA, V\u00c1CH LG\", pg: \"\" },\n      { stt: 4, row: 20, nv: \"NH\u1ea0N\", kv: \"M\u00c1Y GI\u1eb6T 1,2,3\", pg: \"TRANG / -\" },\n      { stt: 5, row: 21, nv: \"KIM M\u1ef8\", kv: \"M\u00c1Y GI\u1eb6T 4,5,6\", pg: \"\" },\n      { stt: 6, row: 22, nv: \"DI\u1ec4M MY\", kv: \"V\u00c1CH ML, D\u00c0N M\u01af\u1edaP, T\u1ee6 \u0110\u00d4NG\", pg: \"-\" },\n      { stt: 7, row: 23, nv: \"\u00c1NH\", kv: \"ALL V\u00c1CH GD \u00c1P T\u01af\u1edcNG, CH\u1ea2O, N\u1ed2I CHI\u00caN\", pg: \"PG KAROFI\" },\n      { stt: 8, row: 24, nv: \"DUY\", kv: \"L\u1eccC N\u01af\u1edaC, GIA D\u1ee4NG 1\", pg: \"HI MUTOSHI\" },\n      { stt: 9, row: 25, nv: \"\u00dd\", kv: \"GIA D\u1ee4NG 2,3\", pg: \"\" },\n      { stt: 10, row: 26, nv: \"- MI\", kv: \"GIA D\u1ee4NG 4,5\", pg: \"B\u0102NG BLUE\" },\n      { stt: 11, row: 27, nv: \"TH\u1eaeM\", kv: \"GIA D\u1ee4NG 6,7\", pg: \"TRINH SUN\" },\n      { stt: 12, row: 28, nv: \"THANH NHI\", kv: \"T\u1ee6 L\u1ea0NH 1,2\", pg: \"T\u00cdN TCL\" },\n      { stt: 13, row: 29, nv: \"PH\u00daC\", kv: \"T\u1ee6 L\u1ea0NH 3,4\", pg: \"\u0110\u01af\u1ee2C\" },\n      { stt: 14, row: 30, nv: \"\u0110\u1ea0I\", kv: \"ALL V\u00c1CH T\u1ee6 L\u1ea0NH\", pg: \"\" },\n      { stt: 15, row: 31, nv: \"LINH + L\u00caN T\u0110KH\", kv: \"V\u00c1CH K\u00cdNH - S\u00c2N XE - BANNER\", pg: \"\" }\n    ];\n\n    const DEFAULT_EMPLOYEES = [\n      { stt: 1, name: \"Hu\u1ef3nh Ho\u00e0ng Ph\u00fac\", role: \"nv\", marked: true },\n      { stt: 2, name: \"L\u00e2m Th\u1ecb Nh\u01b0 \u00dd\", role: \"nv\", marked: true },\n      { stt: 3, name: \"L\u00ea Kim M\u1ef9\", role: \"nv\", marked: true },\n      { stt: 4, name: \"Ng\u00f4 Th\u1ecb B\u00e9 Th\u1eafm\", role: \"nv\", marked: true },\n      { stt: 5, name: \"Nguy\u1ec5n Di\u1ec5m My\", role: \"nv\", marked: true },\n      { stt: 6, name: \"Nguy\u1ec5n H\u00f9ng M\u1ea1nh\", role: \"nv\", marked: true },\n      { stt: 7, name: \"Nguy\u1ec5n Tu\u1ea5n Mi\", role: \"nv\", marked: true },\n      { stt: 8, name: \"Nguy\u1ec5n Th\u1ecb Nh\u1ea1n\", role: \"nv\", marked: true },\n      { stt: 9, name: \"Ph\u1ea1m Ng\u1ecdc Anh\", role: \"nv\", marked: true },\n      { stt: 10, name: \"Ph\u1ea1m V\u0103n \u0110\u1ea1i\", role: \"nv\", marked: true },\n      { stt: 11, name: \"Trang - Toshiba\", role: \"pg\", marked: true },\n      { stt: 12, name: \"Thanh - Xiaomi\", role: \"pg\", marked: true },\n      { stt: 13, name: \"Trinh - Sunhouse\", role: \"pg\", marked: true },\n      { stt: 14, name: \"Trung T\u00edn - LG\", role: \"pg\", marked: true },\n      { stt: 15, name: \"Ng\u1ecdc Tr\u00e2m - Realme\", role: \"pg\", marked: true },\n      { stt: 16, name: \"Anh Th\u01b0 - Oppo\", role: \"pg\", marked: true },\n      { stt: 17, name: \"Lam - Karofi\", role: \"pg\", marked: true },\n      { stt: 18, name: \"Giang Nh\u01b0 \u00dd\", role: \"nv\", marked: true },\n      { stt: 19, name: \"Xuy\u00ean - Aqua\", role: \"pg\", marked: true },\n      { stt: 20, name: \"Khang Hi\", role: \"nv\", marked: true },\n      { stt: 21, name: \"Th\u00e0nh \u0110\u01b0\u1ee3c\", role: \"nv\", marked: true }\n    ];\n\n    try {\n      const storedShifts = JSON.parse(localStorage.getItem('st1841_shifts'));\n      state.shifts = (Array.isArray(storedShifts) && storedShifts.length > 0) ? storedShifts : DEFAULT_SHIFTS;\n    } catch(e) {\n      state.shifts = DEFAULT_SHIFTS;\n    }\n\n    // T\u1ef1 \u0111\u1ed9ng l\u00e0m s\u1ea1ch ca tr\u1ef1c n\u1ebfu b\u1ed9 nh\u1edb \u0111\u1ec7m c\u0169 t\u1eebng l\u01b0u nh\u1ea7m d\u00f2ng ti\u00eau \u0111\u1ec1\n    if (Array.isArray(state.shifts) && state.shifts.length > 0) {\n      if (state.shifts[0].nv === 'NH\u00c2N VI\u00caN TR\u1ef0C' || state.shifts[0].kv === 'KHU V\u1ef0C PH\u1ee4 TR\u00c1CH') {\n        state.shifts.shift();\n      }\n      if (state.shifts.length < 15) {\n        state.shifts = DEFAULT_SHIFTS;\n      }\n    }\n\n    try {\n      const storedEmps = JSON.parse(localStorage.getItem('st1841_employees'));\n      state.employees = (Array.isArray(storedEmps) && storedEmps.length > 0) ? storedEmps : DEFAULT_EMPLOYEES;\n    } catch(e) {\n      state.employees = DEFAULT_EMPLOYEES;\n    }\n\n    function showToast(msg) {\n      const container = document.getElementById('toastContainer');\n      const toast = document.createElement('div');\n      toast.className = 'toast-msg';\n      toast.innerHTML = '<i class=\"fa-solid fa-circle-info\" style=\"color:#f59e0b;\"></i> ' + msg;\n      container.appendChild(toast);\n      setTimeout(() => {\n        toast.style.opacity = '0';\n        toast.style.transform = 'translateY(10px)';\n        toast.style.transition = 'all 0.3s ease';\n        setTimeout(() => toast.remove(), 300);\n      }, 2600);\n    }\n\n    // RENDER 15 CA TR\u1ef0C (N\u1ebeU C\u00d3 CONTAINER)\n    function renderShifts() {\n      const assignedCount = state.shifts.filter(s => s && s.nv && s.nv.trim() !== '').length;\n      const badgeShift = document.getElementById('badgeShiftCount');\n      if (badgeShift) {\n        badgeShift.textContent = `${assignedCount}/15 V\u1ecb tr\u00ed`;\n      }\n\n      const container = document.getElementById('shiftsCardsContainer');\n      if (!container) return;\n      container.innerHTML = '';\n\n      state.shifts.forEach((s, idx) => {\n        const isAssigned = s.nv && s.nv.trim() !== '';\n        const card = document.createElement('div');\n        card.className = 'shift-card ' + (isAssigned ? 'assigned' : 'empty');\n        card.innerHTML = `\n          <div class=\"shift-card-header\">\n            <span class=\"shift-num\">#${s.stt || (idx + 1)}</span>\n            <span class=\"shift-status-tag ${isAssigned ? 'assigned' : 'empty'}\">\n              ${isAssigned ? '\u2713 \u0110\u00e3 ph\u00e2n c\u00f4ng' : 'Ch\u01b0a ph\u00e2n c\u00f4ng'}\n            </span>\n          </div>\n          <div class=\"shift-field-group\">\n            <label class=\"shift-field-label\"><i class=\"fa-solid fa-user\"></i> Nh\u00e2n Vi\u00ean Tr\u1ef1c</label>\n            <input type=\"text\" class=\"shift-field-input\" value=\"${s.nv || ''}\" placeholder=\"Nh\u1eadp t\u00ean nh\u00e2n vi\u00ean tr\u1ef1c...\" onchange=\"updateShiftField(${idx}, 'nv', this.value)\">\n          </div>\n          <div class=\"shift-field-group\">\n            <label class=\"shift-field-label\"><i class=\"fa-solid fa-location-dot\"></i> Khu V\u1ef1c Ph\u1ee5 Tr\u00e1ch</label>\n            <input type=\"text\" class=\"shift-field-input\" value=\"${s.kv || ''}\" placeholder=\"Khu v\u1ef1c tr\u1ef1c...\" onchange=\"updateShiftField(${idx}, 'kv', this.value)\">\n          </div>\n          <div class=\"shift-field-group\">\n            <label class=\"shift-field-label\"><i class=\"fa-solid fa-handshake\"></i> PG H\u1ed7 Tr\u1ee3 H\u00e3ng</label>\n            <input type=\"text\" class=\"shift-field-input\" value=\"${s.pg || ''}\" placeholder=\"PG h\u1ed7 tr\u1ee3...\" onchange=\"updateShiftField(${idx}, 'pg', this.value)\">\n          </div>\n          <div style=\"font-size:11px; color:#78716c; display:flex; justify-content:space-between; margin-top:2px;\">\n            <span>D\u00f2ng Sheet: ${s.row || (16 + s.stt)}</span>\n            <span style=\"color:#d97706; font-weight:600;\"><i class=\"fa-solid fa-bolt\"></i> T\u1ef1 \u0111\u1ed9ng l\u01b0u</span>\n          </div>\n        `;\n        container.appendChild(card);\n      });\n    }\n\n    // HELPER: PH\u00c2N LO\u1ea0I PG H\u00c3NG HO\u1eb6C NH\u00c2N VI\u00caN\n    function isPgStaff(emp) {\n      if (!emp) return false;\n      if (emp.role === 'pg') return true;\n      if (emp.role === 'nv') return false;\n      const name = (emp.name || '').toLowerCase();\n      const pgKeywords = ['pg', 'tcl', 'lg', 'oppo', 'vivo', 'realme', 'xiaomi', 'aqua', 'toshiba', 'sunhouse', 'bluestone', 'karofi', 'mutosi', 'sony', 'samsung'];\n      return pgKeywords.some(kw => name.includes(kw));\n    }\n\n    // HELPER T\u1ea0O CARD HTML CHO NH\u00c2N S\u1ef0\n    function createEmployeeCardElement(emp) {\n      if (!emp) return document.createElement('div');\n      const originalIdx = state.employees.indexOf(emp);\n      const isPg = isPgStaff(emp);\n      const isMarked = (emp.marked === true || emp.marked === 'X' || emp.marked === '1' || emp.marked === 'TRUE');\n      const card = document.createElement('div');\n      card.className = 'employee-card ' + (isMarked ? 'present' : '');\n      const stt = (emp.stt != null && !isNaN(emp.stt)) ? emp.stt : (originalIdx + 1);\n      const name = emp.name || 'Ch\u01b0a \u0111\u1eb7t t\u00ean';\n      card.innerHTML = `\n        <div class=\"emp-info\">\n          <div class=\"emp-stt\">${stt}</div>\n          <div>\n            <div class=\"emp-name\">${name}</div>\n            <div style=\"display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:2px;\">\n              <span class=\"emp-role-badge ${isPg ? 'role-pg' : 'role-nv'}\">\n                ${isPg ? '<i class=\"fa-solid fa-handshake\"></i> PG H\u00e3ng' : '<i class=\"fa-solid fa-user\"></i> NV Si\u00eau Th\u1ecb'}\n              </span>\n              <span style=\"font-size:11px; color:var(--text-muted);\">\n                ${isMarked ? '<span style=\"color:#059669; font-weight:700;\">\u2713 C\u00f3 m\u1eb7t</span>' : 'V\u1eafng m\u1eb7t'}\n              </span>\n            </div>\n          </div>\n        </div>\n        <div class=\"emp-actions-group\">\n          <button class=\"btn-toggle-attend ${isMarked ? 'checked' : 'unchecked'}\" onclick=\"toggleEmployeeAttendance(${originalIdx >= 0 ? originalIdx : 0})\" title=\"\u0110i\u1ec3m danh c\u00f3 m\u1eb7t / v\u1eafng\">\n            ${isMarked ? '\u2713 C\u00f3 m\u1eb7t' : '\u25cb V\u1eafng'}\n          </button>\n          <button class=\"btn-action-icon edit\" onclick=\"openEditEmployeeModal(${originalIdx >= 0 ? originalIdx : 0})\" title=\"S\u1eeda th\u00f4ng tin\">\n            <i class=\"fa-solid fa-pen-to-square\"></i>\n          </button>\n          <button class=\"btn-action-icon delete\" onclick=\"confirmDeleteEmployee(${originalIdx >= 0 ? originalIdx : 0})\" title=\"Xo\u00e1 kh\u1ecfi danh s\u00e1ch\">\n            <i class=\"fa-solid fa-trash-can\"></i>\n          </button>\n        </div>\n      `;\n      return card;\n    }\n\n    // RENDER DANH S\u00c1CH NV / PG CHIA L\u00c0M 2 C\u1ed8T (NH\u00c2N VI\u00caN B\u00caN TR\u00c1I, PG B\u00caN PH\u1ea2I)\n    function renderEmployees() {\n      try {\n        const staffContainer = document.getElementById('staffNvGridContainer');\n        const pgContainer = document.getElementById('staffPgGridContainer');\n        if (!staffContainer || !pgContainer) return;\n\n        staffContainer.innerHTML = '';\n        pgContainer.innerHTML = '';\n\n        if (!Array.isArray(state.employees) || state.employees.length === 0) {\n          state.employees = DEFAULT_EMPLOYEES;\n        }\n\n        let presentCount = 0;\n        let pgCount = 0;\n        let staffNvPresent = 0;\n        let staffPgPresent = 0;\n\n        state.employees.forEach((emp) => {\n          if (!emp) return;\n          const isPg = isPgStaff(emp);\n          const isMarked = (emp.marked === true || emp.marked === 'X' || emp.marked === '1' || emp.marked === 'TRUE');\n          if (isPg) {\n            pgCount++;\n            if (isMarked) staffPgPresent++;\n          } else {\n            if (isMarked) staffNvPresent++;\n          }\n          if (isMarked) presentCount++;\n        });\n\n        const totalEmployees = state.employees.length;\n        const staffNvCount = Math.max(0, totalEmployees - pgCount);\n        const absentCount = Math.max(0, totalEmployees - presentCount);\n\n        // L\u1ecdc danh s\u00e1ch theo t\u1eeb kh\u00f3a t\u00ecm ki\u1ebfm n\u1ebfu c\u00f3\n        const kw = (state.empSearchKeyword || '').trim().toLowerCase();\n        const displayList = kw \n          ? state.employees.filter(emp => (emp && emp.name || '').toLowerCase().includes(kw))\n          : state.employees;\n\n        const staffNvList = displayList.filter(emp => !isPgStaff(emp));\n        const staffPgList = displayList.filter(emp => isPgStaff(emp));\n\n        // 1. Render C\u1ed9t Nh\u00e2n Vi\u00ean Si\u00eau Th\u1ecb (B\u00ean Tr\u00e1i)\n        if (staffNvList.length === 0) {\n          staffContainer.innerHTML = `\n            <div style=\"grid-column: 1 / -1; text-align: center; padding: 24px 14px; color: #78716c; background: #f8fafc; border-radius: 10px; border: 1.5px dashed #cbd5e1;\">\n              <i class=\"fa-solid fa-user-slash\" style=\"font-size: 24px; color: #94a3b8; margin-bottom: 6px;\"></i>\n              <div style=\"font-weight: 700; font-size: 13.5px; color: #475569;\">Kh\u00f4ng c\u00f3 nh\u00e2n vi\u00ean si\u00eau th\u1ecb n\u00e0o</div>\n              <div style=\"font-size: 11.5px; margin-top: 2px;\">B\u1ea5m \"Th\u00eam NV\" \u0111\u1ec3 th\u00eam nh\u00e2n s\u1ef1 v\u00e0o c\u1ed9t n\u00e0y</div>\n            </div>\n          `;\n        } else {\n          staffNvList.forEach(emp => {\n            staffContainer.appendChild(createEmployeeCardElement(emp));\n          });\n        }\n\n        // 2. Render C\u1ed9t PG H\u1ed7 Tr\u1ee3 H\u00e3ng (B\u00ean Ph\u1ea3i)\n        if (staffPgList.length === 0) {\n          pgContainer.innerHTML = `\n            <div style=\"grid-column: 1 / -1; text-align: center; padding: 24px 14px; color: #78716c; background: #fff5f8; border-radius: 10px; border: 1.5px dashed #fbcfe8;\">\n              <i class=\"fa-solid fa-handshake-slash\" style=\"font-size: 24px; color: #f472b6; margin-bottom: 6px;\"></i>\n              <div style=\"font-weight: 700; font-size: 13.5px; color: #9d174d;\">Kh\u00f4ng c\u00f3 PG h\u00e3ng n\u00e0o</div>\n              <div style=\"font-size: 11.5px; margin-top: 2px;\">B\u1ea5m \"Th\u00eam PG\" \u0111\u1ec3 th\u00eam PG v\u00e0o c\u1ed9t n\u00e0y</div>\n            </div>\n          `;\n        } else {\n          staffPgList.forEach(emp => {\n            pgContainer.appendChild(createEmployeeCardElement(emp));\n          });\n        }\n\n        // 3. C\u1eadp nh\u1eadt Badge s\u1ed1 l\u01b0\u1ee3ng t\u1eebng c\u1ed9t\n        const badgeStaff = document.getElementById('badgeColumnStaffCount');\n        if (badgeStaff) badgeStaff.textContent = `${staffNvCount} NV (${staffNvPresent} c\u00f3 m\u1eb7t)`;\n\n        const badgePg = document.getElementById('badgeColumnPgCount');\n        if (badgePg) badgePg.textContent = `${pgCount} PG (${staffPgPresent} c\u00f3 m\u1eb7t)`;\n\n        // 4. C\u1eadp nh\u1eadt c\u00e1c th\u1ebb th\u1ed1ng k\u00ea t\u1ed5ng\n        const totalEl = document.getElementById('statTotalEmployees');\n        if (totalEl) totalEl.textContent = totalEmployees;\n\n        const presentEl = document.getElementById('statPresentCount');\n        if (presentEl) presentEl.textContent = presentCount;\n\n        const pgEl = document.getElementById('statPgCount');\n        if (pgEl) pgEl.textContent = pgCount;\n\n        const absentEl = document.getElementById('statAbsentCount');\n        if (absentEl) absentEl.textContent = absentCount;\n\n        const badgeEl = document.getElementById('badgeEmpCount');\n        if (badgeEl) badgeEl.textContent = `${totalEmployees} NV/PG`;\n      } catch (err) {\n        console.error('L\u1ed7i khi render danh s\u00e1ch nh\u00e2n s\u1ef1:', err);\n      }\n    }\n\n    // C\u1eacP NH\u1eacT 1 TR\u01af\u1edcNG CA TR\u1ef0C\n    window.updateShiftField = function(idx, field, value) {\n      state.shifts[idx][field] = value.trim();\n      localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n      if (typeof syncMapCellsFromShifts === 'function') syncMapCellsFromShifts();\n      notifyLocalDataChange('UPDATE_SHIFT', { index: idx, data: state.shifts[idx] });\n    };\n\n    // H\u00c0M ESCAPE REGEX AN TO\u00c0N\n    function escapeRegExp(str) {\n      if (!str) return '';\n      return String(str).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    }\n\n    // CHU\u1ea8N HO\u00c1 CHU\u1ed6I \u0110\u1ec2 SO S\u00c1NH T\u00caN KH\u00d4NG D\u1ea4U V\u00c0 T\u00ccM T\u1eea CH\u00cdNH X\u00c1C\n    function normalizeNameForMatch(str) {\n      if (!str) return '';\n      return String(str).toLowerCase()\n        .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n        .replace(/[^a-z0-9]/g, ' ')\n        .replace(/\\s+/g, ' ')\n        .trim();\n    }\n\n    // SO S\u00c1NH T\u00caN TH\u00d4NG MINH (CH\u00cdNH X\u00c1C, VI\u1ebeT HOA/TH\u01af\u1edcNG, HO\u1eb6C BI\u1ebeN TH\u1ec2 T\u00caN G\u1eccI)\n    function isStaffNameMatch(candidate, target) {\n      if (!candidate || !target) return false;\n      const c = String(candidate).trim().toUpperCase();\n      const t = String(target).trim().toUpperCase();\n      if (c === t) return true;\n\n      const normC = normalizeNameForMatch(candidate);\n      const normT = normalizeNameForMatch(target);\n      if (!normC || !normT) return false;\n      if (normC === normT) return true;\n\n      // Ki\u1ec3m tra kh\u1edbp t\u1eeb nguy\u00ean v\u1eb9n ho\u1eb7c ch\u1ee9a t\u00ean nhau\n      if (normT.length >= 3 && new RegExp('(^|\\\\s)' + escapeRegExp(normT) + '($|\\\\s)').test(normC)) return true;\n      if (normC.length >= 3 && new RegExp('(^|\\\\s)' + escapeRegExp(normC) + '($|\\\\s)').test(normT)) return true;\n      if (c.includes(t) && t.length >= 3) return true;\n      if (t.includes(c) && c.length >= 3) return true;\n\n      return false;\n    }\n\n    // KH\u1edeI T\u1ea0O V\u00c0 C\u1eacP NH\u1eacT T\u1ea4T C\u1ea2 DROPDOWN DANH S\u00c1CH NH\u00c2N S\u1ef0\n    function initModalDropdowns() {\n      const dropdown = document.getElementById('modalStaffDropdown');\n      if (dropdown) {\n        const curVal = dropdown.value;\n        dropdown.innerHTML = '<option value=\"\">-- Ch\u1ecdn t\u1eeb ' + (state.employees ? state.employees.length : 26) + ' NV/PG si\u00eau th\u1ecb --</option>';\n        (state.employees || []).forEach(emp => {\n          const opt = document.createElement('option');\n          opt.value = emp.name;\n          opt.textContent = emp.stt + '. ' + emp.name + (emp.role === 'pg' ? ' [PG]' : '');\n          dropdown.appendChild(opt);\n        });\n        if (curVal) dropdown.value = curVal;\n      }\n    }\n\n    // C\u1eacP NH\u1eacT T\u00caN NH\u00c2N VI\u00caN M\u1edaI TR\u00caN TO\u00c0N B\u1ed8 15 CA TR\u1ef0C V\u00c0 S\u01a0 \u0110\u1ed2 M\u1eb6T B\u1eb0NG\n    function updateAllAssignmentsWithNewName(oldName, newName) {\n      if (!oldName || !newName) return;\n      const oName = String(oldName).trim();\n      const nName = String(newName).trim();\n      if (!oName || !nName || oName.toUpperCase() === nName.toUpperCase()) return;\n\n      const reg = new RegExp(escapeRegExp(oName), 'gi');\n\n      // 1. C\u1eadp nh\u1eadt trong 15 ca tr\u1ef1c (c\u1ea3 tr\u01b0\u1eddng NV v\u00e0 PG)\n      let shiftsModified = false;\n      if (Array.isArray(state.shifts)) {\n        state.shifts.forEach(s => {\n          if (s.nv) {\n            if (s.nv.trim().toUpperCase() === oName.toUpperCase()) {\n              s.nv = nName;\n              shiftsModified = true;\n            } else if (reg.test(s.nv)) {\n              s.nv = s.nv.replace(reg, nName);\n              shiftsModified = true;\n            } else if (isStaffNameMatch(s.nv, oName)) {\n              s.nv = nName;\n              shiftsModified = true;\n            }\n          }\n          if (s.pg) {\n            if (s.pg.trim().toUpperCase() === oName.toUpperCase()) {\n              s.pg = nName;\n              shiftsModified = true;\n            } else if (reg.test(s.pg)) {\n              s.pg = s.pg.replace(reg, nName);\n              shiftsModified = true;\n            } else if (isStaffNameMatch(s.pg, oName)) {\n              s.pg = nName;\n              shiftsModified = true;\n            }\n          }\n        });\n      }\n\n      if (shiftsModified) {\n        localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n        renderShifts();\n      }\n\n      // 2. C\u1eadp nh\u1eadt tr\u00ean t\u1ea5t c\u1ea3 c\u00e1c \u00f4 s\u01a1 \u0111\u1ed3 m\u1eb7t b\u1eb1ng (.map-cell)\n      let mapModified = false;\n      document.querySelectorAll('.map-cell').forEach(c => {\n        const staffAttr = (c.getAttribute('data-staff') || '').trim();\n        if (!staffAttr) return;\n        if (staffAttr.toUpperCase() === oName.toUpperCase()) {\n          c.setAttribute('data-staff', nName);\n          const staffEl = c.querySelector('.cell-staff');\n          if (staffEl) staffEl.textContent = nName;\n          mapModified = true;\n        } else if (reg.test(staffAttr)) {\n          const updatedStaff = staffAttr.replace(reg, nName);\n          c.setAttribute('data-staff', updatedStaff);\n          const staffEl = c.querySelector('.cell-staff');\n          if (staffEl) staffEl.textContent = updatedStaff;\n          mapModified = true;\n        } else if (isStaffNameMatch(staffAttr, oName)) {\n          c.setAttribute('data-staff', nName);\n          const staffEl = c.querySelector('.cell-staff');\n          if (staffEl) staffEl.textContent = nName;\n          mapModified = true;\n        }\n      });\n\n      // 3. \u0110\u1ed3ng b\u1ed9 l\u1ea1i s\u01a1 \u0111\u1ed3 theo 15 ca tr\u1ef1c v\u00e0 l\u01b0u c\u1ea5u h\u00ecnh\n      syncMapCellsFromShifts();\n      saveMapAllocations();\n\n      // 4. C\u1eadp nh\u1eadt l\u1ea1i dropdown danh s\u00e1ch\n      initModalDropdowns();\n    }\n\n    // TOGGLE \u0110I\u1ec2M DANH\n    window.toggleEmployeeAttendance = function(idx) {\n      if (!state.employees[idx]) return;\n      state.employees[idx].marked = !state.employees[idx].marked;\n      localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n      renderEmployees();\n      notifyLocalDataChange('TOGGLE_ATTENDANCE', {\n        index: idx,\n        marked: state.employees[idx].marked,\n        employees: state.employees,\n        shifts: state.shifts\n      });\n      debouncedSaveToSheet();\n    };\n\n    // ==========================================================================\n    // CH\u1ee8C N\u0102NG TH\u00caM / S\u1eecA / X\u00d3A NH\u00c2N VI\u00caN & PG\n    // ==========================================================================\n\n    // M\u1ede MODAL TH\u00caM NV/PG (H\u1ed6 TR\u1ee2 M\u1eb6C \u0110\u1ecaNH VAI TR\u00d2)\n    window.openAddEmployeeModal = function(defaultRole) {\n      const role = (defaultRole === 'pg') ? 'pg' : 'nv';\n      document.getElementById('empEditIndex').value = \"-1\";\n      document.getElementById('empInputName').value = \"\";\n      document.getElementById('empInputRole').value = role;\n      const radios = document.querySelectorAll('input[name=\"empStatusRadio\"]');\n      radios.forEach(r => r.checked = (r.value === 'present'));\n      document.getElementById('empRenameAllocationsRow').style.display = 'none';\n      \n      const titleEl = document.getElementById('employeeModalTitle');\n      if (role === 'pg') {\n        titleEl.innerHTML = '<i class=\"fa-solid fa-handshake\" style=\"color:#db2777;\"></i> Th\u00eam PG H\u00e3ng M\u1edbi';\n      } else {\n        titleEl.innerHTML = '<i class=\"fa-solid fa-user-plus\" style=\"color:#0284c7;\"></i> Th\u00eam Nh\u00e2n Vi\u00ean Si\u00eau Th\u1ecb';\n      }\n      \n      document.getElementById('employeeModal').style.display = 'flex';\n      setTimeout(() => document.getElementById('empInputName').focus(), 100);\n    };\n\n    // M\u1ede MODAL S\u1eecA NV/PG\n    window.openEditEmployeeModal = function(idx) {\n      const emp = state.employees[idx];\n      if (!emp) return;\n      document.getElementById('empEditIndex').value = String(idx);\n      document.getElementById('empInputName').value = emp.name;\n      document.getElementById('empInputRole').value = emp.role || (isPgStaff(emp) ? 'pg' : 'nv');\n      const radios = document.querySelectorAll('input[name=\"empStatusRadio\"]');\n      radios.forEach(r => r.checked = (emp.marked ? r.value === 'present' : r.value === 'absent'));\n      document.getElementById('empRenameAllocationsRow').style.display = 'block';\n      document.getElementById('empSyncAllocationName').checked = true;\n      document.getElementById('employeeModalTitle').innerHTML = `<i class=\"fa-solid fa-user-pen\" style=\"color:#d97706;\"></i> Ch\u1ec9nh S\u1eeda: ${emp.name}`;\n      document.getElementById('employeeModal').style.display = 'flex';\n      setTimeout(() => document.getElementById('empInputName').focus(), 100);\n    };\n\n    // \u0110\u00d3NG MODAL NV/PG\n    function closeEmployeeModal() {\n      document.getElementById('employeeModal').style.display = 'none';\n    }\n    const btnCloseEmpModal = document.getElementById('btnCloseEmployeeModal');\n    if (btnCloseEmpModal) btnCloseEmpModal.onclick = closeEmployeeModal;\n    const btnCancelEmpModal = document.getElementById('btnCancelEmployeeModal');\n    if (btnCancelEmpModal) btnCancelEmpModal.onclick = closeEmployeeModal;\n    const employeeModalEl = document.getElementById('employeeModal');\n    if (employeeModalEl) {\n      employeeModalEl.onclick = (e) => {\n        if (e.target.id === 'employeeModal') closeEmployeeModal();\n      };\n    }\n\n    const btnOpenAddEmp = document.getElementById('btnOpenAddEmployeeModal');\n    if (btnOpenAddEmp) btnOpenAddEmp.onclick = window.openAddEmployeeModal;\n\n    // L\u01afU MODAL TH\u00caM / S\u1eecA NV/PG\n    const btnSaveEmpModal = document.getElementById('btnSaveEmployeeModal');\n    if (btnSaveEmpModal) {\n      btnSaveEmpModal.onclick = function() {\n        const idx = parseInt(document.getElementById('empEditIndex').value, 10);\n        const newName = document.getElementById('empInputName').value.trim();\n        if (!newName) {\n          alert('Vui l\u00f2ng nh\u1eadp H\u1ecd v\u00e0 T\u00ean Nh\u00e2n Vi\u00ean / PG!');\n          document.getElementById('empInputName').focus();\n          return;\n        }\n\n        const role = document.getElementById('empInputRole').value;\n        let isMarked = true;\n        const checkedRadio = document.querySelector('input[name=\"empStatusRadio\"]:checked');\n        if (checkedRadio && checkedRadio.value === 'absent') isMarked = false;\n\n        let oldName = '';\n        if (idx === -1) {\n          // TH\u00caM M\u1edaI\n          const newEmp = {\n            stt: state.employees.length + 1,\n            name: newName,\n            role: role,\n            marked: isMarked\n          };\n          state.employees.push(newEmp);\n          showToast(`\u2705 \u0110\u00e3 th\u00eam NV/PG m\u1edbi: ${newName}`);\n        } else if (idx >= 0 && state.employees[idx]) {\n          // S\u1eecA TH\u00d4NG TIN\n          oldName = state.employees[idx].name;\n          state.employees[idx].name = newName;\n          state.employees[idx].role = role;\n          state.employees[idx].marked = isMarked;\n\n          // C\u1eadp nh\u1eadt t\u00ean li\u00ean quan tr\u00ean c\u00e1c line ca tr\u1ef1c v\u00e0 s\u01a1 \u0111\u1ed3\n          const syncNameEl = document.getElementById('empSyncAllocationName');\n          if (!syncNameEl || syncNameEl.checked) {\n            updateAllAssignmentsWithNewName(oldName, newName);\n          }\n          showToast(`\u2705 \u0110\u00e3 c\u1eadp nh\u1eadt: ${newName}`);\n        }\n\n        localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n        renderEmployees();\n        initModalDropdowns();\n\n        // \u0110\u1ed3ng b\u1ed9 realtime t\u1ee9c th\u00ec ra c\u00e1c tab / thi\u1ebft b\u1ecb\n        notifyLocalDataChange('RENAME_EMPLOYEE', {\n          oldName: oldName,\n          newName: newName,\n          employees: state.employees,\n          shifts: state.shifts\n        });\n\n        // L\u01b0u ngay l\u1eadp t\u1ee9c v\u1ec1 Google Sheet kh\u00f4ng \u0111\u1ed9 tr\u1ec5\n        saveToSheetImmediately();\n        closeEmployeeModal();\n      };\n    }\n\n    // XO\u00c1 NH\u00c2N VI\u00caN / PG\n    window.confirmDeleteEmployee = function(idx) {\n      const emp = state.employees[idx];\n      if (!emp) return;\n      state.pendingDeleteEmpIndex = idx;\n      const spanEl = document.getElementById('deleteEmpNameSpan');\n      if (spanEl) spanEl.textContent = `${emp.name} (STT ${emp.stt})`;\n      const delModal = document.getElementById('deleteEmployeeModal');\n      if (delModal) delModal.style.display = 'flex';\n    };\n\n    function closeDeleteModal() {\n      const delModal = document.getElementById('deleteEmployeeModal');\n      if (delModal) delModal.style.display = 'none';\n      state.pendingDeleteEmpIndex = -1;\n    }\n    const btnCloseDel = document.getElementById('btnCloseDeleteModal');\n    if (btnCloseDel) btnCloseDel.onclick = closeDeleteModal;\n    const btnCancelDel = document.getElementById('btnCancelDeleteModal');\n    if (btnCancelDel) btnCancelDel.onclick = closeDeleteModal;\n    const deleteModalEl = document.getElementById('deleteEmployeeModal');\n    if (deleteModalEl) {\n      deleteModalEl.onclick = (e) => {\n        if (e.target.id === 'deleteEmployeeModal') closeDeleteModal();\n      };\n    }\n\n    const btnConfirmDel = document.getElementById('btnConfirmDeleteModal');\n    if (btnConfirmDel) {\n      btnConfirmDel.onclick = function() {\n        const idx = state.pendingDeleteEmpIndex;\n        if (idx >= 0 && idx < state.employees.length) {\n          const deleted = state.employees.splice(idx, 1)[0];\n          // \u0110\u00e1nh l\u1ea1i s\u1ed1 th\u1ee9 t\u1ef1 (STT) li\u00ean t\u1ee5c t\u1eeb 1..N\n          state.employees.forEach((emp, i) => {\n            emp.stt = i + 1;\n          });\n          localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n          renderEmployees();\n          initModalDropdowns();\n          notifyLocalDataChange('SYNC_EMPLOYEES', { employees: state.employees, shifts: state.shifts });\n          saveToSheetImmediately();\n          showToast(`\ud83d\uddd1\ufe0f \u0110\u00e3 x\u00f3a \"${deleted.name}\" kh\u1ecfi danh s\u00e1ch`);\n        }\n        closeDeleteModal();\n      };\n    }\n\n    // T\u00ccM KI\u1ebeM NHANH TRONG TAB NV/PG\n    const empSearchInput = document.getElementById('employeeSearchInput');\n    if (empSearchInput) {\n      empSearchInput.addEventListener('input', function(e) {\n        state.empSearchKeyword = e.target.value.trim().toLowerCase();\n        renderEmployees();\n      });\n    }\n\n    // ==========================================================================\n    // H\u1ec6 TH\u1ed0NG \u0110\u1ed2NG B\u1ed8 & L\u01afU T\u1ee8C TH\u00cc V\u1ec0 GOOGLE SHEET (REALTIME INSTANT SYNC)\n    // ==========================================================================\n    let isSavingToSheet = false;\n    let pendingSaveAgain = false;\n    let saveDebounceTimer = null;\n\n    function debouncedSaveToSheet(customToastMsg) {\n      if (customToastMsg) {\n        showToast(customToastMsg);\n      }\n      clearTimeout(saveDebounceTimer);\n      saveDebounceTimer = setTimeout(() => {\n        saveToSheetImmediately();\n      }, 180);\n    }\n\n    function saveToSheetImmediately(customToastMsg) {\n      const url = DEFAULT_CONFIG.webAppUrl;\n      if (!url) return;\n\n      if (isSavingToSheet) {\n        pendingSaveAgain = true;\n        return;\n      }\n      isSavingToSheet = true;\n      pendingSaveAgain = false;\n\n      // C\u1eadp nh\u1eadt tr\u1ea1ng th\u00e1i hi\u1ec3n th\u1ecb tr\u00ean giao di\u1ec7n ngay l\u1eadp t\u1ee9c\n      setSyncStatus('syncing', '\u26a1 \u0110ang l\u01b0u v\u1ec1 Google Sheet...');\n      if (customToastMsg) {\n        showToast(customToastMsg);\n      }\n\n      const timestamp = Date.now();\n      lastLocalEditTime = timestamp;\n      const currentShiftsPayload = state.shifts.slice();\n      const currentEmployeesPayload = state.employees.slice();\n\n      const controller = new AbortController();\n      const timeoutId = setTimeout(() => controller.abort(), 6500);\n\n      // G\u1eedi request saveAll nguy\u00ean kh\u1ed1i \u0111\u1ed3ng th\u1eddi c\u1ea3 15 Ca tr\u1ef1c v\u00e0 Danh s\u00e1ch NV/PG\n      fetch(url, {\n        signal: controller.signal,\n        method: 'POST',\n        headers: { 'Content-Type': 'text/plain;charset=utf-8' },\n        mode: 'no-cors',\n        body: JSON.stringify({\n          action: 'saveAll',\n          sheetId: DEFAULT_CONFIG.sheetId,\n          shifts: currentShiftsPayload,\n          employees: currentEmployeesPayload,\n          _t: timestamp\n        })\n      }).then(() => {\n        clearTimeout(timeoutId);\n        isSavingToSheet = false;\n\n        // C\u1eadp nh\u1eadt m\u1ed1c nh\u1eadn di\u1ec7n th\u00e0nh c\u00f4ng \u0111\u1ec3 v\u00f2ng polling kh\u00f4ng \u0111\u00e8 d\u1eef li\u1ec7u\n        lastKnownSaveSig = JSON.stringify({\n          shifts: currentShiftsPayload.map(s => [s.nv, s.kv, s.pg]),\n          emps: currentEmployeesPayload.map(e => [e.name, e.marked])\n        });\n        lastKnownDefSig = lastKnownSaveSig;\n\n        const now = new Date();\n        const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;\n        setSyncStatus('connected', `\ud83d\udfe2 T\u1ef1 \u0111\u1ed9ng \u0111\u1ed3ng b\u1ed9 (${timeStr})`);\n\n        if (pendingSaveAgain) {\n          pendingSaveAgain = false;\n          saveToSheetImmediately();\n        }\n      }).catch(err => {\n        clearTimeout(timeoutId);\n        isSavingToSheet = false;\n        console.warn('L\u1ed7i l\u01b0u v\u1ec1 Sheet:', err);\n        setSyncStatus('connected', '\ud83d\udfe2 T\u1ef1 \u0111\u1ed9ng \u0111\u1ed3ng b\u1ed9');\n        if (pendingSaveAgain) {\n          pendingSaveAgain = false;\n          saveToSheetImmediately();\n        }\n      });\n    }\n\n    // C\u00e1c h\u00e0m t\u01b0\u01a1ng th\u00edch ng\u01b0\u1ee3c \u0111\u1ec3 g\u1ecdi t\u1ee9c th\u00ec kh\u00f4ng \u0111\u1ed9 tr\u1ec5\n    function autoSaveEmployeesToSheetDebounced() {\n      debouncedSaveToSheet();\n    }\n    function saveAllEmployeesToSheet() {\n      saveToSheetImmediately();\n    }\n    function autoSaveToSheetDebounced() {\n      debouncedSaveToSheet();\n    }\n    function saveAllToSheet() {\n      saveToSheetImmediately();\n    }\n\n    // T\u00ccM KI\u1ebeM V\u00c0 HIGHLIGHT TR\u00caN S\u01a0 \u0110\u1ed2 M\u1eb6T B\u1eb0NG\n    document.getElementById('globalSearchInput').addEventListener('input', function(e) {\n      const kw = e.target.value.trim().toLowerCase();\n      state.searchKeyword = kw;\n\n      const cells = document.querySelectorAll('.map-cell');\n      cells.forEach(c => {\n        const text = c.textContent.toLowerCase();\n        const staff = (c.getAttribute('data-staff') || '').toLowerCase();\n        if (kw && (text.includes(kw) || staff.includes(kw))) {\n          c.classList.add('highlight-target');\n        } else {\n          c.classList.remove('highlight-target');\n        }\n      });\n    });\n\n    // ==========================================================================\n    // QU\u1ea2N L\u00dd PH\u00c2N B\u1ed4 KHU V\u1ef0C V\u1ec6 SINH & THAY \u0110\u1ed4I NH\u00c2N VI\u00caN TR\u1ef0C TI\u1ebeP TR\u00caN S\u01a0 \u0110\u1ed2\n    // ==========================================================================\n    state.selectedCellEl = null;\n    state.isAllocatingDirectly = false;\n    state.allocatingStaff = '';\n\n    // Ki\u1ec3m tra xem 1 \u00f4 tr\u00ean s\u01a1 \u0111\u1ed3 c\u00f3 thu\u1ed9c nh\u00e2n vi\u00ean ch\u1ec9 \u0111\u1ecbnh hay kh\u00f4ng\n    function cellMatchesStaff(cell, targetStaff) {\n      if (!cell || !targetStaff) return false;\n      const staffAttr = (cell.getAttribute('data-staff') || '').trim();\n      const staffSpan = cell.querySelector('.cell-staff');\n      const spanText = staffSpan ? staffSpan.textContent.trim() : '';\n      return isStaffNameMatch(staffAttr, targetStaff) || isStaffNameMatch(spanText, targetStaff);\n    }\n\n    // Cu\u1ed9n m\u01b0\u1ee3t v\u00e0 t\u1ea1o hi\u1ec7u \u1ee9ng nh\u1ea5p nh\u00e1y l\u00e0m n\u1ed5i b\u1eadt \u00f4 tr\u00ean s\u01a1 \u0111\u1ed3\n    function focusAndPulseCell(cell) {\n      if (!cell) return;\n      const viewport = document.querySelector('.floorplan-scroll-viewport');\n      if (viewport) {\n        const vRect = viewport.getBoundingClientRect();\n        const cRect = cell.getBoundingClientRect();\n        const targetLeft = viewport.scrollLeft + (cRect.left - vRect.left) - (viewport.clientWidth / 2) + (cRect.width / 2);\n        viewport.scrollTo({ left: Math.max(0, targetLeft), behavior: 'smooth' });\n      }\n      cell.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });\n      cell.classList.remove('cell-pulsing');\n      void cell.offsetWidth;\n      cell.classList.add('cell-pulsing');\n      setTimeout(() => cell.classList.remove('cell-pulsing'), 3200);\n    }\n\n    // Render b\u1ed9 l\u1ecdc danh s\u00e1ch nh\u00e2n vi\u00ean tr\u00ean thanh \u0111i\u1ec1u khi\u1ec3n\n    function renderFloorplanStaffControls() {\n      const selectEl = document.getElementById('spotlightStaffSelect');\n      const scrollerEl = document.getElementById('staffQuickScroller');\n      if (!selectEl || !scrollerEl) return;\n\n      const cells = Array.from(document.querySelectorAll('.map-cell'));\n      const staffCountMap = new Map();\n      const totalCells = cells.length;\n\n      cells.forEach(c => {\n        const staff = (c.getAttribute('data-staff') || (c.querySelector('.cell-staff') ? c.querySelector('.cell-staff').textContent : '')).trim();\n        if (staff) {\n          let matchedKey = null;\n          for (let k of staffCountMap.keys()) {\n            if (isStaffNameMatch(k, staff)) {\n              matchedKey = k;\n              break;\n            }\n          }\n          if (matchedKey) {\n            staffCountMap.set(matchedKey, staffCountMap.get(matchedKey) + 1);\n          } else {\n            staffCountMap.set(staff, 1);\n          }\n        }\n      });\n\n      const sortedStaff = Array.from(staffCountMap.entries()).sort((a, b) => a[0].localeCompare(b[0], 'vi'));\n\n      // 1. C\u1eadp nh\u1eadt Dropdown Select\n      selectEl.innerHTML = '<option value=\"\">\ud83d\udd0d Soi s\u00e1ng khu v\u1ef1c nh\u00e2n vi\u00ean (Ch\u1ecdn t\u00ean)...</option>';\n      sortedStaff.forEach(([staffName, count]) => {\n        const opt = document.createElement('option');\n        opt.value = staffName;\n        opt.textContent = `${staffName} (${count} v\u1ecb tr\u00ed)`;\n        if (state.spotlightStaff && isStaffNameMatch(state.spotlightStaff, staffName)) {\n          opt.selected = true;\n        }\n        selectEl.appendChild(opt);\n      });\n\n      // 2. C\u1eadp nh\u1eadt thanh cu\u1ed9n ngang c\u00e1c chip nh\u00e2n s\u1ef1\n      scrollerEl.innerHTML = '';\n\n      const allPill = document.createElement('button');\n      allPill.type = 'button';\n      allPill.className = `staff-filter-pill ${!state.spotlightStaff ? 'active' : ''}`;\n      allPill.innerHTML = `<span>\ud83c\udf1f Xem t\u1ea5t c\u1ea3</span> <span class=\"area-count\">${totalCells}</span>`;\n      allPill.onclick = () => setStaffSpotlight(null);\n      scrollerEl.appendChild(allPill);\n\n      sortedStaff.forEach(([staffName, count]) => {\n        const pal = getPaletteForStaff(staffName);\n        const isActive = state.spotlightStaff && isStaffNameMatch(state.spotlightStaff, staffName);\n        const isMyProfile = state.mySavedStaff && isStaffNameMatch(state.mySavedStaff, staffName);\n\n        const pill = document.createElement('button');\n        pill.type = 'button';\n        pill.className = `staff-filter-pill ${isActive ? 'active' : ''} ${isMyProfile ? 'is-me' : ''}`;\n        pill.setAttribute('data-staff', staffName);\n        pill.title = `Nh\u1ea5n \u0111\u1ec3 soi s\u00e1ng ${count} khu v\u1ef1c c\u1ee7a ${staffName}`;\n        pill.innerHTML = `\n          <span class=\"color-dot\" style=\"background:${pal.dot};\"></span>\n          <span>${isMyProfile ? '\u2b50 ' : ''}${staffName}</span>\n          <span class=\"area-count\">${count}</span>\n        `;\n        pill.onclick = () => {\n          if (isActive) {\n            setStaffSpotlight(null);\n          } else {\n            setStaffSpotlight(staffName);\n          }\n        };\n        scrollerEl.appendChild(pill);\n      });\n\n      // C\u1eadp nh\u1eadt tr\u1ea1ng th\u00e1i n\u00fat \"Khu V\u1ef1c C\u1ee7a T\u00f4i\"\n      const myStaffBtn = document.getElementById('btnMyStaffSpotlight');\n      const myStaffLabel = document.getElementById('btnMyStaffLabel');\n      if (myStaffBtn && myStaffLabel) {\n        if (state.mySavedStaff) {\n          myStaffLabel.textContent = 'T\u00f4i: ' + state.mySavedStaff;\n          myStaffBtn.classList.add('has-profile');\n        } else {\n          myStaffLabel.textContent = 'Khu V\u1ef1c C\u1ee7a T\u00f4i';\n          myStaffBtn.classList.remove('has-profile');\n        }\n      }\n    }\n\n    // B\u1eadt ch\u1ebf \u0111\u1ed9 Ti\u00eau \u0110i\u1ec3m / Soi S\u00e1ng cho 1 nh\u00e2n vi\u00ean c\u1ee5 th\u1ec3\n    function setStaffSpotlight(staffName) {\n      const cells = Array.from(document.querySelectorAll('.map-cell'));\n      const summaryBanner = document.getElementById('spotlightActiveSummary');\n      const resetBtn = document.getElementById('btnResetSpotlight');\n      const selectEl = document.getElementById('spotlightStaffSelect');\n\n      if (!staffName || staffName === 'ALL') {\n        state.spotlightStaff = null;\n        cells.forEach(cell => {\n          cell.classList.remove('staff-spotlight', 'staff-dimmed');\n          const orderTag = cell.querySelector('.spotlight-order-tag');\n          if (orderTag) orderTag.remove();\n        });\n        if (summaryBanner) summaryBanner.style.display = 'none';\n        if (resetBtn) resetBtn.style.display = 'none';\n        if (selectEl) selectEl.value = '';\n        renderFloorplanStaffControls();\n        return;\n      }\n\n      state.spotlightStaff = staffName;\n      if (resetBtn) resetBtn.style.display = 'inline-flex';\n      if (selectEl) selectEl.value = staffName;\n\n      // T\u00ecm t\u1ea5t c\u1ea3 c\u00e1c \u00f4 kh\u1edbp v\u1edbi nh\u00e2n vi\u00ean n\u00e0y\n      const matchingCells = [];\n      cells.forEach(cell => {\n        if (cellMatchesStaff(cell, staffName)) {\n          matchingCells.push(cell);\n        }\n      });\n\n      // \u0110\u00e1nh s\u1ed1 th\u1ee9 t\u1ef1 & r\u1ecdi s\u00e1ng c\u00e1c \u00f4 t\u01b0\u01a1ng \u1ee9ng, l\u00e0m m\u1edd c\u00e1c \u00f4 c\u00f2n l\u1ea1i\n      let orderIndex = 1;\n      cells.forEach(cell => {\n        const isMatch = matchingCells.includes(cell);\n        if (isMatch) {\n          cell.classList.remove('staff-dimmed');\n          cell.classList.add('staff-spotlight');\n\n          let orderTag = cell.querySelector('.spotlight-order-tag');\n          if (!orderTag) {\n            orderTag = document.createElement('span');\n            orderTag.className = 'spotlight-order-tag';\n            cell.appendChild(orderTag);\n          }\n          orderTag.textContent = '#' + orderIndex++;\n        } else {\n          cell.classList.remove('staff-spotlight');\n          cell.classList.add('staff-dimmed');\n          const orderTag = cell.querySelector('.spotlight-order-tag');\n          if (orderTag) orderTag.remove();\n        }\n      });\n\n      // Hi\u1ec3n th\u1ecb banner t\u1ed5ng k\u1ebft khu v\u1ef1c c\u1ee7a nh\u00e2n vi\u00ean\n      if (summaryBanner) {\n        summaryBanner.style.display = 'flex';\n        const targetNameEl = document.getElementById('spotlightTargetName');\n        const countBadgeEl = document.getElementById('spotlightCountBadge');\n        const areasListEl = document.getElementById('spotlightAreasList');\n        const pinLabel = document.getElementById('pinMyProfileLabel');\n\n        if (targetNameEl) targetNameEl.textContent = staffName;\n        if (countBadgeEl) countBadgeEl.textContent = matchingCells.length + ' khu v\u1ef1c';\n\n        if (pinLabel) {\n          const isMe = state.mySavedStaff && isStaffNameMatch(state.mySavedStaff, staffName);\n          pinLabel.textContent = isMe ? '\u0110\u00e3 l\u00e0 t\u00f4i \u2713' : 'Ghi nh\u1edb t\u00f4i';\n        }\n\n        if (areasListEl) {\n          areasListEl.innerHTML = '';\n          matchingCells.forEach((c, idx) => {\n            const titleEl = c.querySelector('.cell-title');\n            const title = titleEl ? titleEl.textContent.trim() : c.textContent.trim();\n            const chip = document.createElement('button');\n            chip.type = 'button';\n            chip.className = 'spotlight-area-chip';\n            chip.title = `Nh\u1ea5n \u0111\u1ec3 ph\u00f3ng t\u1edbi v\u1ecb tr\u00ed: ${title}`;\n            chip.innerHTML = `<span class=\"seq-num\">#${idx + 1}</span> <span>${title}</span> <i class=\"fa-solid fa-location-crosshairs\"></i>`;\n            chip.onclick = () => focusAndPulseCell(c);\n            areasListEl.appendChild(chip);\n          });\n        }\n      }\n\n      // C\u1eadp nh\u1eadt c\u00e1c n\u00fat filter\n      renderFloorplanStaffControls();\n\n      // T\u1ef1 \u0111\u1ed9ng cu\u1ed9n t\u1edbi \u00f4 \u0111\u1ea7u ti\u00ean c\u1ee7a nh\u00e2n vi\u00ean\n      if (matchingCells.length > 0) {\n        focusAndPulseCell(matchingCells[0]);\n      }\n    }\n\n    // B\u1eadt/t\u1eaft ch\u1ebf \u0111\u1ed9 t\u00f4 m\u00e0u ri\u00eang bi\u1ec7t theo t\u1eebng nh\u00e2n vi\u00ean\n    function toggleColorByStaff() {\n      state.colorByStaffMode = !state.colorByStaffMode;\n      const btn = document.getElementById('btnToggleColorByStaff');\n      const label = document.getElementById('btnToggleColorByStaffLabel');\n\n      if (btn && label) {\n        if (state.colorByStaffMode) {\n          btn.classList.add('active');\n          label.textContent = 'M\u00e0u ng\u00e0nh h\u00e0ng';\n          showToast('\ud83c\udfa8 \u0110\u00e3 b\u1eadt t\u00f4 m\u00e0u ri\u00eang bi\u1ec7t theo t\u1eebng nh\u00e2n vi\u00ean');\n        } else {\n          btn.classList.remove('active');\n          label.textContent = 'T\u00f4 m\u00e0u theo nh\u00e2n vi\u00ean';\n          showToast('\ud83c\udfe2 \u0110\u00e3 quay v\u1ec1 m\u00e0u g\u1ed1c theo ng\u00e0nh h\u00e0ng');\n        }\n      }\n      applyColorByStaff();\n    }\n\n    function applyColorByStaff() {\n      const cells = document.querySelectorAll('.map-cell');\n      cells.forEach(cell => {\n        if (state.colorByStaffMode) {\n          const staff = (cell.getAttribute('data-staff') || (cell.querySelector('.cell-staff') ? cell.querySelector('.cell-staff').textContent : '')).trim();\n          if (staff) {\n            const pal = getPaletteForStaff(staff);\n            cell.style.setProperty('--staff-bg', pal.bg);\n            cell.style.setProperty('--staff-border', pal.border);\n            cell.style.setProperty('--staff-text', pal.text);\n            cell.classList.add('has-staff-color');\n          } else {\n            cell.classList.remove('has-staff-color');\n          }\n        } else {\n          cell.classList.remove('has-staff-color');\n          cell.style.removeProperty('--staff-bg');\n          cell.style.removeProperty('--staff-border');\n          cell.style.removeProperty('--staff-text');\n        }\n      });\n    }\n\n    // B\u1eadt/t\u1eaft huy hi\u1ec7u hi\u1ec3n th\u1ecb s\u1ed1 Ca tr\u1ef1c (#1 - #15)\n    function toggleShiftBadges() {\n      state.showShiftTagsMode = !state.showShiftTagsMode;\n      const btn = document.getElementById('btnToggleShiftBadges');\n      const label = document.getElementById('btnToggleShiftBadgesLabel');\n\n      if (btn && label) {\n        if (state.showShiftTagsMode) {\n          btn.classList.add('active');\n          label.textContent = '\u1ea8n s\u1ed1 Ca';\n          showToast('\ud83d\udd22 \u0110\u00e3 hi\u1ec7n s\u1ed1 th\u1ee9 t\u1ef1 Ca tr\u1ef1c (#1 - #15) tr\u00ean t\u1eebng \u00f4');\n        } else {\n          btn.classList.remove('active');\n          label.textContent = 'Hi\u1ec7n s\u1ed1 Ca';\n          showToast('\u0110\u00e3 \u1ea9n s\u1ed1 Ca');\n        }\n      }\n      applyShiftBadges();\n    }\n\n    function applyShiftBadges() {\n      const cells = document.querySelectorAll('.map-cell');\n      cells.forEach(cell => {\n        let tag = cell.querySelector('.cell-shift-tag');\n        if (state.showShiftTagsMode) {\n          const sIdx = getShiftIndexForCell(cell);\n          if (sIdx >= 0) {\n            if (!tag) {\n              tag = document.createElement('span');\n              tag.className = 'cell-shift-tag';\n              cell.prepend(tag);\n            }\n            tag.textContent = '#' + (sIdx + 1);\n            tag.style.display = 'inline-block';\n          }\n        } else {\n          if (tag) tag.remove();\n        }\n      });\n    }\n\n    // T\u1ef1 \u0111\u1ed9ng thu ph\u00f3ng s\u01a1 \u0111\u1ed3 v\u1eeba v\u1eb7n 100% m\u00e0n h\u00ecnh \u0111i\u1ec7n tho\u1ea1i ho\u1eb7c ph\u00f3ng to t\u00f9y ch\u1ec9nh\n    function updateFloorplanZoom(forceMode) {\n      const viewport = document.getElementById('floorPlanScrollViewport');\n      const grid = document.getElementById('storeLayoutGridEl');\n      const wrapper = document.getElementById('floorplanZoomWrapper');\n      const levelText = document.getElementById('zoomLevelDisplay');\n      const btnFit = document.getElementById('btnZoomFitMobile');\n      const btnActual = document.getElementById('btnZoomActual');\n      const mobileTip = document.querySelector('.mobile-scroll-tip span');\n\n      if (!viewport || !grid || !wrapper) return;\n\n      if (forceMode) {\n        state.zoomMode = forceMode;\n      } else if (!state.zoomMode) {\n        state.zoomMode = (window.innerWidth < 1200) ? 'fit' : 'actual';\n      }\n\n      // \u0110\u01b0a wrapper v\u1ec1 tr\u1ea1ng th\u00e1i chu\u1ea9n \u0111\u1ec3 \u0111o \u0111\u1ea1c k\u00edch th\u01b0\u1edbc th\u1ef1c c\u1ee7a grid\n      wrapper.style.transform = 'none';\n      wrapper.style.width = 'auto';\n      wrapper.style.height = 'auto';\n\n      const gridW = grid.offsetWidth || grid.scrollWidth || 1140;\n      const gridH = grid.offsetHeight || grid.scrollHeight || 750;\n      const availableW = Math.max(260, viewport.clientWidth - 4);\n\n      if (state.zoomMode === 'fit') {\n        const fitScale = Math.min(1.0, Math.max(0.20, availableW / gridW));\n        state.currentZoom = fitScale;\n\n        wrapper.style.transformOrigin = '0 0';\n        wrapper.style.transform = `scale(${fitScale})`;\n        wrapper.style.width = Math.ceil(gridW * fitScale) + 'px';\n        wrapper.style.height = Math.ceil(gridH * fitScale) + 'px';\n\n        viewport.style.overflowX = 'hidden';\n        viewport.style.overflowY = 'hidden';\n\n        if (btnFit) btnFit.classList.add('active');\n        if (btnActual) btnActual.classList.remove('active');\n        if (levelText) levelText.textContent = Math.round(fitScale * 100) + '% (Fit)';\n        if (mobileTip) {\n          mobileTip.innerHTML = '\u2728 <strong>\u0110ang xem to\u00e0n c\u1ea3nh v\u1eeba m\u00e0n h\u00ecnh</strong> (b\u1ea5m <strong>Chu\u1ea9n 100%</strong> \u0111\u1ec3 \u0111\u1ecdc ch\u1eef to h\u01a1n)';\n        }\n      } else {\n        const zoom = Math.max(0.25, Math.min(2.0, state.currentZoom || 1));\n        state.currentZoom = zoom;\n\n        wrapper.style.transformOrigin = '0 0';\n        if (Math.abs(zoom - 1) < 0.01) {\n          wrapper.style.transform = 'none';\n          wrapper.style.width = 'auto';\n          wrapper.style.height = 'auto';\n        } else {\n          wrapper.style.transform = `scale(${zoom})`;\n          wrapper.style.width = Math.ceil(gridW * zoom) + 'px';\n          wrapper.style.height = Math.ceil(gridH * zoom) + 'px';\n        }\n\n        viewport.style.overflowX = 'auto';\n        viewport.style.overflowY = 'hidden';\n\n        if (btnFit) btnFit.classList.remove('active');\n        if (btnActual) {\n          if (Math.abs(zoom - 1) < 0.02) {\n            btnActual.classList.add('active');\n          } else {\n            btnActual.classList.remove('active');\n          }\n        }\n        if (levelText) levelText.textContent = Math.round(zoom * 100) + '%';\n        if (mobileTip) {\n          mobileTip.innerHTML = '\ud83d\udc48 \ud83d\udc49 <strong>Vu\u1ed1t ngang</strong> \u0111\u1ec3 xem chi ti\u1ebft t\u1eebng khu v\u1ef1c';\n        }\n      }\n    }\n\n    // G\u1eafn s\u1ef1 ki\u1ec7n c\u00e1c n\u00fat \u0111i\u1ec1u khi\u1ec3n s\u01a1 \u0111\u1ed3\n    function initFloorplanControlListeners() {\n      const selectEl = document.getElementById('spotlightStaffSelect');\n      if (selectEl && !selectEl._hasInitListener) {\n        selectEl._hasInitListener = true;\n        selectEl.addEventListener('change', function() {\n          setStaffSpotlight(this.value);\n        });\n      }\n\n      const resetBtn = document.getElementById('btnResetSpotlight');\n      if (resetBtn && !resetBtn._hasInitListener) {\n        resetBtn._hasInitListener = true;\n        resetBtn.addEventListener('click', () => setStaffSpotlight(null));\n      }\n\n      const closeSummaryBtn = document.getElementById('btnCloseSpotlight');\n      if (closeSummaryBtn && !closeSummaryBtn._hasInitListener) {\n        closeSummaryBtn._hasInitListener = true;\n        closeSummaryBtn.addEventListener('click', () => setStaffSpotlight(null));\n      }\n\n      const editBtn = document.getElementById('btnEditSpotlightStaff');\n      if (editBtn && !editBtn._hasInitListener) {\n        editBtn._hasInitListener = true;\n        editBtn.addEventListener('click', () => {\n          if (!state.spotlightStaff) return;\n          const firstCell = Array.from(document.querySelectorAll('.map-cell')).find(c => cellMatchesStaff(c, state.spotlightStaff));\n          const cellTitle = firstCell ? (firstCell.querySelector('.cell-title') ? firstCell.querySelector('.cell-title').textContent.trim() : firstCell.textContent.trim()) : 'Khu v\u1ef1c';\n          openStaffAllocationModal(firstCell || document.body, cellTitle, state.spotlightStaff);\n        });\n      }\n\n      const pinBtn = document.getElementById('btnPinAsMyProfile');\n      if (pinBtn && !pinBtn._hasInitListener) {\n        pinBtn._hasInitListener = true;\n        pinBtn.addEventListener('click', () => {\n          if (!state.spotlightStaff) return;\n          state.mySavedStaff = state.spotlightStaff;\n          localStorage.setItem('st1841_my_staff', state.spotlightStaff);\n          renderFloorplanStaffControls();\n          showToast('\u2b50 \u0110\u00e3 ghi nh\u1edb b\u1ea1n l\u00e0: ' + state.spotlightStaff + '. M\u1ed7i l\u1ea7n v\u00e0o web, ch\u1ec9 c\u1ea7n b\u1ea5m \"Khu V\u1ef1c C\u1ee7a T\u00f4i\" l\u00e0 s\u00e1ng ngay!');\n          const pinLabel = document.getElementById('pinMyProfileLabel');\n          if (pinLabel) pinLabel.textContent = '\u0110\u00e3 l\u00e0 t\u00f4i \u2713';\n        });\n      }\n\n      const myStaffBtn = document.getElementById('btnMyStaffSpotlight');\n      if (myStaffBtn && !myStaffBtn._hasInitListener) {\n        myStaffBtn._hasInitListener = true;\n        myStaffBtn.addEventListener('click', () => {\n          if (state.mySavedStaff) {\n            if (state.spotlightStaff && isStaffNameMatch(state.spotlightStaff, state.mySavedStaff)) {\n              setStaffSpotlight(null);\n            } else {\n              setStaffSpotlight(state.mySavedStaff);\n              showToast('\ud83c\udf1f \u0110ang soi s\u00e1ng khu v\u1ef1c c\u1ee7a: ' + state.mySavedStaff);\n            }\n          } else {\n            showToast('\u2139\ufe0f B\u1ea1n ch\u01b0a l\u01b0u t\u00ean. Vui l\u00f2ng ch\u1ecdn t\u00ean tr\u00ean s\u01a1 \u0111\u1ed3 v\u00e0 b\u1ea5m \"Ghi nh\u1edb t\u00f4i\"!');\n            const sel = document.getElementById('spotlightStaffSelect');\n            if (sel) sel.focus();\n          }\n        });\n      }\n\n      const colorToggleBtn = document.getElementById('btnToggleColorByStaff');\n      if (colorToggleBtn && !colorToggleBtn._hasInitListener) {\n        colorToggleBtn._hasInitListener = true;\n        colorToggleBtn.addEventListener('click', toggleColorByStaff);\n      }\n\n      const shiftToggleBtn = document.getElementById('btnToggleShiftBadges');\n      if (shiftToggleBtn && !shiftToggleBtn._hasInitListener) {\n        shiftToggleBtn._hasInitListener = true;\n        shiftToggleBtn.addEventListener('click', toggleShiftBadges);\n      }\n\n      // C\u00e1c n\u00fat \u0111i\u1ec1u khi\u1ec3n thu ph\u00f3ng\n      const btnFit = document.getElementById('btnZoomFitMobile');\n      if (btnFit && !btnFit._hasInitListener) {\n        btnFit._hasInitListener = true;\n        btnFit.addEventListener('click', () => {\n          updateFloorplanZoom('fit');\n          showToast('\ud83d\udcf1 \u0110\u00e3 b\u1eadt ch\u1ebf \u0111\u1ed9 V\u1eeba M\u00e0n H\u00ecnh (Xem to\u00e0n c\u1ea3nh)');\n        });\n      }\n\n      const btnActual = document.getElementById('btnZoomActual');\n      if (btnActual && !btnActual._hasInitListener) {\n        btnActual._hasInitListener = true;\n        btnActual.addEventListener('click', () => {\n          state.currentZoom = 1;\n          updateFloorplanZoom('actual');\n          showToast('\ud83d\udd0d \u0110\u00e3 chuy\u1ec3n sang k\u00edch th\u01b0\u1edbc Chu\u1ea9n 100%');\n        });\n      }\n\n      const btnZoomIn = document.getElementById('btnZoomIn');\n      if (btnZoomIn && !btnZoomIn._hasInitListener) {\n        btnZoomIn._hasInitListener = true;\n        btnZoomIn.addEventListener('click', () => {\n          state.zoomMode = 'actual';\n          state.currentZoom = Math.min(2.0, (state.currentZoom || 1) + 0.15);\n          updateFloorplanZoom('actual');\n        });\n      }\n\n      const btnZoomOut = document.getElementById('btnZoomOut');\n      if (btnZoomOut && !btnZoomOut._hasInitListener) {\n        btnZoomOut._hasInitListener = true;\n        btnZoomOut.addEventListener('click', () => {\n          state.zoomMode = 'actual';\n          state.currentZoom = Math.max(0.25, (state.currentZoom || 1) - 0.15);\n          updateFloorplanZoom('actual');\n        });\n      }\n\n      // H\u1ed7 tr\u1ee3 c\u1ea3m \u1ee9ng pinch-to-zoom (ch\u1ee5m 2 ng\u00f3n tay thu ph\u00f3ng) tr\u00ean \u0111i\u1ec7n tho\u1ea1i\n      const viewport = document.getElementById('floorPlanScrollViewport');\n      if (viewport && !viewport._hasInitTouchPinch) {\n        viewport._hasInitTouchPinch = true;\n        let initialPinchDist = 0;\n        let initialZoom = 1;\n\n        viewport.addEventListener('touchstart', (e) => {\n          if (e.touches.length === 2) {\n            initialPinchDist = Math.hypot(\n              e.touches[0].pageX - e.touches[1].pageX,\n              e.touches[0].pageY - e.touches[1].pageY\n            );\n            initialZoom = state.currentZoom || 1;\n          }\n        }, { passive: true });\n\n        viewport.addEventListener('touchmove', (e) => {\n          if (e.touches.length === 2 && initialPinchDist > 0) {\n            const currentDist = Math.hypot(\n              e.touches[0].pageX - e.touches[1].pageX,\n              e.touches[0].pageY - e.touches[1].pageY\n            );\n            const ratio = currentDist / initialPinchDist;\n            const newZoom = Math.max(0.25, Math.min(2.0, initialZoom * ratio));\n            state.zoomMode = 'actual';\n            state.currentZoom = newZoom;\n            updateFloorplanZoom('actual');\n          }\n        }, { passive: true });\n\n        viewport.addEventListener('touchend', (e) => {\n          if (e.touches.length < 2) {\n            initialPinchDist = 0;\n          }\n        }, { passive: true });\n\n        // H\u1ed7 tr\u1ee3 ch\u1ea1m \u0111\u00fap (double-tap) \u0111\u1ec3 chuy\u1ec3n \u0111\u1ed5i nhanh gi\u1eefa V\u1eeba m\u00e0n h\u00ecnh v\u00e0 Chu\u1ea9n 100%\n        let lastTapTime = 0;\n        viewport.addEventListener('touchend', (e) => {\n          if (e.touches.length === 0 && e.changedTouches.length === 1) {\n            const currentTime = Date.now();\n            const tapGap = currentTime - lastTapTime;\n            if (tapGap < 320 && tapGap > 40) {\n              if (state.zoomMode === 'fit') {\n                state.currentZoom = 1;\n                updateFloorplanZoom('actual');\n                showToast('\ud83d\udd0d \u0110\u00e3 ph\u00f3ng to Chu\u1ea9n 100%');\n              } else {\n                updateFloorplanZoom('fit');\n                showToast('\ud83d\udcf1 \u0110\u00e3 thu v\u1eeba v\u1eb7n to\u00e0n b\u1ed9 m\u00e0n h\u00ecnh');\n              }\n            }\n            lastTapTime = currentTime;\n          }\n        }, { passive: true });\n      }\n    }\n\n    // Kh\u1edfi t\u1ea1o c\u00e1c \u00f4 tr\u00ean s\u01a1 \u0111\u1ed3 v\u1edbi ID duy nh\u1ea5t & n\u1ea1p tr\u1ea1ng th\u00e1i \u0111\u00e3 l\u01b0u\n    function initMapCells() {\n      const cells = document.querySelectorAll('.map-cell');\n      const savedAllocations = JSON.parse(localStorage.getItem('st1841_map_allocations') || '{}');\n\n      cells.forEach((cell, idx) => {\n        const cellId = 'cell_' + idx;\n        cell.setAttribute('data-cell-id', cellId);\n\n        const titleEl = cell.querySelector('.cell-title');\n        const staffEl = cell.querySelector('.cell-staff');\n        const cellTitle = titleEl ? titleEl.textContent.trim() : (cell.textContent.trim() || 'Khu v\u1ef1c');\n\n        // G\u1ee3i \u00fd thao t\u00e1c khi di chu\u1ed9t\n        cell.title = `Nh\u1ea5p \u0111\u1ec3 soi s\u00e1ng khu v\u1ef1c (nh\u1ea5p \u0111\u00fap \u0111\u1ec3 \u0111\u1ed5i ng\u01b0\u1eddi): ${cellTitle}`;\n\n        // N\u1ebfu \u0111\u00e3 c\u00f3 c\u1ea5u h\u00ecnh l\u01b0u tr\u01b0\u1edbc \u0111\u00f3\n        if (savedAllocations[cellId]) {\n          const staffName = savedAllocations[cellId].staff || '';\n          cell.setAttribute('data-staff', staffName);\n          if (staffEl) {\n            staffEl.textContent = staffName;\n          }\n        }\n\n        // G\u00e1n s\u1ef1 ki\u1ec7n h\u1ed7 tr\u1ee3 c\u1ea3 nh\u1ea5p \u0111\u01a1n v\u00e0 nh\u1ea5p \u0111\u00fap tr\u00ean m\u1ecdi tr\u00ecnh duy\u1ec7t/thi\u1ebft b\u1ecb\n        const onCellTrigger = (e) => {\n          if (e) {\n            e.stopPropagation();\n            if (e.type === 'dblclick') {\n              e.preventDefault();\n            }\n          }\n          handleMapCellClick(cell, e ? e.type : 'click');\n        };\n\n        // G\u1ee1 b\u1ecf handler c\u0169 n\u1ebfu c\u00f3 \u0111\u1ec3 tr\u00e1nh tr\u00f9ng l\u1eb7p\n        if (cell._onTriggerHandler) {\n          cell.removeEventListener('click', cell._onTriggerHandler);\n          cell.removeEventListener('dblclick', cell._onTriggerHandler);\n        }\n        cell._onTriggerHandler = onCellTrigger;\n\n        cell.addEventListener('click', onCellTrigger);\n        cell.addEventListener('dblclick', onCellTrigger);\n\n        // Hi\u1ec7u \u1ee9ng t\u01b0\u01a1ng t\u00e1c li\u00ean k\u1ebft khi r\u00ea chu\u1ed9t qua \u00f4: s\u00e1ng c\u00e1c \u00f4 c\u00f9ng nh\u00e2n vi\u00ean\n        cell.addEventListener('mouseenter', () => {\n          if (state.spotlightStaff) return;\n          const staff = (cell.getAttribute('data-staff') || (cell.querySelector('.cell-staff') ? cell.querySelector('.cell-staff').textContent : '')).trim();\n          if (!staff) return;\n          document.querySelectorAll('.map-cell').forEach(other => {\n            if (other !== cell && cellMatchesStaff(other, staff)) {\n              other.classList.add('staff-peer-hover');\n            }\n          });\n        });\n\n        cell.addEventListener('mouseleave', () => {\n          document.querySelectorAll('.map-cell.staff-peer-hover').forEach(other => {\n            other.classList.remove('staff-peer-hover');\n          });\n        });\n      });\n\n      initFloorplanControlListeners();\n      renderFloorplanStaffControls();\n      applyColorByStaff();\n      applyShiftBadges();\n      if (state.spotlightStaff) {\n        setStaffSpotlight(state.spotlightStaff);\n      }\n      updateFloorplanZoom();\n    }\n\n    // X\u1eed l\u00fd khi click / double-click v\u00e0o \u00f4 tr\u00ean s\u01a1 \u0111\u1ed3\n    function handleMapCellClick(cell, triggerType) {\n      const cellTitle = cell.querySelector('.cell-title') ? cell.querySelector('.cell-title').textContent.trim() : cell.textContent.trim();\n      const currentStaff = (cell.getAttribute('data-staff') || (cell.querySelector('.cell-staff') ? cell.querySelector('.cell-staff').textContent.trim() : '')).trim();\n\n      // 1. N\u1ebfu \u0111ang \u1edf CH\u1ebe \u0110\u1ed8 PH\u00c2N B\u1ed4 TR\u1ef0C TI\u1ebeP\n      if (state.isAllocatingDirectly && state.allocatingStaff) {\n        const staffEl = cell.querySelector('.cell-staff');\n        \n        // N\u1ebfu \u00f4 \u0111ang thu\u1ed9c nh\u00e2n vi\u00ean n\u00e0y -> Click l\u1ea1i s\u1ebd b\u1ecf g\u00e1n\n        if (currentStaff.toUpperCase() === state.allocatingStaff.toUpperCase()) {\n          cell.setAttribute('data-staff', '');\n          if (staffEl) staffEl.textContent = '';\n          cell.classList.remove('in-allocation-target');\n          updateShiftForCell(cell, '');\n          showToast('\u26aa \u0110\u00e3 h\u1ee7y g\u00e1n khu v\u1ef1c: ' + cellTitle);\n        } else {\n          // G\u00e1n khu v\u1ef1c cho nh\u00e2n vi\u00ean n\u00e0y\n          cell.setAttribute('data-staff', state.allocatingStaff);\n          if (staffEl) {\n            staffEl.textContent = state.allocatingStaff;\n          } else {\n            const newStaffSpan = document.createElement('span');\n            newStaffSpan.className = 'cell-staff';\n            newStaffSpan.textContent = state.allocatingStaff;\n            cell.appendChild(newStaffSpan);\n          }\n          cell.classList.add('in-allocation-target');\n          updateShiftForCell(cell, state.allocatingStaff);\n          showToast('\ud83c\udfaf \u0110\u00e3 g\u00e1n [' + cellTitle + '] cho ' + state.allocatingStaff);\n        }\n\n        saveMapAllocations();\n        updateAllocatingCount();\n        renderFloorplanStaffControls();\n        applyColorByStaff();\n        notifyLocalDataChange('UPDATE_MAP_CELL', {\n          cellId: cell.getAttribute('data-cell-id'),\n          staff: cell.getAttribute('data-staff')\n        });\n        return;\n      }\n\n      // 2. N\u1ebfu nh\u1ea5p \u0111\u00fap (dblclick) -> M\u1edf tr\u1ef1c ti\u1ebfp Modal Ph\u00e2n B\u1ed5 & Thay \u0110\u1ed5i T\u00ean Nh\u00e2n Vi\u00ean\n      if (triggerType === 'dblclick') {\n        openStaffAllocationModal(cell, cellTitle, currentStaff);\n        return;\n      }\n\n      // 3. N\u1ebfu nh\u1ea5p \u0111\u01a1n (click):\n      if (currentStaff) {\n        // N\u1ebfu nh\u00e2n vi\u00ean n\u00e0y \u0111\u00e3 \u0111ang \u0111\u01b0\u1ee3c r\u1ecdi s\u00e1ng r\u1ed3i -> Nh\u1ea5p ti\u1ebfp s\u1ebd m\u1edf modal ph\u00e2n b\u1ed5\n        if (state.spotlightStaff && isStaffNameMatch(state.spotlightStaff, currentStaff)) {\n          openStaffAllocationModal(cell, cellTitle, currentStaff);\n        } else {\n          // B\u1eadt r\u1ecdi s\u00e1ng ngay l\u1eadp t\u1ee9c cho t\u1ea5t c\u1ea3 khu v\u1ef1c c\u1ee7a nh\u00e2n vi\u00ean n\u00e0y\n          setStaffSpotlight(currentStaff);\n          showToast('\ud83c\udfaf \u0110ang soi s\u00e1ng c\u00e1c khu v\u1ef1c c\u1ee7a: ' + currentStaff + ' (nh\u1ea5p l\u1ea1i ho\u1eb7c b\u1ea5m \"\u0110\u1ed5i ng\u01b0\u1eddi\" \u0111\u1ec3 ph\u00e2n b\u1ed5)');\n        }\n      } else {\n        // \u00d4 ch\u01b0a c\u00f3 nh\u00e2n vi\u00ean -> M\u1edf modal \u0111\u1ec3 g\u00e1n ngay\n        openStaffAllocationModal(cell, cellTitle, currentStaff);\n      }\n    }\n\n    // M\u1edf modal ph\u00e2n b\u1ed5 & thay \u0111\u1ed5i nh\u00e2n vi\u00ean\n    function openStaffAllocationModal(cell, areaTitle, currentStaff) {\n      state.modalOpenTime = Date.now();\n      state.selectedCellEl = cell;\n      const modal = document.getElementById('staffAllocationModal');\n      if (!modal) return;\n      \n      const titleEl = document.getElementById('modalTargetAreaTitle');\n      if (titleEl) titleEl.textContent = areaTitle;\n\n      const currentStaffEl = document.getElementById('modalCurrentStaffName');\n      if (currentStaffEl) currentStaffEl.textContent = currentStaff || 'Ch\u01b0a g\u00e1n';\n\n      const btnTargetEl = document.getElementById('modalBtnStaffTargetName');\n      if (btnTargetEl) btnTargetEl.textContent = currentStaff || 'khu v\u1ef1c n\u00e0y';\n\n      const btnDirectEl = document.getElementById('modalBtnDirectStaffName');\n      if (btnDirectEl) btnDirectEl.textContent = currentStaff || 'nh\u00e2n vi\u00ean';\n\n      // \u0110\u1ebfm s\u1ed1 l\u01b0\u1ee3ng khu v\u1ef1c nh\u00e2n vi\u00ean n\u00e0y \u0111ang ph\u1ee5 tr\u00e1ch\n      const count = getStaffAreaCount(currentStaff);\n      const countBadge = document.getElementById('modalCurrentStaffCountBadge');\n      if (countBadge) countBadge.textContent = '\u0110ang c\u00f3 ' + count + ' khu v\u1ef1c';\n\n      // \u0110\u1ed5 danh s\u00e1ch 26 nh\u00e2n vi\u00ean v\u00e0o dropdown\n      const dropdown = document.getElementById('modalStaffDropdown');\n      if (dropdown) {\n        dropdown.innerHTML = '<option value=\"\">-- Ch\u1ecdn t\u1eeb ' + (state.employees ? state.employees.length : 26) + ' nh\u00e2n vi\u00ean si\u00eau th\u1ecb --</option>';\n        (state.employees || []).forEach(emp => {\n          const opt = document.createElement('option');\n          opt.value = emp.name;\n          opt.textContent = emp.stt + '. ' + emp.name + (emp.role === 'pg' ? ' [PG]' : '');\n          dropdown.appendChild(opt);\n        });\n\n        const customInp = document.getElementById('modalStaffCustomInput');\n        if (customInp) customInp.value = '';\n        dropdown.onchange = function() {\n          if (this.value && customInp) customInp.value = this.value;\n        };\n      }\n\n      modal.style.display = 'flex';\n    }\n\n    // \u0110\u1ebfm s\u1ed1 khu v\u1ef1c 1 nh\u00e2n vi\u00ean \u0111ang ph\u1ee5 tr\u00e1ch\n    function getStaffAreaCount(staffName) {\n      if (!staffName || !staffName.trim()) return 0;\n      let count = 0;\n      document.querySelectorAll('.map-cell').forEach(c => {\n        const st = c.getAttribute('data-staff') || '';\n        if (st.trim().toUpperCase() === staffName.trim().toUpperCase()) {\n          count++;\n        }\n      });\n      return count;\n    }\n\n    // \u00c1NH X\u1ea0 \u00d4 TR\u00caN S\u01a0 \u0110\u1ed2 V\u1ec0 \u0110\u00daNG 1 TRONG 15 CA TR\u1ef0C \u0110\u1ec2 L\u01afU V\u1ec0 GOOGLE SHEET\n    function getShiftIndexForCell(cell) {\n      if (!cell) return -1;\n      const titleEl = cell.querySelector('.cell-title');\n      const title = (titleEl ? titleEl.textContent : cell.textContent).trim().toUpperCase();\n      const isIctSubgrid = cell.closest('.ict-subgrid') !== null;\n\n      if (isIctSubgrid || title.includes('V\u00c1CH PK') || title.includes('LAPTOP') || \n          title.includes('SMARTPHONE') || title.includes('MOTOROLA') || title.includes('REALME') ||\n          title.includes('VIVO') || title.includes('XIAOMI') || title.includes('PK BASEUS') ||\n          title.includes('PK ANKER') || title.includes('CAMERA') || title.includes('BTN XIAOMI') ||\n          title.includes('BTN MOTO') || title.includes('OPPO') || title.includes('\u0110\u1ed2NG H\u1ed2') ||\n          title.includes('BTN OPPO') || title.includes('BTN VIVO') || title.includes('BTN REALME') ||\n          title.includes('BTN SAMSUNG') || title.includes('BTN HONOR') || title.includes('BTN APPLE') ||\n          title.includes('APPLE') || title.includes('V\u00c1CH PH\u1ee4 KI\u1ec6N') || title.includes('BTV ')) {\n        return 0; // Ca 1 (STT 1)\n      } else if (title.includes('TIVI 1') || title.includes('TIVI 2') || title.includes('TIVI 3') || \n                 title.includes('V\u00c1CH H\u00c3NG SONY') || title.includes('V\u00c1CH H\u00c3NG SAMSUNG') || (title.includes('B\u1ee4C H\u00c3NG SAMSUNG') && !title.includes('T\u1ee6 L\u1ea0NH'))) {\n        return 1; // Ca 2 (STT 2)\n      } else if (title.includes('TIVI 4') || title.includes('TIVI 5') || title.includes('LOA') || \n                 title.includes('V\u00c1CH H\u00c3NG LG') || title.includes('V\u00c1CH LOA') || title.includes('K\u1ec6 LOA') || (title.includes('B\u1ee4C H\u00c3NG LG') && !title.includes('T\u1ee6 L\u1ea0NH'))) {\n        return 2; // Ca 3 (STT 3)\n      } else if (title.includes('M\u00c1Y GI\u1eb6T 1') || title.includes('M\u00c1Y GI\u1eb6T 2') || title.includes('M\u00c1Y GI\u1eb6T 3') || \n                 title.includes('M\u00c1Y GI\u1eb6T 1 - 2 -3') || title.includes('M\u00c1Y GI\u1eb6T ELECTROLUX') || title.includes('M\u00c1Y GI\u1eb6T HISENSE') || title.includes('B\u1ee4C H\u00c3NG HESENSI')) {\n        return 3; // Ca 4 (STT 4)\n      } else if (title.includes('M\u00c1Y GI\u1eb6T 4') || title.includes('M\u00c1Y GI\u1eb6T 5') || title.includes('M\u00c1Y GI\u1eb6T 6') || \n                 title.includes('M\u00c1Y GI\u1eb6T 4 - 5 - 6') || title.includes('M\u00c1Y GI\u1eb6T SAMSUNG') || title.includes('M\u00c1Y GI\u1eb6T PANASONIC') || \n                 title.includes('M\u00c1Y GI\u1eb6T AQUA') || title.includes('M\u00c1Y GI\u1eb6T HAIER') || title.includes('M\u00c1Y GI\u1eb6T TOSHIBA') || \n                 title.includes('B\u1ee4C M\u00c1Y GI\u1eb6T') || title.includes('B\u1ee4C H\u00c3NG TOSHIBA') || title.includes('B\u1ee4C H\u00c3NG TCL')) {\n        return 4; // Ca 5 (STT 5)\n      } else if (title.includes('V\u00c1CH M\u00c1Y L\u1ea0NH') || title.includes('D\u00c0N M\u01af\u1edaP') || title.includes('T\u1ee6 \u0110\u00d4NG')) {\n        return 5; // Ca 6 (STT 6)\n      } else if (title.includes('B\u1ebeP') || title.includes('L\u00d2 VI S\u00d3NG') || title.includes('CH\u1ea2O') || \n                 title.includes('V\u00c1CH N\u1ed2I') || title.includes('N\u1ed2I CHI\u00caN') || title.includes('JUNGER') || title.includes('HAFALE')) {\n        return 6; // Ca 7 (STT 7)\n      } else if (title.includes('L\u1eccC N\u01af\u1edaC') || title.includes('MLN MUTOSI') || title.includes('MLN HO\u00c0 PH\u00c1T') || \n                 title.includes('MLN KAROFI') || title.includes('GIA D\u1ee4NG 1') || title.includes('GIA D\u1ee4NG 01')) {\n        return 7; // Ca 8 (STT 8)\n      } else if (title.includes('GIA D\u1ee4NG 2') || title.includes('GIA D\u1ee4NG 02') || title.includes('GIA D\u1ee4NG 3') || title.includes('GIA D\u1ee4NG 03')) {\n        return 8; // Ca 9 (STT 9)\n      } else if (title.includes('GIA D\u1ee4NG 4') || title.includes('GIA D\u1ee4NG 04') || title.includes('GIA D\u1ee4NG 5') || title.includes('GIA D\u1ee4NG 05') || \n                 title.includes('GIA D\u1ee4NG KANGAROO') || (title.includes('GIA D\u1ee4NG TOSHIBA') && !title.includes('MLN'))) {\n        return 9; // Ca 10 (STT 10)\n      } else if (title.includes('GIA D\u1ee4NG 6') || title.includes('GIA D\u1ee4NG 06') || title.includes('GIA D\u1ee4NG 7') || title.includes('GIA D\u1ee4NG 07') || \n                 title.includes('K\u1ec6 GIA D\u1ee4NG') || title.includes('GIA D\u1ee4NG SUNHOUSE') || title.includes('ROBOT') || title.includes('MLN SUNHOUSE')) {\n        return 10; // Ca 11 (STT 11)\n      } else if (title.includes('T\u1ee6 L\u1ea0NH 1') || title.includes('T\u1ee6 L\u1ea0NH 2') || title.includes('T\u1ee6 L\u1ea0NH HITACHI') || \n                 title.includes('T\u1ee6 L\u1ea0NH AQUA') || title.includes('T\u1ee6 L\u1ea0NH LG') || title.includes('T\u1ee6 L\u1ea0NH SHARP') || \n                 (title.includes('T\u1ee6 L\u1ea0NH TOSHIBA') && !title.includes('V\u00c1CH')) || title.includes('B\u1ee4C H\u00c3NG HAIER') || \n                 title.includes('B\u1ee4C H\u00c3NG AQUA') || title.includes('B\u1ee4C H\u00c3NG XIAOMI')) {\n        return 11; // Ca 12 (STT 12)\n      } else if (title.includes('T\u1ee6 L\u1ea0NH 3') || title.includes('T\u1ee6 L\u1ea0NH 4') || title.includes('T\u1ee6 L\u1ea0NH SAMSUNG') || \n                 title.includes('T\u1ee6 L\u1ea0NH PANASONIC') || title.includes('T\u1ee6 L\u1ea0NH HAIER') || title.includes('B\u1ee4C T\u1ee6 L\u1ea0NH')) {\n        return 12; // Ca 13 (STT 13)\n      } else if (title.includes('V\u00c1CH T\u1ee6 L\u1ea0NH') || title.includes('V\u00c1CH TL')) {\n        return 13; // Ca 14 (STT 14)\n      } else if (title.includes('V\u00c1CH K\u00cdNH') || title.includes('C\u1eecA') || title.includes('TI\u1ebeP \u0110\u00d3N') || \n                 title.includes('GIAO H\u00c0NG') || title.includes('HTKT') || title.includes('THU NG\u00c2N')) {\n        return 14; // Ca 15 (STT 15)\n      }\n      return -1;\n    }\n\n    function updateShiftForCell(cell, staffName) {\n      const shiftIdx = getShiftIndexForCell(cell);\n      if (shiftIdx >= 0 && state.shifts[shiftIdx]) {\n        state.shifts[shiftIdx].nv = staffName;\n        localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n        renderShifts();\n      }\n    }\n\n    // L\u01b0u to\u00e0n b\u1ed9 c\u1ea5u h\u00ecnh s\u01a1 \u0111\u1ed3 v\u00e0o localStorage\n    function saveMapAllocations() {\n      const allocations = {};\n      document.querySelectorAll('.map-cell').forEach(c => {\n        const cellId = c.getAttribute('data-cell-id');\n        const staff = c.getAttribute('data-staff') || '';\n        if (cellId) {\n          allocations[cellId] = { staff: staff };\n        }\n      });\n      localStorage.setItem('st1841_map_allocations', JSON.stringify(allocations));\n    }\n\n    // \u0110\u1ed2NG B\u1ed8 T\u1ef0 \u0110\u1ed8NG T\u00caN NH\u00c2N S\u1ef0 T\u1eea 15 CA TR\u1ef0C L\u00caN C\u00c1C \u00d4 S\u01a0 \u0110\u1ed2 M\u1eb6T B\u1eb0NG\n    function syncMapCellsFromShifts() {\n      if (!Array.isArray(state.shifts) || state.shifts.length === 0) return;\n\n      const sMap = {};\n      state.shifts.forEach((s, idx) => {\n        sMap[idx + 1] = s;\n      });\n\n      const cells = document.querySelectorAll('.map-cell');\n      cells.forEach(cell => {\n        const titleEl = cell.querySelector('.cell-title');\n        if (!titleEl) return;\n        const title = titleEl.textContent.trim().toUpperCase();\n        const isIctSubgrid = cell.closest('.ict-subgrid') !== null;\n\n        let assignedStaff = '';\n\n        if (isIctSubgrid || title.includes('V\u00c1CH PK') || title.includes('LAPTOP') || \n            title.includes('SMARTPHONE') || title.includes('MOTOROLA') || title.includes('REALME') ||\n            title.includes('VIVO') || title.includes('XIAOMI') || title.includes('PK BASEUS') ||\n            title.includes('PK ANKER') || title.includes('CAMERA') || title.includes('BTN XIAOMI') ||\n            title.includes('BTN MOTO') || title.includes('OPPO') || title.includes('\u0110\u1ed2NG H\u1ed2') ||\n            title.includes('BTN OPPO') || title.includes('BTN VIVO') || title.includes('BTN REALME') ||\n            title.includes('BTN SAMSUNG') || title.includes('BTN HONOR') || title.includes('BTN APPLE') ||\n            title.includes('APPLE') || title.includes('V\u00c1CH PH\u1ee4 KI\u1ec6N') || title.includes('BTV ')) {\n          assignedStaff = sMap[1] ? sMap[1].nv : '';\n        } else if (title.includes('TIVI 1') || title.includes('TIVI 2') || title.includes('TIVI 3') || \n                   title.includes('V\u00c1CH H\u00c3NG SONY') || title.includes('V\u00c1CH H\u00c3NG SAMSUNG') || (title.includes('B\u1ee4C H\u00c3NG SAMSUNG') && !title.includes('T\u1ee6 L\u1ea0NH'))) {\n          assignedStaff = sMap[2] ? sMap[2].nv : '';\n        } else if (title.includes('TIVI 4') || title.includes('TIVI 5') || title.includes('LOA') || \n                   title.includes('V\u00c1CH H\u00c3NG LG') || title.includes('V\u00c1CH LOA') || title.includes('K\u1ec6 LOA') || (title.includes('B\u1ee4C H\u00c3NG LG') && !title.includes('T\u1ee6 L\u1ea0NH'))) {\n          assignedStaff = sMap[3] ? sMap[3].nv : '';\n        } else if (title.includes('M\u00c1Y GI\u1eb6T 1') || title.includes('M\u00c1Y GI\u1eb6T 2') || title.includes('M\u00c1Y GI\u1eb6T 3') || \n                   title.includes('M\u00c1Y GI\u1eb6T 1 - 2 -3') || title.includes('M\u00c1Y GI\u1eb6T ELECTROLUX') || title.includes('M\u00c1Y GI\u1eb6T HISENSE') || title.includes('B\u1ee4C H\u00c3NG HESENSI')) {\n          assignedStaff = sMap[4] ? sMap[4].nv : '';\n        } else if (title.includes('M\u00c1Y GI\u1eb6T 4') || title.includes('M\u00c1Y GI\u1eb6T 5') || title.includes('M\u00c1Y GI\u1eb6T 6') || \n                   title.includes('M\u00c1Y GI\u1eb6T 4 - 5 - 6') || title.includes('M\u00c1Y GI\u1eb6T SAMSUNG') || title.includes('M\u00c1Y GI\u1eb6T PANASONIC') || \n                   title.includes('M\u00c1Y GI\u1eb6T AQUA') || title.includes('M\u00c1Y GI\u1eb6T HAIER') || title.includes('M\u00c1Y GI\u1eb6T TOSHIBA') || \n                   title.includes('B\u1ee4C M\u00c1Y GI\u1eb6T') || title.includes('B\u1ee4C H\u00c3NG TOSHIBA') || title.includes('B\u1ee4C H\u00c3NG TCL')) {\n          assignedStaff = sMap[5] ? sMap[5].nv : '';\n        } else if (title.includes('V\u00c1CH M\u00c1Y L\u1ea0NH') || title.includes('D\u00c0N M\u01af\u1edaP') || title.includes('T\u1ee6 \u0110\u00d4NG')) {\n          assignedStaff = sMap[6] ? sMap[6].nv : '';\n        } else if (title.includes('B\u1ebeP') || title.includes('L\u00d2 VI S\u00d3NG') || title.includes('CH\u1ea2O') || \n                   title.includes('V\u00c1CH N\u1ed2I') || title.includes('N\u1ed2I CHI\u00caN') || title.includes('JUNGER') || title.includes('HAFALE')) {\n          assignedStaff = sMap[7] ? sMap[7].nv : '';\n        } else if (title.includes('L\u1eccC N\u01af\u1edaC') || title.includes('MLN MUTOSI') || title.includes('MLN HO\u00c0 PH\u00c1T') || \n                   title.includes('MLN KAROFI') || title.includes('GIA D\u1ee4NG 1') || title.includes('GIA D\u1ee4NG 01')) {\n          assignedStaff = sMap[8] ? sMap[8].nv : '';\n        } else if (title.includes('GIA D\u1ee4NG 2') || title.includes('GIA D\u1ee4NG 02') || title.includes('GIA D\u1ee4NG 3') || title.includes('GIA D\u1ee4NG 03')) {\n          assignedStaff = sMap[9] ? sMap[9].nv : '';\n        } else if (title.includes('GIA D\u1ee4NG 4') || title.includes('GIA D\u1ee4NG 04') || title.includes('GIA D\u1ee4NG 5') || title.includes('GIA D\u1ee4NG 05') || \n                   title.includes('GIA D\u1ee4NG KANGAROO') || (title.includes('GIA D\u1ee4NG TOSHIBA') && !title.includes('MLN'))) {\n          assignedStaff = sMap[10] ? sMap[10].nv : '';\n        } else if (title.includes('GIA D\u1ee4NG 6') || title.includes('GIA D\u1ee4NG 06') || title.includes('GIA D\u1ee4NG 7') || title.includes('GIA D\u1ee4NG 07') || \n                   title.includes('K\u1ec6 GIA D\u1ee4NG') || title.includes('GIA D\u1ee4NG SUNHOUSE') || title.includes('ROBOT') || title.includes('MLN SUNHOUSE')) {\n          assignedStaff = sMap[11] ? sMap[11].nv : '';\n        } else if (title.includes('T\u1ee6 L\u1ea0NH 1') || title.includes('T\u1ee6 L\u1ea0NH 2') || title.includes('T\u1ee6 L\u1ea0NH HITACHI') || \n                   title.includes('T\u1ee6 L\u1ea0NH AQUA') || title.includes('T\u1ee6 L\u1ea0NH LG') || title.includes('T\u1ee6 L\u1ea0NH SHARP') || \n                   (title.includes('T\u1ee6 L\u1ea0NH TOSHIBA') && !title.includes('V\u00c1CH')) || title.includes('B\u1ee4C H\u00c3NG HAIER') || \n                   title.includes('B\u1ee4C H\u00c3NG AQUA') || title.includes('B\u1ee4C H\u00c3NG XIAOMI')) {\n          assignedStaff = sMap[12] ? sMap[12].nv : '';\n        } else if (title.includes('T\u1ee6 L\u1ea0NH 3') || title.includes('T\u1ee6 L\u1ea0NH 4') || title.includes('T\u1ee6 L\u1ea0NH SAMSUNG') || \n                   title.includes('T\u1ee6 L\u1ea0NH PANASONIC') || title.includes('T\u1ee6 L\u1ea0NH HAIER') || title.includes('B\u1ee4C T\u1ee6 L\u1ea0NH')) {\n          assignedStaff = sMap[13] ? sMap[13].nv : '';\n        } else if (title.includes('V\u00c1CH T\u1ee6 L\u1ea0NH') || title.includes('V\u00c1CH TL')) {\n          assignedStaff = sMap[14] ? sMap[14].nv : '';\n        } else if (title.includes('V\u00c1CH K\u00cdNH') || title.includes('C\u1eecA') || title.includes('TI\u1ebeP \u0110\u00d3N') || \n                   title.includes('GIAO H\u00c0NG') || title.includes('HTKT') || title.includes('THU NG\u00c2N')) {\n          assignedStaff = sMap[15] ? sMap[15].nv : '';\n        }\n\n        if (assignedStaff) {\n          cell.setAttribute('data-staff', assignedStaff);\n          let staffEl = cell.querySelector('.cell-staff');\n          if (!staffEl) {\n            staffEl = document.createElement('span');\n            staffEl.className = 'cell-staff';\n            cell.appendChild(staffEl);\n          }\n          staffEl.textContent = assignedStaff;\n        }\n      });\n\n      saveMapAllocations();\n      initMapCells();\n    }\n\n    // \u0110\u1ed5i t\u00ean nh\u00e2n vi\u00ean tr\u00ean T\u1ea4T C\u1ea2 c\u00e1c khu v\u1ef1c\n    document.getElementById('btnApplyToAllStaffAreas').addEventListener('click', () => {\n      const oldStaff = (document.getElementById('modalCurrentStaffName').textContent || '').trim();\n      const dropdownVal = document.getElementById('modalStaffDropdown').value.trim();\n      const customVal = document.getElementById('modalStaffCustomInput').value.trim();\n      const newStaff = customVal || dropdownVal;\n\n      if (!newStaff) {\n        showToast('\u26a0\ufe0f Vui l\u00f2ng ch\u1ecdn ho\u1eb7c nh\u1eadp t\u00ean nh\u00e2n vi\u00ean m\u1edbi!');\n        return;\n      }\n\n      if (!oldStaff || oldStaff === 'Ch\u01b0a g\u00e1n') {\n        // N\u1ebfu tr\u01b0\u1edbc \u0111\u00f3 ch\u01b0a g\u00e1n th\u00ec ch\u1ec9 g\u00e1n cho \u00f4 hi\u1ec7n t\u1ea1i\n        if (state.selectedCellEl) {\n          state.selectedCellEl.setAttribute('data-staff', newStaff);\n          const staffEl = state.selectedCellEl.querySelector('.cell-staff');\n          if (staffEl) staffEl.textContent = newStaff;\n          updateShiftForCell(state.selectedCellEl, newStaff);\n          saveMapAllocations();\n        }\n      } else {\n        // Thay \u0111\u1ed5i T\u1ea4T C\u1ea2 c\u00e1c \u00f4 c\u00f3 t\u00ean nh\u00e2n vi\u00ean n\u00e0y\n        let updatedCount = 0;\n        document.querySelectorAll('.map-cell').forEach(c => {\n          const st = (c.getAttribute('data-staff') || '').trim();\n          if (st.toUpperCase() === oldStaff.toUpperCase()) {\n            c.setAttribute('data-staff', newStaff);\n            const staffEl = c.querySelector('.cell-staff');\n            if (staffEl) staffEl.textContent = newStaff;\n            updateShiftForCell(c, newStaff);\n            updatedCount++;\n          }\n        });\n\n        // \u0110\u1ed3ng b\u1ed9 c\u1eadp nh\u1eadt c\u1ea3 b\u1ea3ng ph\u00e2n ca 15 v\u1ecb tr\u00ed n\u1ebfu c\u00f3 t\u00ean c\u0169\n        state.shifts.forEach((s, idx) => {\n          if (s.nv && s.nv.trim().toUpperCase().includes(oldStaff.toUpperCase())) {\n            s.nv = s.nv.replace(new RegExp(escapeRegExp(oldStaff), 'gi'), newStaff);\n          }\n          if (s.pg && s.pg.trim().toUpperCase().includes(oldStaff.toUpperCase())) {\n            s.pg = s.pg.replace(new RegExp(escapeRegExp(oldStaff), 'gi'), newStaff);\n          }\n        });\n        localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n        renderShifts();\n\n        // C\u1eadp nh\u1eadt t\u00ean trong danh s\u00e1ch nh\u00e2n s\u1ef1 n\u1ebfu kh\u1edbp\n        let empUpdated = false;\n        state.employees.forEach(emp => {\n          if (emp.name && (emp.name.trim().toUpperCase() === oldStaff.toUpperCase() || isStaffNameMatch(emp.name, oldStaff))) {\n            emp.name = emp.name.replace(new RegExp(escapeRegExp(oldStaff), 'gi'), newStaff);\n            empUpdated = true;\n          }\n        });\n        if (empUpdated) {\n          localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n          renderEmployees();\n          initModalDropdowns();\n        }\n\n        saveMapAllocations();\n        notifyLocalDataChange('BATCH_RENAME_STAFF', {\n          oldStaff: oldStaff,\n          newStaff: newStaff,\n          shifts: state.shifts,\n          employees: state.employees\n        });\n        saveToSheetImmediately();\n\n        renderFloorplanStaffControls();\n        applyColorByStaff();\n        if (state.spotlightStaff) {\n          if (isStaffNameMatch(state.spotlightStaff, oldStaff)) {\n            setStaffSpotlight(newStaff);\n          } else {\n            setStaffSpotlight(state.spotlightStaff);\n          }\n        }\n\n        showToast('\ud83d\udd04 \u0110\u00e3 \u0111\u1ed5i T\u1ea4T C\u1ea2 ' + updatedCount + ' khu v\u1ef1c c\u1ee7a [' + oldStaff + '] th\u00e0nh [' + newStaff + ']!');\n      }\n\n      document.getElementById('staffAllocationModal').style.display = 'none';\n    });\n\n    // Ch\u1ec9 \u0111\u1ed5i ri\u00eang khu v\u1ef1c \u0111ang ch\u1ecdn\n    document.getElementById('btnApplyToSingleArea').addEventListener('click', () => {\n      const dropdownVal = document.getElementById('modalStaffDropdown').value.trim();\n      const customVal = document.getElementById('modalStaffCustomInput').value.trim();\n      const newStaff = customVal || dropdownVal;\n\n      if (!newStaff) {\n        showToast('\u26a0\ufe0f Vui l\u00f2ng ch\u1ecdn ho\u1eb7c nh\u1eadp t\u00ean nh\u00e2n vi\u00ean m\u1edbi!');\n        return;\n      }\n\n      if (state.selectedCellEl) {\n        state.selectedCellEl.setAttribute('data-staff', newStaff);\n        const staffEl = state.selectedCellEl.querySelector('.cell-staff');\n        if (staffEl) {\n          staffEl.textContent = newStaff;\n        } else {\n          const s = document.createElement('span');\n          s.className = 'cell-staff';\n          s.textContent = newStaff;\n          state.selectedCellEl.appendChild(s);\n        }\n        updateShiftForCell(state.selectedCellEl, newStaff);\n        saveMapAllocations();\n        notifyLocalDataChange('UPDATE_MAP_CELL', {\n          cellId: state.selectedCellEl.getAttribute('data-cell-id'),\n          staff: newStaff,\n          shifts: state.shifts,\n          employees: state.employees\n        });\n        saveToSheetImmediately();\n        renderFloorplanStaffControls();\n        applyColorByStaff();\n        if (state.spotlightStaff) {\n          setStaffSpotlight(state.spotlightStaff);\n        }\n        showToast('\u2713 \u0110\u00e3 c\u1eadp nh\u1eadt khu v\u1ef1c cho: ' + newStaff);\n      }\n\n      document.getElementById('staffAllocationModal').style.display = 'none';\n    });\n\n    // B\u1eaft \u0111\u1ea7u Ch\u1ebf \u0110\u1ed9 Ph\u00e2n B\u1ed5 Tr\u1ef1c Ti\u1ebfp Tr\u00ean S\u01a1 \u0110\u1ed3\n    document.getElementById('btnStartDirectAllocation').addEventListener('click', () => {\n      const staffName = (document.getElementById('modalCurrentStaffName').textContent || '').trim();\n      if (!staffName || staffName === 'Ch\u01b0a g\u00e1n') {\n        showToast('\u26a0\ufe0f Vui l\u00f2ng ch\u1ecdn m\u1ed9t nh\u00e2n vi\u00ean c\u1ee5 th\u1ec3 \u0111\u1ec3 b\u1eaft \u0111\u1ea7u ph\u00e2n b\u1ed5!');\n        return;\n      }\n      document.getElementById('staffAllocationModal').style.display = 'none';\n      enterDirectAllocationMode(staffName);\n    });\n\n    // N\u00fat Ph\u00e2n B\u1ed5 Nhanh tr\u00ean thanh c\u00f4ng c\u1ee5 s\u01a1 \u0111\u1ed3\n    document.getElementById('btnQuickAllocationMode').addEventListener('click', () => {\n      const name = prompt('Nh\u1eadp t\u00ean nh\u00e2n vi\u00ean c\u1ea7n click ph\u00e2n b\u1ed5 tr\u00ean s\u01a1 \u0111\u1ed3 (VD: TRANG, PH\u00daC, \u00c1I, M\u1ea0NH...):');\n      if (name && name.trim()) {\n        enterDirectAllocationMode(name.trim().toUpperCase());\n      }\n    });\n\n    function enterDirectAllocationMode(staffName) {\n      state.isAllocatingDirectly = true;\n      state.allocatingStaff = staffName;\n\n      document.getElementById('allocatingStaffNameBadge').textContent = staffName;\n      document.getElementById('allocationActiveBanner').style.display = 'flex';\n      document.getElementById('storeLayoutGridEl').classList.add('allocation-mode-active');\n\n      // Highlight t\u1ea5t c\u1ea3 c\u00e1c \u00f4 c\u1ee7a nh\u00e2n vi\u00ean n\u00e0y\n      document.querySelectorAll('.map-cell').forEach(c => {\n        const st = (c.getAttribute('data-staff') || '').trim();\n        if (st.toUpperCase() === staffName.toUpperCase()) {\n          c.classList.add('in-allocation-target');\n        } else {\n          c.classList.remove('in-allocation-target');\n        }\n      });\n\n      updateAllocatingCount();\n      showToast('\ud83c\udfaf B\u1eaft \u0111\u1ea7u ph\u00e2n b\u1ed5 cho [' + staffName + ']: Click v\u00e0o c\u00e1c \u00f4 tr\u00ean s\u01a1 \u0111\u1ed3 \u0111\u1ec3 G\u00e1n ho\u1eb7c B\u1ecf G\u00e1n!');\n\n      // Cu\u1ed9n t\u1edbi s\u01a1 \u0111\u1ed3\n      document.getElementById('floorPlanExportTarget').scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n\n    function exitDirectAllocationMode() {\n      state.isAllocatingDirectly = false;\n      state.allocatingStaff = '';\n\n      document.getElementById('allocationActiveBanner').style.display = 'none';\n      document.getElementById('storeLayoutGridEl').classList.remove('allocation-mode-active');\n\n      document.querySelectorAll('.map-cell').forEach(c => {\n        c.classList.remove('in-allocation-target');\n      });\n\n      saveMapAllocations();\n      renderFloorplanStaffControls();\n      applyColorByStaff();\n      if (state.spotlightStaff) {\n        setStaffSpotlight(state.spotlightStaff);\n      }\n      notifyLocalDataChange('SYNC_DATA', {\n        shifts: state.shifts,\n        employees: state.employees\n      });\n    }\n\n    function updateAllocatingCount() {\n      if (!state.allocatingStaff) return;\n      const count = getStaffAreaCount(state.allocatingStaff);\n      document.getElementById('allocatingAreaCountBadge').textContent = count + ' khu v\u1ef1c';\n    }\n\n    document.getElementById('btnFinishAllocation').onclick = exitDirectAllocationMode;\n    document.getElementById('btnCancelAllocation').onclick = exitDirectAllocationMode;\n    document.getElementById('btnCloseStaffModal').onclick = () => {\n      document.getElementById('staffAllocationModal').style.display = 'none';\n    };\n    document.getElementById('staffAllocationModal').onclick = (e) => {\n      if (e.target.id === 'staffAllocationModal') {\n        // Ng\u0103n ch\u1eb7n click th\u1ee9 2 c\u1ee7a thao t\u00e1c nh\u1ea5p \u0111\u00fap v\u00f4 t\u00ecnh r\u01a1i v\u00e0o n\u1ec1n overlay v\u00e0 \u0111\u00f3ng modal ngay l\u1eadp t\u1ee9c\n        if (Date.now() - (state.modalOpenTime || 0) < 400) {\n          return;\n        }\n        document.getElementById('staffAllocationModal').style.display = 'none';\n      }\n    };\n\n    // TABS SWITCHING\n    document.querySelectorAll('.nav-tab-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));\n        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n        btn.classList.add('active');\n        const tabId = btn.getAttribute('data-tab');\n        const tabEl = document.getElementById(tabId);\n        if (tabEl) tabEl.classList.add('active');\n        state.activeTab = tabId;\n        if (tabId === 'employeesTab') {\n          renderEmployees();\n          if (typeof applyMobileEmpFilter === 'function') applyMobileEmpFilter();\n        } else if (tabId === 'floorMapTab') {\n          renderShifts();\n          if (typeof syncMapCellsFromShifts === 'function') syncMapCellsFromShifts();\n          setTimeout(() => {\n            if (typeof updateFloorplanZoom === 'function') updateFloorplanZoom();\n          }, 50);\n        }\n      });\n    });\n\n    // ==========================================================================\n    // C\u01a0 CH\u1ebe \u0110\u1ed2NG B\u1ed8 REALTIME \u0110A T\u1ea6NG: BROADCAST CHANNEL + STORAGE EVENT + MQTT\n    // ==========================================================================\n\n    // K\u00caNH \u0110\u1ed2NG B\u1ed8 TRUY\u1ec0N TIN T\u1ee8C TH\u00cc GI\u1eeeA C\u00c1C TAB C\u00d9NG TR\u00ccNH DUY\u1ec6T (0ms)\n    let syncBroadcastChannel = null;\n    try {\n      if (typeof BroadcastChannel !== 'undefined') {\n        syncBroadcastChannel = new BroadcastChannel('st1841_sync_channel');\n        syncBroadcastChannel.onmessage = (e) => {\n          if (e && e.data) {\n            handleIncomingRealtimeSync(e.data);\n          }\n        };\n      }\n    } catch(err) {}\n\n    // L\u1eaeNG NGHE STORAGE EVENT (D\u1ef0 PH\u00d2NG T\u1ee8C TH\u00cc GI\u1eeeA C\u00c1C TAB - 0ms)\n    window.addEventListener('storage', (e) => {\n      if (e.key === 'st1841_sync_event' && e.newValue) {\n        try {\n          const syncPacket = JSON.parse(e.newValue);\n          handleIncomingRealtimeSync(syncPacket);\n        } catch(err) {}\n      }\n    });\n\n    // MQTT REALTIME CLIENT (\u0110\u1ed2NG B\u1ed8 T\u1ee8C TH\u00cc LI\u00caN THI\u1ebeT B\u1eca < 150ms)\n    const MQTT_BROKERS = (DEFAULT_CONFIG.mqttBrokers && DEFAULT_CONFIG.mqttBrokers.length > 0)\n      ? DEFAULT_CONFIG.mqttBrokers\n      : [\"wss://broker.hivemq.com:8884/mqtt\", \"wss://broker.emqx.io:8084/mqtt\"];\n    let currentBrokerIdx = 0;\n    let mqttClient = null;\n    let mqttConnectTimeout = null;\n\n    function initRealtime() {\n      if (typeof mqtt === 'undefined') return;\n      connectToMqttBroker();\n    }\n\n    function connectToMqttBroker() {\n      if (mqttClient) {\n        try { mqttClient.end(true); } catch(e) {}\n      }\n      clearTimeout(mqttConnectTimeout);\n\n      const brokerUrl = MQTT_BROKERS[currentBrokerIdx];\n      try {\n        mqttClient = mqtt.connect(brokerUrl, {\n          clientId: CLIENT_ID,\n          clean: true,\n          connectTimeout: 4000,\n          reconnectPeriod: 6000\n        });\n\n        mqttConnectTimeout = setTimeout(() => {\n          if (!mqttClient || !mqttClient.connected) {\n            switchMqttBroker();\n          }\n        }, 4500);\n\n        mqttClient.on('connect', () => {\n          clearTimeout(mqttConnectTimeout);\n          mqttClient.subscribe(DEFAULT_CONFIG.mqttTopic);\n        });\n\n        mqttClient.on('message', (topic, payload) => {\n          try {\n            const msg = JSON.parse(payload.toString());\n            handleIncomingRealtimeSync(msg);\n          } catch (err) {}\n        });\n\n        mqttClient.on('error', () => {\n          switchMqttBroker();\n        });\n      } catch (e) {\n        switchMqttBroker();\n      }\n    }\n\n    function switchMqttBroker() {\n      clearTimeout(mqttConnectTimeout);\n      currentBrokerIdx = (currentBrokerIdx + 1) % MQTT_BROKERS.length;\n      setTimeout(() => {\n        if (!mqttClient || !mqttClient.connected) {\n          connectToMqttBroker();\n        }\n      }, 1500);\n    }\n\n    function broadcastMqtt(msg) {\n      if (mqttClient && mqttClient.connected) {\n        try {\n          mqttClient.publish(DEFAULT_CONFIG.mqttTopic, JSON.stringify(msg));\n        } catch(e) {}\n      }\n    }\n\n    // TH\u00d4NG B\u00c1O THAY \u0110\u1ed4I C\u1ee4C B\u1ed8 RA M\u1eccI K\u00caNH (T\u1ee8C TH\u00cc 0ms - 100ms)\n    function notifyLocalDataChange(changeType, payload = {}) {\n      lastLocalEditTime = Date.now();\n\n      const syncPacket = {\n        senderId: CLIENT_ID,\n        type: changeType,\n        shifts: state.shifts,\n        employees: state.employees,\n        payload: payload,\n        time: Date.now()\n      };\n\n      // 1. G\u1eedi qua BroadcastChannel (0ms t\u1edbi c\u00e1c tab kh\u00e1c)\n      if (syncBroadcastChannel) {\n        try {\n          syncBroadcastChannel.postMessage(syncPacket);\n        } catch (e) {}\n      }\n\n      // 2. G\u1eedi qua storage event (0ms d\u1ef1 ph\u00f2ng)\n      try {\n        localStorage.setItem('st1841_sync_event', JSON.stringify(syncPacket));\n      } catch (e) {}\n\n      // 3. G\u1eedi qua MQTT (t\u1ee9c th\u00ec t\u1edbi c\u00e1c thi\u1ebft b\u1ecb kh\u00e1c)\n      broadcastMqtt(syncPacket);\n\n      // 4. L\u01b0u v\u1ec1 Google Sheet (\u0111\u00e3 t\u1ed1i \u01b0u gom \u0111\u1ee3t)\n      debouncedSaveToSheet();\n    }\n\n    // \u00c1P D\u1ee4NG D\u1eee LI\u1ec6U \u0110\u1ed2NG B\u1ed8 \u0110\u1ebeN T\u1eea C\u00c1C TAB HO\u1eb6C THI\u1ebeT B\u1eca KH\u00c1C\n    function handleIncomingRealtimeSync(data) {\n      if (!data || data.senderId === CLIENT_ID) return;\n\n      // N\u1ebfu tab n\u00e0y v\u1eeba ch\u1ec9nh s\u1eeda c\u1ee5c b\u1ed9 trong v\u00f2ng 1.5s, kh\u00f4ng \u0111\u1ec3 tin nh\u1eafn c\u0169 \u0111\u00e8 l\u00ean\n      if (Date.now() - lastLocalEditTime < 1500 && data.time && data.time < lastLocalEditTime) {\n        return;\n      }\n\n      let updated = false;\n\n      // X\u1eed l\u00fd s\u1ef1 ki\u1ec7n \u0111\u1ed5i t\u00ean c\u1ee5 th\u1ec3\n      if (data.type === 'RENAME_EMPLOYEE' && data.payload && data.payload.oldName && data.payload.newName) {\n        updateAllAssignmentsWithNewName(data.payload.oldName, data.payload.newName);\n        updated = true;\n      }\n\n      // C\u1eadp nh\u1eadt 15 ca tr\u1ef1c n\u1ebfu c\u00f3\n      if (Array.isArray(data.shifts) && data.shifts.length > 0) {\n        const curSig = JSON.stringify(state.shifts.map(s => [s.nv, s.kv, s.pg]));\n        const newSig = JSON.stringify(data.shifts.map(s => [s.nv, s.kv, s.pg]));\n        if (curSig !== newSig) {\n          state.shifts = data.shifts;\n          localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n          renderShifts();\n          syncMapCellsFromShifts();\n          updated = true;\n        }\n      }\n\n      // C\u1eadp nh\u1eadt danh s\u00e1ch NV/PG n\u1ebfu c\u00f3\n      if (Array.isArray(data.employees) && data.employees.length > 0) {\n        const curSig = JSON.stringify(state.employees.map(e => [e.name, e.role, e.marked]));\n        const newSig = JSON.stringify(data.employees.map(e => [e.name, e.role, e.marked]));\n        if (curSig !== newSig) {\n          state.employees = data.employees;\n          localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n          renderEmployees();\n          initModalDropdowns();\n          updated = true;\n        }\n      }\n\n      // C\u1eadp nh\u1eadt \u00f4 s\u01a1 \u0111\u1ed3 n\u1ebfu c\u00f3\n      if (data.type === 'UPDATE_MAP_CELL' && data.payload) {\n        const c = document.querySelector('[data-cell-id=\"' + data.payload.cellId + '\"]');\n        if (c) {\n          c.setAttribute('data-staff', data.payload.staff || '');\n          const staffEl = c.querySelector('.cell-staff');\n          if (staffEl) staffEl.textContent = data.payload.staff || '';\n          saveMapAllocations();\n        }\n      } else if (data.type === 'BATCH_RENAME_STAFF' && data.payload) {\n        document.querySelectorAll('.map-cell').forEach(c => {\n          const st = (c.getAttribute('data-staff') || '').trim();\n          if (st.toUpperCase() === (data.payload.oldStaff || '').toUpperCase()) {\n            c.setAttribute('data-staff', data.payload.newStaff || '');\n            const staffEl = c.querySelector('.cell-staff');\n            if (staffEl) staffEl.textContent = data.payload.newStaff || '';\n          }\n        });\n        saveMapAllocations();\n      }\n\n      if (updated) {\n        startReloadButtonSpin();\n        setTimeout(stopReloadButtonSpin, 600);\n        const now = new Date();\n        const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;\n        const statusText = document.getElementById('realtimeStatusText');\n        if (statusText) statusText.textContent = `\ud83d\udfe2 T\u1ef1 \u0111\u1ed9ng \u0111\u1ed3ng b\u1ed9 (${timeStr})`;\n      }\n    }\n\n    // THEO D\u00d5I THAO T\u00c1C C\u1ee6A NG\u01af\u1edcI D\u00d9NG: Ch\u1ec9 ho\u00e3n c\u1eadp nh\u1eadt DOM khi \u0111ang tr\u1ef1c ti\u1ebfp g\u00f5 ph\u00edm\n    let lastUserKeypressTime = 0;\n    window.addEventListener('keydown', (e) => {\n      const tag = (e.target && e.target.tagName) ? e.target.tagName.toUpperCase() : '';\n      if (tag === 'INPUT' || tag === 'TEXTAREA') {\n        lastUserKeypressTime = Date.now();\n      }\n    }, true);\n\n    function isUserActivelyTyping() {\n      return (Date.now() - lastUserKeypressTime) < 1200;\n    }\n\n    function isModalOrPopupOpen() {\n      const allocModal = document.getElementById('staffAllocationModal');\n      if (allocModal && allocModal.style.display === 'flex') return true;\n      const cfgModal = document.getElementById('configModal');\n      if (cfgModal && cfgModal.style.display === 'flex') return true;\n      const editEmpModal = document.getElementById('editEmployeeModal');\n      if (editEmpModal && editEmpModal.style.display === 'flex') return true;\n      if (state.isAllocatingDirectly) return true;\n      return false;\n    }\n\n    // Ch\u1eef k\u00fd (Signature) theo d\u00f5i thay \u0111\u1ed5i \u0111\u1ec3 ph\u00e1t hi\u1ec7n ngay khi c\u00f3 ch\u1ec9nh s\u1eeda tr\u00ean Sheet\n    let lastKnownSaveSig = null;\n    let lastKnownDefSig = null;\n    let isFetchingSheet = false;\n    let pendingApplyData = null;\n    let pendingApplyTimer = null;\n\n    // H\u00c0M X\u1eec L\u00dd V\u00c0 HI\u1ec2N TH\u1eca D\u1eee LI\u1ec6U \u0110\u1eccC \u0110\u01af\u1ee2C T\u1eea SHEET (SMART DIFFING - T\u1ef0 \u0110\u1ed8NG C\u1eacP NH\u1eacT 100%)\n    function applyReceivedSheetData(data, sourceName = 'Google Sheet Realtime', silent = true) {\n      if (!data || !data.success) {\n        stopReloadButtonSpin();\n        return;\n      }\n\n      // N\u1ebfu ng\u01b0\u1eddi d\u00f9ng \u0111ang g\u00f5 ph\u00edm ho\u1eb7c modal \u0111ang m\u1edf, ho\u00e3n c\u1eadp nh\u1eadt l\u1ea1i sau 1.2s\n      if (isUserActivelyTyping() || isModalOrPopupOpen()) {\n        pendingApplyData = { data, sourceName, silent };\n        clearTimeout(pendingApplyTimer);\n        pendingApplyTimer = setTimeout(() => {\n          if (pendingApplyData) {\n            const p = pendingApplyData;\n            pendingApplyData = null;\n            applyReceivedSheetData(p.data, p.sourceName, p.silent);\n          }\n        }, 1200);\n        stopReloadButtonSpin();\n        return;\n      }\n\n      let shiftsChanged = false;\n      let empsChanged = false;\n\n      // 1. C\u1eadp nh\u1eadt 15 ca tr\u1ef1c n\u1ebfu c\u00f3\n      if (Array.isArray(data.shifts) && data.shifts.length > 0) {\n        let validShifts = data.shifts.filter(s => {\n          const nv = (s.nv || '').trim().toUpperCase();\n          const kv = (s.kv || '').trim().toUpperCase();\n          return nv !== 'NH\u00c2N VI\u00caN TR\u1ef0C' && kv !== 'KHU V\u1ef0C PH\u1ee4 TR\u00c1CH' && nv !== 'NH\u00c2N VI\u00caN';\n        });\n\n        validShifts = validShifts.map((s, idx) => ({\n          stt: idx + 1,\n          row: s.rowInSheet || s.row || (17 + idx),\n          nv: (s.nv || '').trim(),\n          kv: (s.kv || '').trim(),\n          pg: (s.pg || '').trim()\n        }));\n\n        if (validShifts.length < 15) {\n          for (let i = validShifts.length; i < 15; i++) {\n            validShifts.push(DEFAULT_SHIFTS[i]);\n          }\n        }\n\n        const currentShiftsSig = JSON.stringify(state.shifts.map(s => [s.nv, s.kv, s.pg]));\n        const newShiftsSig = JSON.stringify(validShifts.map(s => [s.nv, s.kv, s.pg]));\n\n        if (currentShiftsSig !== newShiftsSig) {\n          state.shifts = validShifts;\n          localStorage.setItem('st1841_shifts', JSON.stringify(state.shifts));\n          renderShifts();\n          syncMapCellsFromShifts();\n          shiftsChanged = true;\n        }\n      }\n\n      // 2. C\u1eadp nh\u1eadt danh s\u00e1ch NV/PG n\u1ebfu c\u00f3\n      if (Array.isArray(data.employees) && data.employees.length > 0) {\n        const validEmps = data.employees.filter(e => {\n          const name = (e && e.name || '').trim().toUpperCase();\n          return name && name !== 'H\u1ecc V\u00c0 T\u00caN' && name !== 'NH\u00c2N S\u1ef0' && name !== 'NH\u00c2N VI\u00caN' && name !== 'DANH S\u00c1CH NH\u00c2N S\u1ef0' && name !== 'STT';\n        }).map((emp, idx) => ({\n          stt: emp.stt || (idx + 1),\n          name: (emp.name || '').trim(),\n          role: emp.role || (isPgStaff(emp) ? 'pg' : 'nv'),\n          marked: (emp.marked === true || emp.marked === 'X' || emp.marked === '1' || emp.marked === 'TRUE')\n        }));\n\n        if (validEmps.length > 0) {\n          const currentEmpsSig = JSON.stringify(state.employees.map(e => [e.name, e.role, e.marked]));\n          const newEmpsSig = JSON.stringify(validEmps.map(e => [e.name, e.role, e.marked]));\n\n          if (currentEmpsSig !== newEmpsSig) {\n            state.employees = validEmps;\n            localStorage.setItem('st1841_employees', JSON.stringify(state.employees));\n            renderEmployees();\n            if (typeof initModalDropdowns === 'function') initModalDropdowns();\n            empsChanged = true;\n          } else {\n            const staffContainer = document.getElementById('staffNvGridContainer');\n            if (staffContainer && staffContainer.children.length === 0) {\n              renderEmployees();\n            }\n          }\n        }\n      }\n\n      // 3. C\u1eadp nh\u1eadt tr\u1ea1ng th\u00e1i hi\u1ec3n th\u1ecb Realtime\n      const statusPill = document.getElementById('realtimeStatusPill');\n      const statusText = document.getElementById('realtimeStatusText');\n      const now = new Date();\n      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;\n      if (statusPill && statusText) {\n        statusPill.className = 'live-status-pill connected';\n        statusText.textContent = `\ud83d\udfe2 T\u1ef1 \u0111\u1ed9ng \u0111\u1ed3ng b\u1ed9 (${timeStr})`;\n      }\n\n      // 4. N\u1ebfu c\u00f3 thay \u0111\u1ed5i th\u1eadt s\u1ef1 t\u1eeb Google Sheet, t\u1ef1 \u0111\u1ed9ng quay nh\u1eb9 n\u00fat l\u00e0m m\u1edbi b\u00e1o hi\u1ec7u (\u00e2m th\u1ea7m)\n      if (shiftsChanged || empsChanged) {\n        startReloadButtonSpin();\n        setTimeout(stopReloadButtonSpin, 850);\n        \n        // Ph\u00e1t t\u00edn hi\u1ec7u \u0111\u1ed3ng b\u1ed9 sang c\u00e1c tab kh\u00e1c trong c\u00f9ng tr\u00ecnh duy\u1ec7t\n        if (syncBroadcastChannel) {\n          try {\n            syncBroadcastChannel.postMessage({\n              type: 'SYNC_DATA',\n              shifts: state.shifts,\n              employees: state.employees,\n              time: Date.now()\n            });\n          } catch(e) {}\n        }\n      }\n      stopReloadButtonSpin();\n    }\n\n    // HI\u1ec6U \u1ee8NG T\u1ef0 \u0110\u1ed8NG CH\u1ea0Y XOAY N\u00daT L\u00c0M M\u1edaI (RELOAD BUTTON SPIN)\n    function startReloadButtonSpin() {\n      const btn = document.getElementById('btnReloadPage');\n      if (btn) btn.classList.add('spinning');\n    }\n\n    function stopReloadButtonSpin() {\n      const btn = document.getElementById('btnReloadPage');\n      if (btn) {\n        setTimeout(() => {\n          btn.classList.remove('spinning');\n        }, 500);\n      }\n    }\n\n    function triggerReloadButton(silent = true) {\n      startReloadButtonSpin();\n      fetchDirectFromGoogleSheetGviz(silent);\n    }\n\n    // ==========================================================================\n    // \u0110\u1ed2NG B\u1ed8 \u0110\u1eccC D\u1eee LI\u1ec6U T\u1ee8C TH\u00cc T\u1eea GOOGLE SHEET V\u1ec0 WEB APP (< 150ms)\n    // ==========================================================================\n    function fetchDataFromGoogleSheet(silent = true) {\n      fetchDirectFromGoogleSheetGviz(silent);\n      fetchFromAppsScriptBackground();\n    }\n\n    // Tr\u00edch xu\u1ea5t JSON t\u1eeb ph\u1ea3n h\u1ed3i Google Visualization API chu\u1ea9n x\u00e1c 100%\n    function extractGvizJson(rawText) {\n      if (!rawText) return null;\n      const start = rawText.indexOf('{');\n      const end = rawText.lastIndexOf('}');\n      if (start === -1 || end === -1 || end <= start) return null;\n      try {\n        return JSON.parse(rawText.substring(start, end + 1));\n      } catch (err) {\n        console.warn('L\u1ed7i ph\u00e2n t\u00edch JSON Gviz:', err);\n        return null;\n      }\n    }\n\n    // Tr\u00edch xu\u1ea5t d\u1eef li\u1ec7u t\u1eeb tab 'save data'\n    function parseRowsFromSaveData(rows) {\n      if (!Array.isArray(rows) || rows.length === 0) return null;\n\n      // T\u00ecm v\u1ecb tr\u00ed ca tr\u1ef1c STT 1 (c\u1ed9t 0 c\u00f3 gi\u00e1 tr\u1ecb 1)\n      let shiftStart = -1;\n      for (let r = 0; r < Math.min(rows.length, 10); r++) {\n        const row = rows[r];\n        if (row && row.c && row.c[0] && (row.c[0].v === 1 || row.c[0].v === '1' || row.c[0].f === '1')) {\n          shiftStart = r;\n          break;\n        }\n      }\n      if (shiftStart === -1) shiftStart = 0;\n\n      const shifts = [];\n      for (let i = 0; i < 15; i++) {\n        const r = rows[shiftStart + i];\n        if (!r || !r.c) continue;\n        const c = r.c;\n        const stt = (c[0] && c[0].v != null) ? Number(c[0].v) : (i + 1);\n        const nv = (c[1] && c[1].v != null) ? String(c[1].v).trim() : '';\n        const kv = (c[2] && c[2].v != null) ? String(c[2].v).trim() : '';\n        const pg = (c[3] && c[3].v != null) ? String(c[3].v).trim() : '';\n        if (nv || kv || pg) {\n          shifts.push({ stt, nv, kv, pg, row: 17 + i });\n        }\n      }\n\n      // \u0110\u1ecdc to\u00e0n b\u1ed9 danh s\u00e1ch nh\u00e2n s\u1ef1 t\u1eeb tab 'save data' (c\u1ed9t F..I t\u1ee9c c[5]..c[8])\n      const employees = [];\n      for (let r = 0; r < rows.length; r++) {\n        const row = rows[r];\n        if (!row || !row.c) continue;\n        const c = row.c;\n        const name = (c[6] && c[6].v != null) ? String(c[6].v).trim() : '';\n        if (!name || name === 'H\u1ecc V\u00c0 T\u00caN' || name === 'NH\u00c2N S\u1ef0' || name === 'DANH S\u00c1CH NH\u00c2N S\u1ef0' || name === 'STT' || name === 'NH\u00c2N VI\u00caN') continue;\n        const stt = (c[5] && c[5].v != null && !isNaN(Number(c[5].v))) ? Number(c[5].v) : (employees.length + 1);\n        const roleStr = (c[7] && c[7].v != null) ? String(c[7].v).trim() : '';\n        const mark = (c[8] && c[8].v != null) ? String(c[8].v).trim().toUpperCase() : '';\n        const isPg = /pg/i.test(roleStr) || /pg|tcl|lg|oppo|vivo|realme|xiaomi|aqua|toshiba|sunhouse|bluestone|karofi|mutosi/i.test(name);\n        employees.push({\n          stt,\n          name,\n          role: isPg ? 'pg' : 'nv',\n          marked: (mark === 'X' || mark === '1' || mark === 'TRUE')\n        });\n      }\n\n      return { shifts, employees };\n    }\n\n    // Tr\u00edch xu\u1ea5t d\u1eef li\u1ec7u t\u1eeb tab g\u1ed1c 'VS C\u0168'\n    function parseRowsFromDefaultSheet(rows) {\n      if (!Array.isArray(rows) || rows.length === 0) return null;\n\n      // 1. T\u00ecm v\u1ecb tr\u00ed ca tr\u1ef1c STT 1 (c\u1ed9t 22 c\u00f3 gi\u00e1 tr\u1ecb 1)\n      let shiftStart = -1;\n      for (let r = 0; r < Math.min(rows.length, 35); r++) {\n        const row = rows[r];\n        if (row && row.c && row.c[22] && (row.c[22].v === 1 || row.c[22].v === '1' || row.c[22].f === '1')) {\n          shiftStart = r;\n          break;\n        }\n      }\n      if (shiftStart === -1) shiftStart = 16;\n\n      const shifts = [];\n      for (let i = 0; i < 15; i++) {\n        const r = rows[shiftStart + i];\n        if (!r || !r.c) continue;\n        const c = r.c;\n        const stt = (c[22] && c[22].v != null) ? Number(c[22].v) : (i + 1);\n        const nv = (c[23] && c[23].v != null) ? String(c[23].v).trim() : '';\n        const kv = (c[24] && c[24].v != null) ? String(c[24].v).trim() : '';\n        const pg = (c[25] && c[25].v != null) ? String(c[25].v).trim() : '';\n        if (nv || kv || pg) {\n          shifts.push({ stt, nv, kv, pg, row: 17 + i });\n        }\n      }\n\n      // 2. T\u00ecm nh\u00e2n s\u1ef1: Trong sheet g\u1ed1c, nh\u00e2n s\u1ef1 \u1edf c\u1ed9t AC=28 (STT), AD=29 (T\u00ean), AE=30 (X)\n      let nameCol = 29;\n      let sttCol = 28;\n      let markCol = 30;\n\n      // Ki\u1ec3m tra xem c\u1ed9t 29 c\u00f3 d\u1eef li\u1ec7u t\u00ean hay kh\u00f4ng, n\u1ebfu kh\u00f4ng qu\u00e9t c\u00e1c c\u1ed9t l\u00e2n c\u1eadn\n      let foundNameInCol29 = false;\n      for (let r = 0; r < Math.min(rows.length, 10); r++) {\n        const row = rows[r];\n        if (row && row.c && row.c[29] && row.c[29].v != null && String(row.c[29].v).trim().length > 2) {\n          foundNameInCol29 = true;\n          break;\n        }\n      }\n\n      if (!foundNameInCol29) {\n        for (let col = 26; col <= 34; col++) {\n          let count = 0;\n          for (let r = 0; r < Math.min(rows.length, 10); r++) {\n            const row = rows[r];\n            if (row && row.c && row.c[col] && row.c[col].v != null && String(row.c[col].v).trim().length > 2) {\n              count++;\n            }\n          }\n          if (count >= 2) {\n            nameCol = col;\n            sttCol = col - 1;\n            markCol = col + 1;\n            break;\n          }\n        }\n      }\n\n      const employees = [];\n      for (let r = 0; r < rows.length; r++) {\n        const row = rows[r];\n        if (!row || !row.c) continue;\n        const c = row.c;\n        const name = (c[nameCol] && c[nameCol].v != null) ? String(c[nameCol].v).trim() : '';\n        if (!name || name === 'H\u1ecc V\u00c0 T\u00caN' || name === 'NH\u00c2N S\u1ef0' || name === 'NH\u00c2N VI\u00caN' || name === 'DANH S\u00c1CH NH\u00c2N S\u1ef0' || name === 'STT') continue;\n        const stt = (c[sttCol] && c[sttCol].v != null && !isNaN(Number(c[sttCol].v))) ? Number(c[sttCol].v) : (employees.length + 1);\n        const mark = (c[markCol] && c[markCol].v != null) ? String(c[markCol].v).trim().toUpperCase() : '';\n        const isPg = /pg|tcl|lg|oppo|vivo|realme|xiaomi|aqua|toshiba|sunhouse|bluestone|karofi|mutosi/i.test(name);\n        employees.push({\n          stt,\n          name,\n          role: isPg ? 'pg' : 'nv',\n          marked: (mark === 'X' || mark === '1' || mark === 'TRUE')\n        });\n      }\n\n      return { shifts, employees };\n    }\n\n    // \u0110\u1eccC D\u1eee LI\u1ec6U QUA GOOGLE VISUALIZATION API SI\u00caU T\u1ed0C (< 150ms) - \u0110\u1ed2NG TH\u1edcI C\u1ea2 2 TAB SHEET\n    function fetchDirectFromGoogleSheetGviz(silent = true) {\n      if (isFetchingSheet || isSavingToSheet) return;\n      isFetchingSheet = true;\n\n      const sheetId = DEFAULT_CONFIG.sheetId;\n      const t = Date.now();\n      const r = Math.random().toString(36).substring(2, 8);\n      const gvizSaveDataUrl = 'https://docs.google.com/spreadsheets/d/' + sheetId + '/gviz/tq?tqx=out:json&sheet=save%20data&_t=' + t + '&_r=' + r;\n      const gvizDefaultUrl = 'https://docs.google.com/spreadsheets/d/' + sheetId + '/gviz/tq?tqx=out:json&_t=' + t + '&_r=' + r;\n\n      const controller = new AbortController();\n      const timeoutId = setTimeout(() => controller.abort(), 4500);\n\n      const fetchOpts = {\n        signal: controller.signal,\n        cache: 'no-store',\n        headers: {\n          'Cache-Control': 'no-cache, no-store, must-revalidate',\n          'Pragma': 'no-cache'\n        }\n      };\n\n      Promise.allSettled([\n        fetch(gvizSaveDataUrl, fetchOpts).then(res => res.text()),\n        fetch(gvizDefaultUrl, fetchOpts).then(res => res.text())\n      ]).then(results => {\n        clearTimeout(timeoutId);\n        isFetchingSheet = false;\n\n        let dataSave = null;\n        let dataDefault = null;\n\n        if (results[0].status === 'fulfilled' && results[0].value) {\n          const jsonSave = extractGvizJson(results[0].value);\n          if (jsonSave && jsonSave.table && jsonSave.table.rows) {\n            dataSave = parseRowsFromSaveData(jsonSave.table.rows);\n          }\n        }\n\n        if (results[1].status === 'fulfilled' && results[1].value) {\n          const jsonDef = extractGvizJson(results[1].value);\n          if (jsonDef && jsonDef.table && jsonDef.table.rows) {\n            dataDefault = parseRowsFromDefaultSheet(jsonDef.table.rows);\n          }\n        }\n\n        // T\u00ednh ch\u1eef k\u00fd d\u1eef li\u1ec7u \u0111\u1ec3 ph\u00e1t hi\u1ec7n ngu\u1ed3n thay \u0111\u1ed5i ch\u00ednh x\u00e1c nh\u1ea5t\n        const curAppSig = JSON.stringify({\n          shifts: state.shifts.map(s => [s.nv, s.kv, s.pg]),\n          emps: state.employees.map(e => [e.name, e.marked])\n        });\n\n        const saveSig = (dataSave && ((dataSave.shifts && dataSave.shifts.length > 0) || (dataSave.employees && dataSave.employees.length > 0))) ? JSON.stringify({\n          shifts: (dataSave.shifts || []).map(s => [s.nv, s.kv, s.pg]),\n          emps: (dataSave.employees || []).map(e => [e.name, e.marked])\n        }) : null;\n\n        const defSig = (dataDefault && ((dataDefault.shifts && dataDefault.shifts.length > 0) || (dataDefault.employees && dataDefault.employees.length > 0))) ? JSON.stringify({\n          shifts: (dataDefault.shifts || []).map(s => [s.nv, s.kv, s.pg]),\n          emps: (dataDefault.employees || []).map(e => [e.name, e.marked])\n        }) : null;\n\n        // 1. L\u1ea7n \u0111\u1ea7u m\u1edf trang: kh\u1edfi t\u1ea1o m\u1ed1c signature v\u00e0 n\u1ea1p d\u1eef li\u1ec7u ban \u0111\u1ea7u\n        if (lastKnownSaveSig === null && lastKnownDefSig === null) {\n          lastKnownSaveSig = saveSig;\n          lastKnownDefSig = defSig;\n\n          if (dataSave && (dataSave.shifts.length > 0 || dataSave.employees.length > 0)) {\n            applyReceivedSheetData(dataSave, 'Google Sheet (save data)', silent);\n          } else if (dataDefault && (dataDefault.shifts.length > 0 || dataDefault.employees.length > 0)) {\n            applyReceivedSheetData(dataDefault, 'Google Sheet (VS C\u0169)', silent);\n          }\n          stopReloadButtonSpin();\n          return;\n        }\n\n        // 2. Ki\u1ec3m tra xem Sheet c\u00f3 th\u1ef1c s\u1ef1 thay \u0111\u1ed5i so v\u1edbi l\u1ea7n poll tr\u01b0\u1edbc hay kh\u00f4ng\n        const saveChanged = (saveSig && saveSig !== lastKnownSaveSig);\n        const defChanged = (defSig && defSig !== lastKnownDefSig);\n\n        // C\u1eadp nh\u1eadt l\u1ea1i m\u1ed1c so s\u00e1nh\n        if (saveSig) lastKnownSaveSig = saveSig;\n        if (defSig) lastKnownDefSig = defSig;\n\n        // N\u1ebfu ng\u01b0\u1eddi d\u00f9ng v\u1eeba s\u1eeda c\u1ee5c b\u1ed9 tr\u00ean Web App trong v\u00f2ng 5 gi\u00e2y, KH\u00d4NG \u0111\u1ec3 d\u1eef li\u1ec7u c\u0169 t\u1eeb Sheet \u0111\u00e8 l\u00ean\n        if (Date.now() - lastLocalEditTime < 5000) {\n          stopReloadButtonSpin();\n          return;\n        }\n\n        if (defChanged && !saveChanged) {\n          // Ng\u01b0\u1eddi d\u00f9ng v\u1eeba s\u1eeda tr\u1ef1c ti\u1ebfp tr\u00ean s\u01a1 \u0111\u1ed3 sheet g\u1ed1c 'VS C\u0168'\n          applyReceivedSheetData(dataDefault, 'Google Sheet (S\u01a1 \u0111\u1ed3 VS C\u0169)', silent);\n        } else if (saveChanged) {\n          // Tab 'save data' v\u1eeba \u0111\u01b0\u1ee3c c\u1eadp nh\u1eadt m\u1edbi\n          applyReceivedSheetData(dataSave || dataDefault, 'Google Sheet (save data)', silent);\n        } else {\n          // Kh\u00f4ng c\u00f3 thay \u0111\u1ed5i t\u1eeb Google Sheet: n\u1ebfu d\u1eef li\u1ec7u local \u0111ang tr\u1ed1ng r\u1ed7ng th\u00ec m\u1edbi n\u1ea1p\n          if (state.shifts.length === 0 || state.employees.length === 0) {\n            const fallbackEmps = (dataSave && dataSave.employees && dataSave.employees.length > 0)\n              ? dataSave.employees\n              : (dataDefault && dataDefault.employees && dataDefault.employees.length > 0 ? dataDefault.employees : state.employees);\n            const fallbackShifts = (dataSave && dataSave.shifts && dataSave.shifts.length > 0)\n              ? dataSave.shifts\n              : (dataDefault && dataDefault.shifts && dataDefault.shifts.length > 0 ? dataDefault.shifts : state.shifts);\n            if (fallbackEmps.length > 0 || fallbackShifts.length > 0) {\n              applyReceivedSheetData({ success: true, shifts: fallbackShifts, employees: fallbackEmps }, 'Google Sheet Realtime', silent);\n            }\n          }\n          stopReloadButtonSpin();\n        }\n      }).catch(err => {\n        clearTimeout(timeoutId);\n        isFetchingSheet = false;\n        stopReloadButtonSpin();\n      });\n    }\n\n    // \u0110\u1eccC D\u1ef0 PH\u00d2NG T\u1eea APPS SCRIPT \u1ede N\u1ec0N (KH\u00d4NG CH\u1eb6N GIAO DI\u1ec6N)\n    function fetchFromAppsScriptBackground() {\n      const url = DEFAULT_CONFIG.webAppUrl;\n      if (!url) return;\n\n      const fetchUrl = url + (url.includes('?') ? '&' : '?') + 'action=getData&sheetId=' + encodeURIComponent(DEFAULT_CONFIG.sheetId) + '&_t=' + Date.now();\n      const controller = new AbortController();\n      const timeoutId = setTimeout(() => controller.abort(), 4000);\n\n      fetch(fetchUrl, {\n        method: 'GET',\n        signal: controller.signal\n      })\n        .then(res => {\n          clearTimeout(timeoutId);\n          if (!res.ok) throw new Error('HTTP ' + res.status);\n          return res.json();\n        })\n        .then(data => {\n          if (data && data.success) {\n            applyReceivedSheetData(data, 'Google Apps Script', true);\n          }\n        })\n        .catch(() => {\n          clearTimeout(timeoutId);\n        });\n    }\n\n    // N\u00daT XU\u1ea4T \u1ea2NH HD: \u0110\u1ea2M B\u1ea2O CH\u1ee4P 100% TO\u00c0N B\u1ed8 S\u01a0 \u0110\u1ed2 M\u1eb6T B\u1eb0NG KH\u00d4NG B\u1eca C\u1eaeT X\u00c9N\n    document.getElementById('btnExportImage').addEventListener('click', async () => {\n      if (typeof html2canvas === 'undefined') {\n        showToast('\u274c Th\u01b0 vi\u1ec7n t\u1ea1o \u1ea3nh ch\u01b0a s\u1eb5n s\u00e0ng!');\n        return;\n      }\n\n      showToast('\ud83d\udcf8 \u0110ang k\u1ebft xu\u1ea5t to\u00e0n b\u1ed9 s\u01a1 \u0111\u1ed3 HD (s\u1eafc n\u00e9t 2X)...');\n\n      const isFloorMap = (state.activeTab === 'floorMapTab');\n      const target = isFloorMap \n        ? document.getElementById('floorPlanExportTarget') \n        : (state.activeTab === 'rulesTab' \n          ? document.getElementById('rulesExportTarget') \n          : document.getElementById('employeesTab') || document.getElementById('appMainContainer'));\n\n      if (!target) return;\n\n      // X\u00f3a c\u00e1c \u00f4 \u0111ang highlight t\u00ecm ki\u1ebfm (n\u1ebfu c\u00f3) \u0111\u1ec3 \u1ea3nh xu\u1ea5t ra chu\u1ea9n \u0111\u1eb9p\n      document.querySelectorAll('.highlight-target').forEach(el => el.classList.remove('highlight-target'));\n\n      // L\u01b0u tr\u1ea1ng th\u00e1i scroll ngang c\u1ee7a viewport s\u01a1 \u0111\u1ed3\n      const scrollViewport = document.querySelector('.floorplan-scroll-viewport');\n      const originalScrollLeft = scrollViewport ? scrollViewport.scrollLeft : 0;\n      if (scrollViewport) scrollViewport.scrollLeft = 0;\n\n      // C\u1eadp nh\u1eadt timestamp xu\u1ea5t \u1ea3nh\n      const now = new Date();\n      const timeStr = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;\n      const tsEl = document.getElementById('exportTimeText');\n      if (tsEl) tsEl.textContent = timeStr;\n\n      // B\u1eadt ch\u1ebf \u0111\u1ed9 full width \u0111\u1ec3 bung to\u00e0n b\u1ed9 k\u00edch th\u01b0\u1edbc s\u01a1 \u0111\u1ed3 trong DOM\n      if (isFloorMap) {\n        document.body.classList.add('exporting-full-map');\n      }\n\n      // Ch\u1edd DOM t\u00ednh to\u00e1n l\u1ea1i layout (60ms)\n      await new Promise(r => setTimeout(r, 60));\n\n      try {\n        const gridEl = document.getElementById('storeLayoutGridEl');\n        const gridW = gridEl ? Math.max(gridEl.scrollWidth, 1920) : 1920;\n        const exportW = isFloorMap ? Math.max(target.scrollWidth, target.offsetWidth, gridW + 40, 1960) : Math.max(target.offsetWidth, target.scrollWidth);\n        const exportH = isFloorMap ? Math.max(target.scrollHeight, target.offsetHeight) : target.scrollHeight;\n\n        const windowW = Math.max(exportW + 80, 2050);\n        const windowH = Math.max(exportH + 100, 1600);\n\n        const canvas = await html2canvas(target, {\n          scale: 2,\n          backgroundColor: '#fffdf5',\n          useCORS: true,\n          logging: false,\n          width: exportW,\n          height: exportH,\n          windowWidth: windowW,\n          windowHeight: windowH,\n          scrollX: 0,\n          scrollY: 0,\n          onclone: (clonedDoc) => {\n            if (isFloorMap) {\n              clonedDoc.documentElement.style.overflow = 'visible';\n              clonedDoc.body.style.overflow = 'visible';\n              \n              const clonedApp = clonedDoc.querySelector('.app-container');\n              if (clonedApp) {\n                clonedApp.style.width = exportW + 'px';\n                clonedApp.style.maxWidth = 'none';\n                clonedApp.style.overflow = 'visible';\n                clonedApp.style.padding = '0';\n                clonedApp.style.margin = '0';\n              }\n\n              const clonedTarget = clonedDoc.getElementById('floorPlanExportTarget');\n              if (clonedTarget) {\n                clonedTarget.style.width = exportW + 'px';\n                clonedTarget.style.minWidth = exportW + 'px';\n                clonedTarget.style.maxWidth = 'none';\n                clonedTarget.style.overflow = 'visible';\n              }\n\n              const clonedVp = clonedDoc.querySelector('.floorplan-scroll-viewport');\n              if (clonedVp) {\n                clonedVp.style.width = '100%';\n                clonedVp.style.maxWidth = 'none';\n                clonedVp.style.overflow = 'visible';\n                clonedVp.style.overflowX = 'visible';\n                clonedVp.scrollLeft = 0;\n              }\n\n              const clonedGrid = clonedDoc.getElementById('storeLayoutGridEl');\n              if (clonedGrid) {\n                clonedGrid.style.width = '100%';\n                clonedGrid.style.minWidth = (exportW - 40) + 'px';\n              }\n\n              const clonedWrapper = clonedDoc.getElementById('floorplanZoomWrapper');\n              if (clonedWrapper) {\n                clonedWrapper.style.transform = 'none';\n                clonedWrapper.style.width = '100%';\n                clonedWrapper.style.height = 'auto';\n              }\n\n              const clonedZoomBar = clonedDoc.getElementById('floorplanZoomToolbar');\n              if (clonedZoomBar) clonedZoomBar.style.display = 'none';\n\n              const btnQ = clonedDoc.getElementById('btnQuickAllocationMode');\n              if (btnQ) btnQ.style.display = 'none';\n              const tip = clonedDoc.querySelector('.mobile-scroll-tip');\n              if (tip) tip.style.display = 'none';\n              const banner = clonedDoc.getElementById('allocationActiveBanner');\n              if (banner) banner.style.display = 'none';\n              const timeBadge = clonedDoc.getElementById('exportTimeBadge');\n              if (timeBadge) timeBadge.style.display = 'inline-flex';\n            }\n          }\n        });\n\n        currentExportDataUrl = canvas.toDataURL('image/png');\n\n        canvas.toBlob(blob => {\n          currentExportBlob = blob;\n\n          // Auto copy v\u00e0o Clipboard n\u1ebfu h\u1ed7 tr\u1ee3\n          if (navigator.clipboard && window.ClipboardItem && blob) {\n            try {\n              const item = new ClipboardItem({ 'image/png': blob });\n              navigator.clipboard.write([item]).then(() => {\n                showToast('\ud83d\udccb \u0110\u00e3 t\u1ef1 \u0111\u1ed9ng sao ch\u00e9p to\u00e0n b\u1ed9 \u1ea3nh s\u01a1 \u0111\u1ed3 v\u00e0o Clipboard! (B\u1ea5m Ctrl+V \u0111\u1ec3 d\u00e1n Zalo)');\n              }).catch(err => {\n                console.warn('Clipboard write error:', err);\n              });\n            } catch(e) {}\n          }\n\n          // Hi\u1ec3n th\u1ecb modal popup xem tr\u01b0\u1edbc\n          const modal = document.getElementById('imagePreviewModal');\n          const imgEl = document.getElementById('previewModalImageEl');\n          imgEl.src = currentExportDataUrl;\n          modal.style.display = 'flex';\n\n          showToast('\u2705 \u0110\u00e3 xu\u1ea5t tr\u1ecdn v\u1eb9n to\u00e0n b\u1ed9 s\u01a1 \u0111\u1ed3 HD!');\n        }, 'image/png');\n\n      } catch (err) {\n        console.error('L\u1ed7i khi xu\u1ea5t \u1ea3nh s\u01a1 \u0111\u1ed3:', err);\n        showToast('\u274c L\u1ed7i xu\u1ea5t \u1ea3nh: ' + err.message);\n      } finally {\n        // Lu\u00f4n kh\u00f4i ph\u1ee5c giao di\u1ec7n ng\u01b0\u1eddi d\u00f9ng b\u00ecnh th\u01b0\u1eddng\n        if (isFloorMap) {\n          document.body.classList.remove('exporting-full-map');\n        }\n        if (scrollViewport) {\n          scrollViewport.scrollLeft = originalScrollLeft;\n        }\n      }\n    });\n\n    // N\u00fat sao ch\u00e9p l\u1ea1i \u1ea3nh trong modal\n    document.getElementById('btnCopyImageAgain').addEventListener('click', () => {\n      if (currentExportBlob && navigator.clipboard && window.ClipboardItem) {\n        try {\n          const item = new ClipboardItem({ 'image/png': currentExportBlob });\n          navigator.clipboard.write([item]).then(() => {\n            showToast('\ud83d\udccb \u0110\u00e3 sao ch\u00e9p l\u1ea1i \u1ea3nh v\u00e0o Clipboard! B\u1ea5m Ctrl+V d\u00e1n v\u00e0o Zalo');\n          }).catch(() => {\n            showToast('\u26a0\ufe0f Kh\u00f4ng th\u1ec3 ghi v\u00e0o Clipboard t\u1ef1 \u0111\u1ed9ng');\n          });\n        } catch(e) {\n          showToast('\u26a0\ufe0f Kh\u00f4ng th\u1ec3 sao ch\u00e9p tr\u1ef1c ti\u1ebfp');\n        }\n      } else {\n        showToast('\u26a0\ufe0f Tr\u00ecnh duy\u1ec7t kh\u00f4ng h\u1ed7 tr\u1ee3 sao ch\u00e9p \u1ea3nh tr\u1ef1c ti\u1ebfp');\n      }\n    });\n\n    // N\u00fat t\u1ea3i v\u1ec1 m\u00e1y th\u1ee7 c\u00f4ng (khi ng\u01b0\u1eddi d\u00f9ng ch\u1ee7 \u0111\u1ed9ng mu\u1ed1n t\u1ea3i)\n    document.getElementById('btnDownloadImageManually').addEventListener('click', () => {\n      if (currentExportDataUrl) {\n        const a = document.createElement('a');\n        a.download = `SoDo_VeSinh_1841_${Date.now()}.png`;\n        a.href = currentExportDataUrl;\n        a.click();\n        showToast('\ud83d\udcbe \u0110ang t\u1ea3i \u1ea3nh v\u1ec1 m\u00e1y...');\n      }\n    });\n\n    // \u0110\u00f3ng modal xem tr\u01b0\u1edbc \u1ea3nh\n    const closePreviewModal = () => {\n      document.getElementById('imagePreviewModal').style.display = 'none';\n    };\n    document.getElementById('btnClosePreviewModal').onclick = closePreviewModal;\n    document.getElementById('btnClosePreviewModalBtn').onclick = closePreviewModal;\n    document.getElementById('imagePreviewModal').onclick = (e) => {\n      if (e.target.id === 'imagePreviewModal') closePreviewModal();\n    };\n\n    // L\u00c0M M\u1edaI & \u0110\u1ed2NG B\u1ed8 T\u1eea GOOGLE SHEET\n    document.getElementById('btnReloadPage').addEventListener('click', () => {\n      triggerReloadButton(true);\n    });\n\n    // N\u00daT L\u01afU V\u1ec0 SHEET (L\u01afU C\u1ea2 CA TR\u1ef0C V\u00c0 DANH S\u00c1CH NV/PG)\n    document.getElementById('btnSaveToSheetMain').addEventListener('click', () => {\n      showToast('\u2601\ufe0f \u0110ang l\u01b0u to\u00e0n b\u1ed9 ca tr\u1ef1c & danh s\u00e1ch NV/PG v\u1ec1 tab \"save data\" tr\u00ean Google Sheet...');\n      saveAllToSheet();\n      saveAllEmployeesToSheet();\n    });\n\n    // MODAL C\u00c0I \u0110\u1eb6T\n    document.getElementById('btnOpenConfigModal').onclick = () => {\n      document.getElementById('cfgWebAppUrl').value = DEFAULT_CONFIG.webAppUrl;\n      document.getElementById('configModal').style.display = 'flex';\n    };\n    document.getElementById('btnCloseConfigModal').onclick = () => document.getElementById('configModal').style.display = 'none';\n    document.getElementById('btnSaveConfig').onclick = () => {\n      const url = document.getElementById('cfgWebAppUrl').value.trim();\n      DEFAULT_CONFIG.webAppUrl = url;\n      localStorage.setItem('phancong_webapp_url', url);\n      document.getElementById('configModal').style.display = 'none';\n      showToast('\u2705 \u0110\u00e3 l\u01b0u c\u1ea5u h\u00ecnh Web App URL!');\n    };\n\n\n    // X\u1eec L\u00dd SUB-TABS TR\u00caN \u0110I\u1ec6N THO\u1ea0I (CHUY\u1ec2N NHANH NV / PG)\n    let currentMobileEmpFilter = 'all';\n    document.querySelectorAll('.mobile-subtab-btn').forEach(btn => {\n      btn.addEventListener('click', function() {\n        document.querySelectorAll('.mobile-subtab-btn').forEach(b => b.classList.remove('active'));\n        this.classList.add('active');\n        currentMobileEmpFilter = this.getAttribute('data-filter');\n        applyMobileEmpFilter();\n      });\n    });\n\n    function applyMobileEmpFilter() {\n      const panelStaff = document.querySelector('.emp-column-panel.panel-staff');\n      const panelPg = document.querySelector('.emp-column-panel.panel-pg');\n      if (!panelStaff || !panelPg) return;\n\n      if (window.innerWidth <= 768) {\n        if (currentMobileEmpFilter === 'nv') {\n          panelStaff.style.display = 'flex';\n          panelPg.style.display = 'none';\n        } else if (currentMobileEmpFilter === 'pg') {\n          panelStaff.style.display = 'none';\n          panelPg.style.display = 'flex';\n        } else {\n          panelStaff.style.display = 'flex';\n          panelPg.style.display = 'flex';\n        }\n      } else {\n        panelStaff.style.display = 'flex';\n        panelPg.style.display = 'flex';\n      }\n    }\n\n    let resizeZoomTimer = null;\n    window.addEventListener('resize', () => {\n      applyMobileEmpFilter();\n      clearTimeout(resizeZoomTimer);\n      resizeZoomTimer = setTimeout(() => {\n        if (typeof updateFloorplanZoom === 'function') {\n          updateFloorplanZoom();\n        }\n      }, 120);\n    });\n\n    window.addEventListener('orientationchange', () => {\n      setTimeout(() => {\n        if (typeof updateFloorplanZoom === 'function') {\n          updateFloorplanZoom();\n        }\n      }, 200);\n    });\n\n    // N\u00daT CU\u1ed8N L\u00caN \u0110\u1ea6U TRANG (MOBILE BACK TO TOP)\n    const btnScrollTopEl = document.getElementById('btnScrollTop');\n    if (btnScrollTopEl) {\n      window.addEventListener('scroll', () => {\n        btnScrollTopEl.style.display = (window.scrollY > 300) ? 'flex' : 'none';\n      });\n      btnScrollTopEl.addEventListener('click', () => {\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n      });\n    }\n\n    // KH\u1edeI \u0110\u1ed8NG\n    renderShifts();\n    renderEmployees();\n    initRealtime();\n    initMapCells();\n    syncMapCellsFromShifts();\n    triggerReloadButton(true);\n\n    // ==========================================================================\n    // AUTO-SYNC HO\u00c0N TO\u00c0N T\u1ef0 \u0110\u1ed8NG 100%: M\u1ed6I 2 GI\u00c2Y & T\u1ee8C TH\u00cc KHI FOCUS / M\u1ede TAB\n    // ==========================================================================\n    // 1. T\u1ef1 \u0111\u1ed9ng \u0111\u1ed3ng b\u1ed9 \u0111\u1ecbnh k\u1ef3 m\u1ed7i 2 gi\u00e2y li\u00ean t\u1ee5c (ho\u00e0n to\u00e0n t\u1ef1 \u0111\u1ed9ng, kh\u00f4ng c\u1ea7n b\u1ea5m n\u00fat)\n    setInterval(() => {\n      if (document.visibilityState === 'visible') {\n        fetchDirectFromGoogleSheetGviz(true);\n      }\n    }, 2000);\n\n    // 2. T\u1ef1 \u0111\u1ed9ng \u0111\u1ed3ng b\u1ed9 t\u1ee9c th\u00ec (0ms) ngay khi click chu\u1ed9t ho\u1eb7c quay l\u1ea1i c\u1eeda s\u1ed5 tr\u00ecnh duy\u1ec7t\n    window.addEventListener('focus', () => {\n      fetchDirectFromGoogleSheetGviz(true);\n    });\n\n    // 3. T\u1ef1 \u0111\u1ed9ng \u0111\u1ed3ng b\u1ed9 ngay khi tab tr\u00ecnh duy\u1ec7t hi\u1ec3n th\u1ecb l\u1ea1i\n    document.addEventListener('visibilitychange', () => {\n      if (document.visibilityState === 'visible') {\n        fetchDirectFromGoogleSheetGviz(true);\n      }\n    });\n\n    // 4. T\u1ef1 \u0111\u1ed9ng \u0111\u1ed3ng b\u1ed9 khi chuy\u1ec3n trang / m\u1edf l\u1ea1i\n    window.addEventListener('pageshow', () => {\n      fetchDirectFromGoogleSheetGviz(true);\n    });\n\n    // 5. T\u1ef1 \u0111\u1ed9ng \u0111\u1ed3ng b\u1ed9 khi v\u1eeba m\u1edf trang ho\u1eb7c F5 xong\n    window.addEventListener('load', () => {\n      triggerReloadButton(true);\n      setTimeout(() => {\n        if (typeof updateFloorplanZoom === 'function') {\n          updateFloorplanZoom();\n        }\n      }, 100);\n    });\n\n    // 6. B\u1ea5m th\u1ee7 c\u00f4ng v\u00e0o status pill n\u1ebfu mu\u1ed1n l\u00e0m m\u1edbi ch\u1ee7 \u0111\u1ed9ng (\u0111\u1ed3ng b\u1ed9 \u00e2m th\u1ea7m)\n    const pillEl = document.getElementById('realtimeStatusPill');\n    if (pillEl) {\n      pillEl.addEventListener('click', () => {\n        triggerReloadButton(true);\n      });\n    }\n  </script>\n</body>\n</html>\n";
